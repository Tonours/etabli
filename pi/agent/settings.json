{
  "packages": [
    {
      "source": "local:etabli-workflow",
      "extensions": [
        "rtk.ts"
      ],
      "skills": [
        "plan-loop",
        "plan-implement",
        "review",
        "implement",
        "caveman",
        "ui"
      ]
    }
  ],
  "lsp": {
    "hookMode": "agent_end"
  },
  "lastChangelogVersion": "0.67.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.4",
  "theme": "catppuccin-mocha",
  "defaultThinkingLevel": "high",
  "subagents": {
    "scout": {
      "model": "kimi-coding/k2p5",
      "thinking": "high"
    },
    "worker": {
      "model": "openai-codex/gpt-5.4",
      "thinking": "high"
    },
    "reviewer": {
      "model": "github-copilot/claude-sonnet-4.6",
      "thinking": "high"
    }
  },
  "subagentAutomation": {
    "planLoop": {
      "enabled": true,
      "autoScout": true,
      "autoReviewer": true
    },
    "planImplement": {
      "enabled": true,
      "autoScout": true,
      "autoReviewer": true,
      "autoWorkerOnReady": true
    }
  },
  "rtk": {
    "enabled": true,
    "mode": "always",
    "timeoutMs": 2500,
    "maxCacheEntries": 256,
    "maxCommandLength": 4000,
    "dangerousCommandBypass": true
  },
  "editorPaddingX": 1,
  "hideThinkingBlock": false,
  "collapseChangelog": true,
  "quietStartup": true,
  "doubleEscapeAction": "tree"
}
