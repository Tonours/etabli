{
  "packages": [
    {
      "source": "local:etabli-workflow",
      "extensions": [
        "rtk.ts"
      ],
      "skills": [
        "plan-loop",
        "plan-implement",
        "review",
        "implement",
        "caveman",
        "ui"
      ]
    }
  ],
  "lastChangelogVersion": "0.66.1",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.1",
  "theme": "catppuccin-mocha",
  "defaultThinkingLevel": "off",
  "rtk": {
    "enabled": true,
    "mode": "always",
    "timeoutMs": 2500,
    "maxCacheEntries": 256,
    "maxCommandLength": 4000,
    "dangerousCommandBypass": true
  },
  "editorPaddingX": 1,
  "hideThinkingBlock": true,
  "collapseChangelog": true,
  "quietStartup": true,
  "doubleEscapeAction": "tree"
}
