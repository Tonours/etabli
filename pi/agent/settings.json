{
  "packages": [
    {
      "source": "local:etabli-workflow",
      "extensions": [
        "rtk.ts",
        "filter-output.ts",
        "block-google-providers.ts"
      ],
      "skills": [
        "plan-loop",
        "plan-implement",
        "review",
        "implement",
        "caveman",
        "ui",
        "grill-me"
      ]
    },
    {
      "source": "npm:pi-hooks",
      "extensions": [
        "lsp/lsp.ts",
        "lsp/lsp-tool.ts"
      ],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    {
      "source": "npm:mitsupi",
      "extensions": [],
      "skills": [
        "github",
        "commit"
      ],
      "prompts": [],
      "themes": []
    },
    {
      "source": "git:github.com/badlogic/pi-skills",
      "extensions": [],
      "skills": [
        "brave-search"
      ],
      "prompts": [],
      "themes": []
    },
    {
      "source": "npm:pi-interview",
      "extensions": [
        "index.ts"
      ],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    {
      "source": "https://github.com/davebcn87/pi-autoresearch",
      "extensions": [
        "extensions/pi-autoresearch/index.ts"
      ],
      "skills": [
        "autoresearch-create",
        "autoresearch-finalize",
        "autoresearch-hooks"
      ],
      "prompts": [],
      "themes": []
    },
    {
      "source": "npm:glimpseui",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    }
  ],
  "lsp": {
    "hookMode": "agent_end"
  },
  "lastChangelogVersion": "0.67.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.4",
  "theme": "catppuccin-mocha",
  "defaultThinkingLevel": "high",
  "subagents": {
    "scout": {
      "model": "kimi-coding/k2p5",
      "thinking": "high"
    },
    "worker": {
      "model": "openai-codex/gpt-5.4",
      "thinking": "high"
    },
    "reviewer": {
      "model": "github-copilot/claude-sonnet-4.6",
      "thinking": "high"
    }
  },
  "subagentAutomation": {
    "planLoop": {
      "enabled": true,
      "autoScout": true,
      "autoReviewer": true
    },
    "planImplement": {
      "enabled": true,
      "autoScout": true,
      "autoReviewer": true,
      "autoWorkerOnReady": true
    }
  },
  "rtk": {
    "enabled": true,
    "mode": "always",
    "timeoutMs": 2500,
    "maxCacheEntries": 256,
    "maxCommandLength": 4000,
    "dangerousCommandBypass": true
  },
  "editorPaddingX": 1,
  "hideThinkingBlock": false,
  "collapseChangelog": true,
  "quietStartup": true,
  "doubleEscapeAction": "tree"
}
