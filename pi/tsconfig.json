{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@earendil-works/*": ["./node_modules/@earendil-works/*"],
      "@pi-mobile/protocol": ["../../pi-mobile/packages/protocol/src/index.ts"]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["bun", "node"]
  },
  "include": ["extensions/**/*.ts", "../workflow/runtime/*.mjs"]
}
