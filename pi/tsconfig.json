{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["bun", "node"]
  },
  "include": ["extensions/**/*.ts", "../workflow/runtime/*.mjs"]
}
