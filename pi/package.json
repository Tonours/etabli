{
  "name": "pi-config",
  "private": true,
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@protobufjs/utf8": "1.1.2",
    "brace-expansion": "5.0.8",
    "protobufjs": "7.6.5",
    "ws": "8.21.1"
  },
  "scripts": {
    "test": "bun test ./extensions/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:workflow": "bun test ./extensions/__tests__/block-google-providers.test.ts ./extensions/__tests__/rtk-runtime.test.ts ./extensions/__tests__/settings-consistency.test.ts",
    "test:workflow-coverage": "bun test --coverage ./extensions/__tests__/block-google-providers.test.ts ./extensions/__tests__/rtk-runtime.test.ts ./extensions/__tests__/settings-consistency.test.ts",
    "verify:skills": "bun ./scripts/verify-skills-lock.mjs",
    "update:skills-lock": "bun ./scripts/verify-skills-lock.mjs --write"
  }
}
