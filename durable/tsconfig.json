{
  "compilerOptions": { "target": "ESNext", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "allowJs": true, "checkJs": false, "skipLibCheck": true, "types": ["node", "bun"], "paths": { "@/*": ["./web-src/*"] } },
