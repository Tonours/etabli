{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@/*": [
        "./web-src/*"
      ]
    }
  },
  "include": [
    "web-src/**/*.ts",
    "web-src/**/*.tsx",
    "shared/**/*.ts",
    "__tests__/web-*.ts",
    "__tests__/web-*.tsx"
  ]
}
