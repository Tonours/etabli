{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etabli.local/workflow/self-improvement/jev-efficiency-result.schema.json",
  "title": "Jev efficiency campaign arm result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "arm",
    "campaign_id",
    "manifest_sha256",
    "evaluator_bundle_sha256",
    "artifact_fingerprint",
    "population_fingerprint",
    "runtime",
    "repetitions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "arm": { "enum": ["baseline", "candidate"] },
    "campaign_id": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "evaluator_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "artifact_fingerprint": { "$ref": "#/$defs/sha256" },
    "population_fingerprint": { "$ref": "#/$defs/sha256" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "provider", "model", "effort", "runtime_fingerprint", "candidate_enabled"],
      "properties": {
        "runner": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "effort": { "type": "string", "minLength": 1 },
        "runtime_fingerprint": { "$ref": "#/$defs/sha256" },
        "candidate_enabled": { "type": "boolean" }
      }
    },
    "repetitions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repetition", "tasks"],
        "properties": {
          "repetition": { "type": "integer", "minimum": 1, "maximum": 3 },
          "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "money": { "type": "number", "minimum": 0 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measured", "provenance", "input_tokens", "output_tokens", "cached_input_tokens", "cache_write_input_tokens", "total_tokens", "cost_usd", "cost_status"],
      "properties": {
        "measured": { "const": true },
        "provenance": { "const": "provider_receipt" },
        "input_tokens": { "$ref": "#/$defs/count" },
        "output_tokens": { "$ref": "#/$defs/count" },
        "cached_input_tokens": { "$ref": "#/$defs/count" },
        "cache_write_input_tokens": { "$ref": "#/$defs/count" },
        "total_tokens": { "$ref": "#/$defs/count" },
        "cost_usd": { "oneOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }] },
        "cost_status": { "enum": ["measured", "unavailable"] }
      }
    },
    "jev": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "input_tokens", "output_tokens", "total_tokens", "cost_usd", "cost_status", "latency_ms", "abstentions", "escalations", "retries"],
      "properties": {
        "calls": { "$ref": "#/$defs/count" },
        "input_tokens": { "$ref": "#/$defs/count" },
        "output_tokens": { "$ref": "#/$defs/count" },
        "total_tokens": { "$ref": "#/$defs/count" },
        "cost_usd": { "oneOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }] },
        "cost_status": { "enum": ["measured", "unavailable", "not_incurred"] },
        "latency_ms": { "$ref": "#/$defs/count" },
        "abstentions": { "$ref": "#/$defs/count" },
        "escalations": { "$ref": "#/$defs/count" },
        "retries": { "const": 0 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "protected", "passed", "latency_ms", "traditional_llm", "jev"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "protected": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "latency_ms": { "$ref": "#/$defs/count" },
        "traditional_llm": { "$ref": "#/$defs/usage" },
        "jev": { "$ref": "#/$defs/jev" }
      }
    }
  }
}
