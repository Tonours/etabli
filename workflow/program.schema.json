{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etabli.local/workflow/program.schema.json",
  "title": "Etabli large-program manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "goal", "coordinator_id", "artifact_root", "authorization", "units"],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "program_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "goal": { "type": "string", "minLength": 1 },
    "coordinator_id": { "type": "string", "minLength": 1 },
    "artifact_root": { "type": "string", "minLength": 1 },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_in_flight", "allowed_files", "allowed_tools", "forbidden_actions", "worktree_policy", "independent_verifier"],
      "properties": {
        "max_in_flight": { "type": "integer", "minimum": 1 },
        "allowed_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "allowed_tools": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "forbidden_actions": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "worktree_policy": { "enum": ["required", "optional"] },
        "independent_verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "distinct_model_family"],
          "properties": {
            "required": { "type": "boolean" },
            "distinct_model_family": { "type": "boolean" }
          }
        },
        "pilot_unit_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objective", "dependencies", "allowed_files", "allowed_tools", "verification", "retry_limit"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
          "objective": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "allowed_files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "allowed_tools": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "evidence"],
            "properties": {
              "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "evidence": { "type": "string", "minLength": 1 }
            }
          },
          "retry_limit": { "type": "integer", "minimum": 0 },
          "context": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
          "acceptance": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
          "timebox_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "report_artifact_prefix": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 2 } }, "required": ["schema_version"] },
      "then": {
        "properties": {
          "authorization": { "required": ["max_in_flight", "allowed_files", "allowed_tools", "forbidden_actions", "worktree_policy", "independent_verifier", "pilot_unit_id"] },
          "units": { "items": { "required": ["id", "objective", "dependencies", "allowed_files", "allowed_tools", "verification", "retry_limit", "context", "acceptance", "timebox_minutes", "report_artifact_prefix"] } }
        }
      },
      "else": {
        "properties": {
          "authorization": { "not": { "required": ["pilot_unit_id"] } },
          "units": {
            "items": {
              "allOf": [
                { "not": { "required": ["context"] } },
                { "not": { "required": ["acceptance"] } },
                { "not": { "required": ["timebox_minutes"] } },
                { "not": { "required": ["report_artifact_prefix"] } }
              ]
            }
          }
        }
      }
    }
  ]
}
