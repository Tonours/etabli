{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etabli.local/workflow/project-autonomy-envelope.schema.json",
  "title": "Etabli bounded project autonomy envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project",
    "authorization",
    "budget",
    "checkpoints",
    "stop_conditions",
    "evaluation",
    "slices",
    "started_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "goal"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "goal": { "type": "string", "minLength": 1 }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_files", "allowed_tools", "forbidden_actions"],
      "properties": {
        "allowed_files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_iterations", "max_duration_minutes", "max_candidates"],
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1 },
        "max_duration_minutes": { "type": "integer", "minimum": 1 },
        "max_candidates": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "before_slice", "category", "target"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "before_slice": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stop_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_hypothesis_failures", "red_checks_without_diff"],
      "properties": {
        "same_hypothesis_failures": { "const": 2 },
        "red_checks_without_diff": { "const": 3 }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "final_state_grader", "held_out_surface", "sealed_held_out"],
      "properties": {
        "runner": { "type": "string", "minLength": 1 },
        "final_state_grader": { "type": "string", "minLength": 1 },
        "held_out_surface": { "type": "string", "minLength": 1 },
        "sealed_held_out": { "const": true }
      }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objective", "allowed_files", "allowed_tools", "verification"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
          "objective": { "type": "string", "minLength": 1 },
          "allowed_files": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "allowed_tools": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "checkpoint_id": { "type": "string", "minLength": 1 },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "evidence"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
