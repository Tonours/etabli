{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etabli.local/workflow/evidence-pack.schema.json",
  "title": "Etabli evidence pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "mode", "target", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "mode": { "enum": ["product", "ui", "investigation", "performance"] },
    "target": { "$ref": "#/$defs/target" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "execution": { "$ref": "#/$defs/execution" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "ui": { "$ref": "#/$defs/ui" },
    "investigation": { "$ref": "#/$defs/investigation" },
    "performance": { "$ref": "#/$defs/performance" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "product" } } },
      "then": {
        "required": ["execution", "scenarios"],
        "not": { "anyOf": [{ "required": ["ui"] }, { "required": ["investigation"] }, { "required": ["performance"] }] }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "ui" } } },
      "then": {
        "required": ["execution", "scenarios", "ui"],
        "not": { "anyOf": [{ "required": ["investigation"] }, { "required": ["performance"] }] }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "investigation" } } },
      "then": {
        "required": ["investigation"],
        "not": { "anyOf": [{ "required": ["scenarios"] }, { "required": ["ui"] }, { "required": ["performance"] }] }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "performance" } } },
      "then": {
        "required": ["performance"],
        "not": { "anyOf": [{ "required": ["scenarios"] }, { "required": ["ui"] }, { "required": ["investigation"] }] }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ref", "subject_path", "subject_sha256", "environment_sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "subject_path": { "type": "string", "minLength": 1 },
        "subject_sha256": { "$ref": "#/$defs/sha256" },
        "environment_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "kind", "captured_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "kind": {
          "enum": ["execution_receipt", "command_stdout", "command_stderr", "observed_tree", "action", "outcome", "side_effect", "screenshot", "trace", "console", "network", "accessibility", "benchmark_declaration", "benchmark_samples", "source", "log", "cleanup"]
        },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not_applicable", "blocked"] },
        "evidence": { "$ref": "#/$defs/artifact_ids" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt_artifact", "launch", "doctor", "isolation", "cleanup"],
      "properties": {
        "status": { "enum": ["parent_observed", "integrity_only", "blocked"] },
        "receipt_artifact": { "type": ["string", "null"] },
        "launch": { "$ref": "#/$defs/step" },
        "doctor": { "$ref": "#/$defs/step" },
        "isolation": { "$ref": "#/$defs/step" },
        "cleanup": { "$ref": "#/$defs/step" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "status", "action_evidence", "result_evidence", "side_effect_expected", "side_effect_evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "blocked"] },
        "action_evidence": { "$ref": "#/$defs/artifact_ids" },
        "result_evidence": { "$ref": "#/$defs/artifact_ids" },
        "side_effect_expected": { "type": "boolean" },
        "side_effect_evidence": { "$ref": "#/$defs/artifact_ids" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "width", "height", "evidence"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "evidence": { "$ref": "#/$defs/artifact_ids" }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responsive_in_scope", "motion_in_scope", "reference_in_scope", "viewports", "checks"],
      "properties": {
        "responsive_in_scope": { "type": "boolean" },
        "motion_in_scope": { "type": "boolean" },
        "reference_in_scope": { "type": "boolean" },
        "viewports": { "type": "array", "items": { "$ref": "#/$defs/viewport" } },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyboard", "focus", "accessibility", "console", "network", "responsive", "reduced_motion"],
          "properties": {
            "keyboard": { "$ref": "#/$defs/step" },
            "focus": { "$ref": "#/$defs/step" },
            "accessibility": { "$ref": "#/$defs/step" },
            "console": { "$ref": "#/$defs/step" },
            "network": { "$ref": "#/$defs/step" },
            "responsive": { "$ref": "#/$defs/step" },
            "reduced_motion": { "$ref": "#/$defs/step" }
          }
        }
      }
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "reproduction", "hypotheses", "intervention", "verdict", "conclusion"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence"],
          "properties": {
            "status": { "enum": ["reproduced", "not_reproduced", "intermittent", "blocked"] },
            "evidence": { "$ref": "#/$defs/artifact_ids" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mechanism", "falsifier", "status", "evidence"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "mechanism": { "type": "string", "minLength": 1 },
              "falsifier": { "type": "string", "minLength": 1 },
              "status": { "enum": ["supported", "rejected", "open"] },
              "evidence": { "$ref": "#/$defs/artifact_ids" }
            }
          }
        },
        "intervention": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "mechanism_id", "predicted_change", "observed_change", "baseline_evidence", "treatment_evidence"],
              "properties": {
                "kind": { "enum": ["controlled_change", "failing_passing_pair", "isolation"] },
                "mechanism_id": { "type": "string", "minLength": 1 },
                "predicted_change": { "type": "string", "minLength": 1 },
                "observed_change": { "type": "string", "minLength": 1 },
                "baseline_evidence": { "$ref": "#/$defs/artifact_ids" },
                "treatment_evidence": { "$ref": "#/$defs/artifact_ids" }
              }
            }
          ]
        },
        "verdict": { "enum": ["CAUSE_CONFIRMED", "CAUSE_SUPPORTED", "NOT_REPRODUCED", "INCONCLUSIVE"] },
        "conclusion": { "type": "string", "minLength": 1 }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration_artifact", "samples_artifact", "first_warmup_at", "baseline_environment_sha256", "candidate_environment_sha256"],
      "properties": {
        "declaration_artifact": { "type": "string", "minLength": 1 },
        "samples_artifact": { "type": "string", "minLength": 1 },
        "first_warmup_at": { "type": "string", "format": "date-time" },
        "baseline_environment_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_environment_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
