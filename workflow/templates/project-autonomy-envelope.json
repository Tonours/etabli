{
  "schema_version": 1,
  "run_id": "replace-project-run",
  "started_at": "2026-01-01T00:00:00Z",
  "project": {
    "id": "replace-project-id",
    "goal": "State one measurable, bounded project outcome."
  },
  "authorization": {
    "allowed_files": ["path/to/owned-area/**"],
    "allowed_tools": ["node", "bash"],
    "forbidden_actions": [
      "external_write",
      "push",
      "pull_request",
      "deploy",
      "production",
      "billing",
      "secrets",
      "obvault_write"
    ]
  },
  "budget": {
    "max_iterations": 2,
    "max_duration_minutes": 30,
    "max_candidates": 8
  },
  "checkpoints": [
    {
      "id": "review-boundary",
      "before_slice": "verification",
      "category": "fresh_context_review",
      "target": "replace-project-id:verification"
    }
  ],
  "stop_conditions": {
    "same_hypothesis_failures": 2,
    "red_checks_without_diff": 3
  },
  "evaluation": {
    "runner": "replace-with-final-state-evaluation-command",
    "final_state_grader": "replace-with-final-state-grader-name",
    "held_out_surface": "replace-with-frozen-held-out-surface",
    "sealed_held_out": true
  },
  "slices": [
    {
      "id": "implementation",
      "objective": "Change one small, verifiable vertical slice.",
      "allowed_files": ["path/to/owned-area/**"],
      "allowed_tools": ["node", "bash"],
      "verification": {
        "command": "replace-with-focused-check",
        "evidence": "replace-with-inspectable-proof"
      }
    },
    {
      "id": "verification",
      "objective": "Run final proof after the implementation slice.",
      "allowed_files": ["path/to/owned-area/**"],
      "allowed_tools": ["node", "bash"],
      "checkpoint_id": "review-boundary",
      "verification": {
        "command": "replace-with-final-state-evaluation-command",
        "evidence": "replace-with-final-state-grader-result"
      }
    }
  ]
}
