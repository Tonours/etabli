{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etabli.local/workflow/project-verification-recipe.schema.json",
  "title": "Project owned verification recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "launch",
    "doctor",
    "cleanup",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "launch": {
      "$ref": "#/$defs/command"
    },
    "doctor": {
      "$ref": "#/$defs/command"
    },
    "cleanup": {
      "$ref": "#/$defs/command"
    },
    "service": {
      "$ref": "#/$defs/service"
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "target"],
            "properties": {
              "path": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package_json"],
            "properties": {
              "package_json": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion_ids", "action", "result"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "criterion_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AC-[A-Za-z0-9-]+$"
            }
          },
          "action": {
            "$ref": "#/$defs/command"
          },
          "result": {
            "$ref": "#/$defs/observation"
          },
          "persistence": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "timeout_ms"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "contains": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "timeout_ms", "assertions"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "contains": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pointer", "expected"],
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^(/|$)"
              },
              "expected": {}
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "timeout_ms", "readiness"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "contains": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "readiness": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "timeout_ms", "provider", "model", "required_env"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "contains": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "required_env": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    }
  }
}
