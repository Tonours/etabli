{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etabli.local/schemas/trace-observation-v1.json",
  "title": "Etabli sanitized harness trace observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability", "adapter", "adapter_version", "binding", "observation_id", "completeness", "reason_codes", "lifecycle", "signals", "usage", "decision", "jev_state"],
  "properties": {
    "schema_version": { "const": 1 },
    "capability": { "const": "prototype_offline" },
    "adapter": { "enum": ["pi", "claude"] },
    "adapter_version": { "const": "prototype-offline-1" },
    "binding": { "enum": ["explicit_unverified", "native_correlated"] },
    "observation_id": { "type": "string", "format": "uuid" },
    "completeness": { "enum": ["complete", "partial", "unavailable"] },
    "reason_codes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }, "uniqueItems": true },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal", "outcome"],
      "properties": {
        "terminal": { "type": "boolean" },
        "outcome": { "type": ["string", "null"], "enum": ["completed", "blocked", null] }
      }
    },
    "signals": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["tool_calls", "tool_errors", "validation_failures", "review_rework", "plan_rework", "compactions", "retries", "unsupported_rows", "verifier"],
      "properties": {
        "tool_calls": { "type": ["integer", "null"], "minimum": 0 },
        "tool_errors": { "type": ["integer", "null"], "minimum": 0 },
        "validation_failures": { "type": ["integer", "null"], "minimum": 0 },
        "review_rework": { "type": ["integer", "null"], "minimum": 0 },
        "plan_rework": { "type": ["integer", "null"], "minimum": 0 },
        "compactions": { "type": ["integer", "null"], "minimum": 0 },
        "retries": { "type": ["integer", "null"], "minimum": 0 },
        "unsupported_rows": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "verifier": { "type": "boolean" }
      }
    },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "output_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "total_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "decision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["action", "category", "target", "causal_status"],
      "properties": {
        "action": { "enum": ["no_op", "recommendation"] },
        "category": { "enum": ["no_issue", "validation_failure", "tool_failure", "review_rework", "plan_rework", "context_pressure", "incomplete_evidence"] },
        "target": { "enum": ["none", "skill", "rule", "testing", "tooling", "context"] },
        "causal_status": { "const": "unknown" }
      }
    },
    "jev_state": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["candidate", "evidence"],
      "properties": {
        "candidate": { "type": "string", "pattern": "^action=(no_op|recommendation);category=(no_issue|validation_failure|tool_failure|review_rework|plan_rework|context_pressure|incomplete_evidence);target=(none|skill|rule|testing|tooling|context)$" },
        "evidence": { "type": "string", "pattern": "^runs=([1-9][0-9]{0,2}|1000);complete=(true|false);terminal=(completed|blocked);verifier=(true|false)$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "adapter": { "const": "claude" } }, "required": ["adapter"] },
      "then": { "properties": { "binding": { "const": "explicit_unverified" } } }
    },
    {
      "if": { "properties": { "completeness": { "const": "unavailable" } }, "required": ["completeness"] },
      "then": { "properties": { "signals": { "const": null }, "usage": { "const": null }, "decision": { "const": null }, "jev_state": { "const": null } } }
    },
    {
      "if": { "properties": { "completeness": { "const": "partial" } }, "required": ["completeness"] },
      "then": {
        "properties": {
          "lifecycle": { "type": "object", "properties": { "terminal": { "const": true } } },
          "signals": { "type": "object", "properties": { "unsupported_rows": { "type": "integer", "minimum": 1 } } },
          "decision": { "type": "object", "properties": { "action": { "const": "no_op" }, "category": { "const": "incomplete_evidence" }, "target": { "const": "none" }, "causal_status": { "const": "unknown" } } },
          "jev_state": {
            "type": "object",
            "properties": {
              "candidate": { "const": "action=no_op;category=incomplete_evidence;target=none" },
              "evidence": { "type": "string", "pattern": "^runs=([1-9][0-9]{0,2}|1000);complete=false;terminal=(completed|blocked);verifier=(true|false)$" }
            }
          }
        },
        "oneOf": [
          { "properties": { "lifecycle": { "properties": { "outcome": { "const": "completed" } } }, "signals": { "properties": { "verifier": { "const": true } } }, "jev_state": { "properties": { "evidence": { "pattern": ";complete=false;terminal=completed;verifier=true$" } } } } },
          { "properties": { "lifecycle": { "properties": { "outcome": { "const": "completed" } } }, "signals": { "properties": { "verifier": { "const": false } } }, "jev_state": { "properties": { "evidence": { "pattern": ";complete=false;terminal=completed;verifier=false$" } } } } },
          { "properties": { "lifecycle": { "properties": { "outcome": { "const": "blocked" } } }, "signals": { "properties": { "verifier": { "const": true } } }, "jev_state": { "properties": { "evidence": { "pattern": ";complete=false;terminal=blocked;verifier=true$" } } } } },
          { "properties": { "lifecycle": { "properties": { "outcome": { "const": "blocked" } } }, "signals": { "properties": { "verifier": { "const": false } } }, "jev_state": { "properties": { "evidence": { "pattern": ";complete=false;terminal=blocked;verifier=false$" } } } } }
        ]
      }
    },
    {
      "if": { "properties": { "completeness": { "const": "complete" } }, "required": ["completeness"] },
      "then": {
        "properties": {
          "lifecycle": { "type": "object", "properties": { "terminal": { "const": true } } },
          "signals": { "type": "object", "properties": { "unsupported_rows": { "const": 0 } } },
          "decision": { "type": "object" },
          "jev_state": { "type": "object", "properties": { "evidence": { "pattern": ";complete=true;terminal=(completed|blocked);verifier=(true|false)$" } } }
        },
        "allOf": [
          {
            "oneOf": [
              { "properties": { "decision": { "properties": { "action": { "const": "no_op" }, "category": { "const": "no_issue" }, "target": { "const": "none" } } }, "jev_state": { "properties": { "candidate": { "const": "action=no_op;category=no_issue;target=none" } } } } },
              { "properties": { "decision": { "properties": { "action": { "const": "recommendation" }, "category": { "const": "validation_failure" }, "target": { "const": "testing" } } }, "jev_state": { "properties": { "candidate": { "const": "action=recommendation;category=validation_failure;target=testing" } } } } },
              { "properties": { "decision": { "properties": { "action": { "const": "recommendation" }, "category": { "const": "tool_failure" }, "target": { "const": "tooling" } } }, "jev_state": { "properties": { "candidate": { "const": "action=recommendation;category=tool_failure;target=tooling" } } } } },
              { "properties": { "decision": { "properties": { "action": { "const": "recommendation" }, "category": { "const": "review_rework" }, "target": { "const": "rule" } } }, "jev_state": { "properties": { "candidate": { "const": "action=recommendation;category=review_rework;target=rule" } } } } },
              { "properties": { "decision": { "properties": { "action": { "const": "recommendation" }, "category": { "const": "plan_rework" }, "target": { "const": "skill" } } }, "jev_state": { "properties": { "candidate": { "const": "action=recommendation;category=plan_rework;target=skill" } } } } },
              { "properties": { "decision": { "properties": { "action": { "const": "recommendation" }, "category": { "const": "context_pressure" }, "target": { "const": "context" } } }, "jev_state": { "properties": { "candidate": { "const": "action=recommendation;category=context_pressure;target=context" } } } } }
            ]
          },
          {
            "oneOf": [
              { "properties": { "lifecycle": { "properties": { "outcome": { "const": "completed" } } }, "signals": { "properties": { "verifier": { "const": true } } }, "jev_state": { "properties": { "evidence": { "pattern": ";complete=true;terminal=completed;verifier=true$" } } } } },
              { "properties": { "lifecycle": { "properties": { "outcome": { "const": "completed" } } }, "signals": { "properties": { "verifier": { "const": false } } }, "jev_state": { "properties": { "evidence": { "pattern": ";complete=true;terminal=completed;verifier=false$" } } } } },
              { "properties": { "lifecycle": { "properties": { "outcome": { "const": "blocked" } } }, "signals": { "properties": { "verifier": { "const": true } } }, "jev_state": { "properties": { "evidence": { "pattern": ";complete=true;terminal=blocked;verifier=true$" } } } } },
              { "properties": { "lifecycle": { "properties": { "outcome": { "const": "blocked" } } }, "signals": { "properties": { "verifier": { "const": false } } }, "jev_state": { "properties": { "evidence": { "pattern": ";complete=true;terminal=blocked;verifier=false$" } } } } }
            ]
          }
        ]
      }
    }
  ]
}
