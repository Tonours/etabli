#!/usr/bin/env bash
set -euo pipefail

base="${1:--}"
log_opts="${2:?pass the Git history range to scan}"
root="$(git rev-parse --show-toplevel)"
state="$(mktemp -d)"
trap 'rm -rf "$state"' EXIT

git clone -q --mirror --shared "$root" "$state/repo.git"
printf '[extend]\nuseDefault = true\n' >"$state/config.toml"
: >"$state/repo.git/.gitleaksignore"
if [ "$base" != - ]; then
  [[ "$base" =~ ^[0-9a-f]{40}$ ]] && git cat-file -e "$base^{commit}" || {
    printf 'secret scan: trusted base is unavailable; fetch it and retry.\n' >&2
    exit 1
  }
  if git cat-file -e "$base:.gitleaksignore" 2>/dev/null; then
    git show "$base:.gitleaksignore" >"$state/repo.git/.gitleaksignore"
  fi
fi
cd "$state/repo.git"
gitleaks git --no-banner --redact --ignore-gitleaks-allow --config "$state/config.toml" \
  --gitleaks-ignore-path "$state/repo.git/.gitleaksignore" --log-opts="$log_opts" .
