#!/usr/bin/env bash
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  printf 'pre-push: gitleaks is not installed, push blocked. Install it (macOS: brew install gitleaks, or rerun scripts/install.sh), then push again.\n' >&2
  exit 1
fi

remote_url="${2:-}"
default_base=
checked_default=0
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  range="$local_sha"
  base=-
  case "$remote_sha" in *[!0]*)
    if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      range="$remote_sha..$local_sha"
      base="$remote_sha"
    fi
    ;;
    *)
      if [ "$checked_default" -eq 0 ] && [ -n "$remote_url" ]; then
        checked_default=1
        if ! advertised="$(git ls-remote --symref -- "$remote_url" HEAD)"; then
          printf 'pre-push: cannot verify the remote default branch, push blocked. Check remote connectivity and retry.\n' >&2
          status=1
          continue
        fi
        default_ref="$(printf '%s\n' "$advertised" | awk '$1 == "ref:" && $3 == "HEAD" { print $2 }')"
        if [ "$default_ref" = refs/heads/main ]; then
          default_base="$(printf '%s\n' "$advertised" | awk '$2 == "HEAD" && length($1) == 40 && $1 ~ /^[0-9a-f]+$/ { print $1 }')"
        fi
        if [ -n "$default_base" ] && ! git cat-file -e "$default_base^{commit}" 2>/dev/null; then
          printf 'pre-push: remote default commit is unavailable locally, push blocked. Fetch the remote and retry.\n' >&2
          status=1
          continue
        fi
      fi
      if [ -n "$default_base" ]; then base="$default_base"; fi
    ;;
  esac
  "$(dirname "$0")/scan-secrets" "$base" "$range --diff-merges=first-parent" || status=1
done

if [ "$status" -ne 0 ]; then
  printf 'pre-push: gitleaks flagged the pushed commits, push blocked. Remove the secret from history, or have a verified false-positive fingerprint reviewed into the trusted base .gitleaksignore first.\n' >&2
fi
exit "$status"
