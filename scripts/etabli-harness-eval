#!/usr/bin/env bash
set -euo pipefail

HARNESS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/etabli-harness-eval.sh
source "$HARNESS_ROOT/scripts/lib/etabli-harness-eval.sh"

usage() {
  cat <<'EOF'
Usage:
  etabli-harness-eval print-argv --runner pi|grok [--cwd DIR] [--prompt TEXT]
  etabli-harness-eval grade --task ID --worktree DIR --transcript FILE [--runner NAME] [--runner-exit N]
  etabli-harness-eval run --runner pi|grok|all [--task ID] [--repeats N] [--output FILE]
  etabli-harness-eval report FILE.jsonl

run invokes models only when ETABLI_HARNESS_EVAL=1.
print-argv and grade never invoke pi or grok.
EOF
}

cmd="${1:-}"
[ -n "$cmd" ] || { usage >&2; exit 2; }
shift || true

case "$cmd" in
  -h | --help)
    usage
    exit 0
    ;;
  print-argv)
    runner=""
    cwd="/tmp/etabli-harness-eval"
    prompt="PROMPT"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --runner) runner="${2:?}"; shift 2 ;;
        --cwd) cwd="${2:?}"; shift 2 ;;
        --prompt) prompt="${2:?}"; shift 2 ;;
        *) harness_die "unknown print-argv option: $1" ;;
      esac
    done
    [ -n "$runner" ] || harness_die "--runner is required"
    printf 'TIMEOUT=%s\n' "$HARNESS_TIMEOUT_DEFAULT"
    harness_print_argv "$runner" "$cwd" "$prompt"
    ;;
  grade)
    task_id=""
    worktree=""
    transcript=""
    runner="offline"
    runner_exit=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --task) task_id="${2:?}"; shift 2 ;;
        --worktree) worktree="${2:?}"; shift 2 ;;
        --transcript) transcript="${2:?}"; shift 2 ;;
        --runner) runner="${2:?}"; shift 2 ;;
        --runner-exit) runner_exit="${2:?}"; shift 2 ;;
        *) harness_die "unknown grade option: $1" ;;
      esac
    done
    [ -n "$task_id" ] && [ -n "$worktree" ] && [ -n "$transcript" ] || \
      harness_die "grade requires --task --worktree --transcript"
    [[ "$runner_exit" =~ ^[0-9]+$ ]] || harness_die "--runner-exit must be an integer"
    harness_grade "$task_id" "$worktree" "$transcript" "$runner" \
      none none none none "$runner_exit"
    ;;
  run)
    if [ "${ETABLI_HARNESS_EVAL:-}" != "1" ]; then
      printf 'etabli-harness-eval: run skipped (set ETABLI_HARNESS_EVAL=1 to invoke models)\n' >&2
      exit 0
    fi
    runner=""
    task_id=""
    repeats=1
    output=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --runner) runner="${2:?}"; shift 2 ;;
        --task) task_id="${2:?}"; shift 2 ;;
        --repeats) repeats="${2:?}"; shift 2 ;;
        --output) output="${2:?}"; shift 2 ;;
        *) harness_die "unknown run option: $1" ;;
      esac
    done
    [ -n "$runner" ] || harness_die "--runner is required"
    [[ "$repeats" =~ ^[1-9][0-9]*$ ]] || harness_die "--repeats must be a positive integer"
    runners=()
    case "$runner" in
      all) runners=(pi grok) ;;
      pi | grok) runners=("$runner") ;;
      *) harness_die "unknown runner: $runner" ;;
    esac
    tasks=()
    if [ -n "$task_id" ]; then
      known=0
      while IFS= read -r id; do
        if [ "$id" = "$task_id" ]; then
          known=1
          break
        fi
      done < <(harness_task_ids)
      [ "$known" -eq 1 ] || harness_die "unknown task: $task_id"
      if [ "$runner" != "all" ]; then
        harness_task_has_runner "$task_id" "$runner" \
          || harness_die "task $task_id is not eligible for runner $runner"
      fi
      tasks=("$task_id")
    else
      while IFS= read -r id; do
        tasks+=("$id")
      done < <(harness_task_ids)
    fi
    results_dir="${ETABLI_HARNESS_EVAL_DIR:-}"
    if [ -z "$results_dir" ]; then
      results_dir="$(mktemp -d "${TMPDIR:-/tmp}/etabli-harness-eval.XXXXXX")"
    else
      mkdir -p "$results_dir"
    fi
    printf 'etabli-harness-eval: keeping cells in %s\n' "$results_dir" >&2
    for r in "${runners[@]}"; do
      harness_resolve_bin "$r" >/dev/null || harness_die "$r not on PATH"
    done
    emit() {
      if [ -n "$output" ]; then
        printf '%s\n' "$1" >>"$output"
      else
        printf '%s\n' "$1"
      fi
    }
    for r in "${runners[@]}"; do
      for id in "${tasks[@]}"; do
        harness_task_has_runner "$id" "$r" || continue
        n=1
        while [ "$n" -le "$repeats" ]; do
          cell="$results_dir/${r}-${id}-${n}"
          row=""
          set +e
          row="$(harness_run_once "$r" "$id" "$cell")"
          cell_status=$?
          set -e
          [ "$cell_status" -eq 0 ] && [ -n "$row" ] || harness_die "cell failed: $r/$id"
          emit "$row"
          n=$((n + 1))
        done
      done
    done
    ;;
  report)
    [ "$#" -eq 1 ] || harness_die "report requires a jsonl path"
    harness_report "$1"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
