#!/usr/bin/env node
/**
 * Prevent a self-improvement loop from re-proposing a candidate that was
 * already rejected in the same ledger without an explicit supersession
 * rationale. A `harness_proposal` whose `.candidate` matches a prior
 * `harness_candidate_rejected.candidate` MUST carry a `supersedes` array that
 * names it; otherwise the proposal is reward-hacking over an already-rejected
 * change.
 *
 * Read-only: never edits ledgers.
 */
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

function fail(message) {
  process.stderr.write(`workflow-supersession-check: ${message}\n`);
  process.exit(1);
}

function usage() {
  fail("usage: workflow-supersession-check <ledger-events.jsonl>");
}

const [target] = process.argv.slice(2);
if (!target) usage();
const ledgerPath = resolve(target);

let text;
try {
  text = readFileSync(ledgerPath, "utf8");
} catch (error) {
  fail(`cannot read ledger ${ledgerPath}: ${error.message}`);
}

const rejected = new Set();
const violations = [];
for (const line of text.split("\n")) {
  if (!line.trim()) continue;
  let event;
  try {
    event = JSON.parse(line);
  } catch {
    continue;
  }
  if (event?.event === "harness_candidate_rejected") {
    const candidate = event.detail?.candidate;
    if (typeof candidate === "string" && candidate.trim()) rejected.add(candidate.trim());
    continue;
  }
  if (event?.event === "harness_proposal") {
    const candidate = String(event.detail?.candidate || "").trim();
    if (!candidate || !rejected.has(candidate)) continue;
    const supersedes = Array.isArray(event.detail?.supersedes)
      ? event.detail.supersedes.map((value) => String(value).trim())
      : [];
    if (!supersedes.includes(candidate)) {
      violations.push(
        `harness_proposal re-proposes rejected candidate '${candidate}' without a matching supersedes entry`,
      );
    }
  }
}

if (violations.length > 0) {
  for (const violation of violations) {
    process.stderr.write(`workflow-supersession-check: ${violation}\n`);
  }
  process.exit(1);
}

process.stdout.write(`${rejected.size} rejected candidate(s), no re-proposal without supersession, ok\n`);
