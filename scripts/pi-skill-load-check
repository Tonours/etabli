#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

GATE=7800
ALERT=7785
DUMP_ARG=""
HOME_DIR="${PI_SKILL_LOAD_HOME:-$HOME}"

usage() {
  cat <<EOF
Usage: $(basename "$0") [--dump <system-prompt-file>] [--home DIR]

Renders pi's system prompt natively (pi -p --no-session --offline with a
measurement extension that exits before any model call), then checks:
  B1  block chars <= $GATE (alert at >= $ALERT)
  B2  manifest == universe - deny - dmi + package keepers; deny == complement
      for installed skills (deny entries for absent skills are inert);
      pinned dmi detected and absent from the block
  B3  zero pi-pstack locations; brave-search absent; zero dangling links;
      zero differing-target collisions

--dump  re-check an existing system-prompt dump instead of running pi
--home  skill roots + settings root for the assertions; the native pi run
        honors \$HOME (override it for fixture homes)
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
  --dump)
    DUMP_ARG="$2"
    shift
    ;;
  --home)
    HOME_DIR="$2"
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    printf 'unknown argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  esac
  shift
done

command -v node >/dev/null 2>&1 || {
  printf 'pi-skill-load-check: node is required\n' >&2
  exit 1
}

bak_hits=()
for root in "$HOME_DIR/.pi/agent/skills" "$HOME_DIR/.agents/skills"; do
  [ -L "$root" ] || [ -e "$root" ] || continue
  if [ ! -d "$root" ]; then
    printf 'FAIL: skill root is not a directory: %s\n' "$root" >&2
    exit 1
  fi
  # -H follows the root itself when it is a link; links below the root
  # stay un-descended (Pi traversal through linked skill dirs is unverified).
  if scan="$(find -H "$root" -name '*.bak.*' -print 2>&1)"; then
    while IFS= read -r hit; do
      [ -n "$hit" ] && bak_hits+=("$hit")
    done <<< "$scan"
  else
    printf 'FAIL: cannot scan %s for stale backups: %s\n' "$root" "$scan" >&2
    exit 1
  fi
done
if [ "${#bak_hits[@]}" -gt 0 ]; then
  printf 'FAIL: stale skill backup(s) Pi may load as real skills:\n' >&2
  printf '  %s\n' "${bak_hits[@]}" >&2
  printf 'quarantine them out of the skill roots (e.g. mv to ~/.pi/agent/skills.disabled/) and re-run\n' >&2
  exit 1
fi

TMP_DIR="$(mktemp -d)"
cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

DUMP_FILE="$TMP_DIR/system-prompt.txt"

if [ -n "$DUMP_ARG" ]; then
  cp "$DUMP_ARG" "$DUMP_FILE"
else
  command -v pi >/dev/null 2>&1 || {
    printf 'pi-skill-load-check: pi binary not found on PATH\n' >&2
    exit 1
  }
  cat >"$TMP_DIR/measure.ts" <<'EXT'
export default function (pi: {
  on: (event: string, handler: (event: { systemPrompt?: string }) => Promise<unknown>) => void;
}) {
  pi.on("before_agent_start", async (event) => {
    const fs = await import("node:fs");
    fs.writeFileSync(process.env.PI_SKILLS_DUMP ?? "/tmp/pi-skills-dump.txt", event.systemPrompt ?? "");
    process.exit(0);
  });
}
EXT
  PI_SKILLS_DUMP="$DUMP_FILE" pi -p --no-session --offline -e "$TMP_DIR/measure.ts" ok </dev/null >/dev/null 2>&1 || true
  [ -s "$DUMP_FILE" ] || {
    printf 'pi-skill-load-check: native dump failed or empty (pi run produced no system prompt)\n' >&2
    exit 1
  }
fi

node "$SCRIPT_DIR/lib/pi-skill-load-check.mjs" "$DUMP_FILE" "$HOME_DIR" "$REPO_DIR"
