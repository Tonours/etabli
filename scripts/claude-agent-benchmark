#!/usr/bin/env bash
# Claude token benchmark: frozen-manifest runner with a network-free dry-run.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
MANIFEST="$ROOT_DIR/claude/benchmarks/token-budget/manifest.v2.json"
COMMAND="dry-run"
JSON_OUTPUT=0
ARMS=""
ROUTES=""
REPS=3
OUT_DIR="$ROOT_DIR/.workflow/claude-token-budget/samples"

usage() {
  cat <<EOF
Usage: claude-agent-benchmark [dry-run|inventory] [--manifest path] [--json]

Commands:
  dry-run     default; prints the full paid-process budget without any network
              call: 115 nominal processes (1 pilot + 36 calibration + 2 cold +
              4 warmups + 72 measures), max 6 replay pairs, absolute cap 128,
              max-token/max-cost estimates from the frozen baseline p95.
  inventory   machine-readable process inventory (add --json for the full list).
  run-probes      SPENDS TOKENS (ledger-guarded): live role/alias probes — canonical
                  model per agent role, write refusal. Requires budget approval.
  run-calibration SPENDS TOKENS (ledger-guarded): calibration runs over the selected
                  arms (--arms, --routes, --reps, --out), then the whole-matrix
                  selection report. Calibration never enters the proof.

The runner refuses to launch paid process 129; the atomic ledger lives in
.workflow/claude-token-budget/paid-processes.json. No stage that spends tokens
exists before the human budget approval recorded in PLAN.md.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    dry-run|inventory|run-probes|run-calibration) COMMAND="$1"; shift ;;
    --manifest) MANIFEST="${2:?--manifest requires a path}"; shift 2 ;;
    --json) JSON_OUTPUT=1; shift ;;
    --arms) ARMS="${2:?--arms requires a comma list}"; shift 2 ;;
    --routes) ROUTES="${2:?--routes requires a comma list}"; shift 2 ;;
    --reps) REPS="${2:?--reps requires a number}"; shift 2 ;;
    --out) OUT_DIR="${2:?--out requires a directory}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

export BENCH_MANIFEST="$MANIFEST"
export BENCH_COMMAND="$COMMAND"
export BENCH_JSON="$JSON_OUTPUT"
export BENCH_ARMS="$ARMS"
export BENCH_ROUTES="$ROUTES"
export BENCH_REPS="$REPS"
export BENCH_OUT_DIR="$OUT_DIR"
export BENCH_ROOT="$ROOT_DIR"
export BENCH_LEDGER="$ROOT_DIR/.workflow/claude-token-budget/paid-processes.json"
export BENCH_LIB="$ROOT_DIR/scripts/lib/claude-agent-benchmark.mjs"
export BENCH_RUN_LIB="$ROOT_DIR/scripts/lib/claude-bench-run.mjs"

node --input-type=module <<'NODE'
import { pathToFileURL } from "node:url";

const lib = await import(pathToFileURL(process.env.BENCH_LIB).href);
const manifest = lib.loadManifest(process.env.BENCH_MANIFEST);

if (process.env.BENCH_COMMAND === "run-probes" || process.env.BENCH_COMMAND === "run-calibration") {
	const run = await import(pathToFileURL(process.env.BENCH_RUN_LIB).href);
	const split = (raw, fallback) =>
		(raw ? raw.split(",").map((s) => s.trim()).filter(Boolean) : fallback);
	if (process.env.BENCH_COMMAND === "run-probes") {
		const probes = [];
		const outDir = `${process.env.BENCH_OUT_DIR}/probes`;
		const aliasTuples = [
			{ role: "scout", model: "sonnet", effort: "low", maxTurns: 16 },
			{ role: "worker", model: "opus", effort: "low", maxTurns: 24 },
			{ role: "reviewer", model: "fable", effort: "medium", maxTurns: 24 },
			{ role: "adversary", model: "fable", effort: "low", maxTurns: 24 },
		];
		for (const tuple of aliasTuples) {
			const sample = run.runProbe({
				manifest,
				repoRoot: process.env.BENCH_ROOT,
				workDir: `${process.env.BENCH_OUT_DIR}/work/probe-${tuple.role}`,
				outFile: `${outDir}/role-${tuple.role}.json`,
				ledgerFile: process.env.BENCH_LEDGER,
				...tuple,
			});
			console.log(`probe ${tuple.role}: ok=${sample.ok} models=${sample.model_usage_keys.join(",") || "none"} canonical=${sample.canonical_models.map((m) => m.canonical).join(",") || "none"} turns=${sample.num_turns}`);
			probes.push(sample);
		}
		const writeProbe = run.runProbe({
			manifest,
			repoRoot: process.env.BENCH_ROOT,
			workDir: `${process.env.BENCH_OUT_DIR}/work/probe-write`,
			outFile: `${outDir}/write-refusal.json`,
			ledgerFile: process.env.BENCH_LEDGER,
			role: "reviewer",
			model: "sonnet",
			effort: "low",
			maxTurns: 16,
		});
		console.log(`probe write-refusal: ok=${writeProbe.ok} pwned_created=${writeProbe.pwned_created}`);
		console.log(JSON.stringify({ probes: probes.length + 1, all_ok: probes.every((p) => p.ok) && writeProbe.ok }, null, 2));
		process.exit(0);
	}
	const arms = split(process.env.BENCH_ARMS, ["baseline", "candidate_a", "candidate_b"]);
	const routes = split(process.env.BENCH_ROUTES, manifest.calibration.routes);
	const samples = run.runCalibration({
		manifest,
		repoRoot: process.env.BENCH_ROOT,
		fixturesRoot: `${process.env.BENCH_ROOT}/claude/benchmarks/token-budget/fixtures`,
		ledgerFile: process.env.BENCH_LEDGER,
		outDir: process.env.BENCH_OUT_DIR,
		arms,
		routes,
		reps: Number(process.env.BENCH_REPS),
		onProgress: (s) =>
			console.log(`[calibration] ${s.arm}/${s.route}/rep${s.rep} ok=${s.ok} oracle=${s.oracle.passed} tokens=${s.processed_total_tokens} (${Math.round(s.duration_ms / 1000)}s)`),
	});
	const selection = run.selectArm(samples, manifest);
	const { writeFileSync } = await import("node:fs");
	writeFileSync(`${process.env.BENCH_OUT_DIR}/calibration-selection.json`, `${JSON.stringify(selection, null, 2)}\n`);
	console.log(JSON.stringify(selection, null, 2));
	process.exit(0);
}

const processes = lib.buildInventory(manifest);

if (process.env.BENCH_COMMAND === "inventory") {
	const report = {
		processes,
		summary: lib.summarizeInventory(processes),
		pair_orders: manifest.scenario_order.map((scenario, index) => ({
			scenario,
			rep_orders: [1, 2, 3].map((rep) => ({
				rep,
				order: lib.pairOrderFor(manifest, index, rep),
			})),
		})),
	};
	console.log(JSON.stringify(report, null, 2));
	process.exit(0);
}

const dryRun = lib.dryRunReport(manifest, processes);
if (process.env.BENCH_JSON === "1") {
	console.log(JSON.stringify(dryRun, null, 2));
} else {
	const inv = dryRun.inventory;
	console.log("claude-agent-benchmark dry-run (no network calls made)");
	console.log(`  manifest:            v${dryRun.manifest_version} declared ${dryRun.declared_at} @ ${dryRun.revision}`);
	console.log(`  nominal processes:   ${dryRun.budget.nominal_processes}`);
	console.log(`    pilot:             ${inv.by_stage.pilot ?? 0}`);
	console.log(`    calibration:       ${inv.by_stage.calibration ?? 0} (4 routes x 3 reps x 3 arms, excluded from KPI)`);
	console.log(`    cold diagnostics:  ${inv.by_stage.cold_diag ?? 0} (excluded from KPI)`);
	console.log(`    warmups:           ${inv.by_stage.warmup ?? 0} (B-C-C-B, excluded from KPI)`);
	console.log(`    measures:          ${inv.by_stage.measure ?? 0} (12 scenarios x 3 reps x 2 arms, counted)`);
	console.log(`  counted in KPI:      ${inv.counted_in_kpi}`);
	console.log(`  replay budget:       ${dryRun.budget.max_replay_pairs} pairs (${dryRun.budget.replay_pair_processes} processes)`);
	console.log(`  absolute cap:        ${dryRun.budget.absolute_cap} paid processes (refuses 129th)`);
	console.log(`  headroom after max replays: ${dryRun.budget.headroom_after_max_replays}`);
	console.log(`  max tokens estimate: ${dryRun.estimate.estimated_max_total_tokens} (${dryRun.estimate.per_process_p95_tokens} p95/process)`);
	console.log(`  max cost estimate:   $${dryRun.estimate.estimated_max_usd} (secondary, blended rate)`);
	console.log(`  seed:                ${dryRun.seed}`);
	console.log(`  gates:               R<=${dryRun.gates.ratio_max}, bootstrap95<=${dryRun.gates.upper_bound_max}, otel<${dryRun.gates.otel_reconciliation_max}`);
	console.log("  approval:            human checkpoint — no paid run before explicit budget approval (PLAN.md)");
}
NODE
