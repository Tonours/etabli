#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
# bun boots this ESM CLI ~4x faster than node (~10ms vs ~40ms); behavior is
# identical (node:* builtins only). Fall back to node where bun is absent.
if command -v bun >/dev/null 2>&1; then
  exec bun "$ROOT_DIR/scripts/lib/skill-eval.mjs" "$@"
fi
exec node "$ROOT_DIR/scripts/lib/skill-eval.mjs" "$@"
