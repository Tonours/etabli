#!/usr/bin/env node
import { execFileSync } from 'node:child_process'
import { createHash } from 'node:crypto'
import { readFileSync, writeFileSync, existsSync, statSync } from 'node:fs'
import { resolve } from 'node:path'

const argv = process.argv.slice(2)
const command = argv[0]
const value = (name) => {
  const index = argv.indexOf(name)
  return index >= 0 ? argv[index + 1] : null
}
let root = resolve(value('--repo') ?? process.cwd())
const controlRoot = resolve(value('--control-root') ?? process.cwd())
const scope = value('--scope')
const allowlistFile = value('--allowlist-file')
const output = value('--output')

function fail(message) {
  console.error(`privacy-worktree-check: ${message}`)
  process.exit(1)
}
function git(args) {
  try {
    return execFileSync('git', args, { cwd: root, encoding: 'buffer', maxBuffer: 64 * 1024 * 1024, stdio: ['ignore', 'pipe', 'pipe'] })
  } catch (error) {
    fail(`git ${args.join(' ')} failed: ${error instanceof Error ? error.message : String(error)}`)
  }
}
function head() {
  return git(['rev-parse', 'HEAD']).toString('utf8').trim()
}
function sha(path) {
  return createHash('sha256').update(readFileSync(resolve(root, path))).digest('hex')
}
function controlSha(path) {
  return createHash('sha256').update(readFileSync(resolve(controlRoot, path))).digest('hex')
}
function loadAllowlist() {
  if (!allowlistFile) fail('--allowlist-file is required')
  if (!scope || !['etabli', 'brain', 'obvault'].includes(scope)) fail('invalid --scope')
  const data = JSON.parse(readFileSync(resolve(controlRoot, allowlistFile), 'utf8'))
  const paths = new Set(data[scope] ?? [])
  if (Object.keys(data).sort().join('|') !== 'brain|etabli|obvault|planned_creations|planned_deletions|schema_version' || data.schema_version !== 1 || !Array.isArray(data[scope]) || !Array.isArray(data.planned_creations) || !Array.isArray(data.planned_deletions) || [...paths, ...data.planned_creations, ...data.planned_deletions].some((path) => typeof path !== 'string' || path.length === 0 || path.startsWith('/') || path.split('/').includes('..'))) fail('invalid worktree allowlist schema')
  // Planned creation/deletion paths are for the Etabli control surface only;
  // satellite-store snapshots must not inherit them implicitly.
  const planned = scope === 'etabli'
    ? { creations: new Set(data.planned_creations ?? []), deletions: new Set(data.planned_deletions ?? []) }
    : { creations: new Set(), deletions: new Set() }
  return { paths, ...planned }
}
function statusPaths() {
  const tracked = git(['ls-files']).toString('utf8').split('\n').filter(Boolean)
  const all = git(['ls-files', '-co', '--exclude-standard']).toString('utf8').split('\n').filter(Boolean)
  const trackedSet = new Set(tracked)
  const untracked = all.filter((path) => !trackedSet.has(path))
  return { tracked, untracked, status: git(['status', '--short']).toString('utf8').trimEnd().split('\n').filter(Boolean) }
}
function ignoredDigest(allow) {
  const ignored = git(['ls-files', '-o', '--ignored', '--exclude-standard']).toString('utf8').split('\n').filter(Boolean)
  const allowlisted = new Set([...allow.paths, ...allow.creations, ...allow.deletions])
  const entries = []
  for (const path of ignored) {
    if (allowlisted.has(path) || !existsSync(resolve(root, path)) || !statSync(resolve(root, path)).isFile()) continue
    entries.push(`${path}\0${sha(path)}`)
  }
  return createHash('sha256').update(entries.join('\n')).digest('hex')
}
function captureSnapshot() {
  const { tracked, untracked, status } = statusPaths()
  const trackedHashes = {}
  for (const path of tracked) if (existsSync(resolve(root, path)) && statSync(resolve(root, path)).isFile()) trackedHashes[path] = { head_oid: git(['rev-parse', `HEAD:${path}`]).toString('utf8').trim(), current_sha256: sha(path) }
  const untrackedHashes = {}
  for (const path of untracked) if (existsSync(resolve(root, path)) && statSync(resolve(root, path)).isFile()) untrackedHashes[path] = sha(path)
  const allow = loadAllowlist()
  return { schema_version: 2, repo: root, scope, allowlist_sha256: controlSha(allowlistFile), head: head(), tracked: trackedHashes, untracked: untrackedHashes, ignored_unallowlisted_sha256: ignoredDigest(allow), status, planned_deletions: [...allow.deletions].sort(), planned_creations: [...allow.creations].sort() }
}
function snapshot() {
  const data = captureSnapshot()
  if (!output) fail('--output is required')
  writeFileSync(resolve(controlRoot, output), `${JSON.stringify(data, null, 2)}\n`, { mode: 0o600 })
}
function validateSnapshot(data, label) {
  if (!data || data.schema_version !== 2 || data.repo !== root || data.scope !== scope || !/^[0-9a-f]{64}$/.test(data.allowlist_sha256 ?? '') || data.allowlist_sha256 !== controlSha(allowlistFile) || !/^[0-9a-f]{40}$/.test(data.head ?? '') || data.head !== head() || !data.tracked || !data.untracked || !/^[0-9a-f]{64}$/.test(data.ignored_unallowlisted_sha256 ?? '') || !Array.isArray(data.status) || !Array.isArray(data.planned_deletions) || !Array.isArray(data.planned_creations)) fail(`invalid ${label} snapshot identity or schema`)
  for (const planned of [data.planned_deletions, data.planned_creations]) {
    if (planned.some((path) => typeof path !== 'string' || path.length === 0 || path.startsWith('/') || path.split('/').includes('..')) || new Set(planned).size !== planned.length) fail(`invalid ${label} planned path metadata`)
  }
  for (const [path, value] of Object.entries(data.tracked)) {
    if (!value || typeof value.current_sha256 !== 'string' || !/^[0-9a-f]{64}$/.test(value.current_sha256) || typeof value.head_oid !== 'string' || !/^[0-9a-f]{40}$/.test(value.head_oid)) fail(`invalid ${label} tracked inventory ${path}`)
  }
  for (const [path, value] of Object.entries(data.untracked)) if (typeof value !== 'string' || !/^[0-9a-f]{64}$/.test(value)) fail(`invalid ${label} untracked inventory ${path}`)
}
function assertChanges(before, after, allow) {
  if (before.ignored_unallowlisted_sha256 !== after.ignored_unallowlisted_sha256) fail('out-of-allowlist mutation in ignored files')
  const allPaths = new Set([...Object.keys(before.tracked ?? {}), ...Object.keys(after.tracked ?? {}), ...Object.keys(before.untracked ?? {}), ...Object.keys(after.untracked ?? {})])
  for (const path of allPaths) {
    const beforeValue = before.tracked?.[path]?.current_sha256 ?? before.untracked?.[path] ?? null
    const afterValue = after.tracked?.[path]?.current_sha256 ?? after.untracked?.[path] ?? null
    if (beforeValue === afterValue) continue
    if (beforeValue !== null && afterValue !== null && allow.paths.has(path)) continue
    if (beforeValue === null && afterValue !== null && allow.creations.has(path)) continue
    if (beforeValue !== null && afterValue === null && allow.deletions.has(path)) continue
    fail(`out-of-allowlist mutation: ${path}`)
  }
  const beforeStatus = new Set(before.status ?? [])
  const afterStatus = new Set(after.status ?? [])
  for (const line of [...beforeStatus, ...afterStatus]) {
    const path = line.slice(3).trim()
    if (beforeStatus.has(line) === afterStatus.has(line)) continue
    if (!allow.paths.has(path) && !allow.creations.has(path) && !allow.deletions.has(path)) fail(`out-of-allowlist status change: ${line}`)
  }
  const preserved = [...beforeStatus]
    .filter((line) => afterStatus.has(line))
    .filter((line) => {
      const path = line.slice(3).trim()
      return !allow.paths.has(path) && !allow.creations.has(path) && !allow.deletions.has(path)
    })
    .sort()
  if (preserved.length > 0) {
    const digest = createHash('sha256').update(preserved.join('\n')).digest('hex')
    console.log(`privacy-worktree-check: preserved ${preserved.length} pre-existing out-of-scope status entries (digest=${digest})`)
  }
}
function compare() {
  const beforePath = value('--before')
  const afterPath = value('--after')
  if (!beforePath || !afterPath) fail('--before and --after are required')
  const before = JSON.parse(readFileSync(resolve(controlRoot, beforePath), 'utf8'))
  const after = JSON.parse(readFileSync(resolve(controlRoot, afterPath), 'utf8'))
  if (!value('--repo') && typeof before?.repo === 'string') root = resolve(before.repo)
  validateSnapshot(before, 'before')
  validateSnapshot(after, 'after')
  if (before.repo !== after.repo || before.head !== after.head || after.head !== head()) fail('snapshot does not describe the current repository')
  const allow = loadAllowlist()
  assertChanges(before, after, allow)
}
function controlSummary(path) {
  const bytes = readFileSync(resolve(root, path), 'utf8')
  if (path === 'PLAN.md') {
    const status = bytes.match(/^\s*-?\s*Status:\s*(\S+)/m)?.[1] ?? 'unknown'
    return `# control-artifact=local-only\n# status=${status}\n# sha256=${sha(path)}\n`
  }
  if (path.endsWith('.jsonl')) {
    const counts = {}
    for (const line of bytes.split('\n').filter(Boolean)) {
      try {
        const event = JSON.parse(line).event
        if (typeof event === 'string') counts[event] = (counts[event] ?? 0) + 1
      } catch {
        counts.invalid = (counts.invalid ?? 0) + 1
      }
    }
    return `# control-artifact=local-only\n# events=${JSON.stringify(counts)}\n# sha256=${sha(path)}\n`
  }
  const data = JSON.parse(bytes)
  if (path.endsWith('/classification.json')) {
    const counts = {}
    for (const unit of data.units ?? []) counts[unit.classification] = (counts[unit.classification] ?? 0) + 1
    return `# control-artifact=local-only\n# units=${data.units?.length ?? 0}\n# classifications=${JSON.stringify(counts)}\n# sha256=${sha(path)}\n`
  }
  if (path.endsWith('/receipts.json')) {
    const counts = {}
    for (const receipt of data.receipts ?? []) counts[receipt.action] = (counts[receipt.action] ?? 0) + 1
    return `# control-artifact=local-only\n# receipts=${data.receipts?.length ?? 0}\n# actions=${JSON.stringify(counts)}\n# sha256=${sha(path)}\n`
  }
  if (path.endsWith('/local-artifacts.json')) {
    const artifacts = data.artifacts ?? []
    return `# control-artifact=local-only\n# artifacts=${artifacts.length}\n# artifact_units=${artifacts.reduce((total, artifact) => total + (artifact.unit_ids?.length ?? 0), 0)}\n# artifact_receipts=${artifacts.reduce((total, artifact) => total + (artifact.receipt_ids?.length ?? 0), 0)}\n# sha256=${sha(path)}\n`
  }
  if (path.endsWith('/worktree-allowlist.json')) {
    return `# control-artifact=local-only\n# scopes=${JSON.stringify({ etabli: data.etabli?.length ?? 0, brain: data.brain?.length ?? 0, obvault: data.obvault?.length ?? 0 })}\n# planned_creations=${data.planned_creations?.length ?? 0}\n# planned_deletions=${data.planned_deletions?.length ?? 0}\n# sha256=${sha(path)}\n`
  }
  if (path.endsWith('/public-allowlist.json')) {
    return `# control-artifact=local-only\n# synthetic_ids=${data.synthetic_ids?.length ?? 0}\n# opaque_sha256=${data.opaque_sha256?.length ?? 0}\n# sha256=${sha(path)}\n`
  }
  if (/(?:before|after)\.json$/.test(path)) {
    return `# control-artifact=local-only\n# scope=${data.scope ?? 'unknown'}\n# tracked=${Object.keys(data.tracked ?? {}).length}\n# untracked=${Object.keys(data.untracked ?? {}).length}\n# status_entries=${data.status?.length ?? 0}\n# planned_creations=${data.planned_creations?.length ?? 0}\n# planned_deletions=${data.planned_deletions?.length ?? 0}\n# ignored_digest=${data.ignored_unallowlisted_sha256 ?? 'unknown'}\n# allowlist_digest=${data.allowlist_sha256 ?? 'unknown'}\n# sha256=${sha(path)}\n`
  }
  return `# control-artifact=local-only\n# sha256=${sha(path)}\n`
}
function bundle() {
  const base = value('--base')
  if (!base || !output) fail('--base and --output are required for bundle')
  const allow = loadAllowlist()
  const baselinePath = value('--baseline') ?? (scope === 'etabli' ? '.workflow/self-improvement-privacy-20260914/worktree-before.json' : `.workflow/self-improvement-privacy-20260914/${scope}-before.json`)
  const baseline = JSON.parse(readFileSync(resolve(controlRoot, baselinePath), 'utf8'))
  const current = captureSnapshot()
  validateSnapshot(baseline, 'baseline')
  assertChanges(baseline, current, allow)
  const paths = [...allow.paths].sort()
  const chunks = [`# privacy review bundle\n# base=${base}\n# scope=${scope}\n# paths=${JSON.stringify(paths)}\n`]
  const localArtifactsPath = '.workflow/self-improvement-privacy-20260914/local-artifacts.json'
  const localArtifactHashes = new Map()
  if (scope === 'etabli' && existsSync(resolve(root, localArtifactsPath))) {
    const localArtifacts = JSON.parse(readFileSync(resolve(root, localArtifactsPath), 'utf8')).artifacts ?? []
    for (const artifact of localArtifacts) if (typeof artifact.path === 'string' && typeof artifact.before_sha256 === 'string') localArtifactHashes.set(artifact.path, artifact.before_sha256)
  }
  for (const path of paths) {
    if (path === output || path.startsWith(`${output}/`)) continue
    // Control artifacts contain local inventories and hashes needed by the
    // comparator, but they are not reviewable public source. Keep only a
    // digest in the ephemeral bundle so a reviewer cannot publish them.
    if (scope === 'etabli' && (path === 'PLAN.md' || path.startsWith('.workflow/'))) {
      const controlPath = resolve(root, path)
      if (existsSync(controlPath) && statSync(controlPath).isFile()) {
        chunks.push(`# path=${path}\n${controlSummary(path)}`)
      }
      continue
    }
    const tracked = (() => {
      try {
        execFileSync('git', ['ls-files', '--error-unmatch', path], { cwd: root, stdio: 'ignore' })
        return true
      } catch {
        return false
      }
    })()
    if (tracked) {
      chunks.push(`# path=${path}\n`)
      chunks.push(git(['diff', '--binary', base, '--', path]).toString('utf8'))
    } else if (existsSync(resolve(root, path))) {
      chunks.push(`# path=${path}\n`)
      try { chunks.push(execFileSync('git', ['diff', '--no-index', '--binary', '/dev/null', path], { cwd: root, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] })) } catch (error) {
        if (error && typeof error === 'object' && 'stdout' in error && typeof error.stdout === 'string') chunks.push(error.stdout)
      }
    }
  }
  // Keep declared deletions visible in the review bundle even when the file is
  // already absent from the current checkout and therefore has no diff.
  for (const path of [...allow.deletions].sort()) {
    if (existsSync(resolve(root, path)) || path === output || path.startsWith(`${output}/`)) continue
    const baselineValue = baseline.tracked?.[path]?.current_sha256 ?? baseline.untracked?.[path] ?? null
    chunks.push(`# path=${path}\n# deletion=planned baseline_sha256=${baselineValue ?? localArtifactHashes.get(path) ?? 'unavailable'}\n`)
  }
  writeFileSync(resolve(controlRoot, output), chunks.join(''), { mode: 0o600 })
}
if (command === 'snapshot') snapshot()
else if (command === 'compare') compare()
else if (command === 'bundle') bundle()
else fail('command must be snapshot, compare or bundle')
