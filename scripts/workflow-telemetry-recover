#!/usr/bin/env node

const crypto = require('node:crypto')
const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')
const { execFileSync } = require('node:child_process')

const rootDir = path.resolve(__dirname, '..')
const workflowEvent = path.join(rootDir, 'scripts', 'workflow-event')

function usage() {
  process.stdout.write(`Usage: workflow-telemetry-recover [options]

Recover aggregate token usage for terminal workflow runs from local Codex
session envelopes. The default is a read-only dry run.

Options:
  --workflow-dir path   Workflow ledger directory (default: .workflow)
  --sessions-dir path   Codex session directory (default: ~/.codex/sessions)
  --ledger-run slug     Active run that receives population/import events
  --dry-run             Preview only (also the default)
  --apply               Append validated events through workflow-event
  --json                Emit machine-readable output
  -h, --help            Show this help
`)
}

function fail(message) {
  process.stderr.write(`${message}\n`)
  process.exit(1)
}

function parseArgs(argv) {
  const options = {
    workflowDir: '.workflow',
    sessionsDir: path.join(os.homedir(), '.codex', 'sessions'),
    ledgerRun: null,
    apply: false,
    dryRun: false,
    json: false,
  }
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index]
    if (argument === '--workflow-dir') options.workflowDir = argv[++index]
    else if (argument === '--sessions-dir') options.sessionsDir = argv[++index]
    else if (argument === '--ledger-run') options.ledgerRun = argv[++index]
    else if (argument === '--apply') options.apply = true
    else if (argument === '--dry-run') options.dryRun = true
    else if (argument === '--json') options.json = true
    else if (argument === '-h' || argument === '--help') {
      usage()
      process.exit(0)
    } else {
      process.stderr.write(`unknown option: ${argument}\n`)
      usage()
      process.exit(2)
    }
    if ((argument === '--workflow-dir' || argument === '--sessions-dir' || argument === '--ledger-run') && argv[index] == null) {
      process.stderr.write(`missing value for ${argument}\n`)
      process.exit(2)
    }
  }
  if (options.apply && options.dryRun) fail('--apply and --dry-run are mutually exclusive')
  if (options.apply && !options.ledgerRun) fail('--apply requires --ledger-run')
  return options
}

function sha256(value) {
  return crypto.createHash('sha256').update(value).digest('hex')
}

function stable(value) {
  if (Array.isArray(value)) return `[${value.map(stable).join(',')}]`
  if (value && typeof value === 'object') {
    return `{${Object.keys(value).sort().map((key) => `${JSON.stringify(key)}:${stable(value[key])}`).join(',')}}`
  }
  return JSON.stringify(value)
}

function parseTimestamp(value, context) {
  const milliseconds = Date.parse(value)
  if (!Number.isFinite(milliseconds)) fail(`invalid timestamp in ${context}`)
  return milliseconds
}

function listFiles(directory, predicate) {
  if (!fs.existsSync(directory)) return []
  const files = []
  const pending = [directory]
  while (pending.length > 0) {
    const current = pending.pop()
    for (const entry of fs.readdirSync(current, { withFileTypes: true })) {
      const entryPath = path.join(current, entry.name)
      if (entry.isDirectory()) pending.push(entryPath)
      else if (predicate(entryPath)) files.push(entryPath)
    }
  }
  return files.sort()
}

function parseLedger(file) {
  const raw = fs.readFileSync(file, 'utf8')
  const rawLines = raw.split(/\r?\n/).filter(Boolean)
  const entries = rawLines.map((line, index) => {
    try {
      return { value: JSON.parse(line), raw: line, index }
    } catch {
      fail(`invalid workflow ledger JSON: ${file}`)
    }
  })
  if (entries.length === 0) return null
  const terminalEntry = [...entries].reverse().find(({ value }) => value.event === 'completed' || value.event === 'blocked')
  if (!terminalEntry) return null
  const outcomeEntry = [...entries].reverse().find(({ value }) => value.event === 'outcome_metric') || null
  const run = path.basename(path.dirname(file))
  const metrics = entries.filter(({ value }) => value.event === 'outcome_metric').map(({ value }) => value.detail || {})
  const measured = metrics.some((metric) => metric.measured === true)
  const usageMeasured = metrics.some((metric) => metric.measured === true && Number.isInteger(metric.total_tokens))
  return {
    run,
    file,
    raw,
    entries,
    startedAt: entries[0].value.ts,
    endedAt: terminalEntry.value.ts,
    startMs: parseTimestamp(entries[0].value.ts, run),
    endMs: parseTimestamp(terminalEntry.value.ts, run),
    terminal: terminalEntry.value.event,
    terminalFingerprint: sha256(terminalEntry.raw),
    outcomeFingerprint: outcomeEntry ? sha256(outcomeEntry.raw) : null,
    ledgerFingerprint: sha256(raw),
    baselineMeasured: measured,
    baselineUsageMeasured: usageMeasured,
    metricCount: metrics.length,
    success: outcomeEntry && typeof outcomeEntry.value.detail?.success === 'boolean'
      ? outcomeEntry.value.detail.success
      : terminalEntry.value.event === 'completed',
  }
}

function sessionDateInRange(file, earliestMs, latestMs) {
  const match = path.basename(file).match(/^rollout-(\d{4}-\d{2}-\d{2})T/)
  if (!match) return false
  const dayMs = Date.parse(`${match[1]}T00:00:00Z`)
  return dayMs >= earliestMs - 86400000 && dayMs <= latestMs + 86400000
}

function parseSession(file) {
  const lines = fs.readFileSync(file, 'utf8').split(/\r?\n/).filter(Boolean)
  let metadata = null
  let lastMs = null
  const tokenSamples = []
  const userMessages = []
  const toolCalls = []
  for (let index = 0; index < lines.length; index += 1) {
    let entry
    try {
      entry = JSON.parse(lines[index])
    } catch {
      continue
    }
    const timestamp = entry.timestamp
    const timestampMs = Date.parse(timestamp)
    if (Number.isFinite(timestampMs)) lastMs = timestampMs
    if (entry.type === 'session_meta' && entry.payload?.id && entry.payload?.source) {
      metadata = { id: entry.payload.id, source: entry.payload.source, timestamp, timestampMs }
    } else if (entry.type === 'event_msg' && entry.payload?.type === 'token_count') {
      const total = entry.payload.info?.total_token_usage
      if (total && Number.isInteger(total.input_tokens) && Number.isInteger(total.output_tokens) && Number.isInteger(total.total_tokens)) {
        tokenSamples.push({
          index,
          timestamp,
          timestampMs,
          inputTokens: total.input_tokens,
          outputTokens: total.output_tokens,
          totalTokens: total.total_tokens,
        })
      }
    } else if (entry.type === 'event_msg' && entry.payload?.type === 'user_message' && Number.isFinite(timestampMs)) {
      userMessages.push(timestampMs)
    } else if (entry.type === 'response_item' && entry.payload?.type === 'function_call' && Number.isFinite(timestampMs)) {
      toolCalls.push(timestampMs)
    }
  }
  if (!metadata || metadata.source !== 'vscode' || !Number.isFinite(metadata.timestampMs) || !Number.isFinite(lastMs)) return null
  return {
    fingerprint: sha256(`codex-session:${metadata.id}`),
    startedAt: metadata.timestamp,
    startMs: metadata.timestampMs,
    endMs: lastMs,
    tokenSamples,
    userMessages,
    toolCalls,
  }
}

function monotone(samples, startIndex, endIndex) {
  let previous = startIndex >= 0
    ? samples[startIndex]
    : { inputTokens: 0, outputTokens: 0, totalTokens: 0 }
  for (let index = startIndex + 1; index <= endIndex; index += 1) {
    const current = samples[index]
    if (current.inputTokens < previous.inputTokens || current.outputTokens < previous.outputTokens || current.totalTokens < previous.totalTokens) return false
    previous = current
  }
  return true
}

function recoverCandidate(run, sessions) {
  if (run.baselineUsageMeasured) return { run, status: 'baseline', reason: 'already-usage-measured' }
  if (run.metricCount > 1) return { run, status: 'rejected', reason: 'multiple-outcome-events' }
  if (run.endMs - run.startMs < 60000) return { run, status: 'rejected', reason: 'run-window-too-short' }
  const enclosing = sessions
    .filter((session) => session.startMs <= run.startMs && session.endMs >= run.endMs)
    .sort((left, right) => (left.endMs - left.startMs) - (right.endMs - right.startMs) || right.startMs - left.startMs || left.fingerprint.localeCompare(right.fingerprint))
  if (enclosing.length === 0) return { run, status: 'rejected', reason: 'no-enclosing-primary-session' }
  if (enclosing.length > 1 && (enclosing[0].endMs - enclosing[0].startMs) === (enclosing[1].endMs - enclosing[1].startMs)) {
    return { run, status: 'rejected', reason: 'ambiguous-primary-session' }
  }
  const session = enclosing[0]
  const samples = session.tokenSamples
  const endIndex = samples.findIndex((sample) => sample.timestampMs >= run.endMs)
  if (endIndex < 0 || samples[endIndex].timestampMs - run.endMs > 120000) return { run, status: 'rejected', reason: 'missing-near-terminal-sample' }
  const hasInsideSample = samples.some((sample) => sample.timestampMs >= run.startMs && sample.timestampMs <= run.endMs)
  if (!hasInsideSample) return { run, status: 'rejected', reason: 'no-sample-inside-run-window' }
  let baselineIndex = -1
  for (let index = 0; index < samples.length && samples[index].timestampMs < run.startMs; index += 1) baselineIndex = index
  const baselineTimestampMs = baselineIndex >= 0 ? samples[baselineIndex].timestampMs : session.startMs
  if (run.startMs - baselineTimestampMs > 120000) return { run, status: 'rejected', reason: 'stale-pre-run-baseline' }
  if (!monotone(samples, baselineIndex, endIndex)) return { run, status: 'rejected', reason: 'counter-reset' }
  if (session.userMessages.some((timestamp) => timestamp > run.endMs && timestamp <= samples[endIndex].timestampMs)) {
    return { run, status: 'rejected', reason: 'post-terminal-user-message' }
  }
  const baseline = baselineIndex >= 0
    ? samples[baselineIndex]
    : { timestamp: session.startedAt, timestampMs: session.startMs, inputTokens: 0, outputTokens: 0, totalTokens: 0 }
  const final = samples[endIndex]
  const aggregate = {
    input_tokens: final.inputTokens - baseline.inputTokens,
    output_tokens: final.outputTokens - baseline.outputTokens,
    total_tokens: final.totalTokens - baseline.totalTokens,
    tool_calls: session.toolCalls.filter((timestamp) => timestamp > baseline.timestampMs && timestamp <= final.timestampMs).length,
    elapsed_ms: final.timestampMs - run.startMs,
  }
  if (aggregate.input_tokens < 0 || aggregate.output_tokens < 0 || aggregate.total_tokens < aggregate.input_tokens + aggregate.output_tokens) {
    return { run, status: 'rejected', reason: 'invalid-token-delta' }
  }
  return {
    run,
    status: 'accepted',
    reason: null,
    session,
    baselineIndex,
    endIndex,
    sampleCount: endIndex - baselineIndex,
    sampleStartedAt: baseline.timestamp,
    sampleEndedAt: final.timestamp,
    aggregate,
  }
}

function rejectOverlaps(candidates) {
  const acceptedBySession = new Map()
  for (const candidate of candidates.filter(({ status }) => status === 'accepted')) {
    const group = acceptedBySession.get(candidate.session.fingerprint) || []
    group.push(candidate)
    acceptedBySession.set(candidate.session.fingerprint, group)
  }
  for (const group of acceptedBySession.values()) {
    group.sort((left, right) => left.baselineIndex - right.baselineIndex || left.endIndex - right.endIndex)
    for (let index = 1; index < group.length; index += 1) {
      const previous = group[index - 1]
      const current = group[index]
      if (current.baselineIndex < previous.endIndex) {
        previous.status = 'rejected'
        previous.reason = 'overlapping-measurement-slice'
        current.status = 'rejected'
        current.reason = 'overlapping-measurement-slice'
      }
    }
  }
}

function targetFor(run) {
  return {
    target_run: run.run,
    target_ledger_sha256: run.ledgerFingerprint,
    target_terminal: run.terminal,
    target_terminal_event_sha256: run.terminalFingerprint,
    target_outcome_event_sha256: run.outcomeFingerprint,
    baseline_measured: run.baselineMeasured,
    baseline_usage_measured: run.baselineUsageMeasured,
  }
}

function importFor(candidate, populationId) {
  const detail = {
    population_id: populationId,
    import_id: '',
    target_run: candidate.run.run,
    target_ledger_sha256: candidate.run.ledgerFingerprint,
    target_terminal: candidate.run.terminal,
    target_terminal_event_sha256: candidate.run.terminalFingerprint,
    target_outcome_event_sha256: candidate.run.outcomeFingerprint,
    source_adapter: 'codex',
    source_scope: 'primary_session_window',
    selection: 'shortest_enclosing_primary_session',
    session_fingerprint: candidate.session.fingerprint,
    window_started_at: candidate.run.startedAt,
    window_ended_at: candidate.run.endedAt,
    sample_started_at: candidate.sampleStartedAt,
    sample_ended_at: candidate.sampleEndedAt,
    sample_count: candidate.sampleCount,
    success: candidate.run.success,
    ...candidate.aggregate,
  }
  detail.import_id = sha256(stable({ ...detail, import_id: undefined }))
  return detail
}

function appendEvent(options, event, detail) {
  execFileSync(workflowEvent, ['--dir', options.workflowDir, 'append', options.ledgerRun, event, JSON.stringify(detail)], { stdio: 'pipe' })
}

function applyEvents(options, population, imports) {
  const ledger = path.join(options.workflowDir, options.ledgerRun, 'events.jsonl')
  if (!fs.existsSync(ledger)) fail(`missing active import ledger: ${ledger}`)
  let events = fs.readFileSync(ledger, 'utf8').split(/\r?\n/).filter(Boolean).map((line) => JSON.parse(line))
  if (events.some(({ event }) => event === 'completed' || event === 'blocked')) fail('import ledger is already terminal')
  const populations = events.filter(({ event }) => event === 'outcome_measurement_population').map(({ detail }) => detail)
  const samePopulation = populations.find(({ population_id }) => population_id === population.population_id)
  if (populations.length > 1 || (populations.length === 1 && !samePopulation)) fail('existing population conflicts with current manifest')
  if (samePopulation && stable(samePopulation) !== stable(population)) fail('existing population conflicts with current manifest')
  if (!samePopulation) appendEvent(options, 'outcome_measurement_population', population)
  events = fs.readFileSync(ledger, 'utf8').split(/\r?\n/).filter(Boolean).map((line) => JSON.parse(line))
  const existingImports = events.filter(({ event }) => event === 'outcome_measurement_imported').map(({ detail }) => detail)
  for (const detail of imports) {
    const existing = existingImports.find((item) => item.target_run === detail.target_run)
    if (existing && stable(existing) !== stable(detail)) fail(`existing import conflicts for ${detail.target_run}`)
    if (!existing) appendEvent(options, 'outcome_measurement_imported', detail)
  }
  execFileSync(workflowEvent, ['--dir', options.workflowDir, 'validate', options.ledgerRun], { stdio: 'pipe' })
}

function main() {
  const options = parseArgs(process.argv.slice(2))
  const workflowDir = path.resolve(options.workflowDir)
  const ledgerFiles = listFiles(workflowDir, (file) => path.basename(file) === 'events.jsonl')
  const terminalRuns = ledgerFiles.map(parseLedger).filter(Boolean).filter((run) => run.run !== options.ledgerRun).sort((left, right) => left.run.localeCompare(right.run))
  if (terminalRuns.length === 0) fail(`no terminal workflow runs found in ${workflowDir}`)
  const earliestMs = Math.min(...terminalRuns.map(({ startMs }) => startMs))
  const latestMs = Math.max(...terminalRuns.map(({ endMs }) => endMs))
  const sessionFiles = listFiles(path.resolve(options.sessionsDir), (file) => file.endsWith('.jsonl') && sessionDateInRange(file, earliestMs, latestMs))
  const sessions = sessionFiles.map(parseSession).filter(Boolean)
  const targets = terminalRuns.map(targetFor)
  const manifestSha256 = sha256(stable(targets))
  const populationId = `terminal-runs-v1-${manifestSha256.slice(0, 16)}`
  const population = { population_id: populationId, manifest_sha256: manifestSha256, terminal_runs: targets.length, targets }
  const candidates = terminalRuns.map((run) => recoverCandidate(run, sessions))
  rejectOverlaps(candidates)
  const accepted = candidates.filter(({ status }) => status === 'accepted')
  const imports = accepted.map((candidate) => importFor(candidate, populationId))
  const baselineUsage = terminalRuns.filter(({ baselineUsageMeasured }) => baselineUsageMeasured).length
  const covered = baselineUsage + imports.length
  const result = {
    mode: options.apply ? 'apply' : 'dry-run',
    population_id: populationId,
    manifest_sha256: manifestSha256,
    terminal_runs: terminalRuns.length,
    baseline_usage_measured_outcomes: baselineUsage,
    recovered_outcomes: imports.length,
    usage_measured_outcomes: covered,
    usage_measurement_coverage: covered / terminalRuns.length,
    rejected_outcomes: candidates.filter(({ status }) => status === 'rejected').length,
    verified_imports: imports,
    candidates: candidates.map((candidate) => ({
      target_run: candidate.run.run,
      status: candidate.status,
      reason: candidate.reason,
      ...(candidate.status === 'accepted' ? { session_fingerprint: candidate.session.fingerprint, ...candidate.aggregate } : {}),
    })),
  }
  if (options.apply) applyEvents({ ...options, workflowDir }, population, imports)
  if (options.json) process.stdout.write(`${JSON.stringify(result, null, 2)}\n`)
  else {
    process.stdout.write(`mode=${result.mode}\nterminal_runs=${result.terminal_runs}\nbaseline_usage_measured_outcomes=${result.baseline_usage_measured_outcomes}\nrecovered_outcomes=${result.recovered_outcomes}\nusage_measurement_coverage=${result.usage_measurement_coverage}\nrejected_outcomes=${result.rejected_outcomes}\n`)
  }
}

try {
  main()
} catch (error) {
  const detail = error && error.stderr ? error.stderr.toString().trim() : error.message
  fail(detail || 'telemetry recovery failed')
}
