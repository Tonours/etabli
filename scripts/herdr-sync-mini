#!/usr/bin/env bash
# Compatibility entrypoint for an existing ~/.local/bin/herdr-sync-mini link.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DOTFILES_DIR="${DOTFILES_DIR:-$REPO_DIR/../dotfiles}"
if [ ! -f "$DOTFILES_DIR/scripts/herdr-sync-mini" ]; then
  printf 'Herdr sync moved to dotfiles; set DOTFILES_DIR to its checkout and retry\n' >&2
  exit 1
fi
export ETABLI_DIR="$REPO_DIR"
exec bash "$DOTFILES_DIR/scripts/herdr-sync-mini" "$@"
