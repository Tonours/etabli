#!/usr/bin/env bash
# Sync etabli Herdr managed tree + plugins to macmini (no GitHub SSH required on mini).
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
HOST="${HERDR_MINI_HOST:-macmini}"
REMOTE_HERDR="${HERDR_MINI_TREE:-~/work/etabli-herdr}"

echo "[herdr-sync-mini] repo=$REPO_DIR host=$HOST remote_tree=$REMOTE_HERDR"

ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST" "mkdir -p $REMOTE_HERDR ~/.config/herdr/plugins"

echo "[herdr-sync-mini] rsync herdr/ config tree..."
rsync -az --delete \
  "$REPO_DIR/herdr/" \
  "$HOST:$REMOTE_HERDR/"

echo "[herdr-sync-mini] tar plugins (github checkouts + config)..."
(
  cd "$HOME/.config/herdr/plugins"
  tar cf - github config 2>/dev/null
) | ssh -o BatchMode=yes "$HOST" 'mkdir -p ~/.config/herdr/plugins && cd ~/.config/herdr/plugins && tar xf -'

echo "[herdr-sync-mini] remote links + plugin register..."
ssh -o BatchMode=yes "$HOST" "export PATH=\"\$HOME/.local/bin:\$PATH\"
HERDR_MINI_TREE_SPEC='$REMOTE_HERDR'
set -e
TREE=\"\$HERDR_MINI_TREE_SPEC\"
case \"\$TREE\" in '~'*) TREE=\"\$HOME\${TREE#\~}\" ;; esac
ln -sfn \"\$TREE/config.toml\" ~/.config/herdr/config.toml
mkdir -p ~/.config/herdr/plugins/config/sessionizer
ln -sfn \"\$TREE/layouts/sessionizer.config.toml\" \
  ~/.config/herdr/plugins/config/sessionizer/config.toml
for skill_dir in ~/.claude/skills ~/.codex/skills ~/.agents/skills ~/.pi/agent/skills; do
  mkdir -p \"\$skill_dir\"
  if [ -e \"\$skill_dir/herdr\" ] && [ ! -L \"\$skill_dir/herdr\" ]; then
    mv \"\$skill_dir/herdr\" \"\$skill_dir/herdr.bak.\$(date +%Y%m%d-%H%M%S)\"
  fi
  ln -sfn \"\$TREE/skills/herdr\" \"\$skill_dir/herdr\"
done
for d in ~/.config/herdr/plugins/github/*/; do
  [ -f \"\${d}herdr-plugin.toml\" ] || continue
  herdr plugin link \"\${d%/}\" >/dev/null 2>&1 || herdr plugin link \"\${d%/}\" || true
done
herdr plugin link \"\$TREE/plugins/etabli-obvault\" >/dev/null 2>&1 || \
  herdr plugin link \"\$TREE/plugins/etabli-obvault\" || true
herdr config check
herdr server reload-config 2>/dev/null || true
herdr --version
herdr plugin list
"

echo "[herdr-sync-mini] done"
