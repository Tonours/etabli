#!/usr/bin/env bash
# Validate workflow/route-context-manifests.json against router routes (blueprint T1).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
MANIFEST="$ROOT_DIR/workflow/route-context-manifests.json"
ROUTER_LIB="$ROOT_DIR/claude/hooks/workflow-router-lib.mjs"
SPEC="$ROOT_DIR/workflow/spec.md"

usage() {
  cat <<EOF
Usage: route-context-manifest-check

Ensure every routed Etabli route has a context manifest with budgets and sources.
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

fail() {
  printf 'route-context-manifest-check: %s\n' "$1" >&2
  exit 1
}

[ -f "$MANIFEST" ] || fail "missing $MANIFEST"
[ -f "$ROUTER_LIB" ] || fail "missing $ROUTER_LIB"
command -v jq >/dev/null || fail "jq required"
command -v node >/dev/null || fail "node required"

jq -e '
  (.version | type == "number") and
  (.routes | type == "object") and
  (.routes | length) > 0 and
  all(.routes[]; 
    (.required_sources | type == "array") and
    (.required_sources | length) > 0 and
    all(.required_sources[]; type == "string" and length > 0) and
    ((.conditional_sources // []) | type == "array") and
    (.max_estimated_tokens | type == "number" and . > 0) and
    (.stop | type == "string" and length > 0)
  )
' "$MANIFEST" >/dev/null || fail "manifest schema invalid"

# Routes observed in the shared router classifier source.
router_routes="$(
  node --input-type=module -e '
    import fs from "node:fs";
    const src = fs.readFileSync(process.argv[1], "utf8");
    const routes = new Set();
    for (const m of src.matchAll(/route:\s*"([^"]+)"/g)) routes.add(m[1]);
    // verify-workflow is Claude alias of verify; keep both if present
    console.log([...routes].sort().join("\n"));
  ' "$ROUTER_LIB"
)"

manifest_routes="$(jq -r '.routes | keys[]' "$MANIFEST" | sort)"
missing="$(comm -23 <(printf '%s\n' "$router_routes") <(printf '%s\n' "$manifest_routes") || true)"
extra="$(comm -13 <(printf '%s\n' "$router_routes") <(printf '%s\n' "$manifest_routes") || true)"

[ -z "$missing" ] || fail "routes missing manifests: $(printf '%s' "$missing" | tr '\n' ' ')"
# Extra manifests are allowed only for documented aliases already in router set;
# fail closed on unexpected extras not in router.
[ -z "$extra" ] || fail "manifest routes not present in router: $(printf '%s' "$extra" | tr '\n' ' ')"

# Required source paths must exist when they are repo-relative files (skip PLAN.md dynamic).
while IFS= read -r src; do
  case "$src" in
    PLAN.md) continue ;;
    /*) [ -e "$src" ] || fail "missing absolute source: $src" ;;
    *) [ -e "$ROOT_DIR/$src" ] || fail "missing required source path: $src" ;;
  esac
done < <(jq -r '.routes[].required_sources[]' "$MANIFEST" | sort -u)

# Spec routing table should mention plan-implement and ops-stop still.
grep -Fq 'plan-implement' "$SPEC" || fail "spec missing plan-implement"
grep -Fq 'ops-stop' "$SPEC" || fail "spec missing ops-stop"

printf 'route-context-manifest-check: ok (%s routes)\n' "$(printf '%s\n' "$manifest_routes" | grep -c .)"
