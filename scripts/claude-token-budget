#!/usr/bin/env bash
# Claude token budget: statistical verdict over paired holdout samples.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
DEFAULT_MANIFEST="$ROOT_DIR/claude/benchmarks/token-budget/manifest.v2.json"

usage() {
  cat <<EOF
Usage: claude-token-budget verify [--manifest path] <samples-dir>

Verifies paired holdout samples against the frozen manifest and prints the
verdict. Exits 0 only when every gate passes; each failure names its
remediation.

Gates (all required):
  sample_structure        exactly 3 complete baseline/candidate pairs for each
                          of the 12 frozen scenarios; infra-error pairs excluded
                          whole; replaced runs marked superseded
  oracles                 candidate 3/3 per scenario, no cap-hit, no baseline
                          score regression
  conformance             route/model/effort recorded and matching per run
  otel_reconciliation     |otel - record| <= 1% of the record total
  ratio                   R = sum(Tcand)/sum(Tbase) <= 0.50
  bootstrap_upper_bound   one-sided 95% upper bound of R <= 0.50
                          (10000 draws, clusters = scenarios, frozen seed)

Sample file schema (one JSON per run in <samples-dir>): stage="measure",
scenario (from manifest.scenario_order), arm ("baseline" or the selected
candidate), rep (1..3), route, model_id, effort, infra_error, superseded,
record (final headless claude -p --output-format json), cost_states (optional
cumulative fallback), otel.processed_total_tokens (optional),
oracle.passed / oracle.cap_hit.

T = input + output + cache_read + cache_creation from the final record;
the live outcome-metric hook is never the benchmark source.
EOF
}

COMMAND="verify"
MANIFEST="$DEFAULT_MANIFEST"
SAMPLES_DIR=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    verify) COMMAND="verify"; shift ;;
    --manifest) MANIFEST="${2:?--manifest requires a path}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) printf 'unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    *) SAMPLES_DIR="$1"; shift ;;
  esac
done

if [ "$COMMAND" != "verify" ]; then
  usage >&2
  exit 2
fi
if [ -z "$SAMPLES_DIR" ]; then
  printf 'missing <samples-dir>\n' >&2
  usage >&2
  exit 2
fi
if [ ! -d "$SAMPLES_DIR" ]; then
  printf 'samples dir not found: %s — pass the directory containing the paired run samples\n' "$SAMPLES_DIR" >&2
  exit 2
fi

export TB_MANIFEST="$MANIFEST"
export TB_SAMPLES_DIR="$SAMPLES_DIR"
export TB_LIB="$ROOT_DIR/scripts/lib/claude-token-budget-verify.mjs"
export TB_BENCH_LIB="$ROOT_DIR/scripts/lib/claude-agent-benchmark.mjs"

node --input-type=module <<'NODE'
import { pathToFileURL } from "node:url";

const bench = await import(pathToFileURL(process.env.TB_BENCH_LIB).href);
const verify = await import(pathToFileURL(process.env.TB_LIB).href);
const manifest = bench.loadManifest(process.env.TB_MANIFEST);
const report = verify.verifyFromFiles(manifest, process.env.TB_SAMPLES_DIR);

console.log(`claude-token-budget verify: ${report.passed ? "PASS" : "FAIL"}`);
console.log(`  pairs included:     ${report.pairs_included}/36`);
console.log(`  infra exclusions:   ${report.excluded_infra_pairs.length}${report.excluded_infra_pairs.length ? ` (${report.excluded_infra_pairs.join(", ")})` : ""}`);
console.log(`  superseded samples: ${report.superseded_samples.length}`);
if (report.ratio != null) {
	console.log(`  R:                  ${report.ratio.toFixed(4)}`);
	console.log(`  baseline total:     ${report.baseline_total_tokens}`);
	console.log(`  candidate total:    ${report.candidate_total_tokens}`);
}
if (report.bootstrap_upper_bound != null) {
	console.log(`  bootstrap upper95:  ${report.bootstrap_upper_bound.toFixed(4)}`);
}
for (const gate of report.gates) {
	console.log(`  gate ${gate.gate}: ${gate.passed ? "ok" : "FAIL"}${gate.detail ? ` (${gate.detail})` : ""}`);
}
for (const problem of report.problems) {
	console.error(`  - ${problem}`);
}
if (!report.passed) {
	console.error("Remediation: fix each listed problem (or replay excluded pairs within the budget), then rerun verify. Do not weaken the manifest gates.");
	process.exit(1);
}
NODE
