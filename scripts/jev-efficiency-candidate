#!/usr/bin/env node
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { consumeValidatedEscalation, decideEscalatedCampaign, executeLiveCandidate } from "./lib/jev-efficiency-candidate.mjs";

function usage() {
  return "usage: scripts/jev-efficiency-candidate consume-escalation --state <json> --receipt <json>\n       scripts/jev-efficiency-candidate next --manifest <json> --state <json> --receipt <json>\n       scripts/jev-efficiency-candidate run-live-candidate --manifest <json> --population <json> --state <json> --config <json> --baseline <json> --artifact <dir> --output <dir>";
}

const [command, ...args] = process.argv.slice(2);
const options = {};
for (let index = 0; index < args.length; index += 2) {
  const key = args[index];
  if (!key?.startsWith("--") || args[index + 1] === undefined) throw new Error(usage());
  options[key.slice(2)] = args[index + 1];
}

if (command === "consume-escalation") {
  if (!options.state || !options.receipt) throw new Error(usage());
  const state = JSON.parse(readFileSync(options.state, "utf8"));
  const receiptBytes = readFileSync(options.receipt);
  const receipt = JSON.parse(receiptBytes);
  const receiptFingerprint = createHash("sha256").update(receiptBytes).digest("hex");
  process.stdout.write(`${JSON.stringify(consumeValidatedEscalation({ state, receipt, receiptFingerprint }), null, 2)}\n`);
} else if (command === "next") {
  if (!options.manifest || !options.state || !options.receipt) throw new Error(usage());
  const manifest = JSON.parse(readFileSync(options.manifest, "utf8"));
  const state = JSON.parse(readFileSync(options.state, "utf8"));
  const receiptBytes = readFileSync(options.receipt);
  const receipt = JSON.parse(receiptBytes);
  const receiptFingerprint = createHash("sha256").update(receiptBytes).digest("hex");
  process.stdout.write(`${JSON.stringify(decideEscalatedCampaign(manifest, state, receipt, receiptFingerprint), null, 2)}\n`);
} else if (command === "run-live-candidate") {
  for (const key of ["manifest", "population", "state", "config", "baseline", "artifact", "output"]) if (!options[key]) throw new Error(usage());
  const manifestBytes = readFileSync(options.manifest);
  const populationBytes = readFileSync(options.population);
  const result = await executeLiveCandidate({
    manifest: JSON.parse(manifestBytes),
    manifestSha: createHash("sha256").update(manifestBytes).digest("hex"),
    population: JSON.parse(populationBytes),
    populationFingerprint: createHash("sha256").update(populationBytes).digest("hex"),
    state: JSON.parse(readFileSync(options.state, "utf8")),
    config: JSON.parse(readFileSync(options.config, "utf8")),
    baseline: JSON.parse(readFileSync(options.baseline, "utf8")),
    artifactPath: resolve(options.artifact),
    outputPath: resolve(options.output),
  });
  process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
} else {
  throw new Error(usage());
}
