#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
CLAUDE_DIR="$(node "$SCRIPT_DIR/lib/surfaces.mjs" claude-dir)"
DRY_RUN="0"

usage() {
  cat <<EOF
Usage: $(basename "$0") [--home DIR] [--dry-run]

Merges the hook entries from claude/settings.workflow-hooks.json into the
live Claude settings.json (\$CLAUDE_CONFIG_DIR, else ~/.claude; --home DIR
uses DIR/.claude), keyed by event + matcher + full hook object
(any parameter difference, async included, is a conflict). Adds missing
entries and removes only hooks the repo retired (exact command match);
every other user hook is preserved. Refuses to
write on invalid JSON, on a same-event conflict (same command already
wired on the same event with different parameters, which would
double-fire), or when disableAllHooks is true. Backs up before writing.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
  --home)
    [ "$#" -ge 2 ] || {
      usage >&2
      exit 2
    }
    CLAUDE_DIR="$2/.claude"
    shift
    ;;
  --dry-run) DRY_RUN="1" ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    printf 'unknown argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  esac
  shift
done

command -v node >/dev/null 2>&1 || {
  printf 'claude-hooks-merge: node is required\n' >&2
  exit 1
}

node "$SCRIPT_DIR/lib/claude-hooks-merge.mjs" "$CLAUDE_DIR" "$REPO_DIR" "$DRY_RUN"
