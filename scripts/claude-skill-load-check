#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

GATE=4912
ALERT=4892
HOME_DIR="${CLAUDE_SKILL_LOAD_HOME:-$HOME}"
if [ -n "${CLAUDE_SKILL_LOAD_HOME:-}" ]; then
  CLAUDE_DIR="$HOME_DIR/.claude"
else
  CLAUDE_DIR="${CLAUDE_SKILL_LOAD_CLAUDE_DIR:-$(node "$SCRIPT_DIR/lib/surfaces.mjs" claude-dir)}"
fi
REPO_OVERRIDE="${CLAUDE_SKILL_LOAD_REPO:-}"
FIX=0

usage() {
  cat <<EOF
Usage: $(basename "$0") [--home DIR]

Validates Claude's model-facing skill surface against the tracked
skillOverrides map (claude/settings.skill-overrides.json):

  C1  index chars <= $GATE (alert at >= $ALERT); metric: len(name) +
      len(description) + 20 per listed entry, name+20 for name-only;
      folded YAML descriptions (>- and |) are measured in full
  C2  exhaustive partition: every discovered skill (two-level SKILL.md
      discovery — skills/<name> and skills/<group>/<name>, matching Claude's
      own loading depth; symlink-following; .DS_Store ignored; duplicate
      declared names rejected) is a map key; every map key exists on the
      surface or is a catalog skill another scope owns; every catalog skill
      this machine's scopes deploy to Claude is on the surface
  C3  effective on-set (state "on" and not frontmatter-dmi) equals the
      pinned keep-set minus skills another scope owns, failing in both
      directions; personal skills named in claude/machine-local-skills.json
      may also be "on" where present
  C4  zero dangling links; zero links into skills.disabled
  C5  repo/live map equality (deploy applied)
  C6  no enabled plugin ships SKILL.md files, except plugins named in
      claude/machine-local-plugins.json (their skills stay ungoverned)


--home  skill root + settings root for the assertions (fixture homes);
        without it the Claude dir is \$CLAUDE_CONFIG_DIR, else ~/.claude
--fix            repair the C2 partition in the active map: add every
                 discovered skill missing from it as user-invocable-only,
                 drop keys with neither a surface nor a catalog skill,
                 then re-run the checks

CLAUDE_SKILL_LOAD_HOME and CLAUDE_SKILL_LOAD_REPO redirect the surfaces for
fixture-based smoke tests.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
  --home)
    HOME_DIR="$2"
    CLAUDE_DIR="$2/.claude"
    shift
    ;;
  --fix)
    FIX=1
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    printf 'unknown argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  esac
  shift
done

command -v node >/dev/null 2>&1 || {
  printf 'claude-skill-load-check: node is required\n' >&2
  exit 1
}

REPO_BASE="${REPO_OVERRIDE:-$REPO_DIR}"

# Scope policy from the catalog: known lists every repo skill (all scopes),
# expected the ones this machine's scopes deploy to Claude (minus shadows).
# Without a catalog both stay empty and every map key must be on the surface.
SKILL_NAMES="$(node "$SCRIPT_DIR/lib/surfaces.mjs" skill-names "$REPO_BASE" "$HOME_DIR")"
export SKILL_NAMES

node "$SCRIPT_DIR/lib/claude-skill-load-check.mjs" "$CLAUDE_DIR" "$REPO_BASE" "$GATE" "$ALERT" "$FIX" "$HOME_DIR"
