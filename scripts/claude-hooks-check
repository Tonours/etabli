#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
CLAUDE_DIR="$(node "$SCRIPT_DIR/lib/surfaces.mjs" claude-dir)"

usage() {
  cat <<EOF
Usage: $(basename "$0") [--home DIR]

Verifies every hook entry from claude/settings.workflow-hooks.json is wired
in the live Claude settings.json (\$CLAUDE_CONFIG_DIR, else ~/.claude;
--home DIR uses DIR/.claude) (same event, matcher and identical
hook object; any parameter difference, async included, counts as not
wired). Fails naming the remediation on any gap, fails when
disableAllHooks is true, and fails when a hook script referenced by the
fragment is missing under ~/.claude/hooks.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
  --home)
    [ "$#" -ge 2 ] || {
      usage >&2
      exit 2
    }
    CLAUDE_DIR="$2/.claude"
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    printf 'unknown argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  esac
  shift
done

command -v node >/dev/null 2>&1 || {
  printf 'claude-hooks-check: node is required\n' >&2
  exit 1
}

node "$SCRIPT_DIR/lib/claude-hooks-check.mjs" "$CLAUDE_DIR" "$REPO_DIR"
