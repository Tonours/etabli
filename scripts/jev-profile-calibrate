#!/usr/bin/env node
import { closeSync, constants, fstatSync, openSync, readFileSync } from "node:fs";
import { join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { randomUUID } from "node:crypto";
import {
  CORPUS_DIR,
  REPORT_DIR,
  calibrationProfileIds,
  checkpointMatchesCampaign,
  createBudget,
  loadCalibrationCorpus,
  recomputeCalibrationReport,
  runProfileCalibration,
  verifyCalibrationReport,
  writeCalibrationManifest,
  writeCalibrationReport,
  writeCalibrationSummary,
} from "../pi/extensions/lib/semantic-profile-calibration.mjs";
import { loadSemanticProfilePolicy } from "../pi/extensions/lib/semantic-profiles.mjs";

const ROOT = resolve(fileURLToPath(new URL("..", import.meta.url)));
const command = process.argv[2] || "validate";
const args = process.argv.slice(3);
const policy = loadSemanticProfilePolicy();

function option(name, fallback) {
  const index = args.indexOf(name);
  return index >= 0 ? args[index + 1] : fallback;
}

function integerOption(name, fallback) {
  const value = Number(option(name, fallback));
  if (!Number.isInteger(value) || value <= 0) throw new Error(`invalid ${name}`);
  return value;
}

function selectedProfiles() {
  const all = calibrationProfileIds(policy);
  if (args.includes("--all")) return all;
  const profile = option("--profile", null);
  if (!all.includes(profile)) throw new Error("use --all or --profile <id>");
  return [profile];
}

function json(value) {
  process.stdout.write(`${JSON.stringify(value, null, 2)}\n`);
}

function readCheckpoint(path) {
  let fd;
  try {
    fd = openSync(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
    if (!fstatSync(fd).isFile()) throw new Error("invalid checkpoint");
    return JSON.parse(readFileSync(fd, "utf8"));
  } catch (error) {
    if (error?.code === "ENOENT") return null;
    throw error;
  } finally { if (fd !== undefined) closeSync(fd); }
}

function checkpointPath(profileId) {
  return join(ROOT, ".workflow/jev-profile-calibration", `${profileId}.checkpoint.json`);
}

function campaignManifestPath() {
  return join(ROOT, ".workflow/jev-profile-calibration", "campaign.json");
}

function evidenceCampaignPath() {
  return join(REPORT_DIR, "campaign.json");
}

function restoredBudget(profiles, campaignId, fallback) {
  const checkpoints = profiles.map((profileId) => readCheckpoint(checkpointPath(profileId))).filter((checkpoint) => checkpointMatchesCampaign(checkpoint, campaignId));
  if (!checkpoints.length) return fallback;
  return checkpoints.map((item) => item.budget).sort((a, b) => b.attempts - a.attempts)[0];
}

function createCampaign(profiles, repetitions, maxAttempts, maxInputTokens, maxSeconds) {
  const startedAt = Date.now();
  const manifest = { schema_version: 1, campaign_id: randomUUID(), created_at: new Date(startedAt).toISOString(), profile_ids: profiles, repetitions, limits: { max_attempts: maxAttempts, max_input_tokens: maxInputTokens, max_seconds: maxSeconds }, started_at: startedAt, deadline: startedAt + maxSeconds * 1000 };
  writeCalibrationManifest(campaignManifestPath(), manifest);
  return manifest;
}

function resumeCampaign(profiles, repetitions, maxAttempts, maxInputTokens, maxSeconds) {
  const manifest = readCheckpoint(campaignManifestPath());
  if (!manifest || typeof manifest.campaign_id !== "string" || !Array.isArray(manifest.profile_ids) || profiles.some((profile) => !manifest.profile_ids.includes(profile))) throw new Error("missing or incompatible calibration campaign manifest");
  const limits = manifest.limits || {};
  if (manifest.repetitions !== repetitions || limits.max_attempts !== maxAttempts || limits.max_input_tokens !== maxInputTokens || limits.max_seconds !== maxSeconds) throw new Error("calibration resume limits mismatch");
  return manifest;
}

function evidenceCampaign() {
  const manifest = readCheckpoint(evidenceCampaignPath());
  if (!manifest?.result || manifest.result.campaign_id !== manifest.campaign_id) throw new Error("calibration campaign has no authoritative result");
  return manifest;
}

try {
  const profiles = selectedProfiles();
  const repetitions = integerOption("--repetitions", 3);
  const maxAttempts = integerOption("--max-attempts", 600);
  const maxInputTokens = integerOption("--max-input-tokens", 1_500_000);
  const maxSeconds = integerOption("--max-seconds", 1500);
  if (repetitions !== 3) throw new Error("calibration requires exactly three repetitions");

  if (command === "validate") {
    const validated = profiles.map((profileId) => ({ profile_id: profileId, semantic_cases: loadCalibrationCorpus(profileId, policy).semantic.length }));
    json({ ok: true, corpus_dir: CORPUS_DIR, profiles: validated });
  } else if (command === "dry-run-budget") {
    let attempts = 0;
    for (const profileId of profiles) attempts += loadCalibrationCorpus(profileId, policy).semantic.length * repetitions * (profileId === "skill-suggestion" ? 2 : 1);
    if (attempts > maxAttempts) throw new Error("computed attempts exceed budget");
    json({ ok: true, profiles: profiles.length, semantic_cases: profiles.length * 12, repetitions, computed_max_attempts: attempts, max_attempts: maxAttempts, max_input_tokens: maxInputTokens, max_seconds: maxSeconds, request_reservation_tokens: 64_000 });
  } else if (command === "run" || command === "resume") {
    if (!args.includes("--live")) throw new Error("live calibration requires explicit --live");
    if (!process.env.TYPESAFE_API_KEY) throw new Error("missing TYPESAFE_API_KEY");
    const campaign = command === "resume" ? resumeCampaign(profiles, repetitions, maxAttempts, maxInputTokens, maxSeconds) : createCampaign(profiles, repetitions, maxAttempts, maxInputTokens, maxSeconds);
    const initial = restoredBudget(campaign.profile_ids, campaign.campaign_id, { started_at: campaign.started_at, deadline: campaign.deadline });
    const budget = createBudget({ maxAttempts, maxInputTokens, maxSeconds, initial });
    const reports = [];
    for (const profileId of profiles) {
      const report = await runProfileCalibration({ profileId, repetitions, budget, checkpointPath: checkpointPath(profileId), campaign, resume: command === "resume", policy });
      writeCalibrationReport(profileId, report);
      reports.push({ profile_id: profileId, verdict: report.verdict, attempts: report.operational.attempts, input_tokens: report.operational.input_tokens, input_cost_usd: report.operational.input_cost_usd });
    }
    const campaignResult = { campaign_id: campaign.campaign_id, attempts: budget.attempts, input_tokens: budget.input_tokens, output_tokens: budget.output_tokens, input_cost_usd: budget.input_tokens * 0.042 / 1_000_000, deadline: new Date(budget.deadline).toISOString() };
    const completedCampaign = { ...campaign, completed_at: new Date().toISOString(), result: campaignResult };
    writeCalibrationManifest(campaignManifestPath(), completedCampaign);
    writeCalibrationManifest(evidenceCampaignPath(), completedCampaign);
    if (profiles.length === calibrationProfileIds(policy).length) writeCalibrationSummary(profiles.map((profileId) => verifyCalibrationReport(profileId, REPORT_DIR, policy, completedCampaign)), campaignResult);
    json({ ok: true, reports, campaign: campaignResult });
  } else if (command === "recompute-reports") {
    const campaign = evidenceCampaign();
    const migrateLegacy = args.includes("--migrate-legacy-campaign");
    const reports = profiles.map((profileId) => recomputeCalibrationReport(profileId, REPORT_DIR, policy, campaign, migrateLegacy, migrateLegacy ? readCheckpoint(checkpointPath(profileId))?.identity : null));
    if (profiles.length === calibrationProfileIds(policy).length) writeCalibrationSummary(reports, campaign.result);
    json({ ok: true, reports: reports.map((report) => ({ profile_id: report.collection_identity.profile_id, verdict: report.verdict })) });
  } else if (command === "verify-reports") {
    const campaign = evidenceCampaign();
    const reports = profiles.map((profileId) => verifyCalibrationReport(profileId, REPORT_DIR, policy, campaign));
    json({ ok: true, reports: reports.map((report) => ({ profile_id: report.collection_identity.profile_id, verdict: report.verdict, complete: report.complete })) });
  } else {
    throw new Error("usage: jev-profile-calibrate validate|dry-run-budget|run|resume|recompute-reports|verify-reports (--all|--profile <id>) [--repetitions 3] [--max-attempts 600] [--max-input-tokens 1500000] [--max-seconds 1500] [--live]");
  }
} catch (error) {
  process.stderr.write(`jev-profile-calibrate: ${error?.message || "unknown error"}\n`);
  process.exitCode = 2;
}
