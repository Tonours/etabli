#!/usr/bin/env bash
set -euo pipefail

WORKFLOW_DIR=".workflow"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
SESSIONS_DIR="${CODEX_SESSIONS_DIR:-${HOME}/.codex/sessions}"
JSON=0

usage() {
  cat <<EOF
Usage: workflow-metrics [--dir path] [--sessions-dir path] [--json]

Aggregate native and conservatively recovered outcome metrics, separately
reported runtime usage, and comparative harness validations. Runtime usage
never implies outcome success. Report both generic measurement coverage and
actual token-usage coverage.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dir)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      WORKFLOW_DIR="$2"
      shift
      ;;
    --json)
      JSON=1
      ;;
    --sessions-dir)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      SESSIONS_DIR="$2"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if ! command -v jq >/dev/null 2>&1; then
  printf 'missing jq; install jq to aggregate workflow metrics\n' >&2
  exit 2
fi

if [ ! -d "$WORKFLOW_DIR" ]; then
  if [ "$JSON" -eq 1 ]; then
    printf '{"runs":[],"totals":{"runs":0,"terminal_runs":0,"outcomes":0,"measurement_denominator":0,"measured_outcomes":0,"usage_measured_outcomes":0,"recovered_outcomes":0,"unmeasured_outcomes":0,"legacy_outcomes":0,"measurement_coverage":0,"usage_measurement_coverage":0,"successful_outcomes":0,"measured_successful_outcomes":0,"run_terminal_successful_outcomes":0,"task_grader_successful_outcomes":0,"participant_breakdown_outcomes":0,"batch_makespan_outcomes":0,"batch_makespan_ms":0,"total_tokens":0,"legacy_total_tokens":0,"successful_tokens":0,"tokens_per_successful_outcome":null,"verified_throughput_per_hour":null,"tool_calls":0,"elapsed_ms":0,"runtime_usage_records":0,"runtime_total_tokens":0,"runtime_elapsed_ms":0},"telemetry":{"population_events":0,"imported_events":0,"source_verified_imports":0,"unverified_imports":0,"recovered_outcomes":0,"duplicate_target_imports":0,"unmatched_imports":0,"populations":[]},"harness":{"proposed_candidates":0,"validated_candidates":0,"validated_proposals":0,"unmatched_validations":0,"accepted_candidates":0,"rejected_candidates":0,"validation_coverage":null,"candidates":[]}}\n'
  else
    printf 'no workflow runs found in %s\n' "$WORKFLOW_DIR"
  fi
  exit 0
fi

measurement_events="$(
  find "$WORKFLOW_DIR" -mindepth 2 -maxdepth 2 -name events.jsonl -type f -print |
    sort |
    while IFS= read -r file; do
      ledger_run="$(basename "$(dirname "$file")")"
      jq -c --arg ledger_run "$ledger_run" '
        select(.event == "outcome_measurement_population" or .event == "outcome_measurement_imported")
        | {event, detail, ledger_run: $ledger_run}
      ' "$file"
    done |
    jq -s .
)"
populations="$(printf '%s\n' "$measurement_events" | jq '[.[] | select(.event == "outcome_measurement_population") | .detail]')"
imports="$(printf '%s\n' "$measurement_events" | jq '[.[] | select(.event == "outcome_measurement_imported") | .detail]')"
verified_imports='[]'
population_records="$(printf '%s\n' "$measurement_events" | jq '[.[] | select(.event == "outcome_measurement_population")]')"
if [ "$(printf '%s\n' "$population_records" | jq 'length')" -eq 1 ]; then
  population_ledger="$(printf '%s\n' "$population_records" | jq -r '.[0].ledger_run')"
  population_id="$(printf '%s\n' "$population_records" | jq -r '.[0].detail.population_id')"
  population_manifest="$(printf '%s\n' "$population_records" | jq -r '.[0].detail.manifest_sha256')"
  if recovery_verification="$("$SCRIPT_DIR/workflow-telemetry-recover" --workflow-dir "$WORKFLOW_DIR" --sessions-dir "$SESSIONS_DIR" --ledger-run "$population_ledger" --dry-run --json 2>/dev/null)" &&
    printf '%s\n' "$recovery_verification" | jq -e --arg id "$population_id" --arg manifest "$population_manifest" '.population_id == $id and .manifest_sha256 == $manifest' >/dev/null; then
    verified_imports="$(printf '%s\n' "$recovery_verification" | jq '.verified_imports')"
  fi
fi

runs="$(
  find "$WORKFLOW_DIR" -mindepth 2 -maxdepth 2 -name events.jsonl -type f -print |
    sort |
    while IFS= read -r file; do
      run="$(basename "$(dirname "$file")")"
      jq -s --arg run "$run" --argjson imports "$imports" --argjson populations "$populations" --argjson verified_imports "$verified_imports" '
        def metric_events: [.[] | select(.event == "outcome_metric") | .detail];
        def runtime_usage_events: [.[] | select(.event == "multi_execution_completed" and .detail.usage.measured == true) | .detail.usage];
        def harness_proposal_events: [.[] | select(.event == "harness_proposal") | .detail];
        def harness_validation_events: [to_entries[] | select(.value.event == "harness_validation_completed") | (.value.detail + {_event_index: .key})];
        def tokens($m):
          if ($m.total_tokens? != null) then ($m.total_tokens | tonumber?)
          elif ($m.input_tokens? != null and $m.output_tokens? != null) then (($m.input_tokens | tonumber?) + ($m.output_tokens | tonumber?))
          else null end;
        def success($m): (($m.success == true) or (($m.outcome // "") | ascii_downcase | IN("success", "successful", "passed", "complete", "completed")));
        # Historical outcomes default to run_terminal; task_grader is opt-in via success_kind or grader_success.
        def is_task_grader($m): (($m.success_kind // "") == "task_grader") or ($m.grader_success == true);
        def is_run_terminal_success($m): success($m) and (is_task_grader($m) | not);
        def is_task_grader_success($m): success($m) and is_task_grader($m);
        def has_participant_usage($m): ($m.participant_usage | type == "array") and (($m.participant_usage | length) > 0);
        def batch_ms($m):
          if ($m.batch_wall_clock_ms? != null) then ($m.batch_wall_clock_ms | tonumber?)
          else null end;
        def matching_population_target($import):
          [$populations[]
            | select(.population_id == $import.population_id)
            | .targets[]
            | select(
                .target_run == $import.target_run and
                .target_ledger_sha256 == $import.target_ledger_sha256 and
                .target_terminal == $import.target_terminal and
                .target_terminal_event_sha256 == $import.target_terminal_event_sha256 and
                .target_outcome_event_sha256 == $import.target_outcome_event_sha256
              )]
          | length == 1;
        def valid_run_imports:
          [$imports[] | select(.target_run == $run)] as $run_imports
          | if ($run_imports | length) == 1 and matching_population_target($run_imports[0]) and
               ([$verified_imports[] | select(. == $run_imports[0])] | length) == 1
            then $run_imports
            else []
            end;
        def recovered_metric($import): {
          outcome: (if $import.success then "recovered success" else "recovered unsuccessful outcome" end),
          success: $import.success,
          measured: true,
          input_tokens: $import.input_tokens,
          output_tokens: $import.output_tokens,
          total_tokens: $import.total_tokens,
          tool_calls: $import.tool_calls,
          elapsed_ms: $import.elapsed_ms,
          _measurement_source: "recovered",
          _import_id: $import.import_id
        };
        def rate($result):
          if (($result.total // 0) > 0) then ($result.passed / $result.total) else null end;
        def delta_pp($comparison):
          (rate($comparison.baseline)) as $baseline
          | (rate($comparison.candidate)) as $candidate
          | if $baseline == null or $candidate == null then null else (($candidate - $baseline) * 100) end;
        metric_events as $native_metrics |
        ($native_metrics | map(select(.measured == true and tokens(.) != null))) as $native_usage_metrics |
        valid_run_imports as $run_imports |
        (if ($native_usage_metrics | length) == 0 and ($native_metrics | length) <= 1 and ($run_imports | length) == 1
         then [recovered_metric($run_imports[0])]
         else $native_metrics
         end) as $metrics |
        ($metrics | map(select(.measured == true))) as $measured_metrics |
        ($metrics | map(select(.measured == true and tokens(.) != null))) as $usage_measured_metrics |
        ($metrics | map(select(.measured == false))) as $unmeasured_metrics |
        ($metrics | map(select(has("measured") | not))) as $legacy_metrics |
        runtime_usage_events as $runtime_usage |
        (harness_proposal_events | map(.candidate) | unique) as $proposal_candidates |
        (harness_validation_events | sort_by(.candidate, ._event_index) | group_by(.candidate) | map(last)) as $validations |
        ($validations | map(.candidate) | unique) as $validation_candidates |
        (($proposal_candidates + $validation_candidates) | unique) as $candidate_names |
        ([$proposal_candidates[] as $candidate | select(($validation_candidates | index($candidate)) != null) | $candidate]) as $validated_proposals |
        ([$validation_candidates[] as $candidate | select(($proposal_candidates | index($candidate)) == null) | $candidate]) as $unmatched_validations |
        ([.[] | select(.event == "completed" or .event == "blocked")] | last // null) as $terminal |
        {
          run: $run,
          terminal: ($terminal.event // null),
          outcomes: ($metrics | length),
          measurement_denominator: (if ($metrics | length) == 0 and $terminal != null then 1 else ($metrics | length) end),
          measured_outcomes: ($measured_metrics | length),
          usage_measured_outcomes: ($usage_measured_metrics | length),
          recovered_outcomes: ($usage_measured_metrics | map(select(._measurement_source == "recovered")) | length),
          measurement_source: (
            if ($usage_measured_metrics | any(._measurement_source == "recovered")) then "recovered"
            elif ($native_usage_metrics | length) > 0 then "native"
            elif ($legacy_metrics | length) > 0 then "legacy"
            else "unmeasured"
            end
          ),
          unmeasured_outcomes: (if ($metrics | length) == 0 and $terminal != null then 1 else ($unmeasured_metrics | length) end),
          legacy_outcomes: ($legacy_metrics | length),
          successful_outcomes: ($metrics | map(select(success(.))) | length),
          # Productivity success = usage-measured task_grader only (G7: no run-terminal laundering).
          measured_successful_outcomes: ($usage_measured_metrics | map(select(is_task_grader_success(.))) | length),
          run_terminal_successful_outcomes: ($metrics | map(select(is_run_terminal_success(.))) | length),
          task_grader_successful_outcomes: ($metrics | map(select(is_task_grader_success(.))) | length),
          participant_breakdown_outcomes: ($usage_measured_metrics | map(select(is_task_grader_success(.) and has_participant_usage(.))) | length),
          # Makespan includes failed measured outcomes with batch_wall_clock_ms (blueprint §10.2).
          # Throughput numerator stays task_grader successes that carry batch_wall_clock_ms.
          batch_makespan_outcomes: ($usage_measured_metrics | map(select(is_task_grader_success(.) and (batch_ms(.) != null))) | length),
          batch_makespan_ms: ($usage_measured_metrics | map(batch_ms(.)) | map(select(. != null)) | add // 0),
          total_tokens: ($usage_measured_metrics | map(tokens(.)) | add // 0),
          legacy_total_tokens: ($legacy_metrics | map(tokens(.)) | map(select(. != null)) | add // 0),
          successful_tokens: ($usage_measured_metrics | map(select(is_task_grader_success(.)) | tokens(.)) | add // 0),
          tool_calls: ($usage_measured_metrics | map(.tool_calls // 0) | add // 0),
          elapsed_ms: ($usage_measured_metrics | map(.elapsed_ms // 0) | add // 0),
          runtime_usage_records: ($runtime_usage | length),
          runtime_total_tokens: ($runtime_usage | map(tokens(.)) | add // 0),
          runtime_elapsed_ms: ($runtime_usage | map(.elapsed_ms) | add // 0),
          harness: {
            proposed_candidates: ($proposal_candidates | length),
            validated_candidates: ($validation_candidates | length),
            validated_proposals: ($validated_proposals | length),
            unmatched_validations: ($unmatched_validations | length),
            accepted_candidates: ($validations | map(select(.verdict == "accepted")) | length),
            rejected_candidates: ($validations | map(select(.verdict == "rejected")) | length),
            validation_coverage: (
              if ($proposal_candidates | length) == 0
              then null
              else (($validated_proposals | length) / ($proposal_candidates | length))
              end
            ),
            candidates: (
              $candidate_names
              | map(
                  . as $candidate
                  | ($validations | map(select(.candidate == $candidate)) | last // null) as $validation
                  | if $validation == null
                    then {
                      candidate: $candidate,
                      verdict: null,
                      reason: null,
                      proposed: true,
                      held_in_delta_pp: null,
                      held_out_delta_pp: null,
                      checks: null,
                      evidence: null
                    }
                    else {
                      candidate: $validation.candidate,
                      verdict: $validation.verdict,
                      reason: $validation.reason,
                      proposed: (($proposal_candidates | index($validation.candidate)) != null),
                      held_in_delta_pp: delta_pp($validation.held_in),
                      held_out_delta_pp: delta_pp($validation.held_out),
                      checks: $validation.checks,
                      evidence: $validation.evidence
                    }
                    end
                )
            )
          }
        }
      ' "$file"
    done
)"

summary="$(
  printf '%s\n' "$runs" |
    jq -s --argjson imports "$imports" --argjson populations "$populations" --argjson verified_imports "$verified_imports" '
      def matching_population_target($import):
        [$populations[]
          | select(.population_id == $import.population_id)
          | .targets[]
          | select(
              .target_run == $import.target_run and
              .target_ledger_sha256 == $import.target_ledger_sha256 and
              .target_terminal == $import.target_terminal and
              .target_terminal_event_sha256 == $import.target_terminal_event_sha256 and
              .target_outcome_event_sha256 == $import.target_outcome_event_sha256
            )]
        | length == 1;
      def unique_target_import($import):
        [$imports[] | select(.target_run == $import.target_run)] | length == 1;
      def source_verified($import): [$verified_imports[] | select(. == $import)] | length == 1;
      def valid_import($import): matching_population_target($import) and unique_target_import($import) and source_verified($import);
      (sort_by(.run)) as $runs
      | {
          runs: $runs,
          totals: {
            runs: ($runs | length),
            terminal_runs: ($runs | map(select(.terminal != null)) | length),
            outcomes: ($runs | map(.outcomes) | add // 0),
            measurement_denominator: ($runs | map(.measurement_denominator) | add // 0),
            measured_outcomes: ($runs | map(.measured_outcomes) | add // 0),
            usage_measured_outcomes: ($runs | map(.usage_measured_outcomes) | add // 0),
            recovered_outcomes: ($runs | map(.recovered_outcomes) | add // 0),
            unmeasured_outcomes: ($runs | map(.unmeasured_outcomes) | add // 0),
            legacy_outcomes: ($runs | map(.legacy_outcomes) | add // 0),
            successful_outcomes: ($runs | map(.successful_outcomes) | add // 0),
            measured_successful_outcomes: ($runs | map(.measured_successful_outcomes) | add // 0),
            run_terminal_successful_outcomes: ($runs | map(.run_terminal_successful_outcomes // 0) | add // 0),
            task_grader_successful_outcomes: ($runs | map(.task_grader_successful_outcomes // 0) | add // 0),
            participant_breakdown_outcomes: ($runs | map(.participant_breakdown_outcomes // 0) | add // 0),
            batch_makespan_outcomes: ($runs | map(.batch_makespan_outcomes // 0) | add // 0),
            batch_makespan_ms: ($runs | map(.batch_makespan_ms // 0) | add // 0),
            total_tokens: ($runs | map(.total_tokens) | add // 0),
            legacy_total_tokens: ($runs | map(.legacy_total_tokens) | add // 0),
            successful_tokens: ($runs | map(.successful_tokens) | add // 0),
            tool_calls: ($runs | map(.tool_calls) | add // 0),
            elapsed_ms: ($runs | map(.elapsed_ms) | add // 0),
            runtime_usage_records: ($runs | map(.runtime_usage_records) | add // 0),
            runtime_total_tokens: ($runs | map(.runtime_total_tokens) | add // 0),
            runtime_elapsed_ms: ($runs | map(.runtime_elapsed_ms) | add // 0)
          },
          telemetry: {
            population_events: ($populations | length),
            imported_events: ($imports | length),
            source_verified_imports: ([$imports[] | select(source_verified(.))] | length),
            unverified_imports: ([$imports[] | select(source_verified(.) | not)] | length),
            recovered_outcomes: ($runs | map(.recovered_outcomes) | add // 0),
            duplicate_target_imports: (
              $imports | group_by(.target_run) | map(select(length > 1) | length) | add // 0
            ),
            unmatched_imports: ([$imports[] | select((matching_population_target(.) and unique_target_import(.)) | not)] | length),
            populations: (
              $populations
              | map(
                  . as $population
                  | ([.targets[] | select(.baseline_measured == true)] | length) as $baseline_measured
                  | ([.targets[] | select(.baseline_usage_measured == true)] | length) as $baseline_usage
                  | ([$imports[] | select(.population_id == $population.population_id and valid_import(.))] | length) as $recovered
                  | {
                      population_id: .population_id,
                      manifest_sha256: .manifest_sha256,
                      terminal_runs: .terminal_runs,
                      baseline_measured_outcomes: $baseline_measured,
                      baseline_usage_measured_outcomes: $baseline_usage,
                      recovered_outcomes: $recovered,
                      usage_measured_outcomes: ($baseline_usage + $recovered),
                      usage_measurement_coverage: (
                        if .terminal_runs == 0 then 0 else (($baseline_usage + $recovered) / .terminal_runs) end
                      )
                    }
                )
            )
          },
          harness: {
            proposed_candidates: ($runs | map(.harness.proposed_candidates) | add // 0),
            validated_candidates: ($runs | map(.harness.validated_candidates) | add // 0),
            validated_proposals: ($runs | map(.harness.validated_proposals) | add // 0),
            unmatched_validations: ($runs | map(.harness.unmatched_validations) | add // 0),
            accepted_candidates: ($runs | map(.harness.accepted_candidates) | add // 0),
            rejected_candidates: ($runs | map(.harness.rejected_candidates) | add // 0),
            candidates: [
              $runs[] as $run
              | $run.harness.candidates[]
              | . + {run: $run.run}
            ]
          }
        }
      | .totals.measurement_coverage =
        (if .totals.measurement_denominator == 0
         then 0
         else (.totals.measured_outcomes / .totals.measurement_denominator)
         end)
      | .totals.usage_measurement_coverage =
        (if .totals.measurement_denominator == 0
         then 0
         else (.totals.usage_measured_outcomes / .totals.measurement_denominator)
         end)
      | .totals.tokens_per_successful_outcome =
        (if .totals.measured_successful_outcomes == 0
         then null
         else (.totals.successful_tokens / .totals.measured_successful_outcomes)
         end)
      | .totals.verified_throughput_per_hour =
        (if (.totals.batch_makespan_ms // 0) == 0 or (.totals.batch_makespan_outcomes // 0) == 0
         then null
         else ((.totals.batch_makespan_outcomes) / (.totals.batch_makespan_ms / 3600000))
         end)
      | .harness.validation_coverage =
        (if .harness.proposed_candidates == 0
         then null
         else (.harness.validated_proposals / .harness.proposed_candidates)
         end)'
)"

if [ "$JSON" -eq 1 ]; then
  printf '%s\n' "$summary"
  exit 0
fi

printf '%s\n' "$summary" |
  jq -r '. as $summary | $summary.totals | "runs=\(.runs)\nterminal_runs=\(.terminal_runs)\noutcomes=\(.outcomes)\nmeasurement_denominator=\(.measurement_denominator)\nmeasured_outcomes=\(.measured_outcomes)\nusage_measured_outcomes=\(.usage_measured_outcomes)\nrecovered_outcomes=\(.recovered_outcomes)\nunmeasured_outcomes=\(.unmeasured_outcomes)\nlegacy_outcomes=\(.legacy_outcomes)\nmeasurement_coverage=\(.measurement_coverage)\nusage_measurement_coverage=\(.usage_measurement_coverage)\nsuccessful_outcomes=\(.successful_outcomes)\ntokens_per_successful_outcome=\(.tokens_per_successful_outcome // "n/a")\nparticipant_breakdown_outcomes=\(.participant_breakdown_outcomes)\nbatch_makespan_outcomes=\(.batch_makespan_outcomes)\nverified_throughput_per_hour=\(.verified_throughput_per_hour // "n/a")\ntotal_tokens=\(.total_tokens)\nlegacy_total_tokens=\(.legacy_total_tokens)\ntool_calls=\(.tool_calls)\nelapsed_ms=\(.elapsed_ms)\nruntime_usage_records=\(.runtime_usage_records)\nruntime_total_tokens=\(.runtime_total_tokens)\nruntime_elapsed_ms=\(.runtime_elapsed_ms)\ntelemetry_population_events=\($summary.telemetry.population_events)\ntelemetry_imported_events=\($summary.telemetry.imported_events)\ntelemetry_source_verified_imports=\($summary.telemetry.source_verified_imports)\ntelemetry_unverified_imports=\($summary.telemetry.unverified_imports)\ntelemetry_unmatched_imports=\($summary.telemetry.unmatched_imports)\nharness_proposed_candidates=\($summary.harness.proposed_candidates)\nharness_validated_candidates=\($summary.harness.validated_candidates)\nharness_validated_proposals=\($summary.harness.validated_proposals)\nharness_unmatched_validations=\($summary.harness.unmatched_validations)\nharness_accepted_candidates=\($summary.harness.accepted_candidates)\nharness_rejected_candidates=\($summary.harness.rejected_candidates)\nharness_validation_coverage=\($summary.harness.validation_coverage // "n/a")"'
