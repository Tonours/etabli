#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
MANIFEST="$ROOT_DIR/workflow/runtime/agentic-infra-checks.tsv"

run_check() {
  local label="$1"
  shift
  local started=$SECONDS
  printf 'RUN  %s\n' "$label"
  if "$@"; then
    printf 'PASS %s (%ss)\n' "$label" "$((SECONDS - started))"
  else
    local status=$?
    printf 'FAIL %s (%ss)\nRemediation: run the displayed command directly, fix the reported failures, then rerun this group.\n' "$label" "$((SECONDS - started))" >&2
    return "$status"
  fi
}

shell_syntax() {
  # One xargs-driven pass: the shebang prefilter is a shell-builtin read
  # (was: a head+grep fork pair per file), and bash -n runs concurrently.
  local parallel
  parallel="$(sysctl -n hw.ncpu 2>/dev/null || echo 4)"
  find "$ROOT_DIR/scripts" "$ROOT_DIR/tests" -type f -print0 |
    xargs -0 -n 16 -P "$parallel" bash -c '
      err=0
      for file do
        IFS= read -r shebang <"$file" || shebang=""
        case "$shebang" in
          \#!*) ;;
          *) continue ;;
        esac
        case "$shebang" in
          *bash*|*sh*) ;;
          *) continue ;;
        esac
        if ! bash -n "$file"; then
          printf "syntax error in %s\n" "$file" >&2
          err=1
        fi
      done
      exit "$err"
    ' _
  local status=$?
  return "$status"
}

json_config() {
  jq empty \
    "$ROOT_DIR/pi/settings.json" \
    "$ROOT_DIR/pi/agent/settings.json" \
    "$ROOT_DIR/pi/models.json" \
    "$ROOT_DIR/workflow/runtime-capabilities.json"
}

pi_import_smoke() {
  cd "$ROOT_DIR/pi"
  bun -e 'for (const path of [
    "./extensions/workflow-router.ts",
    "./extensions/filter-output.ts",
    "./extensions/prefer-ipv4-dns.ts",
    "./extensions/rtk.ts",
  ]) await import(path)'
}

run_target() {
  local target="$1"
  case "$target" in
    builtin:shell-syntax) shell_syntax ;;
    builtin:json-config) json_config ;;
    builtin:validate-adrs) node "$ROOT_DIR/scripts/validate-adrs" ;;
    builtin:pi-audit) bash -c "cd '$ROOT_DIR/pi' && bun audit" ;;
    builtin:pi-tests) bash -c "cd '$ROOT_DIR/pi' && bun test ./extensions/__tests__/*.test.ts" ;;
    builtin:router-eval) "$ROOT_DIR/scripts/router-eval" --min-accuracy 1 --require-alignment ;;
    builtin:skill-lock) bash -c "cd '$ROOT_DIR/pi' && bun run verify:skills" ;;
    builtin:pi-import-smoke) pi_import_smoke ;;
    tests/*.sh) bash "$ROOT_DIR/$target" ;;
    *) printf 'Unknown agentic-infra target: %s\n' "$target" >&2; return 2 ;;
  esac
}

run_selection() {
  local selection_kind="$1"
  local selection="$2"
  local found=0
  local failed=0
  local passed=0
  local profile group label target failures="" out

  local idx=0
  local -a pids=() outs=() labels=()
  local out_root
  out_root="$(mktemp -d "${TMPDIR:-/tmp}/agentic-infra.XXXXXX")"

  # Checks run concurrently, but oversubscribing the machine starves
  # wall-clock-sensitive checks (e.g. the obvault metadata resolver's spawn
  # budget), so concurrency is capped a couple of slots below the core count.
  local max_jobs
  max_jobs="${AGENTIC_INFRA_JOBS:-$(($(sysctl -n hw.ncpu 2>/dev/null || echo 10) - 2))}"
  [ "$max_jobs" -ge 1 ] || max_jobs=1
  local slots="$out_root/slots"
  mkfifo "$slots"
  exec 9<>"$slots"
  local slot
  for ((slot = 0; slot < max_jobs; slot++)); do printf 'x' >&9; done

  while IFS=$'\t' read -r profile group label target; do
    case "$selection_kind:$selection" in
      profile:core) [ "$profile" = "core" ] || continue ;;
      profile:full) [ "$profile" = "core" ] || [ "$profile" = "full" ] || continue ;;
      profile:live) [ "$profile" = "live" ] || continue ;;
      group:*)
        if [ "$group" != "$selection" ] || [ "$profile" = "live" ]; then
          continue
        fi
        ;;
      *) printf 'Unknown selection: %s %s\n' "$selection_kind" "$selection" >&2; return 2 ;;
    esac
    found=1
    # Checks are independent (each works inside its own mktemp tree and only
    # reads the repo), so they run concurrently; per-check output is buffered
    # and replayed in manifest order to keep the report deterministic.
    out="$out_root/$idx.out"
    IFS= read -r -n1 <&9
    (
      status=0
      run_check "$label" run_target "$target" || status=$?
      printf 'x' >&9
      exit "$status"
    ) >"$out" 2>&1 &
    pids+=("$!")
    outs+=("$out")
    labels+=("$label")
    idx=$((idx + 1))
  done < <(sed '/^#/d; /^$/d' "$MANIFEST")
  exec 9>&-

  local status i
  for i in "${!pids[@]}"; do
    status=0
    wait "${pids[$i]}" || status=$?
    cat "${outs[$i]}"
    if [ "$status" -eq 0 ]; then
      passed=$((passed + 1))
    else
      failed=$((failed + 1))
      failures="$failures ${labels[$i]}"
    fi
  done
  rm -rf "$out_root"

  [ "$found" -eq 1 ] || {
    printf 'No checks configured for agentic-infra %s: %s\n' "$selection_kind" "$selection" >&2
    return 2
  }

  if [ "$failed" -gt 0 ]; then
    printf 'SUMMARY: %d/%d checks failed:%s\n' "$failed" "$((failed + passed))" "$failures" >&2
    return 1
  fi
  printf 'SUMMARY: %d/%d checks passed\n' "$passed" "$passed"
}

run_live() {
  if [ "${RUN_AGENT_CLI_SMOKE:-}" != "1" ] || [ "${RUN_REAL_AGENT_SCENARIOS:-}" != "1" ] || [ "${RUN_SKILL_RUNTIME_CANARY:-}" != "1" ]; then
    printf 'SKIP live agent proof: set RUN_AGENT_CLI_SMOKE=1, RUN_REAL_AGENT_SCENARIOS=1, and RUN_SKILL_RUNTIME_CANARY=1\n'
    printf 'live_agent_proof: skipped\n'
    return 3
  fi

  if run_selection profile live; then
    printf 'live_agent_proof: ran\n'
    return 0
  fi
  local status=$?
  printf 'live_agent_proof: ran\n'
  return "$status"
}

case "${1:-all}" in
  core) run_selection profile core ;;
  full|all) run_selection profile full ;;
  live) run_live ;;
  shell-docs|pi|nvim) run_selection group "$1" ;;
  *) printf 'Usage: verify-agentic-infra [core|full|live|shell-docs|pi|nvim|all]\n' >&2; exit 2 ;;
esac
