#!/usr/bin/env node
import { closeSync, constants, fstatSync, openSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import { evaluateSelfImprovementDiagnosis, evaluateSemanticProfile, loadSemanticProfilePolicy, prepareSelfImprovementDiagnosisRequest, profileSummary } from "../pi/extensions/lib/semantic-profiles.mjs";
import { suggestSkill } from "../pi/extensions/lib/semantic-skill-suggestion.mjs";
import { prepareClaimEvidenceState } from "../pi/extensions/lib/semantic-claim-evidence.mjs";
import { analyzeTraceEpisode, readBoundedRegularFile } from "./lib/harness-trace-retrospect.mjs";

import { evaluateClaimBatch } from "./lib/jev-claim-batch.mjs";
import { reviewFindings, reviewObligations, groupFindings, rankReviewEvidence } from "./lib/jev-review.mjs";

import { jevHealth, summarizeJevObservations } from "./lib/jev-health.mjs";

const command = process.argv[2] || "health";
const args = process.argv.slice(3);

function json(value) {
  process.stdout.write(`${JSON.stringify(value)}\n`);
}

function option(name) {
  const index = args.indexOf(name);
  return index >= 0 ? args[index + 1] : null;
}

function has(name) {
  return args.includes(name);
}

function boundedFile(path, maxBytes = 65536) {
  if (!path) throw new Error("input file required");
  const absolute = resolve(path);
  let descriptor;
  try {
    descriptor = openSync(absolute, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
    const stat = fstatSync(descriptor);
    if (!stat.isFile()) throw new Error("input must be a regular non-symlink file");
    if (stat.size > maxBytes) throw new Error("input file too large");
    return readFileSync(descriptor, "utf8");
  } catch (error) {
    if (error?.code === "ELOOP") throw new Error("input must be a regular non-symlink file");
    throw error;
  } finally {
    if (descriptor !== undefined) closeSync(descriptor);
  }
}

function requireLive() {
  if (!has("--live")) throw new Error("provider evaluation requires explicit --live");
}

function candidateExecution() {
  if (has("--fixture-response")) {
    if (has("--live")) throw new Error("fixture and live modes are mutually exclusive");
    const fixture=JSON.parse(boundedFile(option("--fixture-response"), 1_048_576));
    const responses=Array.isArray(fixture)?fixture:[fixture];
    let index=0;
    return {allowProviderEgress:true,provider:async()=>{
      if(index>=responses.length) throw new Error("fixture response exhausted");
      return responses[index++];
    }};
  }
  requireLive();
  return {allowProviderEgress:true};
}

function publicResult(result) {
  return {
    profile: result.profile,
    authority: result.authority,
    decisions: result.decisions,
    outcome: result.outcome,
    error_code: result.error_code,
    receipt: result.receipt
  };
}

function canaryObservation() {
  const traceText = readBoundedRegularFile(option("--trace-file"));
  const ledgerText = readBoundedRegularFile(option("--ledger"));
  const run = option("--run");
  const observation = analyzeTraceEpisode({ adapter: "pi", traceText, ledgerText, run });
  if (observation.binding !== "native_correlated" || observation.completeness !== "complete" || observation.reason_codes.length !== 0) throw new Error("canary observation ineligible");
  return observation;
}

function publicCanary(result, mode) {
  return {
    schema_version: 1,
    canary: "self_improvement_diagnosis",
    mode,
    binding: "native_correlated",
    completeness: "complete",
    profile: "self-improvement-diagnosis",
    authority: "diagnostic",
    status: result?.status ?? "prepared",
    diagnosis: result?.diagnosis ?? null,
    reason: result?.reason ?? null,
    provider: result?.provenance?.provider ?? null,
    model: result?.provenance?.model ?? null,
  };
}

function publicDiagnosis(result) {
  return {
    schema_version: result.schema_version,
    profile_id: result.profile_id,
    authority: result.authority,
    status: result.status,
    diagnosis: result.diagnosis,
    reason: result.reason ?? null,
    provenance: result.provenance ? {
      provider: result.provenance.provider,
      model: result.provenance.model,
      policy_version: result.provenance.policy_version,
      catalog_version: result.provenance.catalog_version,
    } : null,
  };
}

try {
  const policy = loadSemanticProfilePolicy();
  const requestPolicy = has("--no-retry") ? { ...policy, max_retries: 0 } : policy;
  if (command === "health") {
    json(jevHealth({ noRetry: has("--no-retry") }));
  } else if (command === "observations") {
    json(summarizeJevObservations(boundedFile(option("--events-file"), 4_194_304).split("\n").filter(Boolean).map((line) => JSON.parse(line))));
  } else if (command === "list") {
    json({ profiles: profileSummary(policy) });
  } else if (command === "show") {
    const id = args[0];
    if (!policy.profiles[id]) throw new Error(`unknown profile: ${id || "<missing>"}`);
    json({ id, ...policy.profiles[id] });
  } else if (command === "evaluate") {
    const profileId = args[0];
    if (profileId === "self-improvement-diagnosis") throw new Error("self-improvement diagnosis requires the dedicated diagnosis command");
    if (!policy.profiles[profileId] || policy.profiles[profileId].builder || profileId === "claim-evidence") throw new Error("evaluate requires a static non-claim profile id");
    requireLive();
    const state = JSON.parse(boundedFile(option("--state-file")));
    json(publicResult(await evaluateSemanticProfile({ profileId, state, policy, allowProviderEgress: true, persistReceipt: !has("--no-receipt") })));
  } else if (["review-findings", "review-obligations", "review-groups", "review-evidence"].includes(command)) {
    const execution = candidateExecution();
    const input = JSON.parse(boundedFile(option("--state-file"), 1_048_576));
    const evaluate = { "review-findings": reviewFindings, "review-obligations": reviewObligations, "review-groups": groupFindings, "review-evidence": rankReviewEvidence }[command];
    const fields = { "review-findings": ["findings", "pack", "batchSize"], "review-obligations": ["obligations", "pack"],
      "review-groups": ["findings"], "review-evidence": ["candidates", "purpose"] }[command];
    const data = Object.fromEntries(fields.filter(key => Object.hasOwn(input, key)).map(key => [key, input[key]]));
    json(await evaluate({ ...data, ...execution }));
  } else if (command === "evaluate-claims" || (command === "evaluate-claim" && has("--candidate-v2"))) {
    const execution = candidateExecution();
    const raw = command === "evaluate-claims" ? option("--claim-indices") : option("--claim-index");
    if (!/^(?:0|[1-9]\d*)(?:,(?:0|[1-9]\d*))*$/.test(raw || "")) throw new Error("explicit claim indices required");
    json(await evaluateClaimBatch({ claimsFile: option("--claims-file"), claimIndices: raw.split(",").map(Number),
      cwd: option("--root") || process.cwd(), conclusion: option("--conclusion"),
      evidenceText: option("--evidence-file") ? boundedFile(option("--evidence-file"),6500) : null, ...execution }));
  } else if (command === "evaluate-claim") {
    requireLive();
    const claimsFile = option("--claims-file");
    const claimIndexValue = option("--claim-index");
    if (!/^(?:0|[1-9]\d*)$/.test(claimIndexValue || "")) throw new Error("claim index must be an explicit non-negative integer");
    const claimIndex = Number(claimIndexValue);
    const evidenceFile = option("--evidence-file");
    const state = prepareClaimEvidenceState({ claimsFile, claimIndex, evidenceText: evidenceFile ? boundedFile(evidenceFile, 6500) : null });
    json(publicResult(await evaluateSemanticProfile({ profileId: "claim-evidence", state, policy, allowProviderEgress: true, persistReceipt: !has("--no-receipt") })));
  } else if (command === "suggest-skill") {
    requireLive();
    const prompt = boundedFile(option("--prompt-file"), 4096);
    const result = await suggestSkill({ prompt, policy, allowProviderEgress: true, persistReceipt: !has("--no-receipt") });
    json({ selected: result.selected, shortlist: result.shortlist, outcome: result.outcome, stages: result.stages.map(publicResult) });
  } else if (command === "prepare-self-improvement") {
    const observation = JSON.parse(boundedFile(option("--observation-file")));
    json(prepareSelfImprovementDiagnosisRequest(observation, policy));
  } else if (command === "diagnose-self-improvement") {
    requireLive();
    const observation = JSON.parse(boundedFile(option("--observation-file")));
    json(publicDiagnosis(await evaluateSelfImprovementDiagnosis({ observation, policy: requestPolicy, allowProviderEgress: true, persistReceipt: !has("--no-receipt") })));
  } else if (command === "canary-self-improvement") {
    const observation = canaryObservation();
    if (!has("--live")) {
      prepareSelfImprovementDiagnosisRequest(observation, policy);
      json(publicCanary(null, "prepared"));
    } else {
      const result = await evaluateSelfImprovementDiagnosis({ observation, policy, allowProviderEgress: true, persistReceipt: false });
      json(publicCanary(result, "live"));
    }
  } else {
    throw new Error("usage: jev-judge review-findings|review-obligations|review-groups|review-evidence --state-file FILE (--fixture-response FILE|--live); evaluate-claims --claims-file FILE --claim-indices 0,2 --root DIR (--fixture-response FILE|--live); observations --events-file FILE; health|list|show <profile>|evaluate <profile> --state-file <file> --live [--no-receipt]|evaluate-claim --claims-file <markdown> --claim-index <n> [--evidence-file <file>] --live [--no-receipt]|suggest-skill --prompt-file <file> --live [--no-receipt]|prepare-self-improvement --observation-file <file>|diagnose-self-improvement --observation-file <file> --live [--no-retry] [--no-receipt]|canary-self-improvement --trace-file <file> --ledger <file> --run <slug> [--live]");
  }
} catch (error) {
  if (command === "canary-self-improvement") {
    process.stderr.write("jev-judge: canary_unavailable\n");
    process.exitCode = 2;
  } else {
  process.stderr.write(`jev-judge: ${error?.message || "unknown error"}\n`);
  process.exitCode = 2;
  }
}
