#!/usr/bin/env bash
set -euo pipefail
SCRIPT_REAL="$(node -e 'process.stdout.write(require("node:fs").realpathSync(process.argv[1]))' "${BASH_SOURCE[0]}")"
ETABLI_ROOT="$(cd -- "$(dirname -- "$SCRIPT_REAL")/.." && pwd)"
PROFILE="$ETABLI_ROOT/pi/profiles/gemma-orchestrator"
PI_BIN="${GEMMA_PI_BIN:-$(command -v pi || true)}"
test -n "$PI_BIN" || { printf '%s\n' 'Pi not found; install pi or set GEMMA_PI_BIN.' >&2; exit 1; }
EXPECT_TARGET=0
for argument in "$@"; do
  if [ "$EXPECT_TARGET" -eq 1 ]; then
    [[ "$argument" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.@-]{0,127}$ ]] || { printf '%s\n' 'invalid_target: use local or a configured SSH alias.' >&2; exit 1; }
    EXPECT_TARGET=0
    continue
  fi
  case "$argument" in
    --gemma-target) EXPECT_TARGET=1; continue ;;
    --gemma-target=*) TARGET_VALUE="${argument#*=}"; [[ "$TARGET_VALUE" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.@-]{0,127}$ ]] || { printf '%s\n' 'invalid_target: use local or a configured SSH alias.' >&2; exit 1; }; continue ;;
  esac
  case "${argument%%=*}" in
    --model|--models|--provider|--tools|-t|--exclude-tools|-xt|--no-tools|-nt|--skill|--prompt-template|--extension|-e|--system-prompt|--append-system-prompt)
      printf '%s\n' 'Model, tools and system prompt are fixed in this profile; use ordinary pi for another loadout.' >&2; exit 1 ;;
  esac
done
[ "$EXPECT_TARGET" -eq 0 ] || { printf '%s\n' 'invalid_target: --gemma-target needs an alias.' >&2; exit 1; }
test -f "$PROFILE/extension.ts" && test -r "$PROFILE/system.md" || { printf '%s\n' 'Gemma profile missing; restore pi/profiles/gemma-orchestrator.' >&2; exit 1; }
export PI_OFFLINE=1
export PI_CODING_AGENT_DIR="${GEMMA_PROFILE_DIR:-$HOME/Library/Application Support/gemma-orchestrator/orchestration/pi}"
test -f "$PI_CODING_AGENT_DIR/settings.json" && test -r "$PI_CODING_AGENT_DIR/models.json" || { printf '%s\n' 'Gemma profile is not installed; see pi/profiles/gemma-orchestrator/README.md.' >&2; exit 1; }
exec "$PI_BIN" --offline --no-extensions --no-mcp --no-skills --no-context-files --no-prompt-templates --no-builtin-tools \
  --tools execute,read_file,write_file,open_page,finish_task --extension "$PROFILE/extension.ts" \
  --system-prompt "$PROFILE/system.md" --model macmini-gemma/gemma-4-e4b --models macmini-gemma/gemma-4-e4b --thinking low "$@"
