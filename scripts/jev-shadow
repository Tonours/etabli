#!/usr/bin/env node
import { lstatSync, readFileSync, renameSync, unlinkSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { runRouteDecision, loadSemanticPolicy, promotionRuntimeFingerprint, summarizeCalibrationResults, validateRuntimePolicy } from "../pi/extensions/lib/route-shadow.mjs";
import { fingerprint } from "../pi/extensions/lib/semantic-judgment.mjs";
import { isProtectedChoice, routeQuestionFingerprint, semanticChoiceForDecision } from "../pi/extensions/lib/semantic-route.mjs";
import { TYPESAFE_TRANSPORT } from "../pi/extensions/lib/typesafe-system-one.mjs";
import { classifyWorkflowRoute } from "../workflow/runtime/workflow-router-core.mjs";

const command = process.argv[2] || "health";
const json = (value) => process.stdout.write(`${JSON.stringify(value)}\n`);
const ROOT = resolve(import.meta.dirname, "..");

function calibrationPolicy() {
  const policy = JSON.parse(readFileSync(resolve(ROOT, "workflow/runtime/semantic-judgment-policy.json"), "utf8"));
  return { ...validateRuntimePolicy(policy), mode: "enforced", promotion: { validated: true } };
}

function writePromotionManifest(path, manifest) {
  const expected = resolve(ROOT, "workflow/runtime/jev-route-promotion.json");
  const destination = resolve(path);
  if (destination !== expected || lstatSync(destination).isSymbolicLink()) throw new Error("invalid promotion manifest output");
  const temporary = `${destination}.tmp-${process.pid}`;
  try {
    writeFileSync(temporary, `${JSON.stringify(manifest, null, 2)}\n`, { mode: 0o644, flag: "wx" });
    renameSync(temporary, destination);
  } finally {
    try { unlinkSync(temporary); } catch (error) { if (error?.code !== "ENOENT") throw error; }
  }
}

async function evaluate(input, overrides = {}) {
  if (!input || typeof input !== "object" || typeof input.prompt !== "string" || !input.prompt.trim()) throw new Error("invalid input");
  const decision = input.deterministicDecision || { route: input.deterministic_route || "answer", writeAllowed: Boolean(input.deterministic_write_allowed) };
  return runRouteDecision({ prompt: input.prompt, deterministicDecision: decision, planStatus: input.plan_status || "missing", cwd: process.env.ETABLI_RECEIPT_ROOT || process.cwd(), provider: overrides.provider, policy: overrides.policy, persistReceipt: overrides.persistReceipt });
}

function syntheticProvider(prediction) {
  return async (request) => {
    const routes = Object.keys(request.questions.route.criteria);
    if (!routes.includes(prediction.choice)) throw new Error("fixture choice outside route set");
    const remainder = (1 - prediction.confidence) / (routes.length - 1);
    const probabilities = Object.fromEntries(routes.map((route) => [route, route === prediction.choice ? prediction.confidence : remainder]));
    return { model: request.model, answers: { route: { type: "choice", choice: prediction.choice, probabilities, confidence: prediction.confidence } }, usage: prediction.usage };
  };
}

function calibrationObservations(results) {
  const bins = [[0, 0.5], [0.5, 0.75], [0.75, 1.000001]];
  return bins.map(([min, max]) => {
    const values = results.filter((item) => item.probabilities[item.prediction] >= min && item.probabilities[item.prediction] < max);
    return { range: [min, Math.min(max, 1)], count: values.length, mean_probability: values.length ? values.reduce((sum, item) => sum + item.probabilities[item.prediction], 0) / values.length : null, observed_accuracy: values.length ? values.filter((item) => item.correct).length / values.length : null };
  });
}

function percentile(values, fraction) {
  if (!values.length) return 0;
  const sorted = [...values].sort((a, b) => a - b);
  return sorted[Math.min(sorted.length - 1, Math.ceil(sorted.length * fraction) - 1)];
}

if (command === "health") {
  const policy = loadSemanticPolicy();
  json({ ok: true, mode: policy.mode, mode_source: "locked_policy", provider: policy.provider, model: policy.model, execution: TYPESAFE_TRANSPORT.execution, cache: TYPESAFE_TRANSPORT.cache, credential: process.env.TYPESAFE_API_KEY ? "present" : "absent" });
} else if (command === "evaluate") {
  let body = "";
  for await (const chunk of process.stdin) body += chunk;
  json(await evaluate(JSON.parse(body)));
} else if (command === "corpus") {
  const corpus = JSON.parse(readFileSync(resolve(process.argv[3] || "tests/fixtures/jev-shadow/route-corpus.json"), "utf8"));
  const policy = { ...calibrationPolicy(), mode: "shadow" };
  const results = [];
  for (const item of corpus.cases) {
    const result = await evaluate({ prompt: item.prompt, deterministic_route: item.expected }, { provider: syntheticProvider(item.prediction), policy, persistReceipt: false });
    const answer = result.receipt.shadow_answer;
    results.push({ id: item.id, expected: item.expected, selected: result.selected.route, prediction: answer.choice, probabilities: answer.probabilities, confidence: answer.confidence, correct: answer.choice === item.expected, outcome: result.receipt.outcome, latency_ms: item.prediction.latency_ms, usage: result.receipt.usage });
  }
  const errors = results.filter((item) => ["abstain", "low_confidence"].includes(item.outcome)).length;
  const agreements = results.filter((item) => item.outcome === "agree").length;
  const latencies = results.map((item) => item.latency_ms);
  json({ schema_version: 1, model: corpus.model, policy_version: corpus.policy_version, synthetic: true, total: results.length, agreement_rate: results.length ? agreements / results.length : 0, abstention_error_rate: results.length ? errors / results.length : 0, latency_ms: { mean: latencies.length ? latencies.reduce((sum, value) => sum + value, 0) / latencies.length : 0, p95: percentile(latencies, 0.95) }, calibration_observations: calibrationObservations(results), results });
} else if (command === "calibrate-live") {
  if (!process.argv.includes("--live")) throw new Error("live calibration requires --live");
  const corpusPath = resolve(process.argv[3] || "tests/fixtures/jev-shadow/live-route-corpus.json");
  const corpus = JSON.parse(readFileSync(corpusPath, "utf8"));
  const policy = calibrationPolicy();
  const repetitions = Number(process.env.ETABLI_CALIBRATION_REPETITIONS || 1);
  if (!Number.isInteger(repetitions) || repetitions < 1 || repetitions > 10) throw new Error("invalid calibration repetitions");
  const results = [];
  for (let run = 1; run <= repetitions; run += 1) {
    for (const item of corpus.cases) {
      const deterministicDecision = classifyWorkflowRoute(item.prompt, { planStatus: item.plan_status || "missing" });
      const deterministicChoice = semanticChoiceForDecision(deterministicDecision);
      if (Boolean(item.protected) !== isProtectedChoice(deterministicChoice)) throw new Error(`protected annotation mismatch: ${item.id}`);
      const result = await evaluate({
        prompt: item.prompt,
        deterministicDecision,
        plan_status: item.plan_status,
      }, { policy, persistReceipt: false });
      const answer = result.receipt.shadow_answer;
      results.push({
        id: item.id,
        run,
        expected: item.expected,
        deterministic_choice: deterministicChoice,
        prediction: answer?.choice ?? null,
        probabilities: answer?.probabilities ?? null,
        confidence: answer?.confidence ?? null,
        correct: answer?.choice === item.expected,
        accepted_by_threshold: ["semantic_agreement", "semantic_override"].includes(result.receipt.selection_reason),
        selection_reason: result.receipt.selection_reason,
        protected: isProtectedChoice(deterministicChoice),
        protected_preserved: !isProtectedChoice(deterministicChoice) || result.receipt.selection_reason === "protected_deterministic_route",
        latency_ms: result.receipt.latency_ms,
        usage: result.receipt.usage,
        error_code: result.receipt.error_code,
      });
    }
  }
  const metrics = summarizeCalibrationResults(results);
  const manifest = {
    schema_version: 1,
    evidence_kind: "live_typesafe",
    synthetic: false,
    generated_at: new Date().toISOString(),
    repetitions,
    policy_version: policy.policy_version,
    model: policy.model,
    corpus_path: process.argv[3] || "tests/fixtures/jev-shadow/live-route-corpus.json",
    corpus_fingerprint: fingerprint(corpus),
    question_fingerprint: routeQuestionFingerprint(policy.allowed_routes),
    runtime_fingerprint: promotionRuntimeFingerprint(policy),
    allowed_routes: policy.allowed_routes,
    thresholds: policy.decision_thresholds,
    metrics,
    gates: policy.promotion_gates,
    passed: metrics.unique_cases >= policy.promotion_gates.min_cases && repetitions >= policy.promotion_gates.min_repetitions && metrics.accuracy >= policy.promotion_gates.min_accuracy && metrics.accepted_accuracy >= policy.promotion_gates.min_accepted_accuracy && metrics.accepted_coverage >= policy.promotion_gates.min_accepted_coverage && metrics.override_cases >= policy.promotion_gates.min_override_cases && metrics.override_accuracy >= policy.promotion_gates.min_override_accuracy && metrics.accepted_override_accuracy >= policy.promotion_gates.min_accepted_override_accuracy && metrics.accepted_override_coverage >= policy.promotion_gates.min_accepted_override_coverage && metrics.protected_safety_rate >= policy.promotion_gates.min_protected_safety_rate && metrics.provider_error_rate <= policy.promotion_gates.max_provider_error_rate && metrics.stable_case_rate >= policy.promotion_gates.min_stable_case_rate && metrics.brier_score <= policy.promotion_gates.max_brier_score && metrics.expected_calibration_error <= policy.promotion_gates.max_expected_calibration_error && metrics.input_cost_usd <= policy.promotion_gates.max_input_cost_usd && metrics.latency_p95_ms <= policy.promotion_gates.max_latency_p95_ms,
    protected_choices: policy.allowed_routes.filter(isProtectedChoice),
    results,
  };
  const outputIndex = process.argv.indexOf("--output");
  if (outputIndex !== -1) {
    if (!manifest.passed) throw new Error("live calibration did not pass promotion gates");
    const outputPath = process.argv[outputIndex + 1];
    if (!outputPath) throw new Error("missing promotion manifest output path");
    writePromotionManifest(outputPath, manifest);
  }
  json(manifest);
} else {
  process.stderr.write("usage: scripts/jev-shadow health|evaluate|corpus|calibrate-live [file] --live [--output workflow/runtime/jev-route-promotion.json]\n");
  process.exitCode = 2;
}
