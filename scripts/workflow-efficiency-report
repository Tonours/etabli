#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
JSON=0

usage() {
  cat <<EOF
Usage: $(basename "$0") [--json]

Report read-only workflow-layer size, duplication, and smoke coverage metrics.

Options:
  --json     Emit one JSON object
  -h, --help Show this help
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json)
      JSON=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

line_count() {
  wc -l < "$ROOT_DIR/$1" | tr -d ' '
}

char_count() {
  wc -c < "$ROOT_DIR/$1" | tr -d ' '
}

estimated_tokens() {
  local chars
  chars="$(char_count "$1")"
  printf '%s\n' $(((chars + 3) / 4))
}

total_lines() {
  local total=0
  local path

  for path in "$@"; do
    total=$((total + $(line_count "$path")))
  done

  printf '%s\n' "$total"
}

paths_with_lines_json() {
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    [ -f "$ROOT_DIR/$path" ] || continue
    printf '%s\t%s\n' "$path" "$(line_count "$path")"
  done | jq -Rn '[inputs | split("\t") | {path: .[0], lines: (.[1] | tonumber)}]'
}

paths_with_budget_json() {
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    [ -f "$ROOT_DIR/$path" ] || continue
    printf '%s\t%s\t%s\t%s\n' \
      "$path" \
      "$(line_count "$path")" \
      "$(char_count "$path")" \
      "$(estimated_tokens "$path")"
  done | jq -Rn '[inputs | split("\t") | {path: .[0], lines: (.[1] | tonumber), chars: (.[2] | tonumber), estimated_tokens: (.[3] | tonumber)}]'
}

status_line() {
  local metric="$1"
  local value="$2"
  printf '%-30s %s\n' "$metric" "$value"
}

instruction_budget_baseline_tokens=9455
instruction_budget_target_ratio="0.25"
instruction_budget_target_tokens=$((instruction_budget_baseline_tokens / 4))
instruction_budget_stretch_target_ratio="0.20"
instruction_budget_stretch_target_tokens=$((instruction_budget_baseline_tokens / 5))
instruction_budget_paths=(
  "pi/AGENTS.md"
  "claude/CLAUDE.md"
  "workflow-scaffold/templates/AGENTS.md"
  "workflow-scaffold/templates/CLAUDE.md"
  "workflow-scaffold/templates/docs/agent-workflow.md"
  "workflow-scaffold/templates/docs/claude-code-workflow.md"
)

shared_contract_paths=()
while IFS= read -r path; do
  shared_contract_paths+=("$path")
done < <(
  cd "$ROOT_DIR"
  {
    find workflow -maxdepth 1 -type f -name '*.md' -print
    if [ -d workflow/skills ]; then
      find workflow/skills -maxdepth 1 -type f -name '*.md' -print
    fi
  } | sort
)

adapter_paths=()
while IFS= read -r path; do
  adapter_paths+=("$path")
done < <(
  cd "$ROOT_DIR"
  {
    find claude/hooks -maxdepth 1 -type f -name '*.mjs' -print
    find pi/extensions -maxdepth 1 -type f -name '*.ts' -print
    find pi/extensions/lib -maxdepth 1 -type f -name '*.ts' -print
    find claude/commands -maxdepth 1 -type f -name '*.md' -print
    if [ -d pi/skills ]; then
      find pi/skills -type f -name '*.md' -print
    fi
  } | sort
)

router_paths=(
  "claude/hooks/workflow-router-lib.mjs"
  "pi/extensions/lib/workflow-router-runtime.ts"
)

instruction_dup_sections="$(
  comm -12 \
    <(grep -E '^## ' "$ROOT_DIR/claude/CLAUDE.md" | sed 's/^## //' | sort -u) \
    <(grep -E '^## ' "$ROOT_DIR/pi/AGENTS.md" | sed 's/^## //' | sort -u) |
    wc -l |
    tr -d ' '
)"

smoke_paths=()
while IFS= read -r path; do
  smoke_paths+=("$path")
done < <(
  awk -F '\t' '!/^#/ && $4 ~ /^tests\/.+\.sh$/ {print $4}' \
    "$ROOT_DIR/workflow/runtime/agentic-infra-checks.tsv" |
    sort -u
)

documented_source_candidates=(
  "workflow/spec.md"
  "claude/CLAUDE.md"
  "claude/hooks/workflow-router-lib.mjs"
  "pi/extensions/lib/workflow-router-runtime.ts"
)
documented_source_surface_files=()
for path in "${documented_source_candidates[@]}"; do
  if [ -f "$ROOT_DIR/$path" ] && grep -Fq 'plan-loop' "$ROOT_DIR/$path"; then
    documented_source_surface_files+=("$path")
  fi
done

duplicate_pairs_tsv="$(
  git -C "$ROOT_DIR" ls-files -s |
    while read -r mode hash stage path; do
      if [ -f "$ROOT_DIR/$path" ]; then printf '%s\t%s\n' "$hash" "$path"; fi
    done |
    sort |
    awk '
      function flush_group(i, j) {
        if (count > 1) {
          for (i = 1; i <= count; i++) {
            for (j = i + 1; j <= count; j++) {
              print current_hash "\t" paths[i] "\t" paths[j]
            }
          }
        }
        for (i = 1; i <= count; i++) paths[i] = ""
        count = 0
      }
      {
        hash = $1
        path = $2
        if (current_hash != "" && hash != current_hash) flush_group()
        current_hash = hash
        count += 1
        paths[count] = path
      }
      END {
        flush_group()
      }
    ' |
    sort
)"

shared_contract_files="${#shared_contract_paths[@]}"
shared_contract_lines="$(total_lines "${shared_contract_paths[@]}")"
adapter_files="${#adapter_paths[@]}"
adapter_total_lines="$(total_lines "${adapter_paths[@]}")"
smoke_suites="${#smoke_paths[@]}"
smoke_total_lines="$(total_lines "${smoke_paths[@]}")"
exact_duplicate_pair_count="$(
  printf '%s' "$duplicate_pairs_tsv" |
    sed '/^$/d' |
    wc -l |
    tr -d ' '
)"
documented_source_surfaces="${#documented_source_surface_files[@]}"
source_conflicts_json='[]'
router_owner_count="$(
  { grep -l 'const REVIEW_PATTERN' \
      "$ROOT_DIR/claude/hooks/workflow-router-lib.mjs" \
      "$ROOT_DIR/pi/extensions/lib/workflow-router-runtime.ts" \
      "$ROOT_DIR/workflow/runtime/workflow-router-core.mjs" 2>/dev/null || true; } |
    wc -l | tr -d ' '
)"
if [ "$router_owner_count" -ne 1 ]; then
  source_conflicts_json="$(jq -nc --arg count "$router_owner_count" '[{surface:"router-classifier",problem:("expected one pattern owner, found " + $count),remediation:"keep patterns in the declared canonical owner and adapters as delegates"}]')"
fi
source_of_truth_conflicts="$(printf '%s\n' "$source_conflicts_json" | jq 'length')"

router_json="$(printf '%s\n' "${router_paths[@]}" | paths_with_lines_json)"
smoke_json="$(printf '%s\n' "${smoke_paths[@]}" | paths_with_lines_json)"
duplicates_json="$(
  printf '%s' "$duplicate_pairs_tsv" |
    jq -Rn '[inputs | select(length > 0) | split("\t") | {hash: .[0], path_a: .[1], path_b: .[2]}]'
)"
documented_source_surfaces_json="$(printf '%s\n' "${documented_source_surface_files[@]}" | jq -Rn '[inputs | select(length > 0)]')"
instruction_budget_files_json="$(printf '%s\n' "${instruction_budget_paths[@]}" | paths_with_budget_json)"
instruction_budget_current_tokens="$(
  printf '%s\n' "$instruction_budget_files_json" |
    jq 'map(.estimated_tokens) | add // 0'
)"
instruction_budget_current_ratio="$(
  jq -n \
    --argjson current "$instruction_budget_current_tokens" \
    --argjson baseline "$instruction_budget_baseline_tokens" \
    'if $baseline == 0 then null else ($current / $baseline) end'
)"
instruction_budget_within_target="$(
  jq -n \
    --argjson current "$instruction_budget_current_tokens" \
    --argjson target "$instruction_budget_target_tokens" \
    '$current <= $target'
)"
instruction_budget_within_stretch_target="$(
  jq -n \
    --argjson current "$instruction_budget_current_tokens" \
    --argjson target "$instruction_budget_stretch_target_tokens" \
    '$current <= $target'
)"

# Additive always-on / lazy-load footprint (does not alter instruction_budget pin set).
# Token estimate matches instruction_budget: ceil(chars / 4).
# Cache model is a documented amortization proxy, not a live provider measurement.
budget_file_entry_json() {
  local abs="$1"
  local label="$2"
  if [ ! -f "$abs" ]; then
    return 1
  fi
  local chars lines tokens
  chars="$(wc -c < "$abs" | tr -d ' ')"
  lines="$(wc -l < "$abs" | tr -d ' ')"
  tokens=$(( (chars + 3) / 4 ))
  jq -nc \
    --arg path "$label" \
    --argjson lines "$lines" \
    --argjson chars "$chars" \
    --argjson tokens "$tokens" \
    '{path:$path, lines:$lines, chars:$chars, estimated_tokens:$tokens}'
}

always_on_context_block_json() {
  local files_json="$1"
  jq -nc --argjson files "$files_json" '
    def uncached: ($files | map(.estimated_tokens) | add // 0);
    {
      files: $files,
      file_count: ($files | length),
      total_chars: ($files | map(.chars) | add // 0),
      total_tokens_uncached: uncached,
      total_tokens_cached_amortized: ((uncached * 0.1) | floor),
      cache_model: "uncached=full estimated tokens; cached_amortized=floor(0.1*uncached) prompt-cache read proxy (not live-measured)"
    }
  '
}

always_on_dev_entries=()
if entry="$(budget_file_entry_json "${HOME}/.claude/CLAUDE.md" "~/.claude/CLAUDE.md")"; then
  always_on_dev_entries+=("$entry")
fi
if entry="$(budget_file_entry_json "$ROOT_DIR/CLAUDE.md" "CLAUDE.md")"; then
  always_on_dev_entries+=("$entry")
fi
if entry="$(budget_file_entry_json "$ROOT_DIR/AGENTS.md" "AGENTS.md")"; then
  always_on_dev_entries+=("$entry")
fi
always_on_dev_files_json="$(printf '%s\n' "${always_on_dev_entries[@]:-}" | jq -s '.')"
always_on_dev_json="$(always_on_context_block_json "$always_on_dev_files_json")"

always_on_deployed_claude_entries=()
if entry="$(budget_file_entry_json "$ROOT_DIR/claude/CLAUDE.md" "claude/CLAUDE.md")"; then
  always_on_deployed_claude_entries+=("$entry")
fi
always_on_deployed_claude_files_json="$(printf '%s\n' "${always_on_deployed_claude_entries[@]:-}" | jq -s '.')"
always_on_deployed_claude_json="$(always_on_context_block_json "$always_on_deployed_claude_files_json")"

always_on_deployed_pi_entries=()
if entry="$(budget_file_entry_json "$ROOT_DIR/pi/AGENTS.md" "pi/AGENTS.md")"; then
  always_on_deployed_pi_entries+=("$entry")
fi
always_on_deployed_pi_files_json="$(printf '%s\n' "${always_on_deployed_pi_entries[@]:-}" | jq -s '.')"
always_on_deployed_pi_json="$(always_on_context_block_json "$always_on_deployed_pi_files_json")"

always_on_context_json="$(
  jq -nc \
    --argjson dev_repo "$always_on_dev_json" \
    --argjson deployed_claude "$always_on_deployed_claude_json" \
    --argjson deployed_pi "$always_on_deployed_pi_json" \
    '{
      estimate: "ceil(chars / 4)",
      note: "Additive always-on footprint for real per-turn context; independent of the pinned 6-file instruction_budget set. Dev-repo includes user CLAUDE.md + project CLAUDE.md + AGENTS.md (imported). Deployed surfaces are thin adapters only.",
      dev_repo: $dev_repo,
      deployed: {
        claude: $deployed_claude,
        pi: $deployed_pi
      }
    }'
)"

lazy_load_paths=()
while IFS= read -r path; do
  lazy_load_paths+=("$path")
done < <(
  cd "$ROOT_DIR"
  find workflow -type f -name '*.md' -print | sort
)
lazy_load_files_json="$(printf '%s\n' "${lazy_load_paths[@]}" | paths_with_budget_json)"
lazy_load_file_count="${#lazy_load_paths[@]}"
lazy_load_total_chars="$(
  printf '%s\n' "$lazy_load_files_json" | jq 'map(.chars) | add // 0'
)"
lazy_load_total_tokens="$(
  printf '%s\n' "$lazy_load_files_json" | jq 'map(.estimated_tokens) | add // 0'
)"
always_on_dev_tokens="$(
  printf '%s\n' "$always_on_dev_json" | jq '.total_tokens_uncached'
)"
lazy_load_ratio="$(
  jq -n \
    --argjson lazy "$lazy_load_total_tokens" \
    --argjson always "$always_on_dev_tokens" \
    'if ($lazy + $always) == 0 then null else ($lazy / ($lazy + $always)) end'
)"
lazy_load_json="$(
  jq -nc \
    --argjson file_count "$lazy_load_file_count" \
    --argjson total_chars "$lazy_load_total_chars" \
    --argjson total_tokens "$lazy_load_total_tokens" \
    --argjson always_on_dev_tokens "$always_on_dev_tokens" \
    --argjson lazy_load_ratio "$lazy_load_ratio" \
    '{
      scope: "workflow/**/*.md (on-demand; not always-on)",
      file_count: $file_count,
      total_chars: $total_chars,
      total_tokens: $total_tokens,
      always_on_dev_tokens_for_ratio: $always_on_dev_tokens,
      lazy_load_ratio: $lazy_load_ratio,
      note: "lazy_load_ratio = lazy_tokens / (lazy_tokens + always_on_dev_tokens); higher means more corpus stays on-demand (decay architecture)"
    }'
)"

if [ "$JSON" -eq 1 ]; then
  jq -n \
    --argjson shared_contract_files "$shared_contract_files" \
    --argjson shared_contract_lines "$shared_contract_lines" \
    --argjson adapter_files "$adapter_files" \
    --argjson adapter_total_lines "$adapter_total_lines" \
    --argjson router_adapter_lines "$router_json" \
    --argjson exact_duplicate_pairs "$duplicates_json" \
    --argjson instruction_dup_sections "$instruction_dup_sections" \
    --argjson smoke_suites "$smoke_json" \
    --argjson smoke_total_lines "$smoke_total_lines" \
    --argjson documented_source_surfaces "$documented_source_surfaces" \
    --argjson documented_source_surface_files "$documented_source_surfaces_json" \
    --argjson source_of_truth_conflicts "$source_of_truth_conflicts" \
    --argjson source_of_truth_conflict_files "$source_conflicts_json" \
    --argjson instruction_budget_files "$instruction_budget_files_json" \
    --argjson instruction_budget_baseline_tokens "$instruction_budget_baseline_tokens" \
    --argjson instruction_budget_current_tokens "$instruction_budget_current_tokens" \
    --argjson instruction_budget_target_tokens "$instruction_budget_target_tokens" \
    --argjson instruction_budget_stretch_target_tokens "$instruction_budget_stretch_target_tokens" \
    --argjson instruction_budget_current_ratio "$instruction_budget_current_ratio" \
    --argjson instruction_budget_within_target "$instruction_budget_within_target" \
    --argjson instruction_budget_within_stretch_target "$instruction_budget_within_stretch_target" \
    --argjson always_on_context "$always_on_context_json" \
    --argjson lazy_load "$lazy_load_json" \
    '{
      shared_contract_files: $shared_contract_files,
      shared_contract_lines: $shared_contract_lines,
      adapter_files: $adapter_files,
      adapter_total_lines: $adapter_total_lines,
      router_adapter_lines: $router_adapter_lines,
      exact_duplicate_pairs: $exact_duplicate_pairs,
      instruction_dup_sections: $instruction_dup_sections,
      smoke_suites: $smoke_suites,
      smoke_total_lines: $smoke_total_lines,
      documented_source_surfaces: $documented_source_surfaces,
      documented_source_surface_files: $documented_source_surface_files,
      source_of_truth_conflicts: $source_of_truth_conflicts,
      source_of_truth_conflict_files: $source_of_truth_conflict_files,
      instruction_budget: {
        files: $instruction_budget_files,
        baseline_tokens: $instruction_budget_baseline_tokens,
        current_tokens: $instruction_budget_current_tokens,
        target_tokens: $instruction_budget_target_tokens,
        stretch_target_tokens: $instruction_budget_stretch_target_tokens,
        target_ratio: 0.25,
        stretch_target_ratio: 0.20,
        current_ratio: $instruction_budget_current_ratio,
        within_target: $instruction_budget_within_target,
        within_stretch_target: $instruction_budget_within_stretch_target,
        estimate: "ceil(chars / 4)"
      },
      always_on_context: $always_on_context,
      lazy_load: $lazy_load
    }'
  exit 0
fi

status_line shared_contract_files "$shared_contract_files"
status_line shared_contract_lines "$shared_contract_lines"
status_line adapter_files "$adapter_files"
status_line adapter_total_lines "$adapter_total_lines"
status_line instruction_dup_sections "$instruction_dup_sections"
status_line smoke_suites "$smoke_suites"
status_line smoke_total_lines "$smoke_total_lines"
status_line documented_source_surfaces "$documented_source_surfaces"
status_line source_of_truth_conflicts "$source_of_truth_conflicts"
status_line exact_duplicate_pairs "$exact_duplicate_pair_count"
status_line instruction_budget_tokens "$instruction_budget_current_tokens/$instruction_budget_baseline_tokens"
status_line instruction_budget_ratio "$instruction_budget_current_ratio"
status_line instruction_budget_target "$instruction_budget_target_tokens"
status_line instruction_budget_stretch "$instruction_budget_stretch_target_tokens"
status_line instruction_budget_ok "$instruction_budget_within_target"
status_line instruction_budget_stretch_ok "$instruction_budget_within_stretch_target"
status_line always_on_context_tokens "$(printf '%s\n' "$always_on_dev_json" | jq -r '"dev_uncached=" + (.total_tokens_uncached|tostring) + " cached_amortized=" + (.total_tokens_cached_amortized|tostring)')"
status_line always_on_deployed_tokens "$(printf '%s\n' "$always_on_deployed_claude_json" | jq -r '"claude=" + (.total_tokens_uncached|tostring)') / $(printf '%s\n' "$always_on_deployed_pi_json" | jq -r '"pi=" + (.total_tokens_uncached|tostring)')"
status_line lazy_load_tokens "$lazy_load_total_tokens"
status_line lazy_load_ratio "$lazy_load_ratio"

printf '\nrouter_adapter_lines\n'
for path in "${router_paths[@]}"; do
  status_line "  $path" "$(line_count "$path")"
done

printf '\ndocumented_source_surface_files\n'
for path in "${documented_source_surface_files[@]}"; do
  printf '  %s\n' "$path"
done

printf '\nsource_of_truth_conflict_files\n'

printf '\ninstruction_budget_files\n'
printf '%s\n' "$instruction_budget_files_json" |
  jq -r '.[] | "  \(.path) estimated_tokens=\(.estimated_tokens) chars=\(.chars)"'

printf '\nalways_on_context_files (dev_repo)\n'
printf '%s\n' "$always_on_dev_json" |
  jq -r '.files[] | "  \(.path) estimated_tokens=\(.estimated_tokens) chars=\(.chars)"'

printf '\nexact_duplicate_pairs\n'
printf '%s' "$duplicate_pairs_tsv" | while IFS=$'\t' read -r _hash path_a path_b; do
  [ -n "${path_a:-}" ] || continue
  printf '  %s == %s\n' "$path_a" "$path_b"
done
