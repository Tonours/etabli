#!/bin/bash
set -euo pipefail

# Pattern matching uses the shell's own ERE engine ([[ =~ ]] with the
# nocasematch shell option) instead of spawning grep processes. Word-boundary
# assertions use the POSIX [[:<:]] / [[:>:]] spellings; accented classes list
# the uppercase form explicitly because nocasematch only folds ASCII.
shopt -s nocasematch

usage() {
  cat <<EOF
Usage: research-proof-check <markdown-file>

Validate that a research artifact contains source evidence and confidence labels.
EOF
}

file="${1:-}"
case "$file" in
  -h|--help)
    usage
    exit 0
    ;;
esac

if [ -z "$file" ]; then
  usage >&2
  exit 2
fi

if [ ! -f "$file" ]; then
  printf 'research artifact not found: %s\n' "$file" >&2
  exit 1
fi

IFS= read -r -d '' content <"$file" || :

has() {
  [[ $content =~ $1 ]]
}

has '(https?://|Sources?:|Evidence:|file:[[:space:]]*|[[:alnum:]_./-]+:[0-9]+)' || {
  printf 'research artifact has no explicit source evidence: %s\n' "$file" >&2
  exit 1
}

has '[[:<:]](confirmed|approximate|proxy[-_ ]supported|blocked|unknown|inconclusive|verified|not verified)[[:>:]]' || {
  printf 'research artifact has no confidence/status labels: %s\n' "$file" >&2
  exit 1
}

if has '[[:<:]](i searched|j.?ai cherch[eéÉ]|searched the web|recherche web effectu[eéÉ]e)[[:>:]]' &&
  ! has 'https?://'; then
  printf 'research artifact claims web search but has no URL source: %s\n' "$file" >&2
  exit 1
fi

printf 'research proof check: ok\n'
