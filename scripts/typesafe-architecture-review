#!/usr/bin/env node
import { readFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import {
	ArchitectureReviewError,
	buildRequest,
	composeReview,
	loadInputs,
	requestTypeSafe,
} from "./lib/typesafe-architecture-review.mjs";

function usage() {
	return "Usage: typesafe-architecture-review [--plan PLAN.md] [--evidence path]... [--fixture-response file] [--preview] [--json]";
}

function parseArgs(args) {
	const options = { plan: "PLAN.md", evidence: [], fixture: "", preview: false, json: false };
	for (let index = 0; index < args.length; index += 1) {
		const arg = args[index];
		if (["--plan", "--evidence", "--fixture-response"].includes(arg)) {
			const value = args[index + 1];
			if (!value) throw new ArchitectureReviewError("input", `${arg} requires a path`);
			index += 1;
			if (arg === "--plan") options.plan = value;
			if (arg === "--evidence") options.evidence.push(value);
			if (arg === "--fixture-response") options.fixture = value;
		} else if (arg === "--preview") options.preview = true;
		else if (arg === "--json") options.json = true;
		else if (arg === "-h" || arg === "--help") options.help = true;
		else throw new ArchitectureReviewError("input", `unknown argument: ${arg}`);
	}
	return options;
}

function render(report) {
	return [
		`TypeSafe architecture review: ${report.verdict.toUpperCase()}`,
		`  provenance:      ${report.provenance}`,
		`  semantic review: ${report.semantic_review}`,
		`  quality index:   ${report.quality_index}`,
		`  findings:        ${report.findings.length}`,
	].join("\n");
}

async function main() {
	const options = parseArgs(process.argv.slice(2));
	if (options.help) {
		console.log(usage());
		return 0;
	}
	const repoRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");
	const loaded = loadInputs(repoRoot, options.plan, options.evidence);
	const { request, bytes } = buildRequest(loaded.inputs);
	const inventory = loaded.inputs.map(({ path, sha256, role, text }) => ({ path, sha256, role, bytes: Buffer.byteLength(text) }));
	if (options.preview) {
		console.log(JSON.stringify({ network: false, request_bytes: bytes, inputs: inventory, model: request.model, questions: Object.keys(request.questions) }, null, 2));
		return 0;
	}
	const provenance = options.fixture ? "fixture" : "live";
	const response = options.fixture
		? JSON.parse(readFileSync(resolve(repoRoot, options.fixture), "utf8"))
		: await requestTypeSafe(request);
	const report = composeReview(response, provenance, inventory);
	console.log(options.json ? JSON.stringify(report, null, 2) : render(report));
	return report.verdict === "pass" ? 0 : 1;
}

try {
	process.exitCode = await main();
} catch (error) {
	if (error instanceof ArchitectureReviewError) {
		console.error(`typesafe-architecture-review ${error.kind}: ${error.message}`);
		process.exitCode = error.kind === "input" ? 2 : 3;
	} else {
		console.error("typesafe-architecture-review response: invalid fixture or unexpected failure");
		process.exitCode = 3;
	}
}
