out.i_effort = {
  outputSharePctRaw: share(total.output, rawTotal(total)), outputSharePctUsd: (() => {
    let o = 0; for (const r of records) { const p = priceOf(r.model); if (p) o += (r.tok.output * p.out) / 1e6; } return share(o, total.usd);
  })(),
  thinkingTokens: total.thinking, thinkingPctOfOutput: share(total.thinking, total.output),
  byModelEffort: Object.fromEntries([...effortDist.entries()].sort((a, b) => b[1].usd - a[1].usd).map(([k, v]) => [k, { turns: v.turns, output: v.output, thinking: v.thinking, usd: round(v.usd), pctUsd: share(v.usd, total.usd) }])),
};

