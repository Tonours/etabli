  mainSessionFirstTurnCtx: dist(sess.map((s) => s.firstCtx)),
  mainSessionMinCtx: dist(sess.map((s) => s.minCtx)),
  mainSessionFirstTurnCtxByEntrypoint: (() => {
    const byEntry = new Map();
    for (const [sid, s] of sessions) bump(byEntry, sessionEntry.get(sid) || '(unknown)', () => []).push(s.firstCtx);
    return Object.fromEntries([...byEntry.entries()].sort().map(([k, v]) => [k, dist(v)]));
  })(),
  note: 'first turn of resumed/forked sessions includes history; minCtx (lowest context seen in a session) is a second estimate of fixed overhead',
  subagentFirstTurnCtxByType: Object.fromEntries([...subByType.entries()].sort((a, b) => b[1].runs - a[1].runs).map(([k, v]) => [k, dist(v.firstCtx)])),
};

