#!/usr/bin/env bash
# Full-capability Claude entry: explicit escape hatch, zero profile overrides.
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" >/dev/null 2>&1 && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" = /* ]] || SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
RESOLVED_SELF="$(readlink -f "$SCRIPT_PATH" 2>/dev/null || printf '%s' "$SCRIPT_PATH")"

CLAUDE_BIN="$(command -v claude || true)"
if [ -z "$CLAUDE_BIN" ]; then
  printf 'claude-full: claude binary not found on PATH — install Claude Code first or fix PATH\n' >&2
  exit 1
fi
RESOLVED_CLAUDE="$(readlink -f "$CLAUDE_BIN" 2>/dev/null || printf '%s' "$CLAUDE_BIN")"
if [ "$RESOLVED_CLAUDE" = "$RESOLVED_SELF" ]; then
  printf 'claude-full: claude resolves to this launcher (%s) — remove the alias and call claude-full directly\n' "$RESOLVED_CLAUDE" >&2
  exit 1
fi

exec "$CLAUDE_BIN" "$@"
