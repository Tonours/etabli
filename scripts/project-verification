#!/usr/bin/env node
import { resolve } from "node:path";
import { discoverVerification, initVerification } from "./lib/project-verification-recipe.mjs";
import { runProjectVerification } from "./lib/project-verification-run.mjs";

export { discoverVerification, initVerification, runProjectVerification };

const args = process.argv.slice(2);
try {
  let result;
  if (["discover", "init"].includes(args[0]) && args.length <= 2) result = (args[0] === "discover" ? discoverVerification : initVerification)(resolve(args[1] ?? "."));
  else if (args[0] === "run" && args[1] === "--plan" && [3, 4].includes(args.length) && (!args[3] || args[3] === "--engine")) result = await runProjectVerification({ planPath: resolve(args[2]), useEngine: args[3] === "--engine" });
  else throw new Error("Usage: project-verification discover [root] | init [root] | run --plan PLAN.md [--engine]");
  console.log(JSON.stringify(result));
} catch (error) {
  console.error(`project-verification: ${error.message}`);
  process.exitCode = 1;
}
