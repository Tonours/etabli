#!/usr/bin/env bash
# Run the vendored Cloudflare security-audit skill in Claude Code on one
# provider's Anthropic-compatible endpoint (Z.ai GLM by default): the session
# and every subagent it spawns use the same model.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." >/dev/null 2>&1 && pwd)"
SKILL_DIR="$REPO_DIR/vendor/cloudflare/skills/security-audit"
RC_INCOMPLETE=3
RC_INVALID=4
RC_CLAUDE=5
RC_TIMEOUT=124

usage() {
  cat <<EOF
Usage: security-audit-glm [target-dir] [--profile quick|standard|deep] [--out DIR]
                          [--model ID] [--effort low|high|max] [--dry-run]
                          [--print --timeout SECONDS]

Runs the security-audit skill through Claude Code against an Anthropic
endpoint (Z.ai by default; SECURITY_AUDIT_GLM_BASE_URL overrides it). Needs
SECURITY_AUDIT_GLM_API_KEY, or ZAI_API_KEY for Z.ai. Defaults: glm-5.3[1m], effort max, profile
standard, reports under ~/security-audit-skill/<repo>/run-N, interactive
session (--print runs headless). The audited repo's .claude settings, hooks
and .mcp.json are not loaded. When security-audit-sandbox --check passes,
agents run target code through it; otherwise the audit is source-only.

--print needs a wall-clock budget (--timeout, else SECURITY_AUDIT_GLM_TIMEOUT).
It runs in a new run directory (--out must not exist yet), stops Claude at
the deadline, then checks the reports with node, jq and perl. Exit: 0 complete and checked, 1-2
refused before launch, $RC_INCOMPLETE audit stopped incomplete, $RC_INVALID
reports missing or invalid, $RC_CLAUDE Claude failed, $RC_TIMEOUT deadline,
129/130/143 interrupted. --dry-run prints the bare Claude command, which skips
the deadline and the checks.
EOF
}

TARGET="."
PROFILE="standard"
OUT=""
MODEL="${SECURITY_AUDIT_GLM_MODEL:-glm-5.3[1m]}"
EFFORT="${SECURITY_AUDIT_GLM_EFFORT:-max}"
BASE_URL="${SECURITY_AUDIT_GLM_BASE_URL:-https://api.z.ai/api/anthropic}"
API_KEY="${SECURITY_AUDIT_GLM_API_KEY:-${ZAI_API_KEY:-}}"
TIMEOUT="${SECURITY_AUDIT_GLM_TIMEOUT:-}"
KILL_GRACE=10
PRINT=0
DRY_RUN=0
while [ "$#" -gt 0 ]; do
  case "$1" in
  --profile) shift; PROFILE="${1:?--profile needs a value}" ;;
  --out) shift; OUT="${1:?--out needs a value}" ;;
  --model) shift; MODEL="${1:?--model needs a value}" ;;
  --effort) shift; EFFORT="${1:?--effort needs a value}" ;;
  --timeout) shift; TIMEOUT="${1:?--timeout needs a value}" ;;
  --print) PRINT=1 ;;
  --dry-run) DRY_RUN=1 ;;
  -h | --help) usage; exit 0 ;;
  -*) usage >&2; exit 2 ;;
  *) TARGET="$1" ;;
  esac
  shift
done

case "$PROFILE" in quick | standard | deep) ;; *) echo "unknown profile: $PROFILE (quick, standard or deep)" >&2; exit 2 ;; esac
case "$EFFORT" in low | high | max) ;; *) echo "unsupported effort: $EFFORT (GLM takes low, high or max)" >&2; exit 2 ;; esac
[ -f "$SKILL_DIR/SKILL.md" ] || { echo "security-audit skill missing at $SKILL_DIR; run scripts/sync-vendor-skills cloudflare" >&2; exit 1; }
TARGET="$(cd "$TARGET" 2>/dev/null && pwd -P)" || { echo "target is not a directory" >&2; exit 1; }
[ -n "$API_KEY" ] || { echo "SECURITY_AUDIT_GLM_API_KEY (or ZAI_API_KEY for Z.ai) is not set; export your provider API key first" >&2; exit 1; }
CLAUDE="$(command -v claude)" || { echo "claude binary not found on PATH" >&2; exit 1; }
if [ "$PRINT" = 1 ]; then
  case "$TIMEOUT" in '' | 0* | *[!0-9]* | ?????????*) echo "--print needs --timeout SECONDS (or SECURITY_AUDIT_GLM_TIMEOUT), a positive integer of at most 8 digits" >&2; exit 2 ;; esac
  for tool in node jq perl; do
    command -v "$tool" >/dev/null || { echo "$tool not found on PATH; --print needs it to check the reports" >&2; exit 1; }
  done
fi

STATE_DIR="${SECURITY_AUDIT_GLM_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/security-audit-glm}"
mkdir -p "$STATE_DIR/skills"
STATE_DIR="$(cd "$STATE_DIR" && pwd)"
# Concurrent launches share this state: keep a correct link, replace files atomically.
SKILL_LINK="$STATE_DIR/skills/security-audit"
[ "$(readlink "$SKILL_LINK")" = "$SKILL_DIR" ] || ln -sfn "$SKILL_DIR" "$SKILL_LINK" 2>/dev/null ||
  [ "$(readlink "$SKILL_LINK")" = "$SKILL_DIR" ]
printf '{"disableAllHooks":true,"skipWebFetchPreflight":true}\n' >"$STATE_DIR/settings.json.$$"
mv -f "$STATE_DIR/settings.json.$$" "$STATE_DIR/settings.json"

OUT_ROOT="$(cd "$HOME" && pwd -P)/security-audit-skill"
if [ "$PRINT" = 1 ]; then
  # Headless runs own a new directory, so no older run's reports can pass the checks.
  if [ -n "$OUT" ]; then
    case "$OUT" in /*) ;; *) OUT="$PWD/$OUT" ;; esac
    if [ -e "$OUT" ] || [ -L "$OUT" ]; then
      echo "--out $OUT already exists; give a new path" >&2
      exit 2
    elif [ "$DRY_RUN" = 0 ]; then
      mkdir -p "$(dirname "$OUT")"
      mkdir "$OUT" || { echo "cannot create --out $OUT" >&2; exit 1; }
    fi
    [ ! -d "$OUT" ] || OUT="$(cd "$OUT" && pwd -P)"
    OUT_ROOT="$OUT"
    RUN_DIR="$OUT"
  else
    REPO_OUT="$OUT_ROOT/$(basename "$TARGET")"
    [ "$DRY_RUN" = 1 ] || mkdir -p "$REPO_OUT"
    N=1
    while :; do
      RUN_DIR="$REPO_OUT/run-$N"
      if [ "$DRY_RUN" = 1 ]; then [ -e "$RUN_DIR" ] || break
      elif mkdir "$RUN_DIR" 2>/dev/null; then break
      else [ -e "$RUN_DIR" ] || { echo "cannot create $RUN_DIR" >&2; exit 1; }
      fi
      N=$((N + 1))
    done
  fi
  PROMPT="Run a full security audit of this codebase with the security-audit skill, profile \`$PROFILE\`, output to \`$RUN_DIR\` (the launcher created this empty directory for this run; use it as is)."
else
  if [ -n "$OUT" ]; then
    mkdir -p "$OUT"
    OUT="$(cd "$OUT" && pwd -P)"
    OUT_ROOT="$OUT"
  fi
  PROMPT="Run a full security audit of this codebase with the security-audit skill, profile \`$PROFILE\`${OUT:+, output to \`$OUT\`}."
fi
[ "$DRY_RUN" = 1 ] || mkdir -p "$OUT_ROOT"

PROMPT+=" On this platform the Task tool is the \`Agent\` tool. Every agent you spawn runs on the same model as you."
SANDBOX="$REPO_DIR/scripts/security-audit-sandbox"
if SANDBOX_STATUS="$("$SANDBOX" --check 2>&1)"; then
  PROMPT+=" An OS-enforced sandbox that meets every Universal execution safety control is available: \`$SANDBOX --scratch <physical output-dir>/agents/<agent-id>/scratch --target $TARGET -- <command>\` (see \`--help\` for limits and exit codes). It is the only allowed way to run target-controlled code; pass this exact invocation to every hunter and verifier. It mounts the scratch read-only as a seed and discards the copy, so results leave only as its capped stdout and stderr: the promotion allowlist is empty, and the parent may save that output as evidence."
else
  printf 'security-audit-glm: no sandbox (%s); the audit stays source-only\n' "$SANDBOX_STATUS" >&2
  PROMPT+=" No OS-enforced sandbox is available on this host: do not execute target code."
fi
if [ "$PRINT" = 1 ]; then
  utc() { perl -MPOSIX -e 'print strftime("%Y-%m-%dT%H:%M:%SZ", gmtime($ARGV[0]))' "$1"; }
  NOW="$(date +%s)"
  PROMPT+=" Hard deadline: $(utc $((NOW + TIMEOUT))) UTC, when this session is killed; check the time with \`date -u\`. If the audit cannot finish by $(utc $((NOW + TIMEOUT - TIMEOUT / 10))) UTC, stop launching agents, mark every untouched coverage unit deferred, set run_status \"incomplete\" with its incomplete_reason, and write the partial report."
fi
ARGS=(--model "$MODEL" --effort "$EFFORT" --permission-mode auto --setting-sources user --strict-mcp-config --add-dir "$OUT_ROOT")
[ "$PRINT" = 0 ] || ARGS+=(--print --output-format text)

RUN=(env -u ANTHROPIC_API_KEY -u ANTHROPIC_CUSTOM_HEADERS -u ANTHROPIC_SMALL_FAST_MODEL -u CLAUDE_CODE_OAUTH_TOKEN
  -u CLAUDE_CODE_USE_BEDROCK -u CLAUDE_CODE_USE_VERTEX -u CLAUDE_CODE_USE_FOUNDRY
  CLAUDE_CONFIG_DIR="$STATE_DIR"
  ANTHROPIC_BASE_URL="$BASE_URL"
  ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL" ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL" ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL"
  CLAUDE_CODE_SUBAGENT_MODEL="$MODEL"
  API_TIMEOUT_MS=3000000 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=3600000
  ENABLE_TOOL_SEARCH=false
  "$CLAUDE" "${ARGS[@]}" -- "$PROMPT")

PROVIDER="${BASE_URL#*://}"; PROVIDER="${PROVIDER%%/*}"
echo "security-audit-glm: $TARGET, profile $PROFILE, $MODEL ($EFFORT) via $PROVIDER" >&2
if [ "$DRY_RUN" = 1 ]; then
  printf '%q ' ANTHROPIC_AUTH_TOKEN="$API_KEY" "${RUN[@]}"
  echo
  exit 0
fi
cd "$TARGET"
[ "$PRINT" = 1 ] || ANTHROPIC_AUTH_TOKEN="$API_KEY" exec "${RUN[@]}"

STATE="$(mktemp -d "${TMPDIR:-/tmp}/security-audit-glm.XXXXXX")"
trap 'rm -rf "$STATE"' EXIT
finish() {
  printf 'security-audit-glm: %s; run directory: %s\n' "$1" "$RUN_DIR" >&2
  exit "$2"
}
# One supervisor owns the deadline and the cleanup. It leaves the launcher's process group before
# it starts Claude, so a signal sent to that group cannot reach it while Claude runs, and it puts
# Claude in a group of its own so ordinary descendants are ended too. A stop request (USR1), the
# deadline or Claude's exit sends TERM to that group once; whatever is left after the grace is
# KILLed. It exits with Claude's status and marks $3 only when the deadline caused the stop.
SUPERVISE='use POSIX ":sys_wait_h"; use Time::HiRes qw(time sleep);
  my ($timeout, $grace, $flag, @cmd) = @ARGV;
  setpgrp(0, 0);
  my $requested = 0;
  $SIG{USR1} = sub { $requested = 1 };
  my $pid = fork() // die "security-audit-glm: fork: $!\n";
  if (!$pid) { setpgrp(0, 0); exec { $cmd[0] } @cmd or die "security-audit-glm: exec $cmd[0]: $!\n" }
  POSIX::setpgid($pid, $pid);
  my $deadline = time + $timeout;
  my ($status, $kill_at);
  while (1) {
    $status = $? if !defined $status && waitpid($pid, WNOHANG) == $pid;
    last if defined $status && !kill(0, -$pid);
    if (!defined $kill_at && (defined $status || $requested || time >= $deadline)) {
      if (!defined $status && !$requested) { open my $fh, ">", $flag; close $fh }
      kill "TERM", -$pid;
      $kill_at = time + $grace;
    }
    kill "KILL", -$pid if defined $kill_at && time >= $kill_at;
    sleep 0.1;
  }
  exit($status & 127 ? 128 + ($status & 127) : $status >> 8);'
# Bash makes background jobs ignore INT, so every signal becomes a stop request to the supervisor.
SIGNAL="" SUPERVISOR=""
on_signal() { SIGNAL=$1; [ -z "$SUPERVISOR" ] || kill -USR1 "$SUPERVISOR" 2>/dev/null || true; }
trap 'on_signal 129' HUP
trap 'on_signal 130' INT
trap 'on_signal 143' TERM
ANTHROPIC_AUTH_TOKEN="$API_KEY" perl -e "$SUPERVISE" "$TIMEOUT" "$KILL_GRACE" "$STATE/stopped" "${RUN[@]}" &
SUPERVISOR=$!
[ -z "$SIGNAL" ] || on_signal "$SIGNAL"
while :; do
  RC=0
  wait "$SUPERVISOR" || RC=$?
  # A trapped signal interrupts wait while the supervisor still runs (or is not yet reaped).
  if [ -z "$SIGNAL" ] || ! kill -0 "$SUPERVISOR" 2>/dev/null; then break; fi
done
trap - HUP INT TERM

[ -z "$SIGNAL" ] || finish "interrupted" "$SIGNAL"
[ ! -e "$STATE/stopped" ] || finish "deadline of ${TIMEOUT}s reached" "$RC_TIMEOUT"
[ "$RC" = 0 ] || finish "claude exited $RC" "$RC_CLAUDE"

META="$RUN_DIR/run-metadata.json"
[ -f "$META" ] && jq -e 'type == "object"' "$META" >/dev/null 2>&1 || finish "run-metadata.json is missing or not a JSON object" "$RC_INVALID"
[ "$(jq -r '.profile' "$META")" = "$PROFILE" ] || finish "run-metadata.json profile is not $PROFILE" "$RC_INVALID"
STATUS="$(jq -r '.run_status' "$META")"
if [ "$STATUS" = incomplete ]; then
  REASON="$(jq -r '.incomplete_reason // empty' "$META")"
  [ -n "$REASON" ] && [ -f "$RUN_DIR/REPORT.md" ] && [ -s "$RUN_DIR/REPORT.md" ] ||
    finish "run_status incomplete without incomplete_reason or REPORT.md" "$RC_INVALID"
  finish "audit stopped incomplete ($REASON)" "$RC_INCOMPLETE"
fi
[ "$STATUS" = complete ] || finish "run_status is $STATUS, not complete" "$RC_INVALID"
for file in architecture.md coverage-ledger.json findings.json REPORT.md FINDINGS-DETAIL.md NEEDS-VALIDATION.md; do
  [ -f "$RUN_DIR/$file" ] && [ -s "$RUN_DIR/$file" ] || finish "$file is missing or empty" "$RC_INVALID"
done
for doc in findings coverage-ledger; do
  node "$SKILL_DIR/validate-$doc.cjs" "$RUN_DIR/$doc.json" >&2 || finish "validate-$doc.cjs rejected $doc.json" "$RC_INVALID"
done
# Validators accept unfinished units and undecided candidates; a complete run has neither
# (VALIDATION-AND-REPORTING.md). The ledger does not record which extra fingerprint of a unit was
# merged as a duplicate (HUNTING.md), so this requires one final record per candidate unit, not per fingerprint.
LEDGER="$RUN_DIR/coverage-ledger.json"
jq -e 'length > 0 and all(.[]; .status != "planned" and .status != "in_progress")' "$LEDGER" >/dev/null ||
  finish "coverage ledger is empty or still has planned or in_progress units" "$RC_INVALID"
jq -e --slurpfile findings "$RUN_DIR/findings.json" '($findings[0] | map(.fingerprint)) as $final
  | all(.[] | select(.status == "candidate"); any(.result_fingerprints[]; IN($final[])))' "$LEDGER" >/dev/null ||
  finish "a candidate coverage unit has no final record in findings.json" "$RC_INVALID"
printf 'security-audit-glm: audit complete, reports checked in %s\n' "$RUN_DIR" >&2
