#!/usr/bin/env bash
# Prefer IPv4 for Node/Pi model API calls and measure/warm provider hosts.
#
# Why: on this Mac, Node's default DNS order is "verbatim", so api.z.ai often
# dials IPv6 first. Measured cold TLS handshake for api.z.ai:
#   IPv6-first ~370–575 ms  vs  IPv4-first ~55–95 ms
# x.ai / kimi (Cloudflare) are already fast; open.bigmodel.cn is worse from EU.
set -euo pipefail

DNS_FLAG="--dns-result-order=ipv4first"
# International coding endpoint hosts used by Pi portfolio (not mainland CN).
DEFAULT_HOSTS=(
  api.z.ai
  api.x.ai
  api.kimi.com
  api.openai.com
  openrouter.ai
)

usage() {
  cat <<'EOF'
Usage: model-network-tune <command>

Commands:
  status     Show NODE_OPTIONS / Node DNS order and a quick path check
  apply      Install shell export (zsh/bash) so Pi inherits IPv4-first DNS
  measure    Benchmark DNS+TLS handshake to model API hosts (v4 vs default)
  warm       Parallel TLS warm-up of model API hosts (DNS + TCP + TLS)
  install    apply + link helpers (called from etabli install)

Env:
  MODEL_NETWORK_HOSTS  space-separated host override for measure/warm
EOF
}

have_flag_in_node_options() {
  case " ${NODE_OPTIONS:-} " in
    *" ${DNS_FLAG} "*) return 0 ;;
    *) return 1 ;;
  esac
}

export_flag_current_shell() {
  if have_flag_in_node_options; then
    return 0
  fi
  if [ -n "${NODE_OPTIONS:-}" ]; then
    export NODE_OPTIONS="${NODE_OPTIONS} ${DNS_FLAG}"
  else
    export NODE_OPTIONS="${DNS_FLAG}"
  fi
}

# Idempotent line for ~/.zshrc / ~/.bashrc (order-preserving, no duplicates).
shell_export_line() {
  printf '%s\n' \
    'case " ${NODE_OPTIONS:-} " in *" --dns-result-order=ipv4first "*) ;; *) export NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--dns-result-order=ipv4first" ;; esac'
}

ensure_shell_export() {
  local rcfile="$1"
  local desired
  local tmp_file
  desired="$(shell_export_line | tr -d '\n')"

  if [ ! -f "$rcfile" ] && [ "$rcfile" != "${HOME}/.zshrc" ] && [ "$rcfile" != "${HOME}/.bashrc" ]; then
    return 0
  fi
  touch "$rcfile" 2>/dev/null || return 0

  if grep -Fq -- "$DNS_FLAG" "$rcfile" 2>/dev/null; then
    return 0
  fi

  tmp_file="$(mktemp)" || return 1
  {
    cat "$rcfile"
    printf '\n# etabli: prefer IPv4 for Node/Pi model API DNS (z.ai etc.)\n'
    printf '%s\n' "$desired"
  } >"$tmp_file"
  cp "$tmp_file" "$rcfile"
  rm -f "$tmp_file"
}

hosts_list() {
  if [ -n "${MODEL_NETWORK_HOSTS:-}" ]; then
    # shellcheck disable=SC2206
    HOSTS=(${MODEL_NETWORK_HOSTS})
  else
    HOSTS=("${DEFAULT_HOSTS[@]}")
  fi
}

cmd_status() {
  local order="(node missing)"
  if command -v node >/dev/null 2>&1; then
    order="$(node -e 'const d=require("dns"); console.log(d.getDefaultResultOrder?.() ?? "unknown")' 2>/dev/null || echo unknown)"
  fi
  printf 'NODE_OPTIONS=%s\n' "${NODE_OPTIONS-}"
  printf 'dns_flag_present=%s\n' "$(have_flag_in_node_options && echo yes || echo no)"
  printf 'node_default_result_order=%s\n' "$order"
  printf 'expected_flag=%s\n' "$DNS_FLAG"
  if command -v node >/dev/null 2>&1; then
    node "$DNS_FLAG" -e '
const dns=require("dns");
const tls=require("tls");
const host="api.z.ai";
const t0=performance.now();
dns.lookup(host,{all:true},(err,addrs)=>{
  if(err){console.error("lookup_error", err.message); process.exit(1)}
  const t1=performance.now();
  const s=tls.connect({host,port:443,servername:host},()=>{
    const total=performance.now()-t0;
    console.log(JSON.stringify({
      host,
      order: dns.getDefaultResultOrder(),
      dns_ms: Math.round(t1-t0),
      handshake_ms: Math.round(total),
      first_addr: addrs[0]?.address,
      first_family: addrs[0]?.family,
    }));
    s.end();
  });
  s.on("error", e=>{console.error(e.message); process.exit(1)});
});
' 2>/dev/null || true
  fi
}

cmd_apply() {
  export_flag_current_shell
  for rcfile in "${HOME}/.zshrc" "${HOME}/.bashrc"; do
    ensure_shell_export "$rcfile"
  done
  printf 'model-network-tune: applied %s to NODE_OPTIONS and shell rc\n' "$DNS_FLAG"
  printf 'Reload shell or: export NODE_OPTIONS=%q\n' "${NODE_OPTIONS}"
}

cmd_measure() {
  hosts_list
  export_flag_current_shell
  if ! command -v node >/dev/null 2>&1; then
    printf 'node is required for measure\n' >&2
    exit 1
  fi
  node "$DNS_FLAG" - "${HOSTS[@]}" <<'NODE'
const dns = require("node:dns");
const tls = require("node:tls");
const { performance } = require("node:perf_hooks");

const hosts = process.argv.slice(2);

function handshake(host, order) {
  return new Promise((resolve) => {
    const previous = dns.getDefaultResultOrder?.();
    if (order && dns.setDefaultResultOrder) dns.setDefaultResultOrder(order);
    const t0 = performance.now();
    dns.lookup(host, { all: true }, (err, addrs) => {
      const dnsMs = performance.now() - t0;
      if (err) {
        if (previous && dns.setDefaultResultOrder) dns.setDefaultResultOrder(previous);
        resolve({ host, order, error: err.message, dns_ms: Math.round(dnsMs) });
        return;
      }
      const socket = tls.connect(
        { host, port: 443, servername: host, rejectUnauthorized: true },
        () => {
          const total = performance.now() - t0;
          socket.end();
          if (previous && dns.setDefaultResultOrder) dns.setDefaultResultOrder(previous);
          resolve({
            host,
            order,
            dns_ms: Math.round(dnsMs),
            handshake_ms: Math.round(total),
            first_addr: addrs[0]?.address ?? null,
            first_family: addrs[0]?.family ?? null,
          });
        },
      );
      socket.setTimeout(10_000, () => {
        socket.destroy(new Error("timeout"));
      });
      socket.on("error", (error) => {
        if (previous && dns.setDefaultResultOrder) dns.setDefaultResultOrder(previous);
        resolve({ host, order, error: error.message, dns_ms: Math.round(dnsMs) });
      });
    });
  });
}

(async () => {
  const rows = [];
  for (const host of hosts) {
    // cold-ish samples
    const v4 = await handshake(host, "ipv4first");
    const ver = await handshake(host, "verbatim");
    rows.push({ host, ipv4first: v4, verbatim: ver });
  }
  for (const row of rows) {
    const a = row.ipv4first;
    const b = row.verbatim;
    const aMs = a.handshake_ms ?? "err";
    const bMs = b.handshake_ms ?? "err";
    const save =
      typeof a.handshake_ms === "number" && typeof b.handshake_ms === "number"
        ? `${b.handshake_ms - a.handshake_ms}ms`
        : "n/a";
    console.log(
      `${row.host.padEnd(22)} ipv4first=${String(aMs).padStart(4)}ms (${a.first_family ?? "?"})  verbatim=${String(bMs).padStart(4)}ms (${b.first_family ?? "?"})  save≈${save}`,
    );
  }
  console.log("# lower handshake_ms is better; api.z.ai usually benefits most from ipv4first");
})();
NODE
}

cmd_warm() {
  hosts_list
  export_flag_current_shell
  if ! command -v node >/dev/null 2>&1; then
    printf 'node is required for warm\n' >&2
    exit 1
  fi
  node "$DNS_FLAG" - "${HOSTS[@]}" <<'NODE'
const tls = require("node:tls");
const { performance } = require("node:perf_hooks");
const hosts = process.argv.slice(2);
function warm(host) {
  return new Promise((resolve) => {
    const t0 = performance.now();
    const socket = tls.connect({ host, port: 443, servername: host }, () => {
      const ms = Math.round(performance.now() - t0);
      socket.end();
      resolve({ host, ok: true, ms });
    });
    socket.setTimeout(8_000, () => socket.destroy(new Error("timeout")));
    socket.on("error", (error) => resolve({ host, ok: false, error: error.message }));
  });
}
(async () => {
  const results = await Promise.all(hosts.map(warm));
  for (const r of results) {
    if (r.ok) console.log(`warm ok  ${r.host.padEnd(22)} ${r.ms}ms`);
    else console.log(`warm fail ${r.host.padEnd(22)} ${r.error}`);
  }
})();
NODE
}

cmd_install() {
  cmd_apply
  # Best-effort warm so first Pi turn after install is less cold.
  if command -v node >/dev/null 2>&1; then
    cmd_warm || true
  fi
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    status) cmd_status ;;
    apply) cmd_apply ;;
    measure) cmd_measure ;;
    warm) cmd_warm ;;
    install) cmd_install ;;
    -h|--help|help|"") usage; [ -n "$cmd" ] || exit 0; exit 0 ;;
    *)
      printf 'unknown command: %s\n' "$cmd" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
