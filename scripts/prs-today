#!/usr/bin/env node
import { execFile } from "node:child_process";
import { promisify } from "node:util";

const run = promisify(execFile);
const LIMIT = 100;
const VIEW_FIELDS = "state,reviewDecision,statusCheckRollup,baseRefName,headRefName,headRepository,mergeable,url";
const USAGE = `Usage: prs-today

List your open PRs across every org, grouped by repo: review decision, CI,
base, mergeable, and the merge order of stacked PRs.
`;

if (process.argv.slice(2).some((arg) => arg === "-h" || arg === "--help")) {
	process.stdout.write(USAGE);
	process.exit(0);
}
if (process.argv.length > 2) {
	process.stderr.write(`prs-today: unexpected argument: ${process.argv[2]}\n${USAGE}`);
	process.exit(2);
}

async function gh(args) {
	const { stdout } = await run("gh", args, { maxBuffer: 32 * 1024 * 1024 });
	return JSON.parse(stdout);
}

const FAILED = new Set(["FAILURE", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE", "ERROR"]);

function ciSummary(checks) {
	if (!Array.isArray(checks) || checks.length === 0) return "none";
	const states = checks.map((check) =>
		check.__typename === "StatusContext" ? { done: !["PENDING", "EXPECTED"].includes(check.state), result: check.state } : { done: check.status === "COMPLETED", result: check.conclusion },
	);
	if (states.some((state) => FAILED.has(state.result))) return "fail";
	if (states.some((state) => !state.done)) return "pending";
	return "pass";
}

async function mapLimit(items, limit, task) {
	const results = new Array(items.length);
	let next = 0;
	const worker = async () => {
		while (next < items.length) {
			const index = next;
			next += 1;
			results[index] = await task(items[index]);
		}
	};
	await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker));
	return results;
}

function stackOrder(prs) {
	const open = prs.filter((pr) => pr.view?.state === "OPEN");
	const parentOf = new Map();
	for (const child of open) {
		const parents = open.filter(
			(pr) => pr !== child && pr.view.headRepository?.nameWithOwner?.toLowerCase() === child.repo.toLowerCase() && pr.view.headRefName === child.view.baseRefName,
		);
		if (parents.length > 1) return null;
		if (parents.length === 1) parentOf.set(child, parents[0]);
	}
	const byNumber = (a, b) => a.number - b.number;
	const ordered = [];
	const placed = new Set();
	const place = (pr) => {
		placed.add(pr);
		ordered.push(pr);
		for (const child of open.filter((candidate) => parentOf.get(candidate) === pr).sort(byNumber)) place(child);
	};
	for (const root of open.filter((pr) => !parentOf.has(pr)).sort(byNumber)) place(root);
	if (placed.size !== open.length) return null;
	return { ordered: [...ordered, ...prs.filter((pr) => !open.includes(pr)).sort(byNumber)], parentOf };
}

function row(pr, parent) {
	if (pr.error) return `  #${pr.number} view failed: ${pr.error}  ${pr.url}`;
	const view = pr.view;
	if (view.state !== "OPEN") return `  #${pr.number} ${view.state.toLowerCase()} since the search  ${view.url}`;
	const after = parent ? ` after #${parent.number}` : "";
	return `  #${pr.number}${after} review=${view.reviewDecision || "none"} ci=${ciSummary(view.statusCheckRollup)} base=${view.baseRefName} mergeable=${view.mergeable}  ${view.url}`;
}

const found = await gh(["search", "prs", "--author", "@me", "--state", "open", "--limit", String(LIMIT), "--json", "number,repository,url"]);
if (found.length >= LIMIT) process.stderr.write(`prs-today: warning: ${found.length} PRs returned, the list may be truncated\n`);
const prs = await mapLimit(found, 8, async (pr) => {
	const base = { number: pr.number, repo: pr.repository.nameWithOwner, url: pr.url };
	try {
		return { ...base, view: await gh(["pr", "view", String(pr.number), "-R", base.repo, "--json", VIEW_FIELDS]) };
	} catch (error) {
		return { ...base, error: String(error.stderr || error.message).trim().split("\n")[0] };
	}
});

const repos = new Map();
for (const pr of prs) repos.set(pr.repo, [...(repos.get(pr.repo) ?? []), pr]);
if (repos.size === 0) process.stdout.write("no open PRs\n");
for (const repo of [...repos.keys()].sort((a, b) => a.localeCompare(b))) {
	const group = repos.get(repo);
	process.stdout.write(`${repo}\n`);
	const stack = stackOrder(group);
	if (!stack) {
		process.stdout.write("  stack: ambiguous\n");
		for (const pr of group.sort((a, b) => a.number - b.number)) process.stdout.write(`${row(pr, null)}\n`);
		continue;
	}
	for (const pr of stack.ordered) process.stdout.write(`${row(pr, stack.parentOf.get(pr))}\n`);
}
