#!/usr/bin/env bash
# Build or append outcome_metric with participant_usage / batch fields (blueprint M1 producers).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
WORKFLOW_DIR=".workflow"
APPLY=0
JSON=1
SUCCESS_KIND="run_terminal"
RUNTIME=""
PARENT_INPUT=""
PARENT_OUTPUT=""
PARENT_TOTAL=""
SUCCESS=1

usage() {
  cat <<EOF
Usage: workflow-outcome-metric [--dir path] [--apply] [--text]
       [--parent-input N --parent-output N [--parent-total N]]
       [--success-kind run_terminal|task_grader] [--runtime id]
       <slug>

Dry-run (default) prints a candidate outcome_metric detail built from ledger
multi_execution_completed usage + optional parent tokens.
--apply appends only when the ledger is non-terminal and has no measured
outcome_metric yet. Never invents token totals.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dir) WORKFLOW_DIR="${2:-}"; shift 2 ;;
    --apply) APPLY=1; shift ;;
    --text) JSON=0; shift ;;
    --parent-input) PARENT_INPUT="${2:-}"; shift 2 ;;
    --parent-output) PARENT_OUTPUT="${2:-}"; shift 2 ;;
    --parent-total) PARENT_TOTAL="${2:-}"; shift 2 ;;
    --success-kind) SUCCESS_KIND="${2:-}"; shift 2 ;;
    --runtime) RUNTIME="${2:-}"; shift 2 ;;
    --failed) SUCCESS=0; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) printf 'unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    *) break ;;
  esac
done

slug="${1:-}"
if [ -z "$slug" ]; then
  usage >&2
  exit 2
fi

file="$WORKFLOW_DIR/$slug/events.jsonl"
if [ ! -f "$file" ]; then
  printf 'ledger not found: %s\n' "$file" >&2
  exit 1
fi

export OM_FILE="$file"
export OM_APPLY="$APPLY"
export OM_JSON="$JSON"
export OM_SUCCESS_KIND="$SUCCESS_KIND"
export OM_RUNTIME="$RUNTIME"
export OM_PARENT_INPUT="$PARENT_INPUT"
export OM_PARENT_OUTPUT="$PARENT_OUTPUT"
export OM_PARENT_TOTAL="$PARENT_TOTAL"
export OM_SUCCESS="$SUCCESS"
export OM_SLUG="$slug"
export OM_BUILDER="$ROOT_DIR/scripts/lib/outcome-metric-builder.mjs"
export OM_APPEND="$ROOT_DIR/scripts/lib/ledger-auto-emit.mjs"

node --input-type=module <<'NODE'
import { readFileSync } from "node:fs"
import { pathToFileURL } from "node:url"

const builder = await import(pathToFileURL(process.env.OM_BUILDER).href)
const { appendLedgerEvent } = await import(pathToFileURL(process.env.OM_APPEND).href)

const file = process.env.OM_FILE
const events = readFileSync(file, "utf8")
  .split("\n")
  .filter(Boolean)
  .map((line) => JSON.parse(line))

if (!builder.isLedgerOpen(events)) {
  console.error("ledger is terminal; refuse to build/apply outcome_metric")
  process.exit(1)
}

/** @type {any} */
const opts = {
  success: process.env.OM_SUCCESS !== "0",
  success_kind: process.env.OM_SUCCESS_KIND,
  runtime: process.env.OM_RUNTIME || undefined,
  grader_success: process.env.OM_SUCCESS_KIND === "task_grader" ? true : undefined,
}

if (process.env.OM_PARENT_INPUT !== "" && process.env.OM_PARENT_OUTPUT !== "") {
  opts.parent = {
    id: "parent",
    role: "parent",
    input_tokens: Number(process.env.OM_PARENT_INPUT),
    output_tokens: Number(process.env.OM_PARENT_OUTPUT),
  }
  if (process.env.OM_PARENT_TOTAL !== "") {
    opts.parent.total_tokens = Number(process.env.OM_PARENT_TOTAL)
  }
}

const detail = builder.buildFromLedgerEvents(events, opts)

if (process.env.OM_JSON === "1") {
  console.log(JSON.stringify({ slug: process.env.OM_SLUG, detail, apply: process.env.OM_APPLY === "1" }, null, 2))
} else {
  console.log(`measured=${detail.measured}`)
  console.log(`total_tokens=${detail.total_tokens ?? "n/a"}`)
  console.log(`participants=${Array.isArray(detail.participant_usage) ? detail.participant_usage.length : 0}`)
  console.log(`batch_wall_clock_ms=${detail.batch_wall_clock_ms ?? "n/a"}`)
}

if (process.env.OM_APPLY === "1") {
  if (builder.hasMeasuredOutcomeMetric(events)) {
    console.error("measured outcome_metric already present; skip apply")
    process.exit(0)
  }
  if (detail.measured !== true) {
    console.error("refusing to apply unmeasured outcome_metric via --apply (pass parent tokens or multi_execution usage)")
    process.exit(1)
  }
  appendLedgerEvent(file, "outcome_metric", detail, process.env.OM_SLUG)
  console.error("appended outcome_metric")
}
NODE
