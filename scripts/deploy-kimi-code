#!/usr/bin/env bash
# deploy-kimi-code — sync Etabli skills into a Kimi Code skills directory.
#
# Copies a fixed whitelist of skills into ~/.kimi-code/skills/ (or a custom
# KIMI_CODE_HOME). The Etabli skills are sourced from etabli/pi/skills (the same
# canonical SKILL.md files pi uses); the rtk skill is sourced from
# etabli/kimi-code/skills (kimi-code-specific, no pi equivalent).
#
# Safety:
#   - Only the whitelisted skills are ever written. Other skills already present
#     in the target (e.g. plan-loop, implement in their kimi-code-adapted form)
#     are never touched or deleted.
#   - Default mode is --dry-run. --apply performs the copy.
#   - An existing whitelisted skill whose content differs from the source is
#     backed up and replaced only with --force; without --force it is skipped
#     with a warning.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
PI_SKILLS_DIR="$REPO_DIR/pi/skills"
KIMI_SKILLS_DIR="$REPO_DIR/kimi-code/skills"

DRY_RUN=1
FORCE=0
KIMI_CODE_HOME_INPUT="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"

COPIED=0
SKIPPED=0
BACKED_UP=0
WARNED=0

# Etabli skills mirrored from etabli/pi/skills (canonical pi source).
ETABLI_SKILLS=(
  caveman
  adversary
  bug-check
  ci-fix
  github-pr-review
  grill-me
  linear-ticket-create
  linear-work
  pr-qa
  pr-review
  sec-pr
  verify
)

usage() {
  cat <<EOF
Usage: $(basename "$0") [--dry-run] [--apply] [--force] [--kimi-home DIR]

Deploy Etabli + rtk skills into a Kimi Code skills directory.

Options:
  --dry-run         Show planned copies without touching the target (default)
  --apply           Copy skills into the target Kimi Code home
  --force           Backup and replace a whitelisted skill that differs from source
  --kimi-home DIR   Target Kimi Code home, defaults to KIMI_CODE_HOME or ~/.kimi-code
  -h, --help        Show this help

Examples:
  deploy-kimi-code --dry-run
  deploy-kimi-code --apply
  deploy-kimi-code --apply --force
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --apply) DRY_RUN=0 ;;
    --force) FORCE=1 ;;
    --kimi-home)
      [ "$#" -lt 2 ] && { printf 'missing value for --kimi-home\n' >&2; exit 2; }
      KIMI_CODE_HOME_INPUT="$2"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if [ ! -d "$PI_SKILLS_DIR" ]; then
  printf 'error: pi skills source not found: %s\n' "$PI_SKILLS_DIR" >&2
  exit 1
fi
if [ ! -d "$KIMI_SKILLS_DIR" ]; then
  printf 'error: kimi-code skills source not found: %s\n' "$KIMI_SKILLS_DIR" >&2
  exit 1
fi

TARGET_SKILLS="$KIMI_CODE_HOME_INPUT/skills"

deploy_one() {
  local name="$1" src_dir="$2"
  local src="$src_dir/$name/SKILL.md"
  local dst="$TARGET_SKILLS/$name"
  local dst_md="$dst/SKILL.md"

  if [ ! -f "$src" ]; then
    printf '  WARN  %s: source missing (%s)\n' "$name" "$src" >&2
    WARNED=$((WARNED + 1))
    return
  fi

  if [ -e "$dst" ] && [ ! -f "$dst_md" ]; then
    printf '  WARN  %s: target exists but has no SKILL.md, skipping (manual review)\n' "$name" >&2
    WARNED=$((WARNED + 1))
    return
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    if [ -f "$dst_md" ] && ! diff -q "$src" "$dst_md" >/dev/null 2>&1; then
      printf '  PLAN  %s: replace (differs from source, needs --force)\n' "$name"
    elif [ -f "$dst_md" ]; then
      printf '  PLAN  %s: up to date\n' "$name"
    else
      printf '  PLAN  %s: create\n' "$name"
    fi
    return
  fi

  if [ -f "$dst_md" ]; then
    if diff -q "$src" "$dst_md" >/dev/null 2>&1; then
      printf '  OK    %s: up to date\n' "$name"
      SKIPPED=$((SKIPPED + 1))
      return
    fi
    if [ "$FORCE" -ne 1 ]; then
      printf '  SKIP  %s: differs from source (use --force to replace)\n' "$name" >&2
      WARNED=$((WARNED + 1))
      return
    fi
    local backup="${dst}.bak-${TIMESTAMP}"
    mv "$dst" "$backup"
    printf '  BACKUP %s -> %s\n' "$name" "$(basename "$backup")"
    BACKED_UP=$((BACKED_UP + 1))
  fi

  cp -R "$src_dir/$name" "$dst"
  printf '  COPY  %s\n' "$name"
  COPIED=$((COPIED + 1))
}

mkdir -p "$TARGET_SKILLS"
printf 'Deploy target : %s\n' "$TARGET_SKILLS"
printf 'Source (pi)   : %s\n' "$PI_SKILLS_DIR"
printf 'Source (kimi) : %s\n' "$KIMI_SKILLS_DIR"
printf 'Mode          : %s\n' "$([ "$DRY_RUN" -eq 1 ] && echo 'dry-run' || echo 'apply')  force=$FORCE"
printf '\n--- Etabli skills ---\n'
for s in "${ETABLI_SKILLS[@]}"; do
  deploy_one "$s" "$PI_SKILLS_DIR"
done
printf -- '--- kimi-code skills ---\n'
deploy_one "rtk" "$KIMI_SKILLS_DIR"
printf '\nSummary: copied=%d skipped=%d backed_up=%d warnings=%d\n' \
  "$COPIED" "$SKIPPED" "$BACKED_UP" "$WARNED"

if [ "$DRY_RUN" -eq 1 ]; then
  printf '\n(dry-run: nothing was changed. Re-run with --apply to deploy.)\n'
fi

# A whitelisted skill that could not be sourced or deployed is a defect: make
# drift visible to automation rather than hiding behind a 0 exit.
if [ "$WARNED" -gt 0 ]; then
  exit 1
fi
