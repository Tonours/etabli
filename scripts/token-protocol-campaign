#!/usr/bin/env node
// scripts/token-protocol-campaign — T8b paid-campaign runner (NEW, T8b engine).
//
// Paid path for the T8b screening (72 runs) + economic (36 runs) campaigns.
// Model zai/glm-5.3 ONLY; every invocation is pinned by the campaign freeze
// (model, max_tokens, timeout, retries, sampling, graders, worktrees,
// corpus shas). Refuses any other provider, any freeze mismatch, any
// cap breach.
//
// Usage:
//   token-protocol-campaign --self-test
//     Offline fixture suite (refusals + grader/veto/validity vectors +
//     trace mapping + report integration). $0. Must be GREEN before any
//     paid run.
//   token-protocol-campaign --dry-run --flow screening|economic
//     Validate freeze + worktrees + corpus, print the run plan. $0.
//   token-protocol-campaign --flow screening --out <absent-or-empty dir>
//   token-protocol-campaign --flow economic --out <absent-or-empty dir>
//     Execute the campaign (paid). Spend is tracked run-by-run in the
//     shared t8b-runs/2026-09-25/spend.jsonl against the $100 hard cap.
// Options: --freeze <path> (default t8b-runs/2026-09-25/campaign-freeze.json).
//
// Exit codes: 0 campaign complete (verdict in summary.json) | 1 refusal or
// error | 3 BLOCKED (partial = crash, retry exhausted) | 4 NONRUN (cap
// guard tripped before the first run).

import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import {
  cpSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync,
  statSync, writeFileSync,
} from "node:fs";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import {
  attestPointerEvent, baseArgv, buildRunTrace, costOf, createSpendTracker,
  diffSnapshots, parsePiJsonl, planLoopArgv, PREAMBLE,
  sha256Bytes, sha256Text, snapshotTree,
  spawnPiCapture, NONINFERIORITY, REPO_ROOT,
} from "./lib/t8b-engine.mjs";
import {
  checkPlanLoopValidity, checkPointerValidity, gradeDossier, gradeDispatch,
  gradeHunter, gradePlanLoop, gradePointerLogic, gradePointerSpec,
  lostRequirementVeto, TASKS,
} from "./lib/t8b-graders.mjs";
import { parseFindings } from "./lib/token-finding-parser.mjs";

const SELF = join(dirname(fileURLToPath(import.meta.url)), "token-protocol-campaign");
const DAY_DIR = join(REPO_ROOT, "t8b-runs/2026-09-25");
const DEFAULT_FREEZE = join(DAY_DIR, "campaign-freeze.json");
const FIX = join(REPO_ROOT, "tests/fixtures/token-protocol");
const REPORT = join(REPO_ROOT, "scripts/token-task-report");

function fail(msg) {
  console.error(`token-protocol-campaign: REFUSED — ${msg}`);
  process.exit(1);
}

function parseArgs(argv) {
  const out = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--self-test") out.selfTest = true;
    else if (a === "--dry-run") out.dryRun = true;
    else if (a.startsWith("--")) {
      const key = a.slice(2).replace(/-([a-z])/g, (_, c) => c.toUpperCase());
      out[key] = argv[++i] ?? "";
    }
  }
  return out;
}

function shaFile(p) { return sha256Bytes(readFileSync(p)); }

function dirSha(dir) {
  const files = [];
  const walk = (d) => {
    for (const e of readdirSync(d).sort()) {
      const full = join(d, e);
      if (statSync(full).isDirectory()) walk(full);
      else files.push(full);
    }
  };
  walk(dir);
  const lines = files.sort().map((f) => {
    const rel = f.slice(dir.length + 1);
    return `${shaFile(f)}  ${rel}\n`;
  });
  return sha256Bytes(Buffer.from(lines.join(""), "utf8"));
}

function loadJson(p, what) {
  try {
    return JSON.parse(readFileSync(p, "utf8"));
  } catch (err) {
    fail(`cannot read ${what} ${p}: ${err.message}`);
  }
}

// ---- freeze verification ----

function verifyFreeze(freezePath) {
  const freeze = loadJson(resolve(freezePath), "campaign freeze");
  if (freeze.schema_version !== 1) fail("freeze schema_version want 1");
  if (freeze.model !== "zai/glm-5.3") fail(`freeze model want zai/glm-5.3, got ${freeze.model}`);
  for (const [rel, want] of Object.entries(freeze.pins?.engine ?? {})) {
    const full = join(REPO_ROOT, rel);
    if (!existsSync(full)) fail(`pinned engine file missing: ${rel}`);
    const actual = shaFile(full);
    if (actual !== want) fail(`engine file ${rel} differs from freeze (want ${want.slice(0, 12)}…, got ${actual.slice(0, 12)}…)`);
  }
  for (const [name, want] of Object.entries(freeze.pins?.worktrees ?? {})) {
    const dir = join(DAY_DIR, "worktrees", name);
    if (!existsSync(dir)) fail(`pinned worktree missing: ${name}`);
    const actual = dirSha(dir);
    if (actual !== want) fail(`worktree ${name} differs from freeze (want ${want.slice(0, 12)}…, got ${actual.slice(0, 12)}…)`);
  }
  for (const [rel, want] of Object.entries(freeze.pins?.corpus ?? {})) {
    const full = join(REPO_ROOT, rel);
    if (!existsSync(full)) fail(`pinned corpus file missing: ${rel}`);
    const actual = shaFile(full);
    if (actual !== want) fail(`corpus file ${rel} differs from freeze`);
  }
  return freeze;
}

function freezeArtifacts(freeze) {
  return {
    freeze_tuple: { ...freeze.freeze_tuple },
    resources: { ...freeze.resources },
  };
}

function requireAbsentOrEmpty(outDir) {
  if (!existsSync(outDir)) return;
  if (!statSync(outDir).isDirectory()) fail(`out-dir ${outDir} exists and is not a directory`);
  if (readdirSync(outDir).length > 0) fail(`out-dir ${outDir} is not empty (absent-or-empty rule)`);
}

// ---- hunter argv via the worktree variant inputs (functional) ----
// Calls <worktree>/scripts/pi-review-hunter --print-argv and substitutes
// --mode json (+ model/thinking appends) for capture. The construction
// (template slot + patch slot) is exactly the script's.

function hunterArgv({ worktree, promptFile, patchFile, patchFirst, concatOut, freeze }) {
  const script = join(worktree, "scripts/pi-review-hunter");
  const args = ["--print-argv", "--prompt-file", promptFile, "--patch", patchFile];
  if (patchFirst) args.push("--patch-first", "--concat-out", concatOut);
  const res = spawnSync(script, args, { encoding: "utf8" });
  if (res.status !== 0) {
    throw new Error(`pi-review-hunter --print-argv failed: ${(res.stderr ?? "").trim().slice(0, 200)}`);
  }
  const lines = res.stdout.split("\n").filter((l) => l !== "");
  const timeoutLine = lines.shift();
  const m = /^TIMEOUT=(\d+)$/.exec(timeoutLine ?? "");
  if (!m || Number(m[1]) !== freeze.timeout_s) {
    throw new Error(`hunter TIMEOUT ${timeoutLine} != freeze timeout_s ${freeze.timeout_s}`);
  }
  const argv = [];
  for (let i = 0; i < lines.length; i++) {
    if (lines[i] === "--mode") { argv.push("--mode", "json"); i++; continue; }
    argv.push(lines[i]);
  }
  argv.push("--model", freeze.model, "--thinking", freeze.thinking);
  return argv;
}

// ---- economic strict grading (R-T8b-9: frozen whole-text semantics, so
// run verdicts agree with the frozen --check-parity) ----

function gradeEconomicStrict(output, patch) {
  const text = typeof output === "string" ? output : "";
  const parsed = parseFindings(text);
  if (!parsed.ok) return { pass: false, detail: `unparseable: ${parsed.error}` };
  if (patch.expect === "zero") {
    return parsed.findings.length === 0
      ? { pass: true, detail: "clean, zero findings" }
      : { pass: false, detail: `clean patch yielded ${parsed.findings.length} finding(s)` };
  }
  if (parsed.findings.length === 0) return { pass: false, detail: "defective patch yielded zero findings" };
  const re = new RegExp(patch.regex.slice(1, patch.regex.lastIndexOf("/")), patch.regex.slice(patch.regex.lastIndexOf("/") + 1));
  for (const f of parsed.findings) {
    if (f.file !== patch.file) return { pass: false, detail: `wrong file '${f.file}'` };
    if (!patch.valid_lines.includes(f.line)) return { pass: false, detail: `line ${f.line} outside valid range` };
    const t = `${f.issue} ${f.impact} ${f.review_comment} ${f.suggested_fix}`;
    if (!re.test(t)) return { pass: false, detail: "keyword regex miss" };
  }
  return { pass: true, detail: `${parsed.findings.length} conforming finding(s)` };
}

// ---- run plans ----

function screeningPlan(freeze) {
  const plan = [];
  for (const taskId of freeze.screening_tasks) {
    for (const variant of ["baseline", "candidate"]) {
      for (let run = 1; run <= freeze.runs; run++) plan.push({ taskId, variant, run });
    }
  }
  return plan;
}

function economicPlan(freeze) {
  const plan = [];
  for (const patchId of freeze.economic_patches) {
    for (const variant of ["baseline", "candidate"]) {
      for (let run = 1; run <= freeze.runs; run++) plan.push({ patchId, variant, run });
    }
  }
  return plan;
}

function loadParity() {
  const manifest = loadJson(join(FIX, "parity-manifest.json"), "parity manifest");
  const map = new Map(manifest.patches.map((p) => [p.id, p]));
  const spec = loadJson(join(FIX, "spec-breach.json"), "spec breach");
  map.set(spec.id, spec);
  return map;
}

// ---- screening run ----

async function executeScreeningRun(ctx, spec) {
  const { freeze, out, parity, tracker } = ctx;
  const { taskId, variant, run } = spec;
  const task = TASKS[taskId];
  if (!task) throw new Error(`unknown screening task ${taskId}`);
  const runId = `screening/${taskId}/${variant}/r${run}`;
  const runDir = join(out, "runs", taskId, variant, `r${run}`);
  const worktree = join(runDir, "worktree");
  const inputs = join(runDir, "inputs");
  mkdirSync(inputs, { recursive: true });
  cpSync(join(DAY_DIR, "worktrees", variant), worktree, { recursive: true });
  const before = snapshotTree(worktree);
  const body = readFileSync(join(FIX, task.body), "utf8");

  let argv;
  let env = {};
  let slotControl = null;
  if (task.kind === "plan-loop") {
    const taskFile = join(inputs, "task.md");
    writeFileSync(taskFile, PREAMBLE(worktree) + body);
    argv = [...planLoopArgv({ freeze }), `@${taskFile}`];
  } else if (task.kind === "hunter") {
    const patch = parity.get(task.patch);
    const patchFile = join(inputs, "patch.diff");
    writeFileSync(patchFile, patch.diff);
    const taskFile = join(inputs, "task.md");
    writeFileSync(taskFile, body);
    argv = hunterArgv({ worktree, promptFile: join(worktree, "workflow/templates/review-logic-hunter.md"),
      patchFile: taskFile, freeze });
    void patchFile;
  } else if (task.kind === "pointer-dossier" || task.kind === "pointer-spec") {
    const taskFile = join(inputs, "task.md");
    writeFileSync(taskFile, PREAMBLE(worktree) + body);
    if (variant === "candidate") {
      argv = [...baseArgv(freeze, { tools: "read,emit-pointer-follow",
        extension: join(REPO_ROOT, "scripts/lib/t8b-pi-tools.mjs") }), `@${taskFile}`];
      env = { T8B_RUN_DIR: runDir, T8B_WORKTREE: worktree,
        T8B_PINNED_PATCH: "pp-null-deref", T8B_PINNED_SHA: "unused",
        T8B_PATCH_FILE: join(inputs, "unused.patch"),
        T8B_LOGIC_TEMPLATE: join(worktree, "workflow/templates/review-logic-hunter.md"),
        T8B_SPEC_TEMPLATE: join(worktree, "workflow/templates/review-spec-hunter.md"),
        T8B_MODEL: freeze.model, T8B_THINKING: freeze.thinking, T8B_TIMEOUT_S: String(freeze.timeout_s) };
    } else {
      argv = [...baseArgv(freeze, { tools: "read" }), `@${taskFile}`];
    }
  } else if (task.kind === "pointer-dispatch") {
    const patch = parity.get(task.patch);
    const patchFile = join(inputs, "patch.diff");
    writeFileSync(patchFile, patch.diff);
    const taskFile = join(inputs, "task.md");
    writeFileSync(taskFile, PREAMBLE(worktree) + body);
    const tools = variant === "candidate" ? "read,emit-pointer-follow,dispatch-review" : "read,dispatch-review";
    argv = [...baseArgv(freeze, { tools, extension: join(REPO_ROOT, "scripts/lib/t8b-pi-tools.mjs") }), `@${taskFile}`];
    env = { T8B_RUN_DIR: runDir, T8B_WORKTREE: worktree,
      T8B_PINNED_PATCH: patch.id, T8B_PINNED_SHA: sha256Text(patch.diff),
      T8B_PATCH_FILE: patchFile,
      T8B_LOGIC_TEMPLATE: join(worktree, "workflow/templates/review-logic-hunter.md"),
      T8B_SPEC_TEMPLATE: join(worktree, "workflow/templates/review-spec-hunter.md"),
      T8B_MODEL: freeze.model, T8B_THINKING: freeze.thinking, T8B_TIMEOUT_S: String(freeze.timeout_s) };
  } else if (task.kind === "pointer-logic") {
    const patch = parity.get(task.patch);
    const patchFile = join(inputs, "patch.diff");
    writeFileSync(patchFile, patch.diff);
    const template = readFileSync(join(worktree, "workflow/templates/review-logic-hunter.md"), "utf8");
    if (variant === "baseline") {
      const taskFile = join(inputs, "task.md");
      writeFileSync(taskFile, body);
      argv = hunterArgv({ worktree, promptFile: join(worktree, "workflow/templates/review-logic-hunter.md"),
        patchFile: taskFile, freeze });
      slotControl = true;
    } else {
      const concatOut = join(inputs, "concat.md");
      argv = hunterArgv({ worktree, promptFile: join(worktree, "workflow/templates/review-logic-hunter.md"),
        patchFile: patchFile, patchFirst: true, concatOut, freeze });
      const concat = readFileSync(concatOut, "utf8");
      slotControl = concat.startsWith(patch.diff) && concat.includes(template);
    }
  } else {
    throw new Error(`unhandled task kind ${task.kind}`);
  }

  const res = await spawnPiCapture({ argv, cwd: worktree, timeoutS: freeze.timeout_s,
    env, stdoutFile: join(runDir, "pi-events.jsonl"), stderrFile: join(runDir, "stderr.log") });
  const after = snapshotTree(worktree);
  const fsDiff = diffSnapshots(before, after);
  if (res.timedOut || res.exit !== 0) {
    return { missing: res.timedOut ? `pi timeout (${freeze.timeout_s}s)` : `pi exit ${res.exit}`, runId, spec };
  }
  const { events, invalidLines } = parsePiJsonl(res.stdout);
  if (invalidLines.length > 0) return { missing: `invalid jsonl lines ${invalidLines.join(",")}`, runId, spec };
  const built = buildRunTrace(events, { runId, worktreeAbs: worktree });
  if (!built.terminal || (built.stopReason !== "stop" && built.stopReason !== "length") || !built.usage) {
    return { missing: `non-terminal run (stop=${built.stopReason}, receipts=${built.receipts})`, runId, spec };
  }
  if (built.models.length !== 1 || built.models[0] !== freeze.model) {
    return { missing: `model provenance [${built.models.join(",")}] != ${freeze.model}`, runId, spec };
  }
  const spendRow = tracker.record({ run_id: runId, flow: "screening", task: taskId,
    variant, run, usage: built.usage, elapsed_ms: res.elapsedMs, freeze: freeze.freeze_version });
  void spendRow;

  writeFileSync(join(runDir, "trace.json"), `${JSON.stringify(built.trace, null, 1)}\n`);
  writeFileSync(join(runDir, "final.txt"), built.finalText);
  writeFileSync(join(runDir, "usage.json"), `${JSON.stringify(built.usage)}\n`);

  const writeVeto = !fsDiff.clean
    ? { type: "write_surface", detail: `worktree diff: +${fsDiff.added.length}/~${fsDiff.modified.length}/-${fsDiff.deleted.length}` } : null;
  const lengthStop = built.stopReason === "length";
  let verdict;
  let veto = writeVeto;
  let grade = null;
  let requirement = null;
  let validity = null;
  let event = null;

  if (task.kind === "plan-loop") {
    grade = gradePlanLoop(built.finalText, task);
    validity = checkPlanLoopValidity(built.reads, variant, task);
    if (!validity.valid && validity.contamination) {
      veto = veto ?? { type: "contamination", detail: validity.reasons.join("; ") };
      verdict = "fail";
    } else if (!validity.valid) {
      verdict = "invalid";
      veto = veto ?? grade.veto;
    } else if (lengthStop) {
      verdict = "fail";
    } else {
      verdict = grade.pass ? "pass" : "fail";
      veto = veto ?? grade.veto;
    }
    requirement = Object.fromEntries(Object.entries(grade.items).map(([k, v]) => [k, v.pass]));
  } else if (task.kind === "hunter") {
    const patch = parity.get(task.patch);
    grade = freeze.screening_hunter_parse === "strict"
      ? (() => { const s = gradeEconomicStrict(built.finalText, patch);
          return { kind: "hunter-strict", pass: s.pass, veto: null, requirement: s.pass, detail: s.detail }; })()
      : gradeHunter(built.finalText, patch);
    if (lengthStop) { verdict = "fail"; veto = veto ?? null; }
    else { verdict = grade.pass ? "pass" : "fail"; veto = veto ?? grade.veto; }
    requirement = grade.requirement;
  } else if (task.kind === "pointer-dossier") {
    grade = gradeDossier(built.finalText);
    const emitted = built.emitCalls.length > 0;
    if (variant === "candidate" && emitted) {
      const att = attestPointerEvent({ runTrace: built.trace, emitCall: built.emitCalls[0],
        runId, worktreeAbs: worktree, runDir });
      validity = checkPointerValidity({ variant, strongOk: att.ok, strongDetail: att.strongDetail, emitted });
      if (att.ok) { event = att.event; writeFileSync(join(runDir, "events.jsonl"), `${JSON.stringify(att.event)}\n`); }
    } else {
      validity = checkPointerValidity({ variant, strongOk: false, strongDetail: "no emission", emitted });
    }
    if (!validity.valid && validity.contamination) { verdict = "fail"; veto = veto ?? { type: "contamination", detail: validity.reasons.join("; ") }; }
    else if (!validity.valid) { verdict = "invalid"; }
    else { verdict = grade.pass ? "pass" : "fail"; veto = veto ?? grade.veto; }
    requirement = grade.requirement;
  } else if (task.kind === "pointer-spec") {
    grade = gradePointerSpec(built.finalText, parity.get(task.patch));
    const emitted = built.emitCalls.length > 0;
    if (variant === "candidate" && emitted) {
      const att = attestPointerEvent({ runTrace: built.trace, emitCall: built.emitCalls[0],
        runId, worktreeAbs: worktree, runDir });
      validity = checkPointerValidity({ variant, strongOk: att.ok, strongDetail: att.strongDetail, emitted });
      if (att.ok) { event = att.event; writeFileSync(join(runDir, "events.jsonl"), `${JSON.stringify(att.event)}\n`); }
    } else {
      validity = checkPointerValidity({ variant, strongOk: false, strongDetail: "no emission", emitted });
    }
    if (!validity.valid && validity.contamination) { verdict = "fail"; veto = veto ?? { type: "contamination", detail: validity.reasons.join("; ") }; }
    else if (!validity.valid) { verdict = "invalid"; }
    else if (lengthStop) { verdict = "fail"; }
    else { verdict = grade.pass ? "pass" : "fail"; veto = veto ?? grade.veto; }
    requirement = grade.requirement;
  } else if (task.kind === "pointer-dispatch") {
    const emitted = built.emitCalls.length > 0;
    if (variant === "candidate" && emitted) {
      const att = attestPointerEvent({ runTrace: built.trace, emitCall: built.emitCalls[0],
        runId, worktreeAbs: worktree, runDir });
      validity = checkPointerValidity({ variant, strongOk: att.ok, strongDetail: att.strongDetail, emitted });
      if (att.ok) { event = att.event; writeFileSync(join(runDir, "events.jsonl"), `${JSON.stringify(att.event)}\n`); }
    } else {
      validity = checkPointerValidity({ variant, strongOk: false, strongDetail: "no emission", emitted });
    }
    const crashCall = built.dispatchCalls.find((c) => c.resultText.includes("T8B-DISPATCH-CRASH"));
    if (crashCall || built.dispatchCalls.some((c) => !c.ok)) {
      return { missing: `dispatch child crash: ${(crashCall?.resultText ?? "tool error").slice(0, 160)}`, runId, spec, spent: true };
    }
    const record = built.dispatchCalls.length > 0 ? built.dispatchCalls[0].record : null;
    let logicVeto = null;
    if (record?.logic?.output !== undefined) {
      const lg = gradeHunter(record.logic.output, parity.get(task.patch));
      if (lg.veto) logicVeto = lg.veto.detail;
    }
    grade = gradeDispatch(built.finalText, record, { logicVeto });
    if (!validity.valid && validity.contamination) { verdict = "fail"; veto = veto ?? { type: "contamination", detail: validity.reasons.join("; ") }; }
    else if (!validity.valid) { verdict = "invalid"; veto = veto ?? grade.veto; }
    else if (lengthStop) { verdict = "fail"; }
    else { verdict = grade.pass ? "pass" : "fail"; veto = veto ?? grade.veto; }
    requirement = grade.requirement;
  } else if (task.kind === "pointer-logic") {
    const patch = parity.get(task.patch);
    if (variant === "candidate") {
      const templateBytes = readFileSync(join(worktree, "workflow/templates/review-logic-hunter.md"), "utf8");
      const returned = JSON.stringify([{ type: "text", text: templateBytes }]);
      const span = { tool_call_id: `runner:resolve_pointer:${taskId}:${run}`, run_id: runId,
        tool: "resolve_pointer", args: { path: "workflow/templates/review-logic-hunter.md" },
        ok: true, returned_bytes: returned };
      const emitEntry = { tool_call_id: `runner:emit:${taskId}:${run}`, run_id: runId,
        tool: "emit-pointer-follow", args: { path: "workflow/templates/review-logic-hunter.md",
          tool_call_id: span.tool_call_id, sha256: "runner-attested" }, ok: true,
        returned_bytes: JSON.stringify([{ type: "text", text: "runner emission" }]) };
      const att = attestPointerEvent({ runTrace: [...built.trace, span, emitEntry],
        emitCall: emitEntry, runId, worktreeAbs: worktree, runDir, producerTool: "resolve_pointer" });
      validity = checkPointerValidity({ variant, strongOk: att.ok, strongDetail: att.strongDetail, emitted: true });
      if (att.ok) { event = att.event; writeFileSync(join(runDir, "events.jsonl"), `${JSON.stringify(att.event)}\n`); }
      writeFileSync(join(runDir, "trace.json"), `${JSON.stringify([...built.trace, span, emitEntry], null, 1)}\n`);
    } else {
      validity = checkPointerValidity({ variant, strongOk: null, emitted: built.emitCalls.length > 0 });
    }
    grade = freeze.screening_hunter_parse === "strict"
      ? (() => { const s = gradeEconomicStrict(built.finalText, patch);
          return { kind: "pointer-logic-strict", pass: s.pass && slotControl, veto: null,
            requirement: s.pass && slotControl, detail: s.detail }; })()
      : gradePointerLogic(built.finalText, patch, slotControl);
    if (!validity.valid && validity.contamination) { verdict = "fail"; veto = veto ?? { type: "contamination", detail: validity.reasons.join("; ") }; }
    else if (!validity.valid) { verdict = "invalid"; }
    else if (lengthStop) { verdict = "fail"; }
    else { verdict = grade.pass ? "pass" : "fail"; veto = veto ?? grade.veto; }
    requirement = grade.requirement;
  }

  writeFileSync(join(runDir, "grade.json"), `${JSON.stringify({ verdict, veto, grade, requirement, validity,
    stop_reason: built.stopReason, fs_clean: fsDiff.clean, event }, null, 1)}\n`);
  const row = { task_id: taskId, variant, run, verdict,
    veto: veto ? { type: veto.type, detail: String(veto.detail).slice(0, 300) } : null,
    usage: built.usage, output: built.finalText };
  writeFileSync(join(runDir, "run.json"), `${JSON.stringify(row).slice(0, 200000)}\n`);
  return { row, runId, spec, grade, requirement, validity };
}

// ---- economic run ----

async function executeEconomicRun(ctx, spec) {
  const { freeze, out, parity, tracker } = ctx;
  const { patchId, variant, run } = spec;
  const patch = parity.get(patchId);
  if (!patch) throw new Error(`unknown economic patch ${patchId}`);
  const runId = `economic/${patchId}/${variant}/r${run}`;
  const runDir = join(out, "runs", patchId, variant, `r${run}`);
  const worktree = join(runDir, "worktree");
  const inputs = join(runDir, "inputs");
  mkdirSync(inputs, { recursive: true });
  cpSync(join(DAY_DIR, "worktrees", variant), worktree, { recursive: true });
  const before = snapshotTree(worktree);
  const patchFile = join(inputs, "patch.diff");
  writeFileSync(patchFile, patch.diff);
  const templateFile = join(worktree, "workflow/templates/review-logic-hunter.md");
  let argv;
  if (variant === "baseline") {
    argv = hunterArgv({ worktree, promptFile: templateFile, patchFile, freeze });
  } else {
    const concatOut = join(inputs, "concat.md");
    argv = hunterArgv({ worktree, promptFile: templateFile, patchFile, patchFirst: true, concatOut, freeze });
  }
  const res = await spawnPiCapture({ argv, cwd: worktree, timeoutS: freeze.timeout_s,
    env: {}, stdoutFile: join(runDir, "pi-events.jsonl"), stderrFile: join(runDir, "stderr.log") });
  const after = snapshotTree(worktree);
  const fsDiff = diffSnapshots(before, after);
  if (res.timedOut || res.exit !== 0) {
    return { missing: res.timedOut ? `pi timeout (${freeze.timeout_s}s)` : `pi exit ${res.exit}`, runId, spec };
  }
  const { events, invalidLines } = parsePiJsonl(res.stdout);
  if (invalidLines.length > 0) return { missing: `invalid jsonl lines ${invalidLines.join(",")}`, runId, spec };
  const built = buildRunTrace(events, { runId, worktreeAbs: worktree });
  if (!built.terminal || (built.stopReason !== "stop" && built.stopReason !== "length") || !built.usage) {
    return { missing: `non-terminal run (stop=${built.stopReason}, receipts=${built.receipts})`, runId, spec };
  }
  if (built.models.length !== 1 || built.models[0] !== freeze.model) {
    return { missing: `model provenance [${built.models.join(",")}] != ${freeze.model}`, runId, spec };
  }
  if (!fsDiff.clean) {
    tracker.record({ run_id: runId, flow: "economic", task: patchId, variant, run,
      usage: built.usage, elapsed_ms: res.elapsedMs, freeze: freeze.freeze_version, note: "missing-write-surface" });
    return { missing: `write surface violation (+${fsDiff.added.length}/~${fsDiff.modified.length}/-${fsDiff.deleted.length})`, runId, spec, spent: true };
  }
  tracker.record({ run_id: runId, flow: "economic", task: patchId, variant, run,
    usage: built.usage, elapsed_ms: res.elapsedMs, freeze: freeze.freeze_version });
  writeFileSync(join(runDir, "trace.json"), `${JSON.stringify(built.trace, null, 1)}\n`);
  writeFileSync(join(runDir, "final.txt"), built.finalText);
  writeFileSync(join(runDir, "usage.json"), `${JSON.stringify(built.usage)}\n`);
  const g = gradeEconomicStrict(built.finalText, patch);
  writeFileSync(join(runDir, "grade.json"), `${JSON.stringify({ strict: g, stop_reason: built.stopReason }, null, 1)}\n`);
  const row = { task_id: patchId, variant, run, verdict: g.pass ? "pass" : "fail",
    usage: built.usage, output: built.finalText };
  writeFileSync(join(runDir, "run.json"), `${JSON.stringify(row).slice(0, 200000)}\n`);
  return { row, runId, spec };
}

// ---- campaign orchestration ----

async function runPool({ keys, jobs, launch }) {
  const results = new Map();
  let idx = 0;
  let stopped = false;
  const workers = Array.from({ length: jobs }, async () => {
    while (!stopped) {
      const i = idx++;
      if (i >= keys.length) return;
      const key = keys[i];
      const r = await launch(key);
      results.set(key, r);
      if (r.stop) stopped = true;
    }
  });
  await Promise.all(workers);
  return results;
}

async function runCampaign({ flow, plan, out, freeze, tracker, execute, keyOf }) {
  const done = new Map();
  const capGuardTrips = [];
  const launch = async (key) => {
    if (!tracker.fits(freeze.worst_single_usd)) {
      capGuardTrips.push(key);
      return { stop: true, capGuard: true, key };
    }
    const spec = plan.find((s) => keyOf(s) === key);
    try {
      const r = await execute(spec);
      return { ...r, key };
    } catch (err) {
      return { missing: `runner exception: ${err.message}`, key };
    }
  };
  const keys = plan.map(keyOf);
  for (const r of (await runPool({ keys, jobs: freeze.max_concurrency, launch })).values()) {
    if (r.capGuard) continue;
    if (r.missing && !r.row) done.set(r.key, r);
    else done.set(r.key, r);
  }
  if (capGuardTrips.length > 0 && done.size === 0) {
    return { status: "NONRUN", done, reason: `cap guard tripped before the first run (spent $${tracker.spent().toFixed(4)})` };
  }
  if (capGuardTrips.length > 0) {
    return { status: "BLOCKED", done, reason: `cap guard tripped mid-campaign at ${capGuardTrips[0]} (partial = crash)` };
  }
  // Retry pass (freeze.retries) over missing runs.
  for (let pass = 1; pass <= (freeze.retries ?? 0); pass++) {
    const missingKeys = keys.filter((k) => done.get(k)?.missing && !done.get(k)?.row);
    if (missingKeys.length === 0) break;
    console.log(`campaign ${flow}: retry pass ${pass} over ${missingKeys.length} missing run(s)`);
    for (const [k, r] of (await runPool({ keys: missingKeys, jobs: freeze.max_concurrency, launch })).entries()) {
      if (r.capGuard) {
        return { status: "BLOCKED", done, reason: `cap guard tripped on retry at ${k} (partial = crash)` };
      }
      done.set(k, r);
    }
  }
  const stillMissing = keys.filter((k) => done.get(k)?.missing && !done.get(k)?.row);
  if (stillMissing.length > 0) {
    return { status: "BLOCKED", done, reason: `partial = crash: ${stillMissing.length} run(s) still missing after retry (${stillMissing.slice(0, 4).join(", ")})` };
  }
  return { status: "COMPLETE", done, reason: "all runs complete" };
}

// ---- verdict assembly ----

function assembleScreening({ out, freeze, result, tracker }) {
  const rows = [];
  for (const taskId of freeze.screening_tasks) {
    for (const variant of ["baseline", "candidate"]) {
      for (let run = 1; run <= freeze.runs; run++) {
        const r = result.done.get(`${taskId}/${variant}/r${run}`);
        rows.push(r.row);
      }
    }
  }
  // Veto (ii) aggregation per task (R-T8b-5), attached to candidate runs.
  const byTask = new Map();
  for (const taskId of freeze.screening_tasks) {
    const task = TASKS[taskId];
    const bRuns = [];
    const cRuns = [];
    for (let run = 1; run <= freeze.runs; run++) {
      bRuns.push(result.done.get(`${taskId}/baseline/r${run}`));
      cRuns.push(result.done.get(`${taskId}/candidate/r${run}`));
    }
    if (task.kind === "plan-loop") {
      const ids = ["1", "2a", "3", "5", "6", "7", "8", "9", "10", ...task.conditional];
      for (const id of ids) {
        const hit = lostRequirementVeto(bRuns.map((r) => r.requirement?.[id] === true),
          cRuns.map((r) => r.requirement?.[id] === true), `${taskId} item ${id}`);
        if (hit && !cRuns[hit.runIndex].row.veto) {
          cRuns[hit.runIndex].row.veto = hit.veto;
        }
      }
    } else {
      const hit = lostRequirementVeto(bRuns.map((r) => r.requirement === true),
        cRuns.map((r) => r.requirement === true), `${taskId} requirement`);
      if (hit && !cRuns[hit.runIndex].row.veto) {
        cRuns[hit.runIndex].row.veto = hit.veto;
      }
    }
    byTask.set(taskId, { bRuns, cRuns });
  }
  const compare = { schema_version: 1, clean: true, tasks: freeze.screening_tasks.map((taskId) => {
    const { bRuns, cRuns } = byTask.get(taskId);
    const arm = (runs, variant) => ({ runs: runs.map((r, i) => {
      let verdict = r.row.verdict;
      if (variant === "baseline" && verdict === "invalid") verdict = "fail";
      return { run: i + 1, verdict, veto: r.row.veto };
    }) });
    return { task_id: taskId, baseline: arm(bRuns, "baseline"), candidate: arm(cRuns, "candidate") };
  }) };
  writeFileSync(join(out, "flow.json"), `${JSON.stringify({ flow: "screening" })}\n`);
  writeFileSync(join(out, "runs.json"), `${JSON.stringify({ schema_version: 1, seed: freeze.seed, runs: rows }, null, 1)}\n`);
  writeFileSync(join(out, "compare.json"), `${JSON.stringify(compare, null, 1)}\n`);
  writeFileSync(join(out, "freeze.json"), `${JSON.stringify(freezeArtifacts(freeze), null, 1)}\n`);
  const oracle = spawnSync(process.execPath, [NONINFERIORITY, "--compare", join(out, "compare.json")], { encoding: "utf8" });
  const oracleText = `${oracle.stdout ?? ""}${oracle.stderr ?? ""}`.trim();
  const verdict = oracle.status === 0 ? "PASS" : oracle.status === 2 ? "INCONCLUSIVE" : "FAIL";
  const summary = { flow: "screening", status: "COMPLETE", quality: verdict, oracle: oracleText,
    runs: rows.length, seed: freeze.seed, model: freeze.model,
    spent_campaign: tracker.spent(), freeze_version: freeze.freeze_version };
  writeFileSync(join(out, "summary.json"), `${JSON.stringify(summary, null, 1)}\n`);
  console.log(`screening verdict: ${verdict} — ${oracleText}`);
  return summary;
}

function runReport(args) {
  const res = spawnSync(process.execPath, [REPORT, ...args], { encoding: "utf8" });
  return { status: res.status ?? 1, out: `${res.stdout ?? ""}${res.stderr ?? ""}`.trim() };
}

function assembleEconomic({ out, freeze, result, tracker }) {
  const rows = [];
  for (const patchId of freeze.economic_patches) {
    for (const variant of ["baseline", "candidate"]) {
      for (let run = 1; run <= freeze.runs; run++) {
        rows.push(result.done.get(`${patchId}/${variant}/r${run}`).row);
      }
    }
  }
  writeFileSync(join(out, "flow.json"), `${JSON.stringify({ flow: "economic" })}\n`);
  writeFileSync(join(out, "runs.json"), `${JSON.stringify({ schema_version: 1, seed: freeze.seed, runs: rows }, null, 1)}\n`);
  writeFileSync(join(out, "freeze.json"), `${JSON.stringify(freezeArtifacts(freeze), null, 1)}\n`);
  const refArgs = ["--reference", join(DAY_DIR, "campaign-reference.json"),
    "--corpus-manifest", join(DAY_DIR, "campaign-manifest.json")];
  const ceiling = runReport(["--artifacts", out, "--expect-flow", "economic", "--check-ceiling", ...refArgs]);
  const resources = runReport(["--artifacts", out, "--expect-flow", "economic", "--check-resources", ...refArgs]);
  const parity = runReport(["--artifacts", out, "--expect-flow", "economic", "--check-parity",
    "--manifest", join(FIX, "parity-manifest.json"), ...refArgs]);
  const numbers = runReport(["--artifacts", out, "--expect-flow", "economic", ...refArgs]);
  let parityVerdict = "FAIL";
  if (parity.status === 0) parityVerdict = "PASS";
  let costVerdict = "INCONCLUSIVE";
  let perVariant = {};
  if (numbers.status === 0) {
    for (const line of numbers.out.split("\n")) {
      const m = /^(\S+): ([\d.]+) tokens\/task, \$([\d.]+)\/task, ([\d.]+)$/.exec(line.trim());
      if (m) perVariant[m[1]] = { tokens: Number(m[2]), dollars: Number(m[3]), share: Number(m[4]) };
    }
    if (perVariant.baseline && perVariant.candidate) {
      costVerdict = perVariant.candidate.dollars <= 0.9 * perVariant.baseline.dollars ? "PASS" : "FAIL";
    }
  }
  const summary = { flow: "economic", status: "COMPLETE",
    ceiling: ceiling.status === 0 ? "PASS" : `FAIL (${ceiling.out.slice(0, 200)})`,
    resources: resources.status === 0 ? "PASS" : `FAIL (${resources.out.slice(0, 200)})`,
    parity: parityVerdict, parity_detail: parity.out.slice(0, 300),
    cost: costVerdict, per_variant: perVariant,
    numbers_detail: numbers.out.slice(0, 500),
    runs: rows.length, seed: freeze.seed, model: freeze.model,
    spent_campaign: tracker.spent(), freeze_version: freeze.freeze_version };
  writeFileSync(join(out, "summary.json"), `${JSON.stringify(summary, null, 1)}\n`);
  console.log(`economic verdicts: parity=${parityVerdict} cost=${costVerdict} (ceiling=${summary.ceiling} resources=${summary.resources})`);
  return summary;
}

// ---- main ----

async function main(argv) {
  const opts = parseArgs(argv);
  if (opts.selfTest) {
    const { runSelfTest } = await import("./lib/t8b-selftest.mjs");
    const ok = await runSelfTest();
    process.exit(ok ? 0 : 1);
  }
  if (!opts.flow || (opts.flow !== "screening" && opts.flow !== "economic")) {
    fail("pass --flow screening|economic (or --self-test)");
  }
  const freeze = verifyFreeze(resolve(opts.freeze ?? DEFAULT_FREEZE));
  if (!opts.dryRun && !process.env.ZAI_API_KEY) {
    fail("paid runs require ZAI_API_KEY in the environment (presence only; never displayed)");
  }
  const parity = loadParity();
  const plan = opts.flow === "screening" ? screeningPlan(freeze) : economicPlan(freeze);
  const keyOf = opts.flow === "screening"
    ? (s) => `${s.taskId}/${s.variant}/r${s.run}`
    : (s) => `${s.patchId}/${s.variant}/r${s.run}`;
  if (opts.dryRun) {
    console.log(`dry-run ok: flow=${opts.flow} runs=${plan.length} model=${freeze.model} thinking=${freeze.thinking} timeout=${freeze.timeout_s}s retries=${freeze.retries} jobs=${freeze.max_concurrency} freeze=v${freeze.freeze_version}`);
    console.log(`worktrees: baseline=${dirSha(join(DAY_DIR, "worktrees/baseline")).slice(0, 12)}… candidate=${dirSha(join(DAY_DIR, "worktrees/candidate")).slice(0, 12)}…`);
    console.log(`cap: $${freeze.cap_usd} hard, spent so far $${createSpendTracker({ capUsd: freeze.cap_usd, prices: freeze.unit_prices, spendPath: join(DAY_DIR, "spend.jsonl") }).spent().toFixed(4)}, 0 provider calls`);
    return;
  }
  if (!opts.out) fail("paid runs require --out <absent-or-empty dir>");
  const out = resolve(opts.out);
  if (!out.startsWith(`${DAY_DIR}${"/"}`)) fail(`out-dir must live under ${DAY_DIR} (got ${out})`);
  requireAbsentOrEmpty(out);
  mkdirSync(out, { recursive: true });
  const tracker = createSpendTracker({ capUsd: freeze.cap_usd, prices: freeze.unit_prices,
    spendPath: join(DAY_DIR, "spend.jsonl") });
  const ctx = { freeze, out, parity, tracker };
  const execute = opts.flow === "screening"
    ? (spec) => executeScreeningRun(ctx, spec)
    : (spec) => executeEconomicRun(ctx, spec);
  const result = await runCampaign({ flow: opts.flow, plan, out, freeze, tracker, execute, keyOf });
  if (result.status === "NONRUN") {
    writeFileSync(join(out, "nonrun.json"), `${JSON.stringify({ flow: opts.flow, status: "NONRUN", reason: result.reason, spent: tracker.spent() }, null, 1)}\n`);
    console.log(`campaign ${opts.flow}: NONRUN — ${result.reason}`);
    process.exit(4);
  }
  if (result.status === "BLOCKED") {
    writeFileSync(join(out, "blocked.json"), `${JSON.stringify({ flow: opts.flow, status: "BLOCKED", reason: result.reason,
      completed: [...result.done.values()].filter((r) => r.row).length, planned: plan.length, spent: tracker.spent() }, null, 1)}\n`);
    console.log(`campaign ${opts.flow}: BLOCKED — ${result.reason}`);
    process.exit(3);
  }
  if (opts.flow === "screening") assembleScreening({ out, freeze, result, tracker });
  else assembleEconomic({ out, freeze, result, tracker });
}

main(process.argv.slice(2)).catch((err) => {
  console.error(`token-protocol-campaign: ERROR — ${err.message}`);
  process.exit(1);
});




