#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

WORKFLOW_DIR=".workflow"
PLAN_DIR="docs/plan"
MIN_COUNT=2
MAX_SAMPLES=3
JSON=0
MEASUREMENT_INTEGRITY="$SCRIPT_DIR/workflow-measurement-integrity"

usage() {
  cat <<EOF
Usage: workflow-retrospect [--dir path] [--plans path] [--min-count n] [--json]

Mine local Etabli workflow ledgers and implemented-plan archives for recurring
workflow issues. The command is read-only: it reports candidate recommendations,
router fixtures, contract patches, or mechanical checks, but never applies them.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dir)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      WORKFLOW_DIR="$2"
      shift
      ;;
    --plans)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      PLAN_DIR="$2"
      shift
      ;;
    --min-count)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      MIN_COUNT="$2"
      case "$MIN_COUNT" in
        ''|*[!0-9]*)
          printf 'min-count must be a positive integer\n' >&2
          exit 2
          ;;
        0)
          printf 'min-count must be a positive integer\n' >&2
          exit 2
          ;;
      esac
      shift
      ;;
    --json)
      JSON=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if ! command -v jq >/dev/null 2>&1; then
  printf 'missing jq; install jq to run workflow retrospectives\n' >&2
  exit 2
fi

tmp="$(mktemp)"
cleanup() {
  rm -f "$tmp"
}
trap cleanup EXIT

normalize_issue() {
  printf '%s' "$1" |
    tr '[:upper:]' '[:lower:]' |
    tr -cs '[:alnum:]' ' ' |
    awk '{$1=$1; print}' |
    cut -c 1-140
}

classify_issue() {
  local default_category="$1"
  local text_lc
  text_lc="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"

  case "$text_lc" in
    *adversary\ finding*|*accepted\ finding*)
      printf 'adversary_finding'
      return
      ;;
    *validation\ failed*|*validation\ failure*|*test\ failed*|*smoke\ failed*)
      printf 'validation_failure'
      return
      ;;
    *router\ miss*|*routing\ miss*|*wrong\ route*|*misroute*|*misclassified\ route*|*incorrect\ route*|*router\ fixture*)
      printf 'router_miss'
      return
      ;;
    *plan\ drift*|*drifted\ plan*|*drift\ evidence*|*scope\ drift*)
      printf 'plan_drift'
      return
      ;;
    *runtime\ capability\ overclaim*|*capability\ overclaim*|*overclaimed\ capability*|*unknown\ capability*|*unavailable\ runner*)
      printf 'runtime_capability_overclaim'
      return
      ;;
    *dogfood\ blocker*|*dogfood\ blocked*|*blocked-human-verify*)
      printf 'dogfood_blocker'
      return
      ;;
  esac

  printf '%s' "$default_category"
}

emit_observation() {
  local default_category="$1"
  local text="$2"
  local source="$3"
  local origin="$4"
  local initiative="$5"
  local category key

  [ -n "$text" ] || return 0
  if printf '%s' "$text" | tr '[:upper:]' '[:lower:]' | grep -Eq '(no|without|sans|aucun[e]?) (plan |scope )?drift|(no|without|sans|aucun[e]?) validation (failure|failed)'; then
    return 0
  fi
  if [ "$default_category" = "harness_failure_pattern" ]; then
    category="$default_category"
  else
    category="$(classify_issue "$default_category" "$text")"
  fi
  case "$category" in
    adversary_finding|validation_failure|plan_drift|router_miss|dogfood_blocker|runtime_capability_overclaim|harness_failure_pattern) ;;
    *)
      return 0
      ;;
  esac

  key="$(normalize_issue "$text")"
  [ -n "$key" ] || return 0

  jq -nc \
    --arg category "$category" \
    --arg key "$key" \
    --arg text "$text" \
    --arg source "$source" \
    --arg origin "$origin" \
    --arg initiative "$initiative" \
    '{category:$category,key:$key,text:$text,source:$source,origin:$origin,initiative:$initiative}' >> "$tmp"
}

normalize_initiative() {
  printf '%s' "$1" | sed -E 's/-(v|retry|attempt|rerun)[0-9]+$//'
}

scan_events() {
  [ -d "$WORKFLOW_DIR" ] || return 0

  find "$WORKFLOW_DIR" -mindepth 2 -maxdepth 2 -name events.jsonl -type f -print |
    sort |
    while IFS= read -r file; do
      run="$(basename "$(dirname "$file")")"
      initiative="$(normalize_initiative "$run")"
      jq -r --arg source "$file" --arg initiative "$initiative" '
        def compact:
          if type == "array" then map(tostring) | join(": ")
          elif type == "object" then to_entries | map(.value | tostring) | join(": ")
          else tostring
          end;
        def row($category; $text): [$category, ($text | compact), $source, "ledger", $initiative] | @tsv;

        . as $event |
        if $event.event == "adversary_completed" then
          ($event.detail.accepted_findings // [])[] | row("adversary_finding"; .)
        elif $event.event == "validation_failed" then
          row("validation_failure"; ($event.detail.failure // $event.detail.command // "validation failed"))
        elif $event.event == "dogfood_blocked" then
          row("dogfood_blocker"; [$event.detail.scenario, $event.detail.reason, $event.detail.needed_input])
        elif $event.event == "harness_failure_pattern" then
          row("harness_failure_pattern"; [$event.detail.terminal_cause, $event.detail.causal_status, $event.detail.mechanism, $event.detail.verifier])
        elif $event.event == "no_progress" then
          row("validation_failure"; [$event.detail.check_or_hypothesis, $event.detail.command, $event.detail.eliminated])
        elif $event.event == "blocked" then
          row("observed_blocker"; [$event.detail.reason, $event.detail.needed_input])
        elif $event.event == "route_decided" then
          row("observed_route"; ($event.detail.reason // $event.detail.route // "route decided"))
        else
          empty
        end
      ' "$file" |
        while IFS=$'\t' read -r category text source origin initiative; do
          emit_observation "$category" "$text" "$source" "$origin" "$initiative"
        done
    done
}

archive_ledger_initiative() {
  local archive_file="$1"
  local archive_absolute archive_logical archive_relative matches=""
  archive_logical="$archive_file"
  case "$archive_logical" in
    /*) ;;
    *) archive_logical="$PWD/${archive_logical#./}" ;;
  esac
  archive_absolute="$(cd "$(dirname "$archive_file")" >/dev/null 2>&1 && pwd -P)/$(basename "$archive_file")"
  archive_relative="$archive_logical"
  case "$archive_logical" in
    "$PWD"/*) archive_relative="${archive_logical#"$PWD"/}" ;;
  esac
  [ -d "$WORKFLOW_DIR" ] || return 0
  while IFS= read -r ledger; do
    if jq -e --arg absolute "$archive_absolute" --arg logical "$archive_logical" --arg relative "$archive_relative" \
      'select(.event == "archive_written" and (.detail.path == $absolute or .detail.path == $logical or .detail.path == $relative or .detail.path == ("./" + $relative)))' \
      "$ledger" >/dev/null 2>&1; then
      matches="${matches}$(normalize_initiative "$(basename "$(dirname "$ledger")")")\n"
    fi
  done < <(find "$WORKFLOW_DIR" -mindepth 2 -maxdepth 2 -name events.jsonl -type f -print | sort)
  matches="$(printf '%b' "$matches" | sed '/^$/d' | sort -u)"
  if [ "$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')" = "1" ]; then
    printf '%s' "$matches"
  fi
}

scan_plan_archives() {
  [ -d "$PLAN_DIR" ] || return 0

  find "$PLAN_DIR" -maxdepth 1 -name '*.md' -type f -print |
    sort |
    while IFS= read -r file; do
      archive_initiative="$(awk -F': *' '
        /^- Workflow initiative: / {
          value=$0
          sub(/^- Workflow initiative: /, "", value)
          gsub(/^`|`$/, "", value)
          if (value != "" && value != "none") print value
          exit
        }
      ' "$file")"
      if [ -n "$archive_initiative" ]; then
        archive_initiative="$(normalize_initiative "$archive_initiative")"
      fi
      if [ -z "$archive_initiative" ]; then
        archive_initiative="$(archive_ledger_initiative "$file")"
      fi
      [ -n "$archive_initiative" ] || archive_initiative="$file"
      awk '
        {
          line = $0
          lower = tolower(line)
        }
        lower ~ /adversary.*finding|accepted finding|validation failed|validation failure|plan drift|scope drift|router miss|routing miss|wrong route|misroute|dogfood blocker|dogfood blocked|runtime capability overclaim|capability overclaim|unknown capability|unavailable runner/ {
          gsub(/^[[:space:]>#*-]+/, "", line)
          if (line != "") print FILENAME ":" FNR "\t" line
        }
      ' "$file" |
        while IFS=$'\t' read -r source text; do
          line_initiative="$(printf '%s' "$text" | sed -nE 's/.*\[initiative:([^]]+)\].*/\1/p')"
          clean_text="$(printf '%s' "$text" | sed -E 's/[[:space:]]*\[initiative:[^]]+\][[:space:]]*/ /g; s/^ +| +$//g')"
          if [ -n "$line_initiative" ]; then
            line_initiative="$(normalize_initiative "$line_initiative")"
          fi
          [ -n "$line_initiative" ] || line_initiative="$archive_initiative"
          emit_observation "archive_signal" "$clean_text" "$source" "archive" "$line_initiative"
        done
    done
}

build_summary() {
  if [ ! -s "$tmp" ]; then
    jq -nc --argjson min_count "$MIN_COUNT" '{
      min_count: $min_count,
      observed_issue_count: 0,
      confirmed_issue_count: 0,
      issues: []
    }'
    return
  fi

  jq -s \
    --argjson min_count "$MIN_COUNT" \
    --argjson max_samples "$MAX_SAMPLES" '
      def scrub:
        tostring
        | gsub("(?i)[A-Z0-9_]*(api[_-]?key|access[_-]?token|refresh[_-]?token|token|client[_-]?secret|password|credential|secret)[A-Z0-9_]*=[^[:space:]]+"; "[REDACTED]")
        | gsub("(?i)(api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret|password|credential|secret)[^[:space:]]*"; "[REDACTED]")
        | if length > 180 then .[0:180] + "..." else . end;
      def action($category; $count):
        if $category == "router_miss" then "router_fixture"
        elif $category == "validation_failure" then "mechanical_check"
        elif $category == "plan_drift" then "contract_patch"
        elif $category == "runtime_capability_overclaim" then "contract_patch"
        elif $category == "dogfood_blocker" then "recommendation"
        elif $category == "harness_failure_pattern" then "contract_patch"
        elif $category == "adversary_finding" and $count >= 3 then "mechanical_check"
        elif $category == "adversary_finding" then "contract_patch"
        else "recommendation"
        end;
      def recommendation($category; $action):
        if $category == "router_miss" then "Add or update a router golden fixture, then verify Pi and Claude router alignment."
        elif $category == "validation_failure" then "Add or strengthen a deterministic smoke check that fails with a remediation message."
        elif $category == "plan_drift" then "Patch the workflow contract or template so the drift condition is named before implementation continues."
        elif $category == "runtime_capability_overclaim" then "Patch runtime capability docs or guards so unsupported tools are labelled blocked or unknown."
        elif $category == "dogfood_blocker" then "Record a product dogfood blocker and add a verification surface before claiming pass."
        elif $category == "harness_failure_pattern" then "Patch the self-improvement contract or checks so the weakness pattern is mined before another proposal is accepted."
        elif $category == "adversary_finding" and $action == "mechanical_check" then "Promote the repeated adversary finding into a mechanical check."
        elif $category == "adversary_finding" then "Patch the relevant contract or template so the adversary finding is checked earlier."
        else "Review the repeated workflow issue and decide whether it needs a contract patch or check."
        end;

      (sort_by(.category, .key) | group_by(.category, .key)) as $groups |
      [
        $groups[]
        | . as $items
        | ($items[0].category) as $category
        | ($items | map(.initiative) | unique) as $initiatives
        | ($initiatives | length) as $count
        | (action($category; $count)) as $action
        | {
            category: $category,
            key: $items[0].key,
            count: $count,
            evidence_count: ($items | length),
            initiatives: $initiatives,
            confirmed: ($count >= $min_count),
            action_kind: $action,
            recommendation: recommendation($category; $action),
            samples: (
              $items
              | map({source, origin, initiative, text: (.text | scrub)})
              | unique_by(.source, .text)
              | .[0:$max_samples]
            )
          }
      ] as $issues |
      {
        min_count: $min_count,
        observed_issue_count: ($issues | length),
        confirmed_issue_count: ($issues | map(select(.confirmed)) | length),
        issues: ($issues | sort_by((.confirmed | not), -(.count), .category, .key))
      }
    ' "$tmp"
}

collect_context_budget() {
  local bin report
  bin="${WORKFLOW_CONTEXT_BUDGET_BIN:-$SCRIPT_DIR/workflow-context-budget}"
  if [ -x "$bin" ]; then
    report="$("$bin" --json 2>/dev/null || true)"
    if printf '%s' "$report" | jq -e 'type == "object" and (.surfaces | type == "object")' >/dev/null 2>&1; then
      printf '%s' "$report"
      return 0
    fi
  fi
  printf '"unavailable"'
}

collect_run_metrics() {
  telemetry='{"measured":0,"unmeasured":0,"quality_only":0,"invalid_usage":0,"outcome_events":0,"outcome_runs":0,"native_runs":0,"imported_measurements":0,"imported_targets":0,"invalid_imports":0,"overlapping_import_targets":0}'
  terminal='{"completed":0,"blocked":0,"in_progress":0}'
  [ -d "$WORKFLOW_DIR" ] || return 0
  local files
  files="$(find "$WORKFLOW_DIR" -mindepth 2 -maxdepth 2 -name events.jsonl -type f -print | sort)"
  [ -n "$files" ] || return 0
  local validated_import_files failed_import_count=0 file import_count population_line import_json import_tmp population_count
  validated_import_files="$(mktemp)"
  while IFS= read -r file; do
    if jq -e 'select(.event == "outcome_measurement_imported")' "$file" >/dev/null 2>&1; then
      population_count="$(jq -s '[.[] | select(.event == "outcome_measurement_population")] | length' "$file")"
      population_line="$(jq -c 'select(.event == "outcome_measurement_population")' "$file" | head -n 1)"
      if [ "$population_count" -ne 1 ] || [ -z "$population_line" ]; then
        import_count="$(jq -s '[.[] | select(.event == "outcome_measurement_imported")] | length' "$file")"
        failed_import_count=$((failed_import_count + import_count))
      else
        while IFS= read -r import_json; do
          import_tmp="$(mktemp)"
          printf '%s\n%s\n' "$population_line" "$import_json" >"$import_tmp"
          if "$MEASUREMENT_INTEGRITY" "$WORKFLOW_DIR" "$import_tmp" >/dev/null 2>&1; then
            printf '%s\n' "$import_json" >>"$validated_import_files"
          else
            failed_import_count=$((failed_import_count + 1))
          fi
          rm -f "$import_tmp"
        done < <(jq -c 'select(.event == "outcome_measurement_imported")' "$file")
      fi
    fi
  done <<EOF
$files
EOF
  local all_events validated_imports
  all_events="$(printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 jq -R 'fromjson? // empty')"
  if [ -s "$validated_import_files" ]; then
    validated_imports="$(jq -R 'fromjson? // empty' "$validated_import_files" | jq -s '[.[] | select(type == "object" and .event == "outcome_measurement_imported") | (.detail // {})]')"
  else
    validated_imports='[]'
  fi
  rm -f "$validated_import_files"
  telemetry="$(printf '%s\n' "$all_events" | jq -s --argjson validated_imports "$validated_imports" --argjson failed_imports "$failed_import_count" '
    def nonnegative_integer:
      type == "number" and floor == . and . >= 0;
    def nonnegative_number:
      type == "number" and . >= 0;
    def valid_usage:
      try (
        (.detail.measured == true)
        and (.detail.input_tokens | nonnegative_integer)
        and (.detail.output_tokens | nonnegative_integer)
        and (.detail.total_tokens | nonnegative_integer)
        and (.detail.total_tokens >= (.detail.input_tokens + .detail.output_tokens))
        and (.detail.tool_calls | nonnegative_integer)
        and (.detail.elapsed_ms | nonnegative_number)
      ) catch false;
    def valid_import:
      try (
      (type == "object")
      and (.population_id | type == "string" and length > 0)
      and (.import_id | type == "string" and test("^[0-9a-f]{64}$"))
      and (.target_run | type == "string" and length > 0)
      and (.target_ledger_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
      and (.target_terminal | type == "string" and length > 0)
      and (.target_terminal_event_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
      and ((.target_outcome_event_sha256 == null) or (.target_outcome_event_sha256 | type == "string" and test("^[0-9a-f]{64}$")))
      and (.source_adapter == "codex")
      and (.source_scope | type == "string" and length > 0)
      and (.selection | type == "string" and length > 0)
      and (.session_fingerprint | type == "string" and test("^[0-9a-f]{64}$"))
      and (.sample_count | nonnegative_integer and . >= 1)
      and (.input_tokens | nonnegative_integer)
      and (.output_tokens | nonnegative_integer)
      and (.total_tokens | nonnegative_integer)
      and (.total_tokens >= (.input_tokens + .output_tokens))
      and (.tool_calls | nonnegative_integer)
      and (.elapsed_ms | nonnegative_integer)
      ) catch false;
    def supplied_usage:
      (.detail // {}) as $detail
      | ["input_tokens", "output_tokens", "total_tokens", "tool_calls", "elapsed_ms"]
      | any(. as $key | $detail | has($key));
    [.[] | select(type == "object" and .event == "outcome_metric")] as $m
    | $validated_imports as $i
    | [$m[] | select(valid_usage)] as $native
    | [$m[] | select(.detail.measured == true and (supplied_usage | not))] as $quality_only
    | [$m[] | select(.detail.measured == true and (valid_usage | not) and supplied_usage)] as $invalid_usage
    | [$i[] | select(valid_import)] as $valid_imports
    | [$i[] | select(valid_import | not)] as $invalid_imports
    | ($valid_imports | group_by(.target_run)) as $import_groups
    | ($import_groups | map(.[0])) as $deduped_imports
    | (($import_groups | map(select(length > 1)) | length)) as $overlap
    | {measured: ($native | length),
       unmeasured: (($m | length) - ($native | length)),
       quality_only: ($quality_only | length),
       invalid_usage: ($invalid_usage | length),
       outcome_events: ($m | length),
       outcome_runs: ([$m[] | .run? // empty] | unique | length),
       native_runs: ([$native[] | .run? // empty] | unique | length),
       imported_measurements: ($deduped_imports | length),
       imported_targets: ([$deduped_imports[] | .target_run] | unique | length),
       invalid_imports: (($invalid_imports | length) + $failed_imports + (($valid_imports | length) - ($deduped_imports | length))),
       overlapping_import_targets: $overlap}')"
  terminal="$(printf '%s\n' "$files" |
    while IFS= read -r file; do
      last="$(tail -n 1 "$file" | jq -Rr '(fromjson? | objects | .event) // "unknown"')"
      printf '%s\n' "${last:-unknown}"
    done |
    jq -Rs 'split("\n") | map(select(. != ""))
      | {completed: ([.[] | select(. == "completed")] | length),
         blocked: ([.[] | select(. == "blocked")] | length),
         in_progress: ([.[] | select(. != "completed" and . != "blocked")] | length)}')"
}

print_context_block() {
  if [ "$context_budget" = '"unavailable"' ]; then
    printf 'context budget: unavailable\n'
  else
    printf 'context budget:\n'
    printf '%s\n' "$context_budget" | jq -r '
      .surfaces | to_entries[]
      | "\(.key) chars=\(.value.chars) ceiling=\(.value.ceiling_chars) headroom=\(.value.headroom) status=\(.value.status)",
        (.value.files | sort_by(-.chars) | .[0:2][] | "  \(.path) chars=\(.chars)")
    '
  fi
  printf 'telemetry: measured=%s unmeasured=%s\n' \
    "$(printf '%s' "$telemetry" | jq -r '.measured')" \
    "$(printf '%s' "$telemetry" | jq -r '.unmeasured')"
  printf 'telemetry coverage: native_runs=%s imported_targets=%s invalid_imports=%s overlapping_import_targets=%s\n' \
    "$(printf '%s' "$telemetry" | jq -r '.native_runs')" \
    "$(printf '%s' "$telemetry" | jq -r '.imported_targets')" \
    "$(printf '%s' "$telemetry" | jq -r '.invalid_imports')" \
    "$(printf '%s' "$telemetry" | jq -r '.overlapping_import_targets')"
  printf 'terminal: completed=%s blocked=%s in_progress=%s\n' \
    "$(printf '%s' "$terminal" | jq -r '.completed')" \
    "$(printf '%s' "$terminal" | jq -r '.blocked')" \
    "$(printf '%s' "$terminal" | jq -r '.in_progress')"
}

scan_events
scan_plan_archives
summary="$(build_summary)"
context_budget="$(collect_context_budget)"
collect_run_metrics

if [ "$JSON" -eq 1 ]; then
  printf '%s\n' "$summary" | jq \
    --argjson context_budget "$context_budget" \
    --argjson telemetry "$telemetry" \
    --argjson terminal "$terminal" \
    '. + {context_budget: $context_budget, telemetry: $telemetry, terminal: $terminal}'
  exit 0
fi

confirmed_count="$(printf '%s\n' "$summary" | jq -r '.confirmed_issue_count')"
if [ "$confirmed_count" -eq 0 ]; then
  printf 'no confirmed recurring workflow issues (min_count=%s)\n' "$MIN_COUNT"
  print_context_block
  exit 0
fi

printf 'confirmed recurring workflow issues: %s (min_count=%s)\n' "$confirmed_count" "$MIN_COUNT"
printf '%s\n' "$summary" |
  jq -r '
    .issues[]
    | select(.confirmed)
    | [
        "",
        ("category=" + .category + " initiatives=" + (.count | tostring) + " evidence=" + (.evidence_count | tostring) + " action=" + .action_kind),
        ("key=" + .key),
        ("recommendation=" + .recommendation),
        (
          .samples[]
          | "sample=" + .source + " :: " + .text
        )
      ]
    | .[]
  '

print_context_block
