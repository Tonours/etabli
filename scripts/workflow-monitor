#!/usr/bin/env bash
set -euo pipefail

WORKFLOW_DIR=".workflow"
STALE_MINUTES=60
JSON=0

usage() {
  cat <<EOF
Usage: workflow-monitor [--dir path] [--stale-minutes n] [--json]

Read workflow event ledgers and report active, stale, blocked, and failing runs.
This command is read-only and never opens PRs, posts comments, or mutates git.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dir)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      WORKFLOW_DIR="$2"
      shift
      ;;
    --stale-minutes)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      STALE_MINUTES="$2"
      case "$STALE_MINUTES" in
        ''|*[!0-9]*)
          printf 'stale minutes must be a non-negative integer\n' >&2
          exit 2
          ;;
      esac
      shift
      ;;
    --json)
      JSON=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if ! command -v jq >/dev/null 2>&1; then
  printf 'missing jq; install jq to inspect workflow ledgers\n' >&2
  exit 2
fi

if [ ! -d "$WORKFLOW_DIR" ]; then
  if [ "$JSON" -eq 1 ]; then
    printf '[]\n'
  else
    printf 'no workflow runs found in %s\n' "$WORKFLOW_DIR"
  fi
  exit 0
fi

now_epoch="$(date -u +%s)"

summaries="$(
  find "$WORKFLOW_DIR" -mindepth 2 -maxdepth 2 -name events.jsonl -type f -print |
    sort |
    while IFS= read -r file; do
      run="$(basename "$(dirname "$file")")"
      jq -s \
        --arg run "$run" \
        --arg file "$file" \
        --argjson now "$now_epoch" \
        --argjson stale_minutes "$STALE_MINUTES" '
          def event_epoch: (.ts | fromdateiso8601? // 0);
          def terminal_event: [.[] | select(.event == "completed" or .event == "blocked")] | last;
          def last_event: .[-1];
          def last_epoch: (last_event | event_epoch);
          def terminal: terminal_event;
          {
            run: $run,
            file: $file,
            event_count: length,
            last_event: (last_event.event // null),
            last_ts: (last_event.ts // null),
            terminal_event: (terminal.event // null),
            active: (terminal == null),
            stale: ((terminal == null) and (($now - last_epoch) > ($stale_minutes * 60))),
            age_minutes: (if length == 0 then null else ((($now - last_epoch) / 60) | floor) end),
            validation_failures: ([.[] | select(.event == "validation_failed")] | length),
            no_progress_events: ([.[] | select(.event == "no_progress")] | length),
            status:
              (
              if terminal.event == "completed" then "completed"
              elif terminal.event == "blocked" then "blocked"
              elif ((terminal == null) and (($now - last_epoch) > ($stale_minutes * 60))) then "stale"
              elif ([.[] | select(.event == "validation_failed" or .event == "no_progress")] | length) > 0 then "failing"
              else "active"
              end
              ),
            alert:
              (
              if terminal.event == "blocked" then "blocked"
              elif ((terminal == null) and (($now - last_epoch) > ($stale_minutes * 60))) then "stale_active_run"
              elif ([.[] | select(.event == "validation_failed")] | length) > 0 then "validation_failed"
              elif ([.[] | select(.event == "no_progress")] | length) > 0 then "no_progress"
              else null
              end
              )
          }
        ' "$file"
    done
)"

if [ "$JSON" -eq 1 ]; then
  printf '%s\n' "$summaries" | jq -s 'sort_by(.run)'
  exit 0
fi

if [ -z "$summaries" ]; then
  printf 'no workflow runs found in %s\n' "$WORKFLOW_DIR"
  exit 0
fi

printf '%s\n' "$summaries" |
  jq -r '. | "\(.status)\t\(.run)\tevents=\(.event_count)\tlast=\(.last_event // "none")\tage_min=\(.age_minutes // "n/a")\talert=\(.alert // "none")"'
