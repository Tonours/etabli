#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

DRY_RUN=1
HOME_DIR="$HOME"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
. "$SCRIPT_DIR/lib/pi-paths.sh"
. "$SCRIPT_DIR/lib/skill-catalog.sh"
. "$SCRIPT_DIR/lib/vendor-surfaces.sh"
. "$SCRIPT_DIR/lib/etabli-scope.sh"
. "$SCRIPT_DIR/lib/managed-surfaces.sh"
SKILL_CATALOG="$REPO_DIR/workflow/runtime/skill-surface.tsv"

AGENTS_VISIBLE_SKILLS=( $(skill_catalog_names "$SKILL_CATALOG" any agents_visible) )

ACTIVE_SCOPES="shared"

resolve_scopes() {
  ACTIVE_SCOPES="$(etabli_active_scopes "$HOME_DIR")"
}

active_scopes() {
  printf '%s\n' "$ACTIVE_SCOPES"
}

usage() {
  cat <<EOF
Usage: $(basename "$0") [--dry-run] [--apply] [--home DIR]

Deploy only the Etabli-managed workflow and skill surfaces for Claude Code,
Pi, Codex, Devin, and Grok (through the shared ~/.agents surface).

Options:
  --dry-run         Show planned changes without touching local harness files (default)
  --apply           Apply local symlinks and safe Pi settings resource sync
  --home DIR        Target home directory, defaults to HOME
  -h, --help        Show this help
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    --apply)
      DRY_RUN=0
      ;;
    --home)
      if [ "$#" -lt 2 ]; then
        printf 'missing value for --home\n' >&2
        exit 2
      fi
      HOME_DIR="$2"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      printf 'unexpected argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

resolve_scopes

status_line() {
  local status="$1"
  local message="$2"

  printf '%-14s %s\n' "$status" "$message"
}

managed_surface_status() {
  status_line "$@"
}

same_link() {
  managed_surface_same_link "$@"
}

link_path() {
  local mode="deploy"
  [ "${ETABLI_DEPLOY_CALLER:-}" = install ] && mode="install"
  managed_surface_reconcile_link "$mode" "$@"
}

remove_managed_path() {
  local target_path="$1"
  local label="$2"
  local backup

  if [ ! -e "$target_path" ] && [ ! -L "$target_path" ]; then
    status_line OK "$label absent"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    status_line WOULD_REMOVE "$label"
    return 0
  fi

  if [ -d "$target_path" ] && [ ! -L "$target_path" ]; then
    backup="$(managed_surface_backup_path "$target_path" "$TIMESTAMP")"
    mv "$target_path" "$backup"
    status_line BACKUP "$backup"
    return 0
  fi

  rm -f "$target_path"
  status_line REMOVE "$label"
}

remove_exact_managed_link() {
  managed_surface_remove_exact_link deploy "$@"
}

prune_stale_managed_claude_agent_links() {
  managed_surface_prune_stale_claude_agents deploy "$REPO_DIR" "$HOME_DIR"
}

node_available() {
  command -v node >/dev/null 2>&1
}

json_list() {
  local script="$1"

  node -e "$script" "$REPO_DIR/pi/agent/settings.json"
}

pi_core_skills() {
  skill_catalog_names "$SKILL_CATALOG" pi pi_core
}

is_core_pi_skill() {
  local candidate="$1"
  local skill
  local skills=()
  while IFS= read -r skill; do
    [ -n "$skill" ] && skills+=("$skill")
  done < <(pi_core_skills)
  managed_surface_catalog_contains "$candidate" "${skills[@]}"
}

is_agents_visible_skill() {
  local candidate="$1"
  managed_surface_catalog_contains "$candidate" "${AGENTS_VISIBLE_SKILLS[@]}"
}

sync_pi_agent_settings() {
  local local_settings="$HOME_DIR/.pi/agent/settings.json"
  local tracked_settings="$REPO_DIR/pi/agent/settings.json"
  local tmp_settings
  local sync_mode="deploy"

  if [ "${ETABLI_DEPLOY_CALLER:-}" = install ]; then
    sync_mode="install"
  fi

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$HOME_DIR/.pi/agent"
  fi

  if [ -L "$local_settings" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      status_line WOULD_MIGRATE "Pi agent settings symlink to local file"
      return 0
    fi

    tmp_settings="$(mktemp)"
    if cp -L "$local_settings" "$tmp_settings" 2>/dev/null; then
      rm "$local_settings"
      mv "$tmp_settings" "$local_settings"
      status_line MIGRATE "Pi agent settings symlink to local file"
    else
      rm -f "$tmp_settings"
      rm "$local_settings"
      cp "$tracked_settings" "$local_settings"
      status_line COPY "Pi agent settings bootstrap after dangling symlink"
    fi
  fi

  if [ ! -f "$local_settings" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      status_line WOULD_COPY "Pi agent settings bootstrap"
      return 0
    fi

    cp "$tracked_settings" "$local_settings"
    status_line COPY "Pi agent settings bootstrap"
  fi

  if ! node_available; then
    status_line SKIP "Node.js unavailable; Pi settings sync skipped"
    return 0
  fi

  node "$SCRIPT_DIR/lib/pi-agent-settings-sync.mjs" \
    "$local_settings" "$tracked_settings" "$DRY_RUN" "$TIMESTAMP" "$sync_mode"
}

sync_claude_skill_overrides() {
  local local_settings="$HOME_DIR/.claude/settings.json"
  local tracked_fragment="$REPO_DIR/claude/settings.skill-overrides.json"

  if [ ! -f "$tracked_fragment" ]; then
    status_line MISSING "Claude skill-overrides fragment source"
    return 0
  fi

  if ! node_available; then
    status_line SKIP "Node.js unavailable; Claude skill overrides sync skipped"
    return 0
  fi

  node "$SCRIPT_DIR/lib/claude-settings-sync.mjs" \
    "$local_settings" "$tracked_fragment" "$DRY_RUN" "$TIMESTAMP" deploy
}

deploy_pi() {
  local agent_file
  local agent_name
  local skill
  local theme_file
  local theme_name
  local skill_link
  local skill_name
  local skill_target
  local pi_node_modules

  status_line SECTION "Pi"

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$HOME_DIR/.pi/agent/agents" "$HOME_DIR/.pi/agent/skills" "$HOME_DIR/.pi/agent/themes" "$HOME_DIR/.agents/skills"
  fi

  link_path "$REPO_DIR/pi/AGENTS.md" "$HOME_DIR/.pi/agent/AGENTS.md" "Pi AGENTS.md"
  link_path "$REPO_DIR/workflow" "$HOME_DIR/.pi/agent/workflow" "Pi workflow"
  link_path "$REPO_DIR/PLAN_TEMPLATE.md" "$HOME_DIR/.pi/agent/PLAN_TEMPLATE.md" "Pi PLAN_TEMPLATE.md"
  link_path "$REPO_DIR/PLAN_TEMPLATE_FULL.md" "$HOME_DIR/.pi/agent/PLAN_TEMPLATE_FULL.md" "Pi PLAN_TEMPLATE_FULL.md"
  link_path "$REPO_DIR/pi/models.json" "$HOME_DIR/.pi/agent/models.json" "Pi models.json"
  link_path "$REPO_DIR/pi/agent/subagents.json" "$HOME_DIR/.pi/agent/subagents.json" "Pi subagents.json"
  link_path "$REPO_DIR/pi/settings.json" "$HOME_DIR/.pi/settings.json" "Pi settings.json"

  for agent_file in "$REPO_DIR/pi/agents"/*.md; do
    [ -f "$agent_file" ] || continue
    agent_name="$(basename "$agent_file")"
    link_path "$agent_file" "$HOME_DIR/.pi/agent/agents/$agent_name" "Pi agent $agent_name"
  done

  remove_managed_path "$HOME_DIR/.pi/extensions" "Pi root extensions path"
  link_path "$REPO_DIR/pi/extensions" "$HOME_DIR/.pi/agent/extensions" "Pi agent extensions"
  link_path "$REPO_DIR/pi/themes" "$HOME_DIR/.pi/themes" "Pi themes"

  if [ "$HOME_DIR" = "$HOME" ] && [ "${ETABLI_INSTALL_HELPER_SMOKE:-}" != 1 ]; then
    pi_node_modules="$(pi_agent_node_modules_dir "$HOME_DIR")"
    if [ "$DRY_RUN" -eq 1 ]; then
      if same_link "$pi_node_modules" "$REPO_DIR/pi/extensions/node_modules"; then
        status_line OK "Pi extension node_modules"
      else
        status_line WOULD_LINK "Pi extension node_modules -> $pi_node_modules"
      fi
    else
      mkdir -p "$pi_node_modules"
      link_path "$pi_node_modules" "$REPO_DIR/pi/extensions/node_modules" "Pi extension node_modules"
    fi
  else
    status_line SKIP "Pi extension node_modules repo link for isolated or non-default home"
  fi

  sync_pi_agent_settings

  managed_surface_remove_symlink deploy \
    "$HOME_DIR/.pi/damage-control-rules.json" \
    "legacy Pi damage-control rules"

  while IFS= read -r skill; do
    [ -z "$skill" ] && continue
    link_path "$REPO_DIR/pi/skills/$skill" "$HOME_DIR/.pi/agent/skills/$skill" "Pi skill $skill"
  done < <(pi_core_skills)

  local core_skills=()
  while IFS= read -r skill; do
    [ -n "$skill" ] && core_skills+=("$skill")
  done < <(pi_core_skills)
  managed_surface_prune_unlisted_source_skills deploy "$REPO_DIR" "$HOME_DIR" \
    .pi/agent/skills Pi pi "${core_skills[@]}"

  for skill in "${AGENTS_VISIBLE_SKILLS[@]}"; do
    [ -n "$skill" ] || continue
    skill_source="$(skill_catalog_dir "$SKILL_CATALOG" "$REPO_DIR" "$skill" || true)"
    [ -n "$skill_source" ] || skill_source="$REPO_DIR/pi/skills/$skill"
    link_path "$skill_source" "$HOME_DIR/.agents/skills/$skill" "Grok/agents-visible skill $skill"
  done

  managed_surface_prune_unlisted_source_skills deploy "$REPO_DIR" "$HOME_DIR" \
    .agents/skills Grok/agents-visible all "${AGENTS_VISIBLE_SKILLS[@]}"

  # Shared plan/workflow sources for ~/.agents skills
  # (../../PLAN_TEMPLATE.md and ../../workflow resolve here).
  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$HOME_DIR/.agents"
  fi
  link_path "$REPO_DIR/PLAN_TEMPLATE.md" "$HOME_DIR/.agents/PLAN_TEMPLATE.md" "Agents PLAN_TEMPLATE.md"
  link_path "$REPO_DIR/PLAN_TEMPLATE_FULL.md" "$HOME_DIR/.agents/PLAN_TEMPLATE_FULL.md" "Agents PLAN_TEMPLATE_FULL.md"
  link_path "$REPO_DIR/workflow" "$HOME_DIR/.agents/workflow" "Agents workflow"

  for theme_file in "$REPO_DIR/pi/themes"/*.json; do
    [ -f "$theme_file" ] || continue
    theme_name="$(basename "$theme_file")"
    link_path "$theme_file" "$HOME_DIR/.pi/agent/themes/$theme_name" "Pi theme $theme_name"
  done
}

deploy_vendor_skills() {
  local skill_name skill_dir record_scope record_pi_core record_vendor surface label

  status_line SECTION "Vendor skills"

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$HOME_DIR/.pi/agent/skills" "$HOME_DIR/.claude/skills" "$HOME_DIR/.codex/skills" "$HOME_DIR/.config/devin/skills" "$HOME_DIR/.agents/skills"
  fi

  managed_surface_prune_pi_cross_surface_links deploy "$REPO_DIR" "$HOME_DIR"
  managed_surface_prune_stale_skill_links deploy "$REPO_DIR" "$HOME_DIR"
  managed_surface_prune_vendor_skill_links deploy "$REPO_DIR" "$HOME_DIR" "$SKILL_CATALOG" "$ACTIVE_SCOPES"

  while IFS=$'\t' read -r record_scope skill_name skill_dir record_pi_core record_vendor; do
    [ -n "$skill_name" ] || continue
    for surface in .claude/skills .codex/skills .config/devin/skills .pi/agent/skills; do
      if vendor_surface_expected "$surface" "$record_scope" "$record_pi_core" "$ACTIVE_SCOPES"; then
        case "$surface" in
        .claude/skills) label="Claude" ;;
        .codex/skills) label="Codex" ;;
        .config/devin/skills) label="Devin" ;;
        .pi/agent/skills) label="Pi" ;;
        esac
        link_path "$skill_dir" "$HOME_DIR/$surface/$skill_name" "$label vendor skill $skill_name"
      fi
    done
  done < <(skill_catalog_vendor_records "$SKILL_CATALOG" "$REPO_DIR")
}

deploy_claude() {
  local command_file
  local command_name
  local target_name
  local hook_file
  local hook_name
  local skill_dir
  local skill_name
  local stale_command
  local agent_file
  local agent_name
  local script_entry
  local script_name

  status_line SECTION "Claude"

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$HOME_DIR/.claude/commands" "$HOME_DIR/.claude/hooks" "$HOME_DIR/.claude/skills" "$HOME_DIR/.claude/agents"
  fi

  link_path "$REPO_DIR/claude/CLAUDE.md" "$HOME_DIR/.claude/CLAUDE.md" "Claude CLAUDE.md"
  link_path "$REPO_DIR/workflow" "$HOME_DIR/.claude/workflow" "Claude workflow"
  link_path "$REPO_DIR/PLAN_TEMPLATE.md" "$HOME_DIR/.claude/PLAN_TEMPLATE.md" "Claude PLAN_TEMPLATE.md"
  link_path "$REPO_DIR/PLAN_TEMPLATE_FULL.md" "$HOME_DIR/.claude/PLAN_TEMPLATE_FULL.md" "Claude PLAN_TEMPLATE_FULL.md"

  for scope in $(active_scopes); do
    for command_file in "$REPO_DIR/claude/scopes/$scope/commands"/*.md; do
      [ -f "$command_file" ] || continue
      command_name="$(basename "$command_file")"
      link_path "$command_file" "$HOME_DIR/.claude/commands/$command_name" "Claude command $command_name"
    done
  done

  for stale_command in \
    qa-planner.md \
    qa-generator.md \
    qa-healer.md \
    qa-reviewer.md \
    qa-failure-dossier.md \
    verify.md \
    plan.md \
    plan-create.md \
    plan-review.md \
    handoff.md \
    handoff-implement.md \
    ops-status.md \
    ops-pi-status.md \
    commit.md \
    cross-repo-audit.md \
    front-quality.md \
    pr-feedback.md \
    pre-commit.md \
    recap.md \
    spec-verify.md \
    tests-iso.md \
    ui-debug.md; do
    remove_exact_managed_link \
      "$HOME_DIR/.claude/commands/$stale_command" \
      "stale Claude command $stale_command" \
      "$REPO_DIR/claude/commands/$stale_command" \
      "$REPO_DIR/claude/scopes/shared/commands/$stale_command"
  done
  remove_exact_managed_link \
    "$HOME_DIR/.claude/handoff-template.md" \
    "stale Claude handoff template" \
    "$REPO_DIR/claude/handoff-template.md"

  for hook_file in "$REPO_DIR/claude/hooks"/*.mjs "$REPO_DIR/claude/hooks"/*.sh; do
    [ -f "$hook_file" ] || continue
    hook_name="$(basename "$hook_file")"
    link_path "$hook_file" "$HOME_DIR/.claude/hooks/$hook_name" "Claude hook $hook_name"
  done

  link_path "$REPO_DIR/claude/statusline-command.sh" "$HOME_DIR/.claude/statusline-command.sh" "Claude statusline command"

  link_path "$REPO_DIR/claude/settings.workflow-hooks.json" "$HOME_DIR/.claude/settings.workflow-hooks.json" "Claude workflow hooks fragment"

  remove_exact_managed_link \
    "$HOME_DIR/.claude/skills/audit" \
    "retired Claude skill audit" \
    "$HOME_DIR/.agents/skills.disabled/ui-pruned-2026-04-28/audit"

  sync_claude_skill_overrides

  prune_stale_managed_claude_agent_links

  for scope in $(active_scopes); do
    for skill_dir in "$REPO_DIR/claude/scopes/$scope/skills"/*; do
      [ -d "$skill_dir" ] || continue
      skill_name="$(basename "$skill_dir")"
      if managed_surface_skill_is_shadowed "$skill_name" "$ACTIVE_SCOPES"; then
        remove_exact_managed_link \
          "$HOME_DIR/.claude/skills/$skill_name" \
          "shadowed Claude skill $skill_name" \
          "$skill_dir"
        continue
      fi
      link_path "$skill_dir" "$HOME_DIR/.claude/skills/$skill_name" "Claude skill $skill_name"
    done

    for agent_file in "$REPO_DIR/claude/scopes/$scope/agents"/*.md; do
      [ -f "$agent_file" ] || continue
      agent_name="$(basename "$agent_file")"
      link_path "$agent_file" "$HOME_DIR/.claude/agents/$agent_name" "Claude agent $agent_name"
    done

    for script_entry in "$REPO_DIR/claude/scopes/$scope/scripts"/*; do
      [ -e "$script_entry" ] || [ -L "$script_entry" ] || continue
      script_name="$(basename "$script_entry")"
      link_path "$script_entry" "$HOME_DIR/.claude/scripts/$script_name" "Claude script $script_name"
    done
  done

  link_path "$REPO_DIR/workflow/review-rubric.md" "$HOME_DIR/.claude/review-rubric.md" "Claude review-rubric.md"

  if [ "$DRY_RUN" -eq 0 ] && [ "$HOME_DIR" = "$HOME" ] && \
    [ "${ETABLI_INSTALL_HELPER_SMOKE:-}" != 1 ] && [ -x "$SCRIPT_DIR/claude-skill-load-check" ]; then
    if ! "$SCRIPT_DIR/claude-skill-load-check"; then
      if [ "${ETABLI_DEPLOY_CALLER:-}" = install ]; then
        status_line WARN "Claude skill load check after installer convergence (see output above)"
      else
        status_line FAIL "Claude skill load check after apply (see output above)"
        exit 1
      fi
    else
      status_line OK "Claude skill load check after apply"
    fi
  fi
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  deploy_pi
  deploy_vendor_skills
  deploy_claude

  if [ "$DRY_RUN" -eq 1 ]; then
    status_line SUMMARY "dry-run complete"
  else
    status_line SUMMARY "agent workflow deployed"
  fi
fi
