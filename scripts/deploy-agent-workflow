#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

DRY_RUN=1
HOME_DIR="$HOME"
CODEX_HOME_INPUT=""
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
. "$SCRIPT_DIR/lib/skill-catalog.sh"
SKILL_CATALOG="$REPO_DIR/workflow/runtime/skill-surface.tsv"

CODEX_VISIBLE_PI_SKILLS=( $(skill_catalog_names "$SKILL_CATALOG" pi codex_visible) )
CODEX_VISIBLE_CODEX_SKILLS=( $(skill_catalog_names "$SKILL_CATALOG" codex codex_visible) )

usage() {
  cat <<EOF
Usage: $(basename "$0") [--dry-run] [--apply] [--home DIR] [--codex-home DIR]

Deploy only the Etabli agent workflow surfaces for Codex, Claude Code, and Pi.

Options:
  --dry-run         Show planned changes without touching local harness files (default)
  --apply           Apply local symlinks and safe Pi settings resource sync
  --home DIR        Target home directory, defaults to HOME
  --codex-home DIR  Target Codex home, defaults to HOME/.codex
  -h, --help        Show this help
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    --apply)
      DRY_RUN=0
      ;;
    --home)
      if [ "$#" -lt 2 ]; then
        printf 'missing value for --home\n' >&2
        exit 2
      fi
      HOME_DIR="$2"
      shift
      ;;
    --codex-home)
      if [ "$#" -lt 2 ]; then
        printf 'missing value for --codex-home\n' >&2
        exit 2
      fi
      CODEX_HOME_INPUT="$2"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      printf 'unexpected argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [ -z "$CODEX_HOME_INPUT" ]; then
  CODEX_HOME_INPUT="$HOME_DIR/.codex"
fi

status_line() {
  local status="$1"
  local message="$2"

  printf '%-14s %s\n' "$status" "$message"
}

backup_path() {
  local path="$1"
  local candidate="$path.bak.$TIMESTAMP"
  local index=1

  while [ -e "$candidate" ]; do
    candidate="$path.bak.$TIMESTAMP.$index"
    index=$((index + 1))
  done

  printf '%s\n' "$candidate"
}

same_link() {
  local source_path="$1"
  local destination_path="$2"

  [ -L "$destination_path" ] && [ "$(readlink "$destination_path")" = "$source_path" ]
}

link_path() {
  local source_path="$1"
  local destination_path="$2"
  local label="$3"
  local destination_dir
  local backup

  if [ ! -e "$source_path" ]; then
    status_line MISSING "$label source missing: $source_path"
    return 1
  fi

  if same_link "$source_path" "$destination_path"; then
    status_line OK "$label"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    if [ -e "$destination_path" ] || [ -L "$destination_path" ]; then
      status_line WOULD_BACKUP "$destination_path"
    fi
    status_line WOULD_LINK "$label -> $source_path"
    return 0
  fi

  destination_dir="$(dirname "$destination_path")"
  mkdir -p "$destination_dir"

  if [ -e "$destination_path" ] || [ -L "$destination_path" ]; then
    backup="$(backup_path "$destination_path")"
    mv "$destination_path" "$backup"
    status_line BACKUP "$backup"
  fi

  ln -s "$source_path" "$destination_path"
  status_line LINK "$label"
}

remove_managed_path() {
  local target_path="$1"
  local label="$2"
  local backup

  if [ ! -e "$target_path" ] && [ ! -L "$target_path" ]; then
    status_line OK "$label absent"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    status_line WOULD_REMOVE "$label"
    return 0
  fi

  if [ -d "$target_path" ] && [ ! -L "$target_path" ]; then
    backup="$(backup_path "$target_path")"
    mv "$target_path" "$backup"
    status_line BACKUP "$backup"
    return 0
  fi

  rm -f "$target_path"
  status_line REMOVE "$label"
}

node_available() {
  command -v node >/dev/null 2>&1
}

json_list() {
  local script="$1"

  node -e "$script" "$REPO_DIR/pi/agent/settings.json"
}

pi_core_skills() {
  skill_catalog_names "$SKILL_CATALOG" pi pi_core
}

is_core_pi_skill() {
  local candidate="$1"
  local skill

  while IFS= read -r skill; do
    [ "$candidate" = "$skill" ] && return 0
  done < <(pi_core_skills)

  return 1
}

sync_pi_agent_settings() {
  local local_settings="$HOME_DIR/.pi/agent/settings.json"
  local tracked_settings="$REPO_DIR/pi/agent/settings.json"
  local tmp_settings

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$HOME_DIR/.pi/agent"
  fi

  if [ -L "$local_settings" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      status_line WOULD_MIGRATE "Pi agent settings symlink to local file"
      return 0
    fi

    tmp_settings="$(mktemp)"
    cp -L "$local_settings" "$tmp_settings"
    rm "$local_settings"
    mv "$tmp_settings" "$local_settings"
    status_line MIGRATE "Pi agent settings symlink to local file"
  fi

  if [ ! -f "$local_settings" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      status_line WOULD_COPY "Pi agent settings bootstrap"
      return 0
    fi

    cp "$tracked_settings" "$local_settings"
    status_line COPY "Pi agent settings bootstrap"
  fi

  if ! node_available; then
    status_line SKIP "Node.js unavailable; Pi settings sync skipped"
    return 0
  fi

  node - "$local_settings" "$tracked_settings" "$DRY_RUN" "$TIMESTAMP" <<'NODE'
const fs = require("node:fs");

const [localPath, trackedPath, dryRunRaw, timestamp] = process.argv.slice(2);
const dryRun = dryRunRaw === "1";
const localSettings = JSON.parse(fs.readFileSync(localPath, "utf8"));
const trackedSettings = JSON.parse(fs.readFileSync(trackedPath, "utf8"));

const managedSources = new Set([
  "local:etabli-workflow",
  "npm:pi-hooks",
  "npm:mitsupi",
  "git:github.com/badlogic/pi-skills",
  "npm:pi-interview",
  "npm:glimpseui",
  "npm:@tintinweb/pi-subagents",
  "npm:@tintinweb/pi-tasks",
]);
const legacySources = new Set(["npm:pi-subagents"]);

function sourceOf(entry) {
  if (typeof entry === "string") return entry;
  if (entry && typeof entry === "object" && typeof entry.source === "string") return entry.source;
  return null;
}

function backupPath(path) {
  let candidate = `${path}.bak.${timestamp}`;
  let index = 1;
  while (fs.existsSync(candidate)) {
    candidate = `${path}.bak.${timestamp}.${index}`;
    index += 1;
  }
  return candidate;
}

const trackedPackages = Array.isArray(trackedSettings.packages) ? trackedSettings.packages : [];
let localPackages = Array.isArray(localSettings.packages) ? localSettings.packages : [];
const changes = [];

const filteredPackages = localPackages.filter((entry) => {
  const source = sourceOf(entry);
  if (source && legacySources.has(source)) {
    changes.push(`remove ${source}`);
    return false;
  }
  return true;
});
localPackages = filteredPackages;

for (const trackedEntry of trackedPackages) {
  const source = sourceOf(trackedEntry);
  if (!source || !managedSources.has(source)) continue;

  const localIndex = localPackages.findIndex((entry) => sourceOf(entry) === source);
  if (localIndex === -1) {
    localPackages.push(trackedEntry);
    changes.push(`add ${source}`);
    continue;
  }

  if (JSON.stringify(localPackages[localIndex]) !== JSON.stringify(trackedEntry)) {
    localPackages[localIndex] = trackedEntry;
    changes.push(`sync ${source}`);
  }
}

if (changes.length === 0) {
  console.log("OK             Pi agent settings resources");
  process.exit(0);
}

if (dryRun) {
  console.log(`WOULD_SYNC     Pi agent settings resources (${changes.join(", ")})`);
  process.exit(0);
}

const backup = backupPath(localPath);
fs.copyFileSync(localPath, backup);
localSettings.packages = localPackages;
fs.writeFileSync(localPath, `${JSON.stringify(localSettings, null, 2)}\n`);
console.log(`BACKUP         ${backup}`);
console.log(`SYNC           Pi agent settings resources (${changes.join(", ")})`);
NODE
}

deploy_codex() {
  status_line SECTION "Codex"

  if [ "$DRY_RUN" -eq 1 ]; then
    "$REPO_DIR/scripts/deploy-codex" --dry-run --prefer-links --codex-home "$CODEX_HOME_INPUT"
    return 0
  fi

  "$REPO_DIR/scripts/deploy-codex" --apply --prefer-links --codex-home "$CODEX_HOME_INPUT"
}

deploy_pi() {
  local skill
  local theme_file
  local theme_name
  local skill_link
  local skill_name
  local skill_target
  local pi_node_modules

  status_line SECTION "Pi"

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$HOME_DIR/.pi/agent/skills" "$HOME_DIR/.pi/agent/themes" "$HOME_DIR/.agents/skills"
  fi

  link_path "$REPO_DIR/pi/AGENTS.md" "$HOME_DIR/.pi/agent/AGENTS.md" "Pi AGENTS.md"
  link_path "$REPO_DIR/workflow" "$HOME_DIR/.pi/agent/workflow" "Pi workflow"
  link_path "$REPO_DIR/PLAN_TEMPLATE.md" "$HOME_DIR/.pi/agent/PLAN_TEMPLATE.md" "Pi PLAN_TEMPLATE.md"
  link_path "$REPO_DIR/PLAN_TEMPLATE_FULL.md" "$HOME_DIR/.pi/agent/PLAN_TEMPLATE_FULL.md" "Pi PLAN_TEMPLATE_FULL.md"
  link_path "$REPO_DIR/pi/models.json" "$HOME_DIR/.pi/agent/models.json" "Pi models.json"
  link_path "$REPO_DIR/pi/settings.json" "$HOME_DIR/.pi/settings.json" "Pi settings.json"

  remove_managed_path "$HOME_DIR/.pi/extensions" "Pi root extensions path"
  link_path "$REPO_DIR/pi/extensions" "$HOME_DIR/.pi/agent/extensions" "Pi agent extensions"
  link_path "$REPO_DIR/pi/themes" "$HOME_DIR/.pi/themes" "Pi themes"

  if [ "$HOME_DIR" = "$HOME" ]; then
    pi_node_modules="$HOME_DIR/.pi/agent/npm/node_modules"
    if [ "$DRY_RUN" -eq 1 ]; then
      if same_link "$pi_node_modules" "$REPO_DIR/pi/extensions/node_modules"; then
        status_line OK "Pi extension node_modules"
      else
        status_line WOULD_LINK "Pi extension node_modules -> $pi_node_modules"
      fi
    else
      mkdir -p "$pi_node_modules"
      link_path "$pi_node_modules" "$REPO_DIR/pi/extensions/node_modules" "Pi extension node_modules"
    fi
  else
    status_line SKIP "Pi extension node_modules repo link for non-default home"
  fi

  sync_pi_agent_settings

  while IFS= read -r skill; do
    [ -z "$skill" ] && continue
    link_path "$REPO_DIR/pi/skills/$skill" "$HOME_DIR/.pi/agent/skills/$skill" "Pi skill $skill"
  done < <(pi_core_skills)

  if [ -d "$HOME_DIR/.pi/agent/skills" ]; then
    for skill_link in "$HOME_DIR/.pi/agent/skills"/*; do
      [ -L "$skill_link" ] || continue
      skill_target="$(readlink "$skill_link")"
      case "$skill_target" in
        "$REPO_DIR/pi/skills/"*)
          skill_name="$(basename "$skill_link")"
          if ! is_core_pi_skill "$skill_name"; then
            remove_managed_path "$skill_link" "stale Pi skill $skill_name"
          fi
          ;;
      esac
    done
  fi

  for skill in "${CODEX_VISIBLE_PI_SKILLS[@]}"; do
    link_path "$REPO_DIR/pi/skills/$skill" "$HOME_DIR/.agents/skills/$skill" "Codex-visible Pi skill $skill"
  done

  for skill in "${CODEX_VISIBLE_CODEX_SKILLS[@]}"; do
    link_path "$REPO_DIR/codex/skills/$skill" "$HOME_DIR/.agents/skills/$skill" "Codex-visible Codex skill $skill"
  done

  for theme_file in "$REPO_DIR/pi/themes"/*.json; do
    [ -f "$theme_file" ] || continue
    theme_name="$(basename "$theme_file")"
    link_path "$theme_file" "$HOME_DIR/.pi/agent/themes/$theme_name" "Pi theme $theme_name"
  done
}

deploy_claude() {
  local command_file
  local command_name
  local target_name
  local hook_file
  local hook_name
  local skill_dir
  local skill_name
  local stale_command

  status_line SECTION "Claude"

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$HOME_DIR/.claude/commands" "$HOME_DIR/.claude/hooks" "$HOME_DIR/.claude/skills" "$HOME_DIR/.claude/agents"
  fi

  link_path "$REPO_DIR/claude/CLAUDE.md" "$HOME_DIR/.claude/CLAUDE.md" "Claude CLAUDE.md"
  link_path "$REPO_DIR/workflow" "$HOME_DIR/.claude/workflow" "Claude workflow"
  link_path "$REPO_DIR/PLAN_TEMPLATE.md" "$HOME_DIR/.claude/PLAN_TEMPLATE.md" "Claude PLAN_TEMPLATE.md"
  link_path "$REPO_DIR/PLAN_TEMPLATE_FULL.md" "$HOME_DIR/.claude/PLAN_TEMPLATE_FULL.md" "Claude PLAN_TEMPLATE_FULL.md"

  for command_file in "$REPO_DIR/claude/commands"/*.md; do
    [ -f "$command_file" ] || continue
    command_name="$(basename "$command_file")"
    target_name="$command_name"
    if [ "$command_name" = "plan-create.md" ]; then
      target_name="plan.md"
    fi
    link_path "$command_file" "$HOME_DIR/.claude/commands/$target_name" "Claude command $target_name"
  done

  for stale_command in \
    qa-planner.md \
    qa-generator.md \
    qa-healer.md \
    qa-reviewer.md \
    qa-failure-dossier.md \
    verify.md \
    plan-create.md \
    plan-review.md \
    handoff.md \
    handoff-implement.md \
    ops-status.md \
    ops-pi-status.md; do
    remove_managed_path "$HOME_DIR/.claude/commands/$stale_command" "stale Claude command $stale_command"
  done
  remove_managed_path "$HOME_DIR/.claude/handoff-template.md" "stale Claude handoff template"

  for hook_file in "$REPO_DIR/claude/hooks"/*.mjs; do
    [ -f "$hook_file" ] || continue
    hook_name="$(basename "$hook_file")"
    link_path "$hook_file" "$HOME_DIR/.claude/hooks/$hook_name" "Claude hook $hook_name"
  done

  link_path "$REPO_DIR/claude/settings.workflow-hooks.json" "$HOME_DIR/.claude/settings.workflow-hooks.json" "Claude workflow hooks fragment"

  for skill_dir in "$REPO_DIR/claude/skills"/*; do
    [ -d "$skill_dir" ] || continue
    skill_name="$(basename "$skill_dir")"
    link_path "$skill_dir" "$HOME_DIR/.claude/skills/$skill_name" "Claude skill $skill_name"
  done

  for agent_file in "$REPO_DIR/claude/agents"/*.md; do
    [ -f "$agent_file" ] || continue
    agent_name="$(basename "$agent_file")"
    link_path "$agent_file" "$HOME_DIR/.claude/agents/$agent_name" "Claude agent $agent_name"
  done

  link_path "$REPO_DIR/workflow/review-rubric.md" "$HOME_DIR/.claude/review-rubric.md" "Claude review-rubric.md"
}

deploy_codex
deploy_pi
deploy_claude

if [ "$DRY_RUN" -eq 1 ]; then
  status_line SUMMARY "dry-run complete"
else
  status_line SUMMARY "agent workflow deployed"
fi
