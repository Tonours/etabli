#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { accessSync, constants, existsSync, writeSync } from "node:fs";
import { basename, dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { activeScopes, claudeConfigOverride, physicalPath, reconcile, seedPiSettings, skillRecords } from "./lib/surfaces.mjs";

const scriptDir = dirname(fileURLToPath(import.meta.url));
const repoDir = dirname(scriptDir);
const USAGE = `Usage: deploy-agent-workflow [--dry-run | --apply | --check [--fix] [--verbose]] [--home DIR]

Reconcile the Etabli-managed workflow and skill surfaces for Claude Code and Pi.

Options:
  --dry-run   Show planned changes without touching local harness files (default)
  --apply     Apply local symlinks and the safe Pi/Claude settings sync
  --check     Report link drift; exit 1 while any remains
  --fix       With --check, repair links in place
  --verbose   With --check, also print entries that are OK
  --home DIR  Target home directory, defaults to HOME
  -h, --help  Show this help
`;

function emit(status, message) {
  writeSync(1, `${status.padEnd(14)} ${message}\n`);
}

function exit(message, code) {
  writeSync(2, `${message}\n`);
  process.exit(code);
}

function parseArgs(argv) {
  const options = { check: false, apply: false, dryRun: false, fix: false, verbose: false, homeDir: process.env.HOME };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--dry-run") options.dryRun = true;
    else if (arg === "--apply") options.apply = true;
    else if (arg === "--check") options.check = true;
    else if (arg === "--fix") options.fix = true;
    else if (arg === "--verbose") options.verbose = true;
    else if (arg === "--home") {
      if (index + 1 >= argv.length) exit("missing value for --home", 2);
      index += 1;
      options.homeDir = argv[index];
    } else if (arg === "-h" || arg === "--help") {
      writeSync(1, USAGE);
      process.exit(0);
    } else {
      exit(`${arg.startsWith("-") ? "unknown option" : "unexpected argument"}: ${arg}\n${USAGE}`, 2);
    }
  }
  if (options.check && options.apply) exit("--apply cannot be combined with --check", 2);
  if (options.dryRun && (options.check || options.apply)) exit("--dry-run cannot be combined with --apply or --check", 2);
  if (!options.homeDir) exit("HOME is unset; pass --home DIR", 2);
  const home = physicalHome(options.homeDir);
  if (home === null) exit(`cannot resolve home directory: ${options.homeDir}`, 2);
  options.homeDir = home;
  if (!options.check && (options.fix || options.verbose)) exit("--fix and --verbose require --check", 2);
  return options;
}

function physicalHome(path) {
  return physicalPath(path.startsWith("/") ? path : `${process.cwd()}/${path}`);
}

function timestamp() {
  const now = new Date();
  const pad = (value) => String(value).padStart(2, "0");
  const date = `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}`;
  return `${date}-${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;
}

function run(script, args, env = {}) {
  const result = spawnSync(process.execPath, [script, ...args], { stdio: "inherit", env: { ...process.env, ...env } });
  if (result.status !== 0) throw new Error(`${basename(script)} exited ${result.status ?? result.signal}`);
}

function isExecutable(path) {
  try {
    accessSync(path, constants.X_OK);
    return true;
  } catch {
    return false;
  }
}

function syncSettings({ homeDir, claudeRoot, claudeOnly, apply, install, timestamp: stamp }) {
  const dryRun = apply ? "0" : "1";
  if (!claudeOnly && seedPiSettings({ homeDir, repoDir, apply }, emit)) {
    run(join(scriptDir, "lib/pi-agent-settings-sync.mjs"), [
      join(homeDir, ".pi/agent/settings.json"),
      join(repoDir, "pi/agent/settings.json"),
      dryRun,
      stamp,
      install ? "install" : "deploy",
    ]);
  }
  const fragment = join(repoDir, "claude/settings.skill-overrides.json");
  if (!existsSync(fragment)) {
    emit("MISSING", "Claude skill-overrides fragment source");
    return;
  }
  run(join(scriptDir, "lib/claude-settings-sync.mjs"), [join(claudeRoot, "settings.json"), fragment, dryRun, stamp, "deploy"]);
}

function skillLoadCheck({ claudeRoot, install }) {
  const loadCheck = join(scriptDir, "claude-skill-load-check");
  if (!isExecutable(loadCheck)) return;
  const result = spawnSync(loadCheck, [], { stdio: "inherit", env: { ...process.env, CLAUDE_SKILL_LOAD_CLAUDE_DIR: claudeRoot } });
  if (result.status === 0) emit("OK", "Claude skill load check after apply");
  else if (install) emit("WARN", "Claude skill load check after installer convergence (see output above)");
  else {
    emit("FAIL", `Claude skill load check on ${claudeRoot} after apply (see output above; scripts/claude-skill-load-check --fix governs new skills)`);
    process.exit(1);
  }
}

const options = parseArgs(process.argv.slice(2));
let scopes;
try {
  scopes = activeScopes(options.homeDir);
} catch (error) {
  exit(error.message, 2);
}
const records = skillRecords(repoDir);
if (records && !records.some((record) => record.source === "etabli")) {
  exit("deploy-agent-workflow: skill catalog present but degenerate (no first-party record); aborting", 1);
}
const homeIsLive = Boolean(process.env.HOME) && options.homeDir === physicalHome(process.env.HOME);
const base = {
  repoDir,
  homeDir: options.homeDir,
  scopes,
  records,
  mode: options.check ? "check" : "deploy",
  apply: options.check ? options.fix : options.apply,
  install: !options.check && process.env.ETABLI_DEPLOY_CALLER === "install",
  verbose: options.verbose,
  timestamp: timestamp(),
  live: homeIsLive && process.env.ETABLI_SKIP_LIVE_CHECKS !== "1",
};
const roots = [{ claudeRoot: join(options.homeDir, ".claude"), claudeOnly: false }];
const override = homeIsLive ? claudeConfigOverride() : null;
if (override) roots.push({ claudeRoot: override, claudeOnly: true });

const totals = { issues: 0, fixed: 0, unresolved: 0 };
for (const root of roots) {
  if (root.claudeOnly) emit("SECTION", `Claude config dir ${root.claudeRoot}`);
  const pass = { ...base, ...root };
  const counts = reconcile(pass, emit);
  for (const key of Object.keys(totals)) totals[key] += counts[key];
  if (options.check) continue;
  try {
    syncSettings(pass);
  } catch (error) {
    totals.unresolved += 1;
    emit("FAIL", error.message);
  }
  if (pass.apply && pass.live) skillLoadCheck(pass);
}

if (options.check) {
  writeSync(1, `\nSummary: ${totals.issues} issue(s), ${totals.fixed} fix(es) applied, ${totals.unresolved} unresolved\n`);
  if (totals.unresolved > 0 || (totals.issues > 0 && !options.fix)) process.exitCode = 1;
} else if (totals.unresolved > 0) {
  emit("FAIL", `${totals.unresolved} unresolved entr${totals.unresolved === 1 ? "y" : "ies"} (see above)`);
  process.exitCode = 1;
} else {
  emit("SUMMARY", options.apply ? "agent workflow deployed" : "dry-run complete");
}
