#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

DRY_RUN=1
HOME_DIR="$HOME"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
. "$SCRIPT_DIR/lib/pi-paths.sh"
. "$SCRIPT_DIR/lib/skill-catalog.sh"
. "$SCRIPT_DIR/lib/vendor-surfaces.sh"
. "$SCRIPT_DIR/lib/etabli-scope.sh"
. "$SCRIPT_DIR/lib/managed-surfaces.sh"
. "$SCRIPT_DIR/lib/claude-config-dir.sh"
SKILL_CATALOG="$REPO_DIR/workflow/runtime/skill-surface.tsv"

ACTIVE_SCOPES="shared"

resolve_scopes() {
  ACTIVE_SCOPES="$(etabli_active_scopes "$HOME_DIR")"
}

active_scopes() {
  printf '%s\n' "$ACTIVE_SCOPES"
}

usage() {
  cat <<EOF
Usage: $(basename "$0") [--dry-run] [--apply] [--home DIR]

Deploy only the Etabli-managed workflow and skill surfaces for Claude Code
and Pi, and remove this checkout's links from the retired Codex, Devin and
shared agents surfaces. Also registers claude/mods as the etabli-local
marketplace and installs the /etabli plugin for the active Claude config
(skipped with --home or ETABLI_SKIP_CLAUDE_PLUGIN=1).

Options:
  --dry-run         Show planned changes without touching local harness files (default)
  --apply           Apply local symlinks and safe Pi settings resource sync
  --home DIR        Target home directory, defaults to HOME
  -h, --help        Show this help
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    --apply)
      DRY_RUN=0
      ;;
    --home)
      if [ "$#" -lt 2 ]; then
        printf 'missing value for --home\n' >&2
        exit 2
      fi
      HOME_DIR="$2"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      printf 'unexpected argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

resolve_scopes

status_line() {
  local status="$1"
  local message="$2"

  printf '%-14s %s\n' "$status" "$message"
}

managed_surface_status() {
  status_line "$@"
}

same_link() {
  managed_surface_same_link "$@"
}

link_path() {
  local mode="deploy"
  [ "${ETABLI_DEPLOY_CALLER:-}" = install ] && mode="install"
  managed_surface_reconcile_link "$mode" "$@"
}

remove_managed_path() {
  local target_path="$1"
  local label="$2"
  local backup

  if [ ! -e "$target_path" ] && [ ! -L "$target_path" ]; then
    status_line OK "$label absent"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    status_line WOULD_REMOVE "$label"
    return 0
  fi

  if [ -d "$target_path" ] && [ ! -L "$target_path" ]; then
    backup="$(managed_surface_backup_path "$target_path" "$TIMESTAMP")"
    mv "$target_path" "$backup"
    status_line BACKUP "$backup"
    return 0
  fi

  rm -f "$target_path"
  status_line REMOVE "$label"
}

remove_exact_managed_link() {
  managed_surface_remove_exact_link deploy "$@"
}

prune_stale_managed_claude_agent_links() {
  managed_surface_prune_stale_claude_agents deploy "$REPO_DIR" "$HOME_DIR"
}

node_available() {
  command -v node >/dev/null 2>&1
}

json_list() {
  local script="$1"

  node -e "$script" "$REPO_DIR/pi/agent/settings.json"
}

pi_core_skills() {
  skill_catalog_names "$SKILL_CATALOG" pi pi_core
}

is_core_pi_skill() {
  local candidate="$1"
  local skill
  local skills=()
  while IFS= read -r skill; do
    [ -n "$skill" ] && skills+=("$skill")
  done < <(pi_core_skills)
  managed_surface_catalog_contains "$candidate" "${skills[@]}"
}

sync_pi_agent_settings() {
  local local_settings="$HOME_DIR/.pi/agent/settings.json"
  local tracked_settings="$REPO_DIR/pi/agent/settings.json"
  local tmp_settings
  local sync_mode="deploy"

  if [ "${ETABLI_DEPLOY_CALLER:-}" = install ]; then
    sync_mode="install"
  fi

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$HOME_DIR/.pi/agent"
  fi

  if [ -L "$local_settings" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      status_line WOULD_MIGRATE "Pi agent settings symlink to local file"
      return 0
    fi

    tmp_settings="$(mktemp)"
    if cp -L "$local_settings" "$tmp_settings" 2>/dev/null; then
      rm "$local_settings"
      mv "$tmp_settings" "$local_settings"
      status_line MIGRATE "Pi agent settings symlink to local file"
    else
      rm -f "$tmp_settings"
      rm "$local_settings"
      cp "$tracked_settings" "$local_settings"
      status_line COPY "Pi agent settings bootstrap after dangling symlink"
    fi
  fi

  if [ ! -f "$local_settings" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      status_line WOULD_COPY "Pi agent settings bootstrap"
      return 0
    fi

    cp "$tracked_settings" "$local_settings"
    status_line COPY "Pi agent settings bootstrap"
  fi

  if ! node_available; then
    status_line SKIP "Node.js unavailable; Pi settings sync skipped"
    return 0
  fi

  node "$SCRIPT_DIR/lib/pi-agent-settings-sync.mjs" \
    "$local_settings" "$tracked_settings" "$DRY_RUN" "$TIMESTAMP" "$sync_mode"
}

sync_claude_skill_overrides() {
  local local_settings="${CLAUDE_ROOT:-$HOME_DIR/.claude}/settings.json"
  local tracked_fragment="$REPO_DIR/claude/settings.skill-overrides.json"

  if [ ! -f "$tracked_fragment" ]; then
    status_line MISSING "Claude skill-overrides fragment source"
    return 0
  fi

  if ! node_available; then
    status_line SKIP "Node.js unavailable; Claude skill overrides sync skipped"
    return 0
  fi

  node "$SCRIPT_DIR/lib/claude-settings-sync.mjs" \
    "$local_settings" "$tracked_fragment" "$DRY_RUN" "$TIMESTAMP" deploy
}

deploy_pi() {
  local agent_file
  local agent_name
  local skill
  local theme_file
  local theme_name
  local skill_link
  local skill_name
  local skill_target
  local pi_node_modules

  status_line SECTION "Pi"

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$HOME_DIR/.pi/agent/agents" "$HOME_DIR/.pi/agent/skills" "$HOME_DIR/.pi/agent/themes"
  fi

  link_path "$REPO_DIR/pi/AGENTS.md" "$HOME_DIR/.pi/agent/AGENTS.md" "Pi AGENTS.md"
  link_path "$REPO_DIR/workflow" "$HOME_DIR/.pi/agent/workflow" "Pi workflow"
  link_path "$REPO_DIR/PLAN_TEMPLATE.md" "$HOME_DIR/.pi/agent/PLAN_TEMPLATE.md" "Pi PLAN_TEMPLATE.md"
  link_path "$REPO_DIR/PLAN_TEMPLATE_FULL.md" "$HOME_DIR/.pi/agent/PLAN_TEMPLATE_FULL.md" "Pi PLAN_TEMPLATE_FULL.md"
  link_path "$REPO_DIR/pi/models.json" "$HOME_DIR/.pi/agent/models.json" "Pi models.json"
  link_path "$REPO_DIR/pi/agent/subagents.json" "$HOME_DIR/.pi/agent/subagents.json" "Pi subagents.json"
  link_path "$REPO_DIR/pi/settings.json" "$HOME_DIR/.pi/settings.json" "Pi settings.json"

  for agent_file in "$REPO_DIR/pi/agents"/*.md; do
    [ -f "$agent_file" ] || continue
    agent_name="$(basename "$agent_file")"
    link_path "$agent_file" "$HOME_DIR/.pi/agent/agents/$agent_name" "Pi agent $agent_name"
  done

  remove_managed_path "$HOME_DIR/.pi/extensions" "Pi root extensions path"
  link_path "$REPO_DIR/scripts" "$HOME_DIR/.pi/scripts" "Pi canonical scripts"
  link_path "$REPO_DIR/workflow" "$HOME_DIR/.pi/workflow" "Pi canonical workflow"
  link_path "$REPO_DIR/pi/extensions" "$HOME_DIR/.pi/agent/extensions" "Pi agent extensions"
  link_path "$REPO_DIR/pi/themes" "$HOME_DIR/.pi/themes" "Pi themes"

  if [ "$HOME_DIR" = "$HOME" ] && [ "${ETABLI_INSTALL_HELPER_SMOKE:-}" != 1 ]; then
    pi_node_modules="$(pi_agent_node_modules_dir "$HOME_DIR")"
    if [ "$DRY_RUN" -eq 1 ]; then
      if same_link "$pi_node_modules" "$REPO_DIR/pi/extensions/node_modules"; then
        status_line OK "Pi extension node_modules"
      else
        status_line WOULD_LINK "Pi extension node_modules -> $pi_node_modules"
      fi
    else
      mkdir -p "$pi_node_modules"
      link_path "$pi_node_modules" "$REPO_DIR/pi/extensions/node_modules" "Pi extension node_modules"
    fi
  else
    status_line SKIP "Pi extension node_modules repo link for isolated or non-default home"
  fi

  sync_pi_agent_settings

  managed_surface_remove_symlink deploy \
    "$HOME_DIR/.pi/damage-control-rules.json" \
    "legacy Pi damage-control rules"

  while IFS= read -r skill; do
    [ -z "$skill" ] && continue
    link_path "$REPO_DIR/pi/skills/$skill" "$HOME_DIR/.pi/agent/skills/$skill" "Pi skill $skill"
  done < <(pi_core_skills)

  local core_skills=()
  while IFS= read -r skill; do
    [ -n "$skill" ] && core_skills+=("$skill")
  done < <(pi_core_skills)
  managed_surface_prune_unlisted_source_skills deploy "$REPO_DIR" "$HOME_DIR" \
    .pi/agent/skills Pi pi "${core_skills[@]}"

  for theme_file in "$REPO_DIR/pi/themes"/*.json; do
    [ -f "$theme_file" ] || continue
    theme_name="$(basename "$theme_file")"
    link_path "$theme_file" "$HOME_DIR/.pi/agent/themes/$theme_name" "Pi theme $theme_name"
  done
}

etabli_plugin_json_field() {
  node -e '
let input = "";
process.stdin.on("data", (chunk) => { input += chunk; });
process.stdin.on("end", () => {
  const [key, value, field] = process.argv.slice(1);
  let items;
  try {
    items = JSON.parse(input);
  } catch {
    process.exit(3);
  }
  if (!Array.isArray(items)) process.exit(3);
  const entry = items.find((item) => item && item[key] === value);
  if (entry) process.stdout.write(String(entry[field] ?? ""));
});' "$@"
}

deploy_etabli_plugin() {
  local mods_dir="$REPO_DIR/claude/mods"
  local marketplace="etabli-local"
  local plugin="etabli@etabli-local"
  local listing registered_path installed_folder

  status_line SECTION "Claude etabli plugin"
  if [ "${ETABLI_SKIP_CLAUDE_PLUGIN:-0}" = 1 ]; then
    status_line SKIP "etabli plugin (ETABLI_SKIP_CLAUDE_PLUGIN=1)"
    return 0
  fi
  if [ "$HOME_DIR" != "$HOME" ] || [ "${ETABLI_INSTALL_HELPER_SMOKE:-}" = 1 ]; then
    status_line SKIP "etabli plugin for isolated or non-default home"
    return 0
  fi
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ] &&
    [ "$(claude_physical_dir "$CLAUDE_CONFIG_DIR" || true)" != "$(claude_physical_dir "$(claude_effective_dir)" || true)" ]; then
    status_line SKIP "etabli plugin: CLAUDE_CONFIG_DIR is outside this home"
    return 0
  fi
  if ! command -v claude >/dev/null 2>&1 || ! node_available; then
    status_line SKIP "etabli plugin: claude CLI or Node.js unavailable"
    return 0
  fi

  if ! listing="$(claude plugin marketplace list --json)" ||
    ! registered_path="$(printf '%s' "$listing" | etabli_plugin_json_field name "$marketplace" path)"; then
    status_line WARN "etabli plugin: cannot list Claude marketplaces"
    return 0
  fi
  if [ "$registered_path" != "$mods_dir" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      [ -z "$registered_path" ] || status_line WOULD_REMOVE "marketplace $marketplace at $registered_path"
      status_line WOULD_LINK "marketplace $marketplace -> $mods_dir"
    else
      [ -z "$registered_path" ] || claude plugin marketplace remove "$marketplace" >/dev/null
      claude plugin marketplace add "$mods_dir" --scope user >/dev/null
      status_line LINK "marketplace $marketplace -> $mods_dir"
    fi
  else
    status_line OK "marketplace $marketplace"
  fi

  if ! listing="$(claude plugin list --json)" ||
    ! installed_folder="$(printf '%s' "$listing" | etabli_plugin_json_field id "$plugin" readFromFolder)"; then
    status_line WARN "etabli plugin: cannot list installed Claude plugins"
    return 0
  fi
  if [ "$installed_folder" = "$mods_dir/etabli" ]; then
    status_line OK "plugin $plugin"
  elif [ "$DRY_RUN" -eq 1 ]; then
    status_line WOULD_INSTALL "plugin $plugin from $mods_dir/etabli"
  else
    claude plugin install "$plugin" --scope user >/dev/null
    status_line INSTALL "plugin $plugin from $mods_dir/etabli"
  fi
}

prune_retired_surfaces() {
  status_line SECTION "Retired surfaces"
  managed_surface_prune_retired_surfaces deploy "$REPO_DIR" "$HOME_DIR"
}

deploy_vendor_skills() {
  local skill_name skill_dir record_scope record_pi_core record_vendor surface label

  status_line SECTION "Vendor skills"

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "$HOME_DIR/.pi/agent/skills" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/skills"
  fi

  managed_surface_prune_pi_cross_surface_links deploy "$REPO_DIR" "$HOME_DIR"
  managed_surface_prune_stale_skill_links deploy "$REPO_DIR" "$HOME_DIR"
  managed_surface_prune_vendor_skill_links deploy "$REPO_DIR" "$HOME_DIR" "$SKILL_CATALOG" "$ACTIVE_SCOPES"

  while IFS=$'\t' read -r record_scope skill_name skill_dir record_pi_core record_vendor; do
    [ -n "$skill_name" ] || continue
    for surface in .claude/skills .pi/agent/skills; do
      managed_surface_selected "$surface" || continue
      if vendor_surface_expected "$surface" "$record_scope" "$record_pi_core" "$ACTIVE_SCOPES"; then
        case "$surface" in
        .claude/skills) label="Claude" ;;
        .pi/agent/skills) label="Pi" ;;
        esac
        link_path "$skill_dir" "$(managed_surface_dir "$HOME_DIR" "$surface")/$skill_name" "$label vendor skill $skill_name"
      fi
    done
  done < <(skill_catalog_vendor_records "$SKILL_CATALOG" "$REPO_DIR")
}

deploy_claude() {
  local command_file
  local command_name
  local target_name
  local hook_file
  local hook_name
  local skill_dir
  local skill_name
  local stale_command
  local agent_file
  local agent_name
  local script_entry
  local script_name

  status_line SECTION "Claude"

  if [ "$DRY_RUN" -eq 0 ]; then
    mkdir -p "${CLAUDE_ROOT:-$HOME_DIR/.claude}/commands" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/hooks" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/skills" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/agents"
  fi

  link_path "$REPO_DIR/claude/CLAUDE.md" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/CLAUDE.md" "Claude CLAUDE.md"
  link_path "$REPO_DIR/workflow" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/workflow" "Claude workflow"
  link_path "$REPO_DIR/PLAN_TEMPLATE.md" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/PLAN_TEMPLATE.md" "Claude PLAN_TEMPLATE.md"
  link_path "$REPO_DIR/PLAN_TEMPLATE_FULL.md" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/PLAN_TEMPLATE_FULL.md" "Claude PLAN_TEMPLATE_FULL.md"

  for scope in $(active_scopes); do
    for command_file in "$REPO_DIR/claude/scopes/$scope/commands"/*.md; do
      [ -f "$command_file" ] || continue
      command_name="$(basename "$command_file")"
      link_path "$command_file" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/commands/$command_name" "Claude command $command_name"
    done
  done

  for stale_command in \
    qa-planner.md \
    qa-generator.md \
    qa-healer.md \
    qa-reviewer.md \
    qa-failure-dossier.md \
    verify.md \
    plan.md \
    plan-create.md \
    plan-review.md \
    handoff.md \
    handoff-implement.md \
    ops-status.md \
    ops-pi-status.md \
    commit.md \
    cross-repo-audit.md \
    front-quality.md \
    pr-feedback.md \
    pre-commit.md \
    recap.md \
    spec-verify.md \
    tests-iso.md \
    ui-debug.md; do
    remove_exact_managed_link \
      "${CLAUDE_ROOT:-$HOME_DIR/.claude}/commands/$stale_command" \
      "stale Claude command $stale_command" \
      "$REPO_DIR/claude/commands/$stale_command" \
      "$REPO_DIR/claude/scopes/shared/commands/$stale_command"
  done
  remove_exact_managed_link \
    "${CLAUDE_ROOT:-$HOME_DIR/.claude}/handoff-template.md" \
    "stale Claude handoff template" \
    "$REPO_DIR/claude/handoff-template.md"

  for hook_file in "$REPO_DIR/claude/hooks"/*.mjs "$REPO_DIR/claude/hooks"/*.sh; do
    [ -f "$hook_file" ] || continue
    hook_name="$(basename "$hook_file")"
    link_path "$hook_file" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/hooks/$hook_name" "Claude hook $hook_name"
  done
  for hook_link in "${CLAUDE_ROOT:-$HOME_DIR/.claude}/hooks"/*; do
    [ -L "$hook_link" ] || continue
    hook_name="$(basename "$hook_link")"
    hook_target="$REPO_DIR/claude/hooks/$hook_name"
    [ "$(readlink "$hook_link")" = "$hook_target" ] || continue
    [ -e "$hook_target" ] && continue
    remove_exact_managed_link "$hook_link" "stale Claude hook $hook_name" "$hook_target"
  done

  link_path "$REPO_DIR/claude/statusline-command.sh" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/statusline-command.sh" "Claude statusline command"

  link_path "$REPO_DIR/claude/settings.workflow-hooks.json" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/settings.workflow-hooks.json" "Claude workflow hooks fragment"

  sync_claude_skill_overrides

  prune_stale_managed_claude_agent_links

  for scope in $(active_scopes); do
    for skill_dir in "$REPO_DIR/claude/scopes/$scope/skills"/*; do
      [ -d "$skill_dir" ] || continue
      skill_name="$(basename "$skill_dir")"
      if managed_surface_skill_is_shadowed "$skill_name" "$ACTIVE_SCOPES"; then
        remove_exact_managed_link \
          "${CLAUDE_ROOT:-$HOME_DIR/.claude}/skills/$skill_name" \
          "shadowed Claude skill $skill_name" \
          "$skill_dir"
        continue
      fi
      link_path "$skill_dir" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/skills/$skill_name" "Claude skill $skill_name"
    done

    for agent_file in "$REPO_DIR/claude/scopes/$scope/agents"/*.md; do
      [ -f "$agent_file" ] || continue
      agent_name="$(basename "$agent_file")"
      link_path "$agent_file" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/agents/$agent_name" "Claude agent $agent_name"
    done

    for script_entry in "$REPO_DIR/claude/scopes/$scope/scripts"/*; do
      [ -e "$script_entry" ] || [ -L "$script_entry" ] || continue
      script_name="$(basename "$script_entry")"
      link_path "$script_entry" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/scripts/$script_name" "Claude script $script_name"
    done
  done

  link_path "$REPO_DIR/workflow/review-rubric.md" "${CLAUDE_ROOT:-$HOME_DIR/.claude}/review-rubric.md" "Claude review-rubric.md"

  if [ "$DRY_RUN" -eq 0 ] && [ "$HOME_DIR" = "$HOME" ] && \
    [ "${ETABLI_INSTALL_HELPER_SMOKE:-}" != 1 ] && [ -x "$SCRIPT_DIR/claude-skill-load-check" ]; then
    if ! CLAUDE_SKILL_LOAD_CLAUDE_DIR="${CLAUDE_ROOT:-$HOME_DIR/.claude}" "$SCRIPT_DIR/claude-skill-load-check"; then
      if [ "${ETABLI_DEPLOY_CALLER:-}" = install ]; then
        status_line WARN "Claude skill load check after installer convergence (see output above)"
      else
        status_line FAIL "Claude skill load check on ${CLAUDE_ROOT:-$HOME_DIR/.claude} after apply (see output above; scripts/claude-skill-load-check --fix governs new skills)"
        exit 1
      fi
    else
      status_line OK "Claude skill load check after apply"
    fi
  fi
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  CLAUDE_ROOT="$HOME_DIR/.claude"
  export MANAGED_CLAUDE_ROOT="$CLAUDE_ROOT"
  deploy_pi
  prune_retired_surfaces
  deploy_vendor_skills
  deploy_claude
  if [ "$HOME_DIR" = "$HOME" ] && config_root="$(claude_config_dir_override)"; then
    CLAUDE_ROOT="$config_root"
    MANAGED_CLAUDE_ROOT="$CLAUDE_ROOT"
    export MANAGED_CLAUDE_ONLY=1
    status_line SECTION "Claude config dir $CLAUDE_ROOT"
    deploy_vendor_skills
    deploy_claude
  fi
  deploy_etabli_plugin

  if [ "$DRY_RUN" -eq 1 ]; then
    status_line SUMMARY "dry-run complete"
  else
    status_line SUMMARY "agent workflow deployed"
  fi
fi
