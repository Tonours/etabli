#!/usr/bin/env bash
set -euo pipefail

WORKFLOW_DIR=".workflow"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
DETAIL_SCHEMA="$SCRIPT_DIR/lib/workflow-event-detail.jq"
MEASUREMENT_INTEGRITY="$SCRIPT_DIR/workflow-measurement-integrity"

ALLOWED_EVENTS=(
  route_decided
  plan_created
  adversary_completed
  review_completed
  simplification_completed
  file_changed
  validation_run
  validation_failed
  dogfood_matrix_created
  dogfood_scenario_run
  dogfood_fix_applied
  dogfood_blocked
  self_improvement_candidate
  harness_failure_pattern
  harness_proposal
  harness_validation_completed
  harness_candidate_rejected
  project_slice_planned
  project_slice_completed
  runtime_run_attached
  multi_execution_completed
  runtime_receipt
  outcome_measurement_population
  outcome_measurement_imported
  outcome_metric
  retry_classified
  no_progress
  handoff
  human_checkpoint
  archive_written
  plan_removed
  completed
  blocked
)

usage() {
  cat <<EOF
Usage: workflow-event [--dir path] append <slug> <event-type> [json-detail]
       workflow-event [--dir path] activate <slug>
       workflow-event [--dir path] recover <slug> <reason-code>
       workflow-event [--dir path] validate <slug> [--allow-missing] [--profile structural|autonomous-completed|autonomous-completed-strict|blocked-terminal]
EOF
}

allowed_list() {
  printf '%s\n' "${ALLOWED_EVENTS[@]}"
}

is_allowed_event() {
  local event="$1"
  local allowed
  for allowed in "${ALLOWED_EVENTS[@]}"; do
    [ "$event" = "$allowed" ] && return 0
  done
  return 1
}

is_valid_slug() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]]
}

detail_valid() {
  local event="$1" detail="$2" schema_version="${3:-2}"
  local strict=false

  [ "$schema_version" = "2" ] && strict=true
  printf '%s\n' "$detail" |
    jq -e --arg event "$event" --argjson strict "$strict" -f "$DETAIL_SCHEMA" >/dev/null 2>&1
}
die_usage() {
  usage >&2
  exit 2
}

if [ "${1:-}" = "--dir" ]; then
  [ "$#" -ge 3 ] || die_usage
  WORKFLOW_DIR="$2"
  shift 2
fi

command="${1:-}"
[ -n "$command" ] || die_usage
shift || true

case "$command" in
  append)
    [ "$#" -ge 2 ] || die_usage
    slug="$1"
    event="$2"
    is_valid_slug "$slug" || { printf 'invalid run slug: %s\n' "$slug" >&2; exit 2; }
    detail="{}"
    if [ "$#" -ge 3 ]; then
      detail="$3"
    fi

    if ! is_allowed_event "$event"; then
      printf 'unknown event type: %s\nAllowed events:\n%s\n' "$event" "$(allowed_list)" >&2
      exit 2
    fi
    if ! detail_valid "$event" "$detail" 2; then
      printf 'invalid json detail for event %s: expected an object with required fields\n' "$event" >&2
      exit 2
    fi

    run_dir="$WORKFLOW_DIR/$slug"
    mkdir -p "$run_dir"
    jq -nc \
      --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg event "$event" \
      --arg run "$slug" \
      --argjson detail "$detail" \
      '{schema_version:2,ts:$ts,event:$event,run:$run,detail:$detail}' >> "$run_dir/events.jsonl"
    if [ "$event" = "completed" ] || [ "$event" = "blocked" ]; then
      pointer="$WORKFLOW_DIR/.active-run.json"
      if [ -f "$pointer" ] && jq -e --arg run "$slug" '.schema_version == 1 and .run == $run' "$pointer" >/dev/null 2>&1; then
        rm -f "$pointer"
      fi
    fi
    ;;
  activate)
    [ "$#" -eq 1 ] || die_usage
    slug="$1"
    is_valid_slug "$slug" || { printf 'invalid run slug: %s\n' "$slug" >&2; exit 2; }
    file="$WORKFLOW_DIR/$slug/events.jsonl"
    [ -f "$file" ] || { printf 'missing ledger: %s\n' "$file" >&2; exit 1; }
    "$0" --dir "$WORKFLOW_DIR" validate "$slug" >/dev/null || {
      printf 'cannot activate an invalid ledger: %s\n' "$slug" >&2
      exit 1
    }
    terminal_event="$(tail -n 1 "$file" | jq -r '.event')"
    if [ "$terminal_event" = "completed" ] || [ "$terminal_event" = "blocked" ]; then
      printf 'cannot activate a terminal ledger: %s\n' "$slug" >&2
      exit 1
    fi
    pointer="$WORKFLOW_DIR/.active-run.json"
    if [ -f "$pointer" ]; then
      current_run="$(jq -r '.run // empty' "$pointer" 2>/dev/null || true)"
      if [ "$current_run" != "$slug" ]; then
        printf 'active run already selected: %s\n' "$current_run" >&2
        exit 1
      fi
      printf 'active run: %s\n' "$slug"
      exit 0
    fi
    temporary_pointer="$WORKFLOW_DIR/.active-run.json.$$"
    jq -nc --arg run "$slug" '{schema_version:1,run:$run}' > "$temporary_pointer"
    if [ -e "$pointer" ]; then
      rm -f "$temporary_pointer"
      printf 'active run changed while activating: %s\n' "$pointer" >&2
      exit 1
    fi
    mv "$temporary_pointer" "$pointer"
    printf 'active run: %s\n' "$slug"
    ;;
  recover)
    [ "$#" -eq 2 ] || die_usage
    slug="$1"
    reason_code="$2"
    is_valid_slug "$slug" || { printf 'invalid run slug: %s\n' "$slug" >&2; exit 2; }
    [[ "$reason_code" =~ ^[a-z0-9][a-z0-9-]{2,63}$ ]] || { printf 'invalid recovery reason code\n' >&2; exit 2; }
    run_dir="$WORKFLOW_DIR/$slug"
    file="$run_dir/events.jsonl"
    [ -f "$file" ] || { printf 'missing ledger: %s\n' "$file" >&2; exit 1; }
    if "$0" --dir "$WORKFLOW_DIR" validate "$slug" >/dev/null 2>&1; then
      printf 'refusing recovery for an already valid ledger: %s\n' "$slug" >&2
      exit 1
    fi
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    quarantine="$run_dir/events.invalid-$stamp.jsonl"
    [ ! -e "$quarantine" ] || { printf 'quarantine target already exists: %s\n' "$quarantine" >&2; exit 1; }
    mv "$file" "$quarantine"
    jq -nc \
      --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg run "$slug" \
      --arg reason "$reason_code" \
      --arg quarantine "${quarantine#$WORKFLOW_DIR/}" \
      '{schema_version:2,ts:$ts,event:"blocked",run:$run,detail:{reason:("ledger recovered: " + $reason),needed_input:("inspect preserved " + $quarantine + " before starting a new run")}}' > "$file"
    pointer="$WORKFLOW_DIR/.active-run.json"
    if [ -f "$pointer" ] && jq -e --arg run "$slug" '.schema_version == 1 and .run == $run' "$pointer" >/dev/null 2>&1; then
      rm -f "$pointer"
    fi
    printf 'recovered %s; preserved %s\n' "$slug" "$quarantine"
    ;;
  validate)
    [ "$#" -ge 1 ] || die_usage
    slug="$1"
    shift
    allow_missing=0
    profile="structural"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --allow-missing|--legacy) allow_missing=1 ;;
        --profile) [ "$#" -ge 2 ] || die_usage; profile="$2"; shift ;;
        *) die_usage ;;
      esac
      shift
    done
    file="$WORKFLOW_DIR/$slug/events.jsonl"
    count=0
    previous_ts=""
    legacy_post_terminal=0

    if [ ! -f "$file" ]; then
      if [ "$allow_missing" -eq 1 ]; then printf '0 events, legacy allow-missing\n'; exit 0; fi
      printf 'missing ledger: %s (use --allow-missing only for explicit legacy compatibility)\n' "$file" >&2
      exit 1
    fi

    while IFS= read -r line || [ -n "$line" ]; do
      count=$((count + 1))
      if ! parsed="$(printf '%s\n' "$line" | jq -ec . 2>/dev/null)"; then
        printf 'line %s: invalid json\n' "$count" >&2
        exit 1
      fi
      ts="$(printf '%s\n' "$parsed" | jq -r '.ts // empty')"
      event="$(printf '%s\n' "$parsed" | jq -r '.event // empty')"
      run="$(printf '%s\n' "$parsed" | jq -r '.run // empty')"
      detail="$(printf '%s\n' "$parsed" | jq -c '.detail // null')"
      schema_version="$(printf '%s\n' "$parsed" | jq -r '.schema_version // "legacy"')"
      if ! printf '%s\n' "$ts" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'; then
        printf 'line %s: invalid timestamp\n' "$count" >&2
        exit 1
      fi
      if [ -n "$previous_ts" ] && [[ "$ts" < "$previous_ts" ]]; then
        printf 'line %s: timestamp moved backwards\n' "$count" >&2
        exit 1
      fi
      if ! is_allowed_event "$event"; then
        printf 'line %s: unknown event type %s\n' "$count" "$event" >&2
        exit 1
      fi
      if [ "$schema_version" != "legacy" ] && [ "$schema_version" != "1" ] && [ "$schema_version" != "2" ]; then
        printf 'line %s: unsupported schema_version %s\n' "$count" "$schema_version" >&2
        exit 1
      fi
      if [ -n "${terminal_line:-}" ]; then
        if [ "$schema_version" = "2" ] || [ "${terminal_schema_version:-}" = "2" ]; then
          printf 'line %s: event follows terminal %s at line %s\n' "$count" "$terminal" "$terminal_line" >&2
          exit 1
        fi
        legacy_post_terminal=1
      fi
      if [ "$run" != "$slug" ]; then printf 'line %s: run does not match %s\n' "$count" "$slug" >&2; exit 1; fi
      if ! detail_valid "$event" "$detail" "$schema_version"; then printf 'line %s: invalid detail for %s\n' "$count" "$event" >&2; exit 1; fi
      if [ "$event" = "completed" ] || [ "$event" = "blocked" ]; then
        terminal="$event"
        terminal_line="$count"
        terminal_schema_version="$schema_version"
      fi
      previous_ts="$ts"
    done < "$file"

    if [ "$legacy_post_terminal" -eq 0 ] && [ -n "${terminal_line:-}" ] && [ "$terminal_line" -ne "$count" ]; then
      printf 'terminal event must be last (line %s of %s)\n' "$terminal_line" "$count" >&2
      exit 1
    fi

    if ! jq -se '
      def populations: [.[] | select(.event == "outcome_measurement_population") | .detail];
      def imports: [.[] | select(.event == "outcome_measurement_imported") | .detail];
      populations as $populations
      | imports as $imports
      | (all($populations[];
          ([.targets[].target_run] | unique | length) == (.targets | length))) and
        (($imports | map(.import_id) | unique | length) == ($imports | length)) and
        (all($imports[];
          . as $import |
          ([$populations[] | select(.population_id == $import.population_id)] | length) == 1 and
          ([$populations[]
            | select(.population_id == $import.population_id)
            | .targets[]
            | select(
                .target_run == $import.target_run and
                .target_ledger_sha256 == $import.target_ledger_sha256 and
                .target_terminal == $import.target_terminal and
                .target_terminal_event_sha256 == $import.target_terminal_event_sha256 and
                .target_outcome_event_sha256 == $import.target_outcome_event_sha256
              )] | length) == 1)) and
        (($imports | group_by(.target_run) | all(.[]; length == 1)))
    ' "$file" >/dev/null; then
      printf 'measurement imports must be unique members of exactly one matching population\n' >&2
      exit 1
    fi
    if ! "$MEASUREMENT_INTEGRITY" "$WORKFLOW_DIR" "$file"; then
      exit 1
    fi
    case "$profile" in
      structural) ;;
      autonomous-completed)
        [ "${terminal:-}" = "completed" ] || { printf 'profile autonomous-completed requires final completed event\n' >&2; exit 1; }
        for required in route_decided plan_created adversary_completed file_changed validation_run simplification_completed review_completed outcome_metric archive_written plan_removed; do
          jq -e --arg event "$required" 'select(.event == $event)' "$file" >/dev/null || { printf 'profile autonomous-completed missing %s\n' "$required" >&2; exit 1; }
        done
        for mode in plan code_diff; do
          jq -e --arg mode "$mode" 'select(.event == "adversary_completed" and .detail.mode == $mode)' "$file" >/dev/null || { printf 'profile autonomous-completed missing adversary mode %s\n' "$mode" >&2; exit 1; }
        done
        last_change="$(grep -n '"event":"file_changed"' "$file" | tail -1 | cut -d: -f1)"
        last_validation="$(grep -n '"event":"validation_run"' "$file" | tail -1 | cut -d: -f1)"
        [ "$last_validation" -gt "$last_change" ] || { printf 'profile autonomous-completed requires validation after last file change\n' >&2; exit 1; }
        ;;
      autonomous-completed-strict)
        [ "${terminal:-}" = "completed" ] || { printf 'profile autonomous-completed-strict requires final completed event\n' >&2; exit 1; }
        for required in route_decided plan_created adversary_completed file_changed validation_run simplification_completed review_completed outcome_metric archive_written plan_removed; do
          jq -e --arg event "$required" 'select(.event == $event)' "$file" >/dev/null || { printf 'profile autonomous-completed-strict missing %s\n' "$required" >&2; exit 1; }
        done
        for mode in plan code_diff; do
          jq -e --arg mode "$mode" 'select(.event == "adversary_completed" and .detail.mode == $mode)' "$file" >/dev/null || { printf 'profile autonomous-completed-strict missing adversary mode %s\n' "$mode" >&2; exit 1; }
        done
        # Runtime receipts bind validation, review, archive, and completion to
        # parent-process observations (hashes + exit), never text-only claims.
        for kind in validation review archive completion; do
          jq -e --arg kind "$kind" 'select(.event == "runtime_receipt" and .detail.kind == $kind and .detail.cryptographic == false and .detail.observed_by == "parent-process")' "$file" >/dev/null ||
            { printf 'profile autonomous-completed-strict missing runtime_receipt kind %s\n' "$kind" >&2; exit 1; }
        done
        # Self-improvement provenance: any comparative validation must carry a
        # candidate fingerprint and an evaluator manifest hash (grader immutability).
        if jq -e 'select(.event == "harness_validation_completed")' "$file" >/dev/null 2>&1; then
          jq -e 'select(.event == "harness_validation_completed") | .detail.candidate_fingerprint and .detail.evaluator_manifest_sha256' "$file" >/dev/null ||
            { printf 'profile autonomous-completed-strict requires candidate_fingerprint and evaluator_manifest_sha256 on every harness_validation_completed\n' >&2; exit 1; }
        fi
        ;;
      blocked-terminal) [ "${terminal:-}" = "blocked" ] || { printf 'profile blocked-terminal requires final blocked event\n' >&2; exit 1; } ;;
      *) printf 'unknown validation profile: %s\n' "$profile" >&2; exit 2 ;;
    esac

    if [ "$legacy_post_terminal" -eq 1 ]; then
      printf '%s events, ok (legacy post-terminal compatibility)\n' "$count"
    else
      printf '%s events, ok\n' "$count"
    fi
    ;;
  -h|--help)
    usage
    ;;
  *)
    printf 'unknown command: %s\n' "$command" >&2
    die_usage
    ;;
esac
