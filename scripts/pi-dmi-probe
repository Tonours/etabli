#!/usr/bin/env bash
# Probe DMI skills via Pi's native loader: hidden from the prompt, still
# expandable via /skill:name. See scripts/lib/pi-dmi-probe.mjs.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"

if command -v bun >/dev/null 2>&1; then
  exec bun "$ROOT_DIR/scripts/lib/pi-dmi-probe.mjs" "$@"
fi
exec node "$ROOT_DIR/scripts/lib/pi-dmi-probe.mjs" "$@"
