#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

DRY_RUN=0
FORCE=0
CHECK=0
TARGET_INPUT="."
TARGET_SET=0
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"

WRITTEN=0
UNCHANGED=0
CONFLICTS=0
CHECK_DRIFT=0
CHECK_MISSING=0
CHECK_OK=0

FILES=(
  "$REPO_DIR/workflow-scaffold/templates/AGENTS.md|AGENTS.md"
  "$REPO_DIR/workflow-scaffold/templates/CLAUDE.md|CLAUDE.md"
  "$REPO_DIR/workflow-scaffold/templates/docs/agent-workflow.md|docs/agent-workflow.md"
  "$REPO_DIR/workflow-scaffold/templates/docs/agent-memory.md|docs/agent-memory/README.md"
  "$REPO_DIR/workflow-scaffold/templates/docs/plan.md|docs/plan/README.md"
  "$REPO_DIR/workflow-scaffold/templates/docs/claude-code-workflow.md|docs/claude-code-workflow.md"
  "$REPO_DIR/workflow-scaffold/templates/docs/project-context.md|docs/project-context.md"
  "$REPO_DIR/workflow/memory.md|workflow/memory.md"
  "$REPO_DIR/workflow/plan-archive.md|workflow/plan-archive.md"
  "$REPO_DIR/workflow/spec.md|workflow/spec.md"
  "$REPO_DIR/workflow/review-rubric.md|workflow/review-rubric.md"
  "$REPO_DIR/workflow/ticket-template.md|workflow/ticket-template.md"
  "$REPO_DIR/workflow/linear-ticket-template.md|workflow/linear-ticket-template.md"
  "$REPO_DIR/workflow/events.md|workflow/events.md"
  "$REPO_DIR/workflow/events-validator.md|workflow/events-validator.md"
  "$REPO_DIR/workflow/contract-details.md|workflow/contract-details.md"
  "$REPO_DIR/workflow/agent-quick-card.md|workflow/agent-quick-card.md"
  "$REPO_DIR/workflow/answer-quality.md|workflow/answer-quality.md"
  "$REPO_DIR/workflow/skill-design.md|workflow/skill-design.md"
  "$REPO_DIR/workflow/project-autonomy-envelope.md|workflow/project-autonomy-envelope.md"
  "$REPO_DIR/workflow/git-contract.md|workflow/git-contract.md"
  "$REPO_DIR/workflow/pr-body-contract.md|workflow/pr-body-contract.md"
  "$REPO_DIR/workflow/verification-report-template.md|workflow/verification-report-template.md"
  "$REPO_DIR/workflow/evidence-pack.schema.json|workflow/evidence-pack.schema.json"
  "$REPO_DIR/workflow/templates/evidence-pack.json|workflow/templates/evidence-pack.json"
  "$REPO_DIR/workflow/templates/escaped-defect.md|workflow/templates/escaped-defect.md"
  "$REPO_DIR/workflow/templates/project-autonomy-envelope.json|workflow/templates/project-autonomy-envelope.json"
  "$REPO_DIR/workflow/templates/review-logic-hunter.md|workflow/templates/review-logic-hunter.md"
  "$REPO_DIR/workflow/templates/review-spec-hunter.md|workflow/templates/review-spec-hunter.md"
  "$REPO_DIR/workflow/templates/review-lead.md|workflow/templates/review-lead.md"
  "$REPO_DIR/workflow/templates/plan-archive.md|workflow/templates/plan-archive.md"
  "$REPO_DIR/PLAN_TEMPLATE.md|PLAN_TEMPLATE.md"
  "$REPO_DIR/PLAN_TEMPLATE_FULL.md|PLAN_TEMPLATE_FULL.md"
  "$REPO_DIR/scripts/plan-cleanup|scripts/plan-cleanup"
  "$REPO_DIR/scripts/workflow-event|scripts/workflow-event"
  "$REPO_DIR/scripts/workflow-measurement-integrity|scripts/workflow-measurement-integrity"
  "$REPO_DIR/scripts/lib/workflow-event-detail.jq|scripts/lib/workflow-event-detail.jq"
)

while IFS= read -r contract_path; do
  # program-orchestration is frozen and references etabli-repo-only binaries;
  # scaffolded projects do not carry the program control plane.
  [ "$(basename "$contract_path")" = "program-orchestration.md" ] && continue
  FILES+=("$contract_path|workflow/skills/$(basename "$contract_path")")
done < <(find "$REPO_DIR/workflow/skills" -maxdepth 1 -type f -name '*.md' -print | sort)

usage() {
  cat <<EOF
Usage: $(basename "$0") [target-dir] [--dry-run] [--force] [--check]

Deploy the Etabli workflow scaffold into a new or existing project.

Options:
  --dry-run   Show planned writes without touching the target
  --force     Backup and overwrite conflicting files
  --check     Report drift between source templates and deployed files without writing
  -h, --help  Show this help

Examples:
  deploy-workflow .
  deploy-workflow ~/code/new-project
  deploy-workflow . --dry-run
  deploy-workflow . --force
  deploy-workflow . --check
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    --force)
      FORCE=1
      ;;
    --check)
      CHECK=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [ "$TARGET_SET" -eq 1 ]; then
        printf 'multiple target directories provided: %s\n' "$1" >&2
        usage >&2
        exit 2
      fi
      TARGET_INPUT="$1"
      TARGET_SET=1
      ;;
  esac
  shift
done

if [ "$CHECK" -eq 1 ] && { [ "$DRY_RUN" -eq 1 ] || [ "$FORCE" -eq 1 ]; }; then
  printf 'flags are mutually exclusive: --check cannot be combined with --dry-run or --force\n' >&2
  exit 2
fi

status_line() {
  local status="$1"
  local message="$2"
  printf '%-9s %s\n' "$status" "$message"
}

backup_path() {
  local path="$1"
  local candidate="$path.bak.$TIMESTAMP"
  local index=1

  while [ -e "$candidate" ]; do
    candidate="$path.bak.$TIMESTAMP.$index"
    index=$((index + 1))
  done

  printf '%s\n' "$candidate"
}

target_dir() {
  if [ -d "$TARGET_INPUT" ]; then
    cd "$TARGET_INPUT" >/dev/null 2>&1 && pwd
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    printf '%s\n' "$TARGET_INPUT"
    return 0
  fi

  mkdir -p "$TARGET_INPUT"
  cd "$TARGET_INPUT" >/dev/null 2>&1 && pwd
}

display_target_dir() {
  if [ -d "$TARGET_INPUT" ]; then
    cd "$TARGET_INPUT" >/dev/null 2>&1 && pwd
    return 0
  fi

  local parent_path
  local target_name
  parent_path="$(dirname "$TARGET_INPUT")"
  target_name="$(basename "$TARGET_INPUT")"

  if [ -d "$parent_path" ]; then
    printf '%s/%s\n' "$(cd "$parent_path" >/dev/null 2>&1 && pwd)" "$target_name"
    return 0
  fi

  case "$TARGET_INPUT" in
    /*) printf '%s\n' "$TARGET_INPUT" ;;
    *) printf '%s/%s\n' "$(pwd -P)" "$TARGET_INPUT" ;;
  esac
}

preflight_sources() {
  local entry source_path

  for entry in "${FILES[@]}"; do
    source_path="${entry%%|*}"

    if [ ! -f "$source_path" ]; then
      status_line MISSING "$source_path"
      CONFLICTS=$((CONFLICTS + 1))
    fi
  done
}

preflight_target() {
  if [ -e "$TARGET_INPUT" ] && [ ! -d "$TARGET_INPUT" ]; then
    status_line CONFLICT "$TARGET_INPUT exists but is not a directory"
    CONFLICTS=$((CONFLICTS + 1))
  fi
}

preflight_conflicts() {
  local entry source_path relative_path destination_path parent_path

  for entry in "${FILES[@]}"; do
    source_path="${entry%%|*}"
    relative_path="${entry#*|}"
    destination_path="$TARGET_DIR/$relative_path"
    parent_path="$(dirname "$destination_path")"

    if [ ! -f "$source_path" ]; then
      status_line MISSING "$source_path"
      CONFLICTS=$((CONFLICTS + 1))
      continue
    fi

    if [ "$FORCE" -eq 0 ] && [ -e "$parent_path" ] && [ ! -d "$parent_path" ]; then
      status_line CONFLICT "$(dirname "$relative_path") exists but is not a directory"
      CONFLICTS=$((CONFLICTS + 1))
      continue
    fi

    if [ -f "$destination_path" ] && git -C "$TARGET_DIR" ls-files --error-unmatch "$relative_path" >/dev/null 2>&1; then
      continue
    fi

    if [ "$FORCE" -eq 0 ] && [ -e "$destination_path" ] && ! { [ -f "$destination_path" ] && cmp -s "$source_path" "$destination_path"; }; then
      status_line CONFLICT "$relative_path exists; rerun with --force or merge manually"
      CONFLICTS=$((CONFLICTS + 1))
    fi
  done
}

check_deployed_files() {
  local entry source_path relative_path destination_path

  for entry in "${FILES[@]}"; do
    source_path="${entry%%|*}"
    relative_path="${entry#*|}"
    destination_path="$TARGET_DIR/$relative_path"

    if [ ! -f "$source_path" ]; then
      status_line MISSING "$source_path"
      CHECK_MISSING=$((CHECK_MISSING + 1))
      continue
    fi

    if [ ! -f "$destination_path" ]; then
      status_line MISSING "$relative_path"
      CHECK_MISSING=$((CHECK_MISSING + 1))
      continue
    fi

    if cmp -s "$source_path" "$destination_path"; then
      status_line OK "$relative_path"
      CHECK_OK=$((CHECK_OK + 1))
      continue
    fi

    status_line DRIFT "$relative_path"
    CHECK_DRIFT=$((CHECK_DRIFT + 1))
  done

  printf '\nSummary: %d drifted, %d missing, %d ok\n' "$CHECK_DRIFT" "$CHECK_MISSING" "$CHECK_OK"

  if [ $((CHECK_DRIFT + CHECK_MISSING)) -gt 0 ]; then
    exit 1
  fi
}

write_file() {
  local source_path="$1"
  local relative_path="$2"
  local destination_path="$TARGET_DIR/$relative_path"
  local destination_dir
  local backup

  if [ ! -f "$source_path" ]; then
    status_line MISSING "$source_path"
    CONFLICTS=$((CONFLICTS + 1))
    return 0
  fi

  if [ -f "$destination_path" ] && cmp -s "$source_path" "$destination_path"; then
    status_line OK "$relative_path"
    UNCHANGED=$((UNCHANGED + 1))
    return 0
  fi

  if [ -f "$destination_path" ] && git -C "$TARGET_DIR" ls-files --error-unmatch "$relative_path" >/dev/null 2>&1; then
    status_line PROTECTED "$relative_path is tracked by the project; scaffold never overwrites it"
    UNCHANGED=$((UNCHANGED + 1))
    return 0
  fi

  destination_dir="$(dirname "$destination_path")"

  if [ -e "$destination_dir" ] && [ ! -d "$destination_dir" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
      status_line WOULD_BACKUP "$(dirname "$relative_path")"
      status_line WOULD_WRITE "$relative_path"
      return 0
    fi

    backup="$(backup_path "$destination_dir")"
    mv "$destination_dir" "$backup"
    status_line BACKUP "${backup#$TARGET_DIR/}"
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    if [ -e "$destination_path" ]; then
      status_line WOULD_BACKUP "$relative_path"
    fi
    status_line WOULD_WRITE "$relative_path"
    return 0
  fi

  mkdir -p "$destination_dir"

  if [ -e "$destination_path" ]; then
    backup="$(backup_path "$destination_path")"
    mv "$destination_path" "$backup"
    status_line BACKUP "${backup#$TARGET_DIR/}"
  fi

  cp "$source_path" "$destination_path"
  status_line WRITE "$relative_path"
  WRITTEN=$((WRITTEN + 1))
}

EXCLUDE_BEGIN="# >>> etabli personal workflow ignores >>>"
EXCLUDE_END="# <<< etabli personal workflow ignores <<<"

exclude_block() {
  printf '%s\n' "$EXCLUDE_BEGIN"
  printf '%s\n' \
    "/PLAN.md" \
    "/PLAN-*.md" \
    "/PLAN_TEMPLATE.md" \
    "/PLAN_TEMPLATE_FULL.md" \
    "/AGENTS.md" \
    "/CLAUDE.md" \
    "/.mcp.json" \
    "/.claude/" \
    "/.pi/" \
    "/.workflow/" \
    "/workflow/" \
    "/scripts/plan-cleanup" \
    "/scripts/workflow-event" \
    "/scripts/workflow-measurement-integrity" \
    "/scripts/lib/workflow-event-detail.jq" \
    "/docs/agent-workflow.md" \
    "/docs/claude-code-workflow.md" \
    "/docs/project-context.md" \
    "/docs/agent-memory/" \
    "/docs/plan/" \
    "*.bak.[0-9]*-[0-9]*"
  printf '%s\n' "$EXCLUDE_END"
}

warn_plan_gitignore() {
  local gitignore_path="$TARGET_DIR/.gitignore"

  [ -f "$gitignore_path" ] || return 0
  grep -Fxq "PLAN.md" "$gitignore_path" || return 0

  if git -C "$TARGET_DIR" show HEAD:.gitignore 2>/dev/null | grep -Fxq "PLAN.md"; then
    status_line WARN ".gitignore tracks PLAN.md in HEAD - remove it in a commit of that repo"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    status_line WOULD_WRITE ".gitignore PLAN.md entry removed"
    return 0
  fi

  local tmp
  tmp="$(mktemp)"
  awk '!(/^PLAN\.md$/ || /^# Agent workflow$/)' "$gitignore_path" >"$tmp"
  mv "$tmp" "$gitignore_path"
  status_line WRITE ".gitignore PLAN.md entry removed"
  WRITTEN=$((WRITTEN + 1))
}

ensure_local_exclude() {
  local git_dir exclude_path desired current tmp

  if ! git_dir="$(git -C "$TARGET_DIR" rev-parse --absolute-git-dir 2>/dev/null)"; then
    status_line SKIP "not a git repository - no .git/info/exclude to manage"
    return 0
  fi

  exclude_path="$git_dir/info/exclude"
  desired="$(exclude_block)"

  if [ -f "$exclude_path" ] && [ "$(awk -v b="$EXCLUDE_BEGIN" -v e="$EXCLUDE_END" 'index($0,b){f=1} f{print} index($0,e){f=0}' "$exclude_path")" = "$desired" ]; then
    status_line OK ".git/info/exclude block current"
    UNCHANGED=$((UNCHANGED + 1))
    warn_plan_gitignore
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    status_line WOULD_WRITE ".git/info/exclude block"
    warn_plan_gitignore
    return 0
  fi

  mkdir -p "$git_dir/info"
  tmp="$(mktemp)"
  if [ -f "$exclude_path" ]; then
    awk -v b="$EXCLUDE_BEGIN" -v e="$EXCLUDE_END" 'index($0,b){f=1} !f{print} index($0,e){f=0}' "$exclude_path" >"$tmp"
  fi
  printf '%s\n' "$desired" >>"$tmp"
  mv "$tmp" "$exclude_path"
  status_line WRITE ".git/info/exclude block"
  WRITTEN=$((WRITTEN + 1))
  warn_plan_gitignore
}

printf 'Target: %s\n\n' "$(display_target_dir)"

if [ "$CHECK" -eq 1 ]; then
  TARGET_DIR="$(display_target_dir)"
  check_deployed_files
  exit 0
fi

preflight_sources
preflight_target

if [ "$CONFLICTS" -eq 0 ]; then
  TARGET_DIR="$(target_dir)"
  preflight_conflicts
fi

if [ "$CONFLICTS" -eq 0 ]; then
  for entry in "${FILES[@]}"; do
    write_file "${entry%%|*}" "${entry#*|}"
  done
  ensure_local_exclude
fi

printf '\nSummary: %d written, %d unchanged, %d conflict(s)\n' "$WRITTEN" "$UNCHANGED" "$CONFLICTS"

if [ "$CONFLICTS" -gt 0 ]; then
  printf 'Resolve conflicts manually or rerun with --force after reviewing the target files.\n' >&2
  exit 1
fi
