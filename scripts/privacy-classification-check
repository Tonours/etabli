#!/usr/bin/env node
import { execFileSync } from 'node:child_process'
import { createHash } from 'node:crypto'
import { readFileSync, existsSync, writeFileSync } from 'node:fs'
import { resolve, isAbsolute, normalize } from 'node:path'

const ROOT = process.cwd()
const EXPECTED_HEAD = '407ec6d21fabfc1cebda04d8c5d0be801c0fb397'
const PRIMARY = new Set([
  'workflow/self-improvement/reviewer-eval-corpus.md',
  'workflow/self-improvement/review-metrics.md',
])
const TRACKED_SOURCES = new Set([
  ...PRIMARY,
  'workflow/skills/reviewer-improvement-loop.md',
  'workflow/skills/ship.md',
  'workflow/templates/escaped-defect.md',
  'docs/adr/0019-measure-ambient-tooling-before-cutting-review-passes.md',
  'docs/plan/20260826-rtk-grep-fix-and-adversary-metrics.md',
  'docs/plan/20260914-public-scrub.md',
  'docs/plan/20260914-workflow-context-budget.md',
  'docs/plan/20260914-context-budget-growth-remediation.md',
])
const ALLOWED_CLASS = new Set(['public-safe', 'Obvault', 'Brain', 'delete'])
const ALLOWED_CONTEXT = new Set(['etabli', 'forestadmin'])
const ALLOWED_BASIS = new Set(['workstack-forestadmin', 'etabli-harness', 'generic-public-contract', 'personal-research'])
const PRIVATE_CLASS = new Set(['Obvault', 'Brain'])
const UNIT_KEYS = [
  'unit_id', 'source_file', 'source_state', 'start_line', 'end_line',
  'source_slice_sha256', 'context', 'context_basis', 'classification',
  'destination_repo', 'destination_note', 'idempotency_key', 'rationale',
  'public_replacement_id',
]

function fail(message) {
  console.error(`privacy-classification-check: ${message}`)
  process.exit(1)
}

function args() {
  const values = process.argv.slice(2)
  const get = (name, fallback = null) => {
    const index = values.indexOf(name)
    return index >= 0 ? values[index + 1] ?? fail(`missing value for ${name}`) : fallback
  }
  return {
    manifest: get('--manifest'),
    root: get('--root', ROOT),
    phase: get('--phase', 'default'),
    localArtifacts: get('--local-artifacts'),
    checkDiff: values.includes('--check-diff'),
    generate: values.includes('--generate'),
    output: get('--output'),
  }
}

function sha256(bytes) {
  return createHash('sha256').update(bytes).digest('hex')
}

function git(argsList, cwd) {
  try {
    return execFileSync('git', argsList, { cwd, encoding: 'buffer', stdio: ['ignore', 'pipe', 'pipe'] })
  } catch (error) {
    fail(`git ${argsList.join(' ')} failed: ${error instanceof Error ? error.message : String(error)}`)
  }
}

function trackedBytes(root, path) {
  return git(['show', `HEAD:${path}`], root)
}

function lineOffsets(bytes) {
  const offsets = [0]
  for (let index = 0; index < bytes.length; index += 1) {
    if (bytes[index] === 0x0a && index + 1 < bytes.length) offsets.push(index + 1)
  }
  return offsets
}

function lineCount(bytes) {
  if (bytes.length === 0) return 0
  let count = 0
  for (const byte of bytes) if (byte === 0x0a) count += 1
  if (bytes.at(-1) !== 0x0a) count += 1
  return count
}

function sliceLines(bytes, start, end) {
  const offsets = lineOffsets(bytes)
  if (start < 1 || end < start || end > offsets.length) fail(`line range ${start}-${end} is out of bounds`)
  const begin = offsets[start - 1]
  const finish = end < offsets.length ? offsets[end] : bytes.length
  return bytes.subarray(begin, finish)
}

function validateRelativePath(value, label) {
  if (typeof value !== 'string' || value.length === 0 || isAbsolute(value) || normalize(value).startsWith('../') || value.split('/').includes('..')) fail(`unsafe ${label}`)
}

function sourceBytes(root, unit, artifacts) {
  if (unit.source_state === 'tracked-head') return trackedBytes(root, unit.source_file)
  if (unit.source_state !== 'untracked-preedit') fail(`unsupported source_state for ${unit.unit_id}`)
  const artifact = artifacts.find((entry) => entry.path === unit.source_file)
  if (!artifact) fail(`untracked unit ${unit.unit_id} is not linked to local-artifacts.json`)
  if (!existsSync(resolve(root, unit.source_file))) {
    if (process.env.PRIVACY_PHASE === 'post-delete') return null
    fail(`pre-edit artifact is missing: ${unit.source_file}`)
  }
  return readFileSync(resolve(root, unit.source_file))
}

function validateUnit(unit, root, artifacts, seen) {
  for (const key of Object.keys(unit)) if (!UNIT_KEYS.includes(key)) fail(`unknown unit key ${key}`)
  for (const key of UNIT_KEYS) if (!(key in unit)) fail(`missing ${key} in ${unit.unit_id ?? 'unit'}`)
  if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(unit.unit_id)) fail(`invalid unit_id ${unit.unit_id}`)
  validateRelativePath(unit.source_file, `source_file ${unit.unit_id}`)
  if (!['tracked-head', 'untracked-preedit'].includes(unit.source_state)) fail(`unsupported source_state for ${unit.unit_id}`)
  if (unit.source_state === 'tracked-head' && !TRACKED_SOURCES.has(unit.source_file)) fail(`tracked source is outside the approved set ${unit.unit_id}`)
  if (!ALLOWED_CLASS.has(unit.classification)) fail(`invalid classification ${unit.unit_id}`)
  if (!ALLOWED_CONTEXT.has(unit.context) || !ALLOWED_BASIS.has(unit.context_basis)) fail(`invalid context ${unit.unit_id}`)
  if ((unit.context_basis === 'workstack-forestadmin') !== (unit.context === 'forestadmin')) fail(`context basis mismatch ${unit.unit_id}`)
  if (unit.classification === 'Brain' && unit.context !== 'forestadmin') fail(`Brain classification requires forestadmin context ${unit.unit_id}`)
  if (unit.classification === 'Obvault' && unit.context !== 'etabli') fail(`Obvault classification requires etabli context ${unit.unit_id}`)
  if (!Number.isInteger(unit.start_line) || !Number.isInteger(unit.end_line) || unit.start_line < 1 || unit.end_line < unit.start_line) fail(`invalid range ${unit.unit_id}`)
  if (!/^[0-9a-f]{64}$/.test(unit.source_slice_sha256)) fail(`invalid source hash ${unit.unit_id}`)
  if (seen.unit.has(unit.unit_id)) fail(`duplicate unit_id ${unit.unit_id}`)
  seen.unit.add(unit.unit_id)
  if (unit.idempotency_key !== null) {
    if (typeof unit.idempotency_key !== 'string' || seen.idempotency.has(unit.idempotency_key)) fail(`duplicate idempotency_key ${unit.unit_id}`)
    seen.idempotency.add(unit.idempotency_key)
  }
  const privateUnit = PRIVATE_CLASS.has(unit.classification)
  if (privateUnit) {
    if (!unit.destination_repo || !unit.destination_note || !unit.idempotency_key) fail(`private destination is incomplete ${unit.unit_id}`)
    const expectedRepo = unit.context === 'forestadmin' ? 'Tonours/brain' : 'Tonours/obvault'
    if (unit.destination_repo !== expectedRepo) fail(`wrong destination for ${unit.unit_id}`)
    if (isAbsolute(unit.destination_note) || normalize(unit.destination_note).startsWith('../') || unit.destination_note.includes('..')) fail(`unsafe destination note ${unit.unit_id}`)
  } else if (unit.destination_repo !== null || unit.destination_note !== null || unit.idempotency_key !== null) {
    fail(`non-private unit has a destination ${unit.unit_id}`)
  }
  for (const key of ['unit_id', 'destination_note', 'idempotency_key', 'rationale', 'public_replacement_id']) {
    const value = unit[key]
    if (typeof value === 'string' && ['...', 'unit-id', 'privacy-unit-key', '64-lowercase-hex', 'PATH_FROM_MANIFEST'].includes(value)) fail(`unsubstituted placeholder in ${unit.unit_id}`)
  }
  const bytes = sourceBytes(root, unit, artifacts)
  if (bytes) {
    const slice = sliceLines(bytes, unit.start_line, unit.end_line)
    if (sha256(slice) !== unit.source_slice_sha256) fail(`source hash mismatch ${unit.unit_id}`)
    const sourceText = slice.toString('utf8')
    const metadataFields = ['unit_id', 'destination_note', 'idempotency_key', 'rationale', 'public_replacement_id']
    const forbiddenMetadata = /(?:\b(?:pr|prd|issue|ticket)[#\s-]*\d{1,6}\b|#[0-9]{1,6}\b|\bprd-none\b|\b[0-9A-Fa-f]{7,64}\b|(?:packages?|src|apps|services|lib|pi|claude|\.claude)\/|~\/(?:\.|Library)|\/(?:Users|Volumes|home)\/|\b(?:fable|xhigh|glm|gpt|claude|opus|sonnet|minimax|qwen|openai|anthropic|gemini|mistral|deepseek|ollama|redocly|azure|vertex|bedrock|openrouter|cohere|together|groq|greptile|zai)\b|\b(?:agent-nodejs|employer|forestadmin|f-f-z|macroscope|vps|work[- ]stack)\b|\b(?:CR-[A-Z0-9]+|R-\d{3}|H-\d{3}|ADR-\d{2,6}|[A-Z]-\d{2,4})\b)/i
    for (const field of metadataFields) {
      const value = unit[field]
      if (typeof value !== 'string') continue
      if (forbiddenMetadata.test(value)) fail(`sensitive metadata ${field} ${unit.unit_id}`)
      const sourceBytes = Buffer.from(sourceText)
      const metadataBytes = Buffer.from(value)
      if (metadataBytes.length >= 32 && sourceBytes.length >= 32) {
        for (let offset = 0; offset <= sourceBytes.length - 32; offset += 1) if (metadataBytes.includes(sourceBytes.subarray(offset, offset + 32))) fail(`metadata copies source text ${field} ${unit.unit_id}`)
      }
      for (const sourceLine of sourceText.split(/\r?\n/)) if (sourceLine === value) fail(`metadata copies source line ${field} ${unit.unit_id}`)
    }
  }
  return bytes ? lineCount(bytes) : null
}

function rangesFor(units, file) {
  return units.filter((unit) => unit.source_file === file).sort((a, b) => a.start_line - b.start_line)
}

function validateCoverage(manifest, root, artifacts) {
  const files = new Map()
  const seen = { unit: new Set(), idempotency: new Set() }
  for (const unit of manifest.units) {
    const count = validateUnit(unit, root, artifacts, seen)
    const previous = files.get(unit.source_file)
    if (previous && previous.count !== count && count !== null) fail(`source line count changed while validating ${unit.source_file}`)
    files.set(unit.source_file, { count, units: [...(previous?.units ?? []), unit] })
  }
  for (const [file, data] of files) {
    const ranges = rangesFor(data.units, file)
    for (let index = 1; index < ranges.length; index += 1) {
      if (ranges[index].start_line <= ranges[index - 1].end_line) fail(`overlapping ranges in ${file}`)
    }
    if (PRIMARY.has(file)) {
      if (ranges.length === 0 || ranges[0].start_line !== 1 || ranges.at(-1).end_line !== data.count) fail(`primary coverage is not gap-free in ${file}`)
      for (let index = 1; index < ranges.length; index += 1) if (ranges[index].start_line !== ranges[index - 1].end_line + 1) fail(`gap in primary coverage ${file}`)
    }
  }
  for (const file of TRACKED_SOURCES) {
    const data = files.get(file)
    if (!data || data.units.length === 0) fail(`required tracked source is omitted: ${file}`)
    if (data.units.some((unit) => unit.source_state !== 'tracked-head')) fail(`tracked source is not anchored to HEAD: ${file}`)
  }
}

function validateDiff(manifest, root) {
  const paths = [...new Set(manifest.units.filter((unit) => unit.source_state === 'tracked-head').map((unit) => unit.source_file).filter((file) => !PRIMARY.has(file)))]
  for (const file of paths) {
    const head = trackedBytes(root, file)
    const currentPath = resolve(root, file)
    if (!existsSync(currentPath)) fail(`tracked inbound/archive path is missing: ${file}`)
    const current = readFileSync(currentPath)
    if (lineCount(head) !== lineCount(current)) fail(`inbound/archive insertion or deletion is forbidden: ${file}`)
    const diff = git(['diff', '--unified=0', 'HEAD', '--', file], root).toString('utf8')
    const changed = []
    for (const match of diff.matchAll(/@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@/g)) {
      const oldStart = Number(match[1])
      const oldCount = match[2] ? Number(match[2]) : 1
      const newStart = Number(match[3])
      const newCount = match[4] ? Number(match[4]) : 1
      for (let line = oldStart; line < oldStart + oldCount; line += 1) changed.push(line)
      for (let line = newStart; line < newStart + newCount; line += 1) changed.push(line)
    }
    const ranges = rangesFor(manifest.units, file)
    for (const line of changed) if (!ranges.some((range) => line >= range.start_line && line <= range.end_line)) fail(`changed line ${line} is outside manifest ranges in ${file}`)
  }
}

function validatePhase(manifest, root, artifacts, phase, artifactsSchemaVersion) {
  if (!['pre-delete', 'post-delete'].includes(phase)) return
  const receiptPath = resolve(root, '.workflow/self-improvement-privacy-20260914/receipts.json')
  const receipts = existsSync(receiptPath) ? JSON.parse(readFileSync(receiptPath, 'utf8')) : { receipts: [] }
  if (artifactsSchemaVersion !== 1 || !Array.isArray(artifacts)) fail('invalid local-artifacts schema')
  const privateUnits = manifest.units.filter((entry) => PRIVATE_CLASS.has(entry.classification))
  const unitsById = new Map(manifest.units.map((unit) => [unit.unit_id, unit]))
  const privateById = new Map(privateUnits.map((unit) => [unit.unit_id, unit]))
  const receiptKeys = ['receipt_id', 'unit_id', 'destination_repo', 'destination_note', 'idempotency_key', 'source_slice_sha256', 'action', 'content_review']
  if (receipts.schema_version !== 1 || !Array.isArray(receipts.receipts)) fail('invalid receipts schema')
  const receiptIds = new Set()
  for (const receipt of receipts.receipts) {
    if (Object.keys(receipt).sort().join('|') !== receiptKeys.slice().sort().join('|')) fail(`invalid receipt schema ${receipt.receipt_id ?? 'unknown'}`)
    if (receiptIds.has(receipt.receipt_id)) fail(`duplicate receipt_id ${receipt.receipt_id}`)
    receiptIds.add(receipt.receipt_id)
    const unit = privateById.get(receipt.unit_id)
    if (!unit || receipt.receipt_id !== receipt.unit_id || receipt.content_review !== 'no-raw' || !['created', 'already-present'].includes(receipt.action)) fail(`invalid receipt ${receipt.receipt_id}`)
    if (receipt.destination_repo !== unit.destination_repo || receipt.destination_note !== unit.destination_note || receipt.idempotency_key !== unit.idempotency_key || receipt.source_slice_sha256 !== unit.source_slice_sha256) fail(`receipt mismatch ${receipt.receipt_id}`)
  }
  for (const unit of privateUnits) if (!receiptIds.has(unit.unit_id)) fail(`missing receipt ${unit.unit_id}`)
  const artifactPaths = new Set()
  const artifactUnitIds = new Set()
  const artifactReceiptIds = new Set()
  for (const artifact of artifacts) {
    if (!artifact || typeof artifact.path !== 'string' || artifactPaths.has(artifact.path) || !Array.isArray(artifact.unit_ids) || !Array.isArray(artifact.receipt_ids) || artifact.action !== 'routed_then_deleted' || artifact.after !== 'absent' || !/^[0-9a-f]{64}$/.test(artifact.before_sha256)) fail('invalid local-artifacts schema')
    validateRelativePath(artifact.path, 'local artifact path')
    artifactPaths.add(artifact.path)
    for (const unitId of artifact.unit_ids) {
      if (artifactUnitIds.has(unitId)) fail(`duplicate local artifact unit ${unitId}`)
      const unit = unitsById.get(unitId)
      if (!unit || unit.source_state !== 'untracked-preedit' || unit.source_file !== artifact.path) fail(`local artifact unit mismatch ${unitId}`)
      artifactUnitIds.add(unitId)
    }
    const expectedArtifactReceipts = artifact.unit_ids.filter((unitId) => PRIVATE_CLASS.has(unitsById.get(unitId)?.classification ?? ''))
    if (artifact.receipt_ids.slice().sort().join('|') !== expectedArtifactReceipts.slice().sort().join('|')) fail(`local artifact receipt coverage mismatch ${artifact.path}`)
    for (const receiptId of artifact.receipt_ids) {
      if (artifactReceiptIds.has(receiptId) || !receiptIds.has(receiptId)) fail(`local artifact receipt mismatch ${receiptId}`)
      artifactReceiptIds.add(receiptId)
    }
  }
  const expectedLocalUnits = manifest.units.filter((unit) => unit.source_state === 'untracked-preedit').map((unit) => unit.unit_id)
  if (artifactUnitIds.size !== expectedLocalUnits.length || expectedLocalUnits.some((unitId) => !artifactUnitIds.has(unitId))) fail('local-artifacts does not cover manifest untracked units exactly')
  const expectedLocalReceipts = receipts.receipts.filter((receipt) => privateById.has(receipt.unit_id) && unitsById.get(receipt.unit_id)?.source_state === 'untracked-preedit').length
  if (artifactReceiptIds.size !== expectedLocalReceipts) fail('local-artifacts receipts are incomplete')
  if (phase === 'pre-delete') for (const artifact of artifacts) {
    if (!existsSync(resolve(root, artifact.path))) fail(`local artifact missing before deletion ${artifact.path}`)
    if (sha256(readFileSync(resolve(root, artifact.path))) !== artifact.before_sha256) fail(`local artifact hash mismatch ${artifact.path}`)
  }
  if (phase === 'post-delete') for (const artifact of artifacts) if (existsSync(resolve(root, artifact.path)) || artifact.after !== 'absent') fail(`local artifact was not deleted ${artifact.path}`)
}

function generateManifest(root, outputPath, localArtifactsPath) {
  const trackedFiles = [
    'workflow/self-improvement/reviewer-eval-corpus.md',
    'workflow/self-improvement/review-metrics.md',
    'workflow/skills/reviewer-improvement-loop.md',
    'workflow/skills/ship.md',
    'workflow/templates/escaped-defect.md',
    'docs/adr/0019-measure-ambient-tooling-before-cutting-review-passes.md',
    'docs/plan/20260826-rtk-grep-fix-and-adversary-metrics.md',
    'docs/plan/20260914-public-scrub.md',
    'docs/plan/20260914-workflow-context-budget.md',
    'docs/plan/20260914-context-budget-growth-remediation.md',
  ]
  const localArtifacts = localArtifactsPath && existsSync(resolve(root, localArtifactsPath)) ? JSON.parse(readFileSync(resolve(root, localArtifactsPath), 'utf8')).artifacts ?? [] : []
  const localFiles = localArtifacts.map((artifact) => artifact.path)
  const units = []
  let nextNumericId = 1
  const explicitIds = new Map([
    ['workflow/self-improvement/reviewer-eval-corpus.md:417-417', 'unit-026b'],
    ['workflow/self-improvement/reviewer-eval-corpus.md:418-423', 'unit-026c'],
    ['workflow/self-improvement/review-metrics.md:17-19', 'unit-053b'],
    ['workflow/self-improvement/review-metrics.md:76-78', 'unit-056b'],
    ['workflow/self-improvement/review-metrics.md:79-79', 'unit-056c'],
  ])
  const sensitive = /(?:\b(?:pr|prd|issue|ticket)[#\s-]*\d{1,6}\b|#[0-9]{1,6}\b|\bprd-none\b|\b[0-9A-Fa-f]{7,40}\b|\b[0-9A-Fa-f]{32,64}\b|(?:packages?|src|apps|services|lib|pi|claude|\.claude)\/|~\/(?:\.|Library)|\/(?:Users|Volumes|home)\/|\b(?:fable|xhigh|glm|gpt|claude|opus|sonnet|minimax|qwen|openai|anthropic|gemini|mistral|deepseek|ollama|redocly|azure|vertex|bedrock|openrouter|cohere|together|groq|greptile|zai)\b|\b(?:agent-nodejs|employer|forestadmin|f-f-z|macroscope|vps|work[- ]stack)\b|\b(?:CR-[A-Z0-9]+|R-\d{3}|H-\d{3}|ADR-\d{2,6}|[A-Z]-\d{2,4})\b)/i
  const contextPattern = /\b(?:agent-nodejs|employer|forestadmin|f-f-z|work[- ]stack)\b/i
  const appendFile = (file, state, bytes, requireFull) => {
    const lines = bytes.toString('utf8').split(/\n/)
    if (lines.at(-1) === '') lines.pop()
    const sectionStarts = [1]
    lines.forEach((line, index) => {
      if (index > 0 && /^#{1,6}\s/.test(line)) sectionStarts.push(index + 1)
    })
    // These source sections contain interleaved public and work-context
    // clauses. Keep the same atomic boundaries used by the checked-in
    // manifest instead of collapsing them back to one Markdown heading.
    const atomicStarts = file === 'workflow/self-improvement/reviewer-eval-corpus.md'
      ? [417, 418]
      : file === 'workflow/self-improvement/review-metrics.md'
        ? [17, 76, 79]
        : []
    sectionStarts.push(...atomicStarts)
    sectionStarts.sort((a, b) => a - b)
    const uniqueSectionStarts = [...new Set(sectionStarts)]
    const appendSection = (start, end) => {
      if (end < start) return
      const sectionText = lines.slice(start - 1, end).join('\n')
      // A storage table can mention both destinations while remaining a
      // public, generic contract. It is not evidence originating in either
      // private work context.
      const publicStorageRule = file === 'workflow/self-improvement/review-metrics.md' && ((start === 9 && end === 16) || (start === 17 && end === 19))
      const genericStorageRule = file === 'workflow/self-improvement/review-metrics.md' && start === 17 && end === 19
      const retainedPublicRule = (file === 'workflow/self-improvement/reviewer-eval-corpus.md' && ((start === 413 && end === 416) || (start === 418 && end === 423))) || (file === 'workflow/self-improvement/review-metrics.md' && ((start === 9 && end === 16) || (start === 79 && end === 79)))
      const hasForestSignal = publicStorageRule ? false : contextPattern.test(sectionText)
      if (hasForestSignal && /\b(?:forestadmin|work[- ]stack|employer|agent-nodejs|f-f-z)\b/i.test(sectionText) && /\b(?:etabli|public|repository)\b/i.test(sectionText) && /\bforestadmin\b/i.test(sectionText) && /\betabli\b/i.test(sectionText)) fail(`ambiguous provenance in ${file}:${start}-${end}`)
      const context = hasForestSignal ? 'forestadmin' : 'etabli'
      const classification = publicStorageRule ? 'public-safe' : (sensitive.test(sectionText) ? (context === 'forestadmin' ? 'Brain' : 'Obvault') : 'public-safe')
      const slice = sliceLines(bytes, start, end)
      const privateUnit = classification === 'Brain' || classification === 'Obvault'
      const key = explicitIds.get(`${file}:${start}-${end}`) ?? `unit-${String(nextNumericId).padStart(3, '0')}`
      if (!explicitIds.has(`${file}:${start}-${end}`)) nextNumericId += 1
      units.push({
        unit_id: key,
        source_file: file,
        source_state: state,
        start_line: start,
        end_line: end,
        source_slice_sha256: sha256(slice),
        context,
        context_basis: genericStorageRule
          ? 'generic-public-contract'
          : context === 'forestadmin' ? 'workstack-forestadmin' : 'etabli-harness',
        classification,
        destination_repo: privateUnit ? (context === 'forestadmin' ? 'Tonours/brain' : 'Tonours/obvault') : null,
        destination_note: privateUnit ? (context === 'forestadmin' ? 'ref/review-effectiveness-log.md' : 'kb/etabli-self-improvement-harness-contract.md') : null,
        idempotency_key: privateUnit ? `self-improvement-privacy-${key}` : null,
        rationale: genericStorageRule
          ? 'generic storage contract redacted from the public surface'
          : retainedPublicRule
            ? 'operational detail retained once in the approved private store or removed from the public surface'
          : classification === 'public-safe' ? 'generic contract or synthetic-safe section' : 'operational detail retained once in the approved private store or removed from the public surface',
        public_replacement_id: null,
      })
    }
    for (let index = 0; index < uniqueSectionStarts.length; index += 1) appendSection(uniqueSectionStarts[index], uniqueSectionStarts[index + 1] ? uniqueSectionStarts[index + 1] - 1 : lines.length)
    if (requireFull && units.filter((unit) => unit.source_file === file).at(-1)?.end_line !== lines.length) fail(`generated coverage failed for ${file}`)
  }
  for (const file of trackedFiles) appendFile(file, 'tracked-head', trackedBytes(root, file), PRIMARY.has(file))
  for (const file of localFiles) appendFile(file, 'untracked-preedit', readFileSync(resolve(root, file)), false)
  writeFileSync(resolve(root, outputPath), `${JSON.stringify({ schema_version: 1, units }, null, 2)}\n`, { mode: 0o600 })
}

const options = args()
const sourceRoot = resolve(options.root ?? ROOT)
if (git(['rev-parse', 'HEAD'], sourceRoot).toString('utf8').trim() !== EXPECTED_HEAD) fail(`HEAD is not the locked source commit ${EXPECTED_HEAD}`)
if (options.generate) {
  if (!options.output) fail('--output is required with --generate')
  generateManifest(resolve(options.root), options.output, options.localArtifacts)
  console.log(`privacy classification manifest generated: ${options.output}`)
  process.exit(0)
}
if (!options.manifest) fail('--manifest is required')
const root = resolve(options.root)
const manifest = JSON.parse(readFileSync(resolve(root, options.manifest), 'utf8'))
if (manifest.schema_version !== 1 || !Array.isArray(manifest.units)) fail('invalid manifest schema')
const artifactDocument = options.localArtifacts && existsSync(resolve(root, options.localArtifacts)) ? JSON.parse(readFileSync(resolve(root, options.localArtifacts), 'utf8')) : { schema_version: 1, artifacts: [] }
const artifacts = Array.isArray(artifactDocument.artifacts) ? artifactDocument.artifacts : []
if (options.phase !== 'default') process.env.PRIVACY_PHASE = options.phase
if (options.checkDiff && options.phase === 'default') {
  const trackedManifest = { ...manifest, units: manifest.units.filter((unit) => unit.source_state === 'tracked-head') }
  validateCoverage(trackedManifest, root, [])
} else {
  validateCoverage(manifest, root, artifacts)
}
if (options.checkDiff) validateDiff(manifest, root)
if (options.phase !== 'default') validatePhase(manifest, root, artifacts, options.phase, artifactDocument.schema_version)
console.log(`privacy classification ok: ${manifest.units.length} units`)
