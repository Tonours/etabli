#!/usr/bin/env node
import { readFileSync, existsSync, writeFileSync } from 'node:fs'
import { resolve } from 'node:path'

const values = process.argv.slice(2)
const paths = []
let allowPath = null
let outputPath = null
let redact = false
let reportOnly = false
for (let index = 0; index < values.length; index += 1) {
  const option = values[index]
  if (option === '--paths') {
    let count = 0
    for (index += 1; index < values.length && !values[index].startsWith('--'); index += 1) {
      paths.push(values[index])
      count += 1
    }
    index -= 1
    if (count === 0) throw new Error('--paths requires at least one path')
  } else if (option === '--allowlist' || option === '--output') {
    const target = values[index + 1]
    if (!target || target.startsWith('--')) throw new Error(`${option} requires a value`)
    if (option === '--allowlist') allowPath = target
    else outputPath = target
    index += 1
  } else if (option === '--redact-tokens') redact = true
  else if (option === '--report-only') reportOnly = true
  else throw new Error(`unknown option ${option}`)
}
if (paths.length === 0) throw new Error('--paths is required')

const classes = [
  ['pr-issue', /\b(?:pr|prd|issue|ticket)[#\s-]*\d{1,6}\b|#[0-9]{1,6}\b|[A-Za-z0-9_-]+#[0-9]{1,6}\b|\bprd-none\b/gi],
  ['commit', /\b(?=[0-9A-Fa-f]{7,40}\b)(?=[0-9A-Fa-f]*[A-Fa-f])[0-9A-Fa-f]{7,40}\b|(?:commit|sha|hash)[=:\/\s-]*[0-9A-Fa-f]{7,64}\b/gi],
  ['opaque', /\b[0-9A-Fa-f]{32,64}\b/g],
  ['path', /(?:packages?|src|apps|services|lib|pi|claude|\.claude)\/[A-Za-z0-9._@~\/-]+/g],
  ['path', /~\/(?:\.[A-Za-z0-9_-]+|Library)[A-Za-z0-9._@~\/ -]*/g],
  ['path', /\/(?:Users|Volumes|home)\/[A-Za-z0-9._@~\/ -]+/g],
  ['path', /@[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+/g],
  ['provider', /\b(?:fable|xhigh|glm[- .]?\d+(?:\.\d+)?|gpt[- .]?\d+(?:\.\d+)?|claude|opus|sonnet|minimax|qwen|openai|anthropic|gemini|mistral|deepseek|ollama|redocly|azure|vertex|bedrock|openrouter|cohere|together|groq|greptile|zai)\b/gi],
  ['work-stack', /\b(?:agent-nodejs|employer|forestadmin|f-f-z|macroscope|vps|work[- ]stack)\b/gi],
  ['campaign', /\b(?:CR-[A-Z0-9]+|R-\d{3}|H-\d{3}|ADR-\d{2,6}|[A-Z]-\d{2,4})\b/g],
]

function fail(message) {
  console.error(`public-privacy-scan: ${message}`)
  process.exitCode = 1
}

let allowlist = { schema_version: 1, synthetic_ids: [], opaque_sha256: [] }
if (allowPath) {
  if (!existsSync(resolve(allowPath))) throw new Error(`allowlist is missing: ${allowPath}`)
  allowlist = JSON.parse(readFileSync(resolve(allowPath), 'utf8'))
  const keys = Object.keys(allowlist).sort().join('|')
  if (keys !== 'opaque_sha256|schema_version|synthetic_ids' || allowlist.schema_version !== 1 || !Array.isArray(allowlist.synthetic_ids) || !Array.isArray(allowlist.opaque_sha256)) throw new Error('invalid allowlist schema')
  if (allowlist.synthetic_ids.some((value) => typeof value !== 'string' || !/^fixture-[a-z0-9-]+$/.test(value))) throw new Error('invalid synthetic allowlist entry')
  if (allowlist.opaque_sha256.some((value) => typeof value !== 'string' || !/^[0-9a-f]{64}$/.test(value))) throw new Error('invalid opaque allowlist entry')
}
const allowed = new Set([...(allowlist.synthetic_ids ?? []), ...(allowlist.opaque_sha256 ?? [])])
const findings = []
for (const path of paths) {
  if (!existsSync(resolve(path))) {
    fail(`missing path ${path}`)
    continue
  }
  const lines = readFileSync(resolve(path), 'utf8').split(/\r?\n/)
  lines.forEach((line, lineIndex) => {
    for (const [kind, pattern] of classes) {
      pattern.lastIndex = 0
      for (const match of line.matchAll(pattern)) {
        const token = match[0]
        if (!allowed.has(token)) findings.push({ path, line: lineIndex + 1, class: kind, token })
      }
    }
  })
}
if (findings.length > 0) {
  const report = findings.map((finding) => ({ ...finding, token: redact ? '[REDACTED]' : finding.token }))
  const payload = `${JSON.stringify({ findings: report }, null, 2)}\n`
  if (outputPath) writeFileSync(resolve(outputPath), payload, { mode: 0o600 })
  if (reportOnly) console.log(payload.trim())
  else console.error(payload.trim())
  process.exitCode = 1
} else {
  const payload = JSON.stringify({ findings: [] })
  if (outputPath) writeFileSync(resolve(outputPath), `${payload}\n`, { mode: 0o600 })
  console.log('public privacy scan ok: no non-allowlisted findings')
}
