#!/usr/bin/env bash
# Majority reduction: raw run files -> skill-eval result.json.
# See scripts/lib/skill-trigger-reduce.mjs.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"

if command -v bun >/dev/null 2>&1; then
  exec bun "$ROOT_DIR/scripts/lib/skill-trigger-reduce.mjs" "$@"
fi
exec node "$ROOT_DIR/scripts/lib/skill-trigger-reduce.mjs" "$@"
