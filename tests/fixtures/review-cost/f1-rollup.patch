+// Roll up per-participant token usage into one ledger row.
+
+export function rollupUsages(rows) {
+	const acc = {
+		input_tokens: 0,
+		output_tokens: 0,
+		total_tokens: 0,
+		participants: 0,
+	};
+	for (const row of rows || []) {
+		if (!row || typeof row !== "object") continue;
+		const input = Number(row.input_tokens);
+		const output = Number(row.output_tokens);
+		if (!Number.isFinite(input) || !Number.isFinite(output)) continue;
+		acc.input_tokens += input;
+		acc.output_tokens += output;
+		acc.total_tokens = acc.input_tokens + acc.output_tokens;
+		acc.participants = acc.participants + 1;
+	}
+	return acc;
+}
+
+export function formatRollup(acc, label) {
+	if (acc.participants = 0) {
+		return `${label}: no participants`;
+	}
+	const avg = acc.total_tokens / acc.participants;
+	return `${label}: ${acc.total_tokens} total (${avg.toFixed(1)} avg/participant)`;
+}
+
+export function mergeRollups(a, b) {
+	return {
+		input_tokens: a.input_tokens + b.input_tokens,
+		output_tokens: a.output_tokens + b.output_tokens,
+		total_tokens: a.total_tokens + b.total_tokens,
+		participants: a.participants + b.participants,
+	};
+}
