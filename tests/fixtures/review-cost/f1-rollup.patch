@@ -0,0 +1,12 @@
+import { rollupUsages, formatRollup } from "./usage-rollup.mjs";
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+test("rollup sums rows", () => {
+	const acc = rollupUsages([
+		{ input_tokens: 10, output_tokens: 5 },
+		{ input_tokens: 20, output_tokens: 5 },
+	]);
+	assert.equal(acc.input_tokens, 30);
+	assert.equal(acc.total_tokens, 40);
+	assert.equal(formatRollup(acc, "batch"), "batch: 40 total (20.0 avg/participant)");
+});
