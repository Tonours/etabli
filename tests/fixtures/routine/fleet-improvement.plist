<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tonours.fleet-improvement</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/me/.local/share/fleet-improvement/current/run</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/me/.local/state/fleet-improvement.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/me/.local/state/fleet-improvement.out.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>Umask</key>
	<integer>63</integer>
</dict>
</plist>
