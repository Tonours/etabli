{
  "$comment": "Sanitized reference inventory. It is not deployed and contains no credentials. Live definitions remain runtime-local; copy only the server a runtime needs. See docs/mcp-strategy.md.",
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@1.7.0"
      ],
      "env": {}
    },
    "alambic-brain": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${HOME}/work/alambic/_meta/mcp/server.mjs"
      ],
      "env": {
        "ALAMBIC_ROOT": "${HOME}/work/brain",
        "ALAMBIC_STATE_DIR": "${HOME}/.local/state/alambic-brain"
      }
    },
    "alambic-obvault": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${HOME}/work/alambic/_meta/mcp/server.mjs"
      ],
      "env": {
        "ALAMBIC_ROOT": "${HOME}/work/obvault",
        "ALAMBIC_STATE_DIR": "${HOME}/.local/state/alambic-obvault"
      }
    },
    "datadog": {
      "type": "http",
      "url": "https://mcp.datadoghq.com/v1/mcp"
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    }
  }
}
