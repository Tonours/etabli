# Ghostty — Catppuccin Mocha

# Font
font-family = Monaco
font-size = 20
adjust-cell-height = 8%

# Theme colors aligned with tmux Catppuccin Mocha
background = #1e1e2e
foreground = #cdd6f4
cursor-color = #cba6f7
cursor-text = #11111b
selection-background = #45475a
selection-foreground = #cdd6f4

# Palette ANSI
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#cba6f7
palette = 6=#94e2d5
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#cba6f7
palette = 14=#94e2d5
palette = 15=#a6adc8

# Curseur
cursor-style = block
cursor-style-blink = false

# Scrollback (même limite que iTerm2)
scrollback-limit = 1000

# Fenêtre
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
window-padding-color = background
macos-titlebar-style = native
macos-window-buttons = visible

# Disable shell integration title override — keeps tmux window names fixed
shell-integration-features = cursor,no-sudo,no-ssh-env,no-ssh-terminfo,path
